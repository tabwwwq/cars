	local starRow = Kit.new("Frame", { Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 84), BackgroundTransparency = 1, Parent = content })
	Kit.list(starRow, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	for i = 1, 3 do
		table.insert(resultStars, Kit.label({ Size = UDim2.fromOffset(80, 84), Text = "★", TextSize = 64, LayoutOrder = i, TextTruncate = Enum.TextTruncate.None, Parent = starRow }))
	end
	resultMoney = Kit.label({ Position = UDim2.fromOffset(0, 136), Size = UDim2.new(1, 0, 0, 52), Text = "", TextSize = 46, Font = T.FontBlack, TextColor3 = T.Gold, Parent = content })
	resultDetail = Kit.label({ Position = UDim2.fromOffset(0, 192), Size = UDim2.new(1, 0, 0, 26), Text = "", TextSize = 18, TextColor3 = T.Accent2, Parent = content })
	Kit.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(240, 56),
		Text = Strings.get("ServiceContinue"),
		TextSize = 24,
		BackgroundColor3 = T.Good,
		onClick = function()
			setResultOpen(false)
		end,
		Parent = content,
	})

	-- level-up card
	levelWindow, content, setLevelOpen = Kit.modal(gui, "LevelUp", "⭐", Vector2.new(560, 440), T.Gold)
	levelTitle = levelWindow:FindFirstChild("Title", true) :: TextLabel
	levelList = Kit.new("Frame", { Position = UDim2.fromOffset(20, 20), Size = UDim2.new(1, -40, 1, -110), BackgroundTransparency = 1, Parent = content })
	Kit.list(levelList, Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center)
	Kit.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(240, 56),
		Text = Strings.get("ServiceCool"),
		TextSize = 24,
		BackgroundColor3 = T.Accent,
		onClick = function()
			setLevelOpen(false)
		end,
		Parent = content,
	})
end

function Service.start()
	Net.on("ServiceState", function(snapshot)
		if typeof(snapshot) == "table" then
			ClientState.setService(snapshot)
		end
	end)
	Net.on("ServiceEvent", function(kind, data)
		if kind == "arrived" then
			Notifications.notifyKey("ServiceArrived", {}, "info")
		elseif kind == "ready" then
			Notifications.notifyKey("ServiceReady", {}, "success")
		elseif kind == "done" and typeof(data) == "table" then
			if not data.worker then
				lastResult = os.clock()
				task.delay(0.8, showResult, data)
				local svc = svcProfile()
				if svc and svc.tutorial < 1 then
					task.spawn(Net.request, "ServiceTutorial", 1)
				end
			end
		elseif kind == "levelup" and typeof(data) == "number" then
			-- after the result card has had its moment
			local recent = os.clock() - lastResult < 2
			task.delay(if recent or resultWindow.Visible then 3 else 1, showLevelUp, data)
		end
	end)
	ClientState.ServiceChanged:Connect(function()
		dropPreviews()
		refreshRail()
		refreshPrompts()
		renderOrders()
		renderBusiness()
	end)
	ClientState.ProfileChanged:Connect(function()
		refreshLevel()
		refreshRail()
		renderBusiness()
	end)
	ClientState.WorkingChanged:Connect(function(id)
		rail.Visible = id == nil
		refreshRail()
	end)
	CollectionService:GetInstanceAddedSignal("ServiceCustomer"):Connect(function()
		task.defer(refreshPrompts)
	end)
	refreshLevel()
	-- live bits: worker progress in the open orders window, hints
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 1 then
			return
		end
		acc = 0
		refreshRail()
		if ordersOpen then
			updateLive()
		end
	end)
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">ServiceFX</string>
            <string name="Source"><![CDATA[-- ServiceFX: animates customers and staff of every service plot. The server
-- stores a path on the model (Util/Path attributes) and parks it at the end;
-- here every client replays the trip smoothly. Staff swing their arms and
-- legs while walking and scrub while working.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Path = require(Shared.Util.Path)

local ServiceFX = {}

type Mover = {
	model: Model,
	track: Path.Track?,
	key: string?,
	start: number,
	speed: number,
	reverse: boolean,
	y: number,
	duration: number,
	done: boolean,
	joints: { [string]: Motor6D },
	phase: number,
}

local movers: { [Model]: Mover } = {}

local function readPath(m: Mover)
	local model = m.model
	local text = model:GetAttribute("MovePath")
	if typeof(text) ~= "string" or text == "" then
		m.track = nil
		m.done = true
		return
	end
	local key = text .. "|" .. tostring(model:GetAttribute("MoveStart"))
	if key == m.key then
		return
	end
	m.key = key
	m.track = Path.new(Path.decode(text))
	m.start = tonumber(model:GetAttribute("MoveStart")) or 0
	m.speed = tonumber(model:GetAttribute("MoveSpeed")) or 10
	m.reverse = model:GetAttribute("MoveReverse") == true
	m.y = tonumber(model:GetAttribute("MoveY")) or 0
	m.duration = Path.duration((m.track :: Path.Track).length, m.speed)
	m.done = false
end

local function add(model: Instance)
	if not model:IsA("Model") or movers[model] then
		return
	end
	local m: Mover = {
		model = model,
		track = nil,
		key = nil,
		start = 0,
		speed = 10,
		reverse = false,
		y = 0,
		duration = 0,
		done = true,
		joints = {},
		phase = math.random() * 10,
	}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			m.joints[d.Name] = d
		end
	end
	movers[model] = m
	readPath(m)
	for _, attr in { "MovePath", "MoveStart" } do
		model:GetAttributeChangedSignal(attr):Connect(function()
			readPath(m)
		end)
	end
end

local function remove(model: Instance)
	movers[model :: Model] = nil
end

local function animateLimbs(m: Mover, walking: boolean, working: boolean, t: number)
	local j = m.joints
	if not next(j) then
		return
	end
	local swing = 0
	if walking then
		swing = math.sin(t * 9 + m.phase) * 0.7
	end
	local armR = -swing
	local armL = swing
	if working then
		armR = -1.3 + math.sin(t * 11 + m.phase) * 0.45
		armL = -0.9 + math.sin(t * 11 + m.phase + 1.5) * 0.3
	end
	if j.Joint_LegL then
		j.Joint_LegL.Transform = CFrame.Angles(swing, 0, 0)
	end
	if j.Joint_LegR then
		j.Joint_LegR.Transform = CFrame.Angles(-swing, 0, 0)
	end
	if j.Joint_ArmL then
		j.Joint_ArmL.Transform = CFrame.Angles(armL, 0, 0)
	end
	if j.Joint_ArmR then
		j.Joint_ArmR.Transform = CFrame.Angles(armR, 0, 0)
	end
end

function ServiceFX.start()
	for _, tag in { "ServiceCustomer", "ServiceWorker" } do
		for _, model in CollectionService:GetTagged(tag) do
			add(model)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(add)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(remove)
	end
	RunService.RenderStepped:Connect(function()
		local now = Workspace:GetServerTimeNow()
		local camera = Workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		local t = os.clock()
		for model, m in movers do
			if not model.Parent then
				movers[model] = nil
				continue
			end
			local root = model.PrimaryPart
			if not root then
				continue
			end
			local moving = false
			if not m.done and m.track then
				local track = m.track :: Path.Track
				local elapsed = now - m.start
				local d = Path.distanceAt(track.length, m.speed, elapsed)
				root.CFrame = Path.groundCFrame(track, d, m.y, m.reverse)
				moving = elapsed < m.duration
				if not moving then
					m.done = true
				end
			end
			if (root.Position - camPos).Magnitude < 220 then
				animateLimbs(m, moving, model:GetAttribute("Working") == true, t)
			end
		end
	end)
end

return ServiceFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">VehicleFX</string>
            <string name="Source"><![CDATA[-- VehicleFX: everything visual about cars, for every car near the camera:
-- wheel animation of other players' cars, head/brake lights, sirens,
-- exhaust smoke, nitro flames, skid marks, tire smoke, optional sounds and
-- the visibility of seat prompts.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local CarBuilder = require(Shared.CarBuilder)
local CarPhysics = require(Shared.CarPhysics)
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)

local Drive = require(script.Parent.Drive)

local VehicleFX = {}

local player = Players.LocalPlayer
local MAX_DISTANCE = 450
local TAIL_OFF = Color3.fromRGB(120, 8, 12)
local TAIL_ON = Color3.fromRGB(255, 40, 40)
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

type Rig = {
	model: Model,
	chassis: BasePart,
	wheels: { CarPhysics.Wheel },
	rays: RaycastParams,
	heads: { BasePart },
	tails: { BasePart },
	beam: Light?,
	brakeGlow: Light?,
	sirens: { BasePart },
	sirenLights: { Light },
	exhausts: { ParticleEmitter },
	flames: { ParticleEmitter },
	trails: { Trail },
	smokes: { ParticleEmitter },
	lastSpeed: number,
	brakeHold: number,
	sirenClock: number,
	engine: Sound?,
	conns: { RBXScriptConnection },
	isMine: boolean,
	prompts: { ProximityPrompt },
}

local rigs: { [Model]: Rig } = {}

local function emitter(parent: Instance, texture: string, color: Color3, size: number, rate: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.4), NumberSequenceKeypoint.new(1, size) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(2, 5)
	e.SpreadAngle = Vector2.new(18, 18)
	e.Rate = rate
	e.LightInfluence = 0.8
	e.Enabled = false
	e.Parent = parent
	return e
end

local function sound(parent: Instance, id: string, looped: boolean, volume: number): Sound?
	if id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = looped
	s.Volume = volume
	s.RollOffMaxDistance = 260
	s.RollOffMinDistance = 12
	s.Parent = parent
	return s
end

local function updatePrompts(rig: Rig)
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local seated = hum ~= nil and hum.SeatPart ~= nil
	for _, prompt in rig.prompts do
		local seat = prompt.Parent :: Seat
		local free = seat.Occupant == nil
		if seat.Name == "DriveSeat" then
			prompt.Enabled = rig.isMine and free and not seated
		else
			prompt.Enabled = free and not seated
		end
		prompt.ActionText = Strings.get(prompt:GetAttribute("LocAction") or "PromptSit")
	end
end

local function build(model: Model)
	if rigs[model] then
		return
	end
	local chassis = model:WaitForChild("Chassis", 10) :: BasePart?
	if not chassis or not model.Parent then
		return
	end
	local rays = RaycastParams.new()
	rays.FilterType = Enum.RaycastFilterType.Exclude
	rays.FilterDescendantsInstances = { model }
	rays.CollisionGroup = "WheelRays"
	rays.IgnoreWater = true
	local rig: Rig = {
		model = model,
		chassis = chassis,
		wheels = CarPhysics.readWheels(model),
		rays = rays,
		heads = {},
		tails = {},
		beam = nil,
		brakeGlow = nil,
		sirens = {},
		sirenLights = {},
		exhausts = {},
		flames = {},
		trails = {},
		smokes = {},
		lastSpeed = 0,
		brakeHold = 0,
		sirenClock = 0,
		engine = nil,
		conns = {},
		isMine = model:GetAttribute("OwnerUserId") == player.UserId,
		prompts = {},
	}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local role = d:GetAttribute("Role")
			if role == "Headlight" then
				table.insert(rig.heads, d)
			elseif role == "Taillight" then
				table.insert(rig.tails, d)
			elseif role == "SirenA" or role == "SirenB" then
				table.insert(rig.sirens, d)
				local l = d:FindFirstChildOfClass("PointLight")
				if l then
					table.insert(rig.sirenLights, l)
				end
			end
		elseif d:IsA("ProximityPrompt") and d.Name == "SitPrompt" then
			table.insert(rig.prompts, d)
		end
	end
	local beamPart = model:FindFirstChild("HeadlightBeam", true)
	rig.beam = beamPart and beamPart:FindFirstChildWhichIsA("Light")
	local tailPart = model:FindFirstChild("TailGlow", true)
	rig.brakeGlow = tailPart and tailPart:FindFirstChildWhichIsA("Light")

	-- exhaust + nitro
	for _, a in chassis:GetChildren() do
		if a:IsA("Attachment") and string.sub(a.Name, 1, 7) == "Exhaust" then
			local smoke = emitter(a, SMOKE, Color3.fromRGB(150, 150, 155), 1.6, 12)
			smoke.EmissionDirection = Enum.NormalId.Back
			table.insert(rig.exhausts, smoke)
			local flame = emitter(a, FIRE, Color3.fromRGB(90, 170, 255), 1.4, 60)
			flame.LightEmission = 1
			flame.Lifetime = NumberRange.new(0.12, 0.22)
			flame.Speed = NumberRange.new(14, 20)
			flame.EmissionDirection = Enum.NormalId.Back
			flame.Transparency = NumberSequence.new(0.1, 1)
			table.insert(rig.flames, flame)
		end
	end
	-- skid marks and tire smoke on the rear wheels
	for _, w in rig.wheels do
		local index = w.part and w.part:GetAttribute("Index")
		local a0 = chassis:FindFirstChild("SkidA_" .. tostring(index))
		local a1 = chassis:FindFirstChild("SkidB_" .. tostring(index))
		if a0 and a1 then
			local trail = Instance.new("Trail")
			trail.Attachment0 = a0 :: Attachment
			trail.Attachment1 = a1 :: Attachment
			trail.Color = ColorSequence.new(Color3.fromRGB(20, 20, 22))
			trail.Transparency = NumberSequence.new(0.35, 1)
			trail.Lifetime = 3
			trail.MinLength = 0.2
			trail.FaceCamera = false
			trail.LightInfluence = 1
			trail.Enabled = false
			trail.Parent = chassis
			table.insert(rig.trails, trail)
			local smoke = emitter(a0, SMOKE, Color3.fromRGB(225, 225, 228), 4, 40)
			smoke.Lifetime = NumberRange.new(0.8, 1.6)
			smoke.Speed = NumberRange.new(1, 3)
			smoke.Acceleration = Vector3.new(0, 3, 0)
			table.insert(rig.smokes, smoke)
		end
	end

	-- optional sounds
	rig.engine = sound(chassis, Config.Sounds.Engine, true, 0.45)
	if rig.engine then
		rig.engine:Play()
	end
	local horn = sound(chassis, Config.Sounds.Horn, false, 0.8)
	local siren = sound(chassis, Config.Sounds.Siren, true, 0.6)
	table.insert(
		rig.conns,
		model:GetAttributeChangedSignal("Horn"):Connect(function()
			if horn then
				horn:Play()
			end
		end)
	)

	local function applyLights()
		local on = model:GetAttribute("Lights") == true
		for _, h in rig.heads do
			h.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
		if rig.beam then
			rig.beam.Enabled = on
		end
	end
	applyLights()
	table.insert(rig.conns, model:GetAttributeChangedSignal("Lights"):Connect(applyLights))
	table.insert(
		rig.conns,
		model:GetAttributeChangedSignal("Siren"):Connect(function()
			local on = model:GetAttribute("Siren") == true
			if siren then
				if on then
					siren:Play()
				else
					siren:Stop()
				end
			end
			if not on then
				for _, p in rig.sirens do
					p.Material = Enum.Material.SmoothPlastic
				end
				for _, l in rig.sirenLights do
					l.Enabled = false
				end
			end
		end)
	)
	for _, prompt in rig.prompts do
		local seat = prompt.Parent :: Seat
		table.insert(
			rig.conns,
			seat:GetPropertyChangedSignal("Occupant"):Connect(function()
				updatePrompts(rig)
			end)
		)
	end
	updatePrompts(rig)
	rigs[model] = rig
end

local function remove(model: Instance)
	local rig = rigs[model :: Model]
	if rig then
		for _, c in rig.conns do
			c:Disconnect()
		end
		rigs[model :: Model] = nil
	end
end

local function setEnabled(list: { any }, on: boolean)
	for _, e in list do
		if e.Enabled ~= on then
			e.Enabled = on
		end
	end
end

local function updateRig(rig: Rig, dt: number, camPos: Vector3)
	local chassis = rig.chassis
	if not chassis.Parent then
		return
	end
	local cf = chassis.CFrame
	local dist = (cf.Position - camPos).Magnitude
	local near = dist < MAX_DISTANCE
	local vel = chassis.AssemblyLinearVelocity
	local look = cf.LookVector
	local fwd = vel:Dot(look)
	local speed = vel.Magnitude
	local up = cf.UpVector
	local planar = vel - up * vel:Dot(up)
	local slip = 0
	if planar.Magnitude > 5 then
		slip = math.deg(math.atan2(math.abs(planar:Dot(cf.RightVector)), math.max(math.abs(planar:Dot(look)), 1e-3)))
	end

	local sim = if rig.isMine then Drive.getSim() else nil
	local grounded = true
	local braking, nitro, drifting, throttleish
	if sim and sim.chassis == chassis then
		local t = sim.telemetry
		braking = t.braking
		nitro = sim.nitroActive
		drifting = t.drifting or (t.slipping and t.grounded >= 2 and math.abs(t.forwardSpeed) < 25 and t.rpm > 0.6)
		throttleish = t.rpm
		grounded = t.grounded >= 2
	else
		-- other cars: animate wheels locally and infer the rest from motion
		if near then
			local yawRate = chassis.AssemblyAngularVelocity:Dot(up)
			local steer = 0
			if math.abs(fwd) > 3 then
				-- yaw rate is negative in a right turn, steer is positive to the right
				steer = math.clamp(math.atan(-yawRate * 9 / fwd), -0.6, 0.6)
			end
			local hits = 0
			for _, w in rig.wheels do
				local mount = cf:PointToWorldSpace(w.mount)
				local rest = (rig.model:GetAttribute("SuspRest") or 1.4) :: number
				local hit = Workspace:Raycast(mount, -up * (rest + w.radius), rig.rays)
				if hit then
					hits += 1
					w.springLen = math.clamp(hit.Distance - w.radius, 0, rest)
				else
					w.springLen += (rest - w.springLen) * math.clamp(dt * 8, 0, 1)
				end
				w.steerAngle = if w.steer then steer else 0
				w.spin += fwd / w.radius * dt
				if w.motor then
					w.motor.Transform = CFrame.new(0, w.staticLen - w.springLen, 0)
						* CFrame.Angles(0, -w.steerAngle, 0)
						* CFrame.Angles(-w.spin, 0, 0)
				end
			end
			grounded = hits >= 2
		end
		local decel = (rig.lastSpeed - math.abs(fwd)) / math.max(dt, 1e-3)
		if decel > 30 and math.abs(fwd) > 3 then
			rig.brakeHold = 0.25
		end
		rig.brakeHold -= dt
		braking = rig.brakeHold > 0
		nitro = rig.model:GetAttribute("Nitro") == true
		drifting = grounded and planar.Magnitude > 28 and slip > 14 and slip < 110
		throttleish = math.clamp(speed / 120, 0.2, 1)
	end
	rig.lastSpeed = math.abs(fwd)

	if not near then
		setEnabled(rig.exhausts, false)
		setEnabled(rig.flames, false)
		setEnabled(rig.trails, false)
		setEnabled(rig.smokes, false)
		return
	end

	-- brake lights
	for _, p in rig.tails do
		local c = if braking then TAIL_ON else TAIL_OFF
		if p.Color ~= c then
			p.Color = c
		end
	end
	if rig.brakeGlow then
		rig.brakeGlow.Brightness = if braking then 3 else 0
	end

	-- exhaust, nitro, skids
	for _, e in rig.exhausts do
		e.Rate = 6 + throttleish * 26
	end
	setEnabled(rig.exhausts, speed < 160)
	setEnabled(rig.flames, nitro)
	setEnabled(rig.trails, drifting and grounded)
	setEnabled(rig.smokes, drifting and grounded)

	-- siren
	if rig.model:GetAttribute("Siren") == true and #rig.sirens > 0 then
		rig.sirenClock += dt
		local phase = math.floor(rig.sirenClock * 6) % 2
		local sirenType = rig.model:GetAttribute("SirenType") or "police"
		local colors = CarBuilder.SirenColors[sirenType] or CarBuilder.SirenColors.police
		for _, p in rig.sirens do
			local isA = p:GetAttribute("Role") == "SirenA"
			local lit = (isA and phase == 0) or (not isA and phase == 1)
			p.Material = if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
			p.Color = (if isA then colors[1] else colors[2]):Lerp(Color3.new(0, 0, 0), if lit then 0 else 0.55)
			local l = p:FindFirstChildOfClass("PointLight")
			if l then
				l.Enabled = lit
			end
		end
	end

	-- engine sound pitch
	if rig.engine then
		rig.engine.PlaybackSpeed = 0.7 + throttleish * 1.1
	end
end

function VehicleFX.start()
	for _, m in CollectionService:GetTagged("Car") do
		task.spawn(build, m)
	end
	CollectionService:GetInstanceAddedSignal("Car"):Connect(function(m)
		task.spawn(build, m)
	end)
	CollectionService:GetInstanceRemovedSignal("Car"):Connect(remove)

	-- seat prompts depend on whether the local player sits
	local function watchCharacter(character: Model)
		local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if hum then
			hum:GetPropertyChangedSignal("SeatPart"):Connect(function()
				for _, rig in rigs do
					updatePrompts(rig)
				end
			end)
		end
		for _, rig in rigs do
			updatePrompts(rig)
		end
	end
	if player.Character then
		task.spawn(watchCharacter, player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)

	RunService.PreSimulation:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		for model, rig in rigs do
			if not model.Parent then
				remove(model)
			else
				local ok, err = pcall(updateRig, rig, dt, camPos)
				if not ok then
					warn("[VehicleFX] " .. tostring(err))
					remove(model)
				end
			end
		end
	end)
end

return VehicleFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Workshop</string>
            <string name="Source"><![CDATA[-- Workshop: the hands-on part of the car service. The camera orbits the
-- vehicle in its bay and you hold the mouse button (or a finger) and move the
-- tool over the body: mud turns into foam, the sponge scrubs it into suds,
-- the hose rinses them into drops and the towel dries them off. Repairs are
-- done with a wrench on the damaged spots and a pump on every tyre; paint jobs
-- sand the rusty spots and then spray the new colour part by part.
--
-- The client only reports "step N finished"; the server checks the timing,
-- pays and moves the vehicle (Systems/Service).

local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local CarCatalog = require(Shared.CarCatalog)
local Net = require(Shared.Net)
local Paints = require(Shared.Paints)
local ServiceConfig = require(Shared.ServiceConfig)
local ServiceModels = require(Shared.ServiceModels)
local Strings = require(Shared.Strings)

local ClientState = require(script.Parent.Parent.ClientState)
local Kit = require(script.Parent.Parent.UI.Kit)
local T = Kit.Theme

local Workshop = {}

--------------------------------------------------------------------------------
-- Spot states and how each step changes them
--------------------------------------------------------------------------------

type Look = { color: Color3, material: Enum.Material, transparency: number?, scale: number, thick: number }

local LOOK: { [string]: Look } = {
	dirt = { color = Color3.fromRGB(96, 72, 50), material = Enum.Material.Mud, scale = 1, thick = 0.08 },
	foam = { color = Color3.fromRGB(248, 250, 255), material = Enum.Material.Snow, scale = 1.3, thick = 0.24 },
	suds = { color = Color3.fromRGB(214, 236, 255), material = Enum.Material.Glass, transparency = 0.3, scale = 0.95, thick = 0.1 },
	drops = { color = Color3.fromRGB(150, 210, 255), material = Enum.Material.Glass, transparency = 0.25, scale = 0.55, thick = 0.08 },
	rust = { color = Color3.fromRGB(152, 80, 38), material = Enum.Material.CorrodedMetal, scale = 1, thick = 0.07 },
	primer = { color = Color3.fromRGB(180, 180, 174), material = Enum.Material.SmoothPlastic, scale = 1, thick = 0.05 },
	damage = { color = Color3.fromRGB(36, 36, 42), material = Enum.Material.Slate, scale = 0.9, thick = 0.06 },
	wheel = { color = Color3.fromRGB(255, 210, 60), material = Enum.Material.Neon, transparency = 0.55, scale = 1, thick = 0.04 },
}

local STEP_FLOW: { [string]: { from: string?, to: string? } } = {
	foam = { from = "dirt", to = "foam" },
	scrub = { from = "foam", to = "suds" },
	rinse = { from = "suds", to = "drops" },
	dry = { from = "drops", to = "done" },
	sand = { from = "rust", to = "primer" },
	wrench = { from = "damage", to = "done" },
	pump = { from = "wheel", to = "done" },
	spray = {},
}

local DAMAGE_COUNT = { tiny = 3, small = 4, car = 6, big = 8 }

export type Spot = {
	part: BasePart,
	offset: CFrame, -- spot frame in part space, X axis = surface normal
	size: number,
	state: string,
	value: number, -- work left in the current step (1 = untouched)
	visual: BasePart?,
	gui: BillboardGui?,
	label: TextLabel?,
}

type PaintUnit = { part: BasePart, area: number, progress: number, from: Color3, to: Color3 }

--------------------------------------------------------------------------------
-- Spot placement (pure, testable): rays from the bounding box towards the body
--------------------------------------------------------------------------------

export type RayFn = (origin: Vector3, direction: Vector3) -> (Vector3?, Vector3?, BasePart?)

-- Local bounding box of `parts` in the frame `rootCf`.
function Workshop.localBounds(parts: { BasePart }, rootCf: CFrame): (Vector3, Vector3)
	local minV = Vector3.new(math.huge, math.huge, math.huge)
	local maxV = -minV
	for _, part in parts do
		local h = part.Size / 2
		for _, sx in { -1, 1 } do
			for _, sy in { -1, 1 } do
				for _, sz in { -1, 1 } do
					local corner = rootCf:PointToObjectSpace(part.CFrame * Vector3.new(h.X * sx, h.Y * sy, h.Z * sz))
					minV = minV:Min(corner)
					maxV = maxV:Max(corner)
				end
			end
		end
	end
	return minV, maxV
end

-- Places up to `count` spots on the visible surface, at least `minDist` apart.
function Workshop.placeSpots(parts: { BasePart }, rootCf: CFrame, count: number, minDist: number, cast: RayFn, rng: Random): { { pos: Vector3, normal: Vector3, part: BasePart } }
	local out = {}
	if #parts == 0 or count <= 0 then
		return out
	end
	local lo, hi = Workshop.localBounds(parts, rootCf)
	local size = hi - lo
	-- faces of the box weighted by area: top, left, right, front, back
	local faces = {
		{ w = size.X * size.Z * 1.3, axis = "top" },
		{ w = size.Y * size.Z, axis = "left" },
		{ w = size.Y * size.Z, axis = "right" },
		{ w = size.X * size.Y * 0.6, axis = "front" },
		{ w = size.X * size.Y * 0.6, axis = "back" },
	}
	local total = 0
	for _, f in faces do
		total += f.w
	end
	local margin = 2
	for _ = 1, count * 14 do
		if #out >= count then
			break
		end
		local roll = rng:NextNumber() * total
		local face = faces[#faces]
		for _, f in faces do
			roll -= f.w
			if roll <= 0 then
				face = f
				break
			end
		end
		local u, v = rng:NextNumber(), rng:NextNumber()
		local origin, dir
		if face.axis == "top" then
			origin = Vector3.new(lo.X + u * size.X, hi.Y + margin, lo.Z + v * size.Z)
			dir = Vector3.new(0, -(size.Y + margin * 2), 0)
		elseif face.axis == "left" or face.axis == "right" then
			local s = if face.axis == "left" then -1 else 1
			origin = Vector3.new(if s < 0 then lo.X - margin else hi.X + margin, lo.Y + (0.15 + u * 0.85) * size.Y, lo.Z + v * size.Z)
			dir = Vector3.new(-s * (size.X + margin * 2), 0, 0)
		else
			local s = if face.axis == "front" then -1 else 1
			origin = Vector3.new(lo.X + u * size.X, lo.Y + (0.15 + v * 0.85) * size.Y, if s < 0 then lo.Z - margin else hi.Z + margin)
			dir = Vector3.new(0, 0, -s * (size.Z + margin * 2))
		end
		local pos, normal, part = cast(rootCf * origin, rootCf:VectorToWorldSpace(dir))
		if pos and normal and part then
			local ok = true
			for _, s in out do
				if (s.pos - pos).Magnitude < minDist then
					ok = false
					break
				end
			end
			if ok then
				table.insert(out, { pos = pos, normal = normal, part = part })
			end
		end
	end
	return out
end

-- Ray against the part boxes (fallback when the engine raycast is unavailable).
function Workshop.boxCast(parts: { BasePart }): RayFn
	return function(origin: Vector3, direction: Vector3)
		local bestT, bestPart, bestNormal = math.huge, nil, nil
		for _, part in parts do
			local o = part.CFrame:PointToObjectSpace(origin)
			local d = part.CFrame:VectorToObjectSpace(direction)
			local h = part.Size / 2
			local tmin, tmax = -math.huge, math.huge
			local nAxis, nSign = 0, 0
			local hit = true
			for axis = 1, 3 do
				local oa = if axis == 1 then o.X elseif axis == 2 then o.Y else o.Z
				local da = if axis == 1 then d.X elseif axis == 2 then d.Y else d.Z
				local ha = if axis == 1 then h.X elseif axis == 2 then h.Y else h.Z
				if math.abs(da) < 1e-8 then
					if oa < -ha or oa > ha then
						hit = false
						break
					end
				else
					local t1, t2 = (-ha - oa) / da, (ha - oa) / da
					local sign = -1
					if t1 > t2 then
						t1, t2 = t2, t1
						sign = 1
					end
					if t1 > tmin then
						tmin = t1
						nAxis, nSign = axis, sign
					end
					tmax = math.min(tmax, t2)
					if tmin > tmax then
						hit = false
						break
					end
				end
			end
			if hit and tmin >= 0 and tmin <= 1 and tmin < bestT then
				bestT = tmin
				bestPart = part
				local n = if nAxis == 1 then Vector3.new(nSign, 0, 0) elseif nAxis == 2 then Vector3.new(0, nSign, 0) else Vector3.new(0, 0, nSign)
				bestNormal = part.CFrame:VectorToWorldSpace(n)
			end
		end
		if bestPart then
			return origin + direction * bestT, bestNormal, bestPart
		end
		return nil, nil, nil
	end
end

--------------------------------------------------------------------------------
-- State
--------------------------------------------------------------------------------

type Session = {
	jobId: number,
	model: Model,
	root: BasePart,
	parts: { BasePart },
	partSet: { [BasePart]: boolean },
	queryBackup: { [BasePart]: boolean },
	size: ServiceConfig.Size,
	sizeId: string,
	steps: { string },
	step: number,
	target: Color3,
	spots: { Spot },
	paint: { PaintUnit },
	power: number,
	radius: number,
	params: RaycastParams,
	center: Vector3,
	extent: number,
	yaw: number,
	pitch: number,
	dist: number,
	yawGoal: number,
	pitchGoal: number,
	distGoal: number,
	busy: boolean,
	finished: boolean,
	progress: number,
	stepTotal: number,
	started: number, -- the step whose spots/tool are set up
	rng: Random,
	tool: Model?,
	emitter: ParticleEmitter?,
	walkSpeed: number?,
	jumpPower: number?,
	jumpHeight: number?,
	touchControls: boolean?,
	mouseIcon: boolean?,
	faded: { [BasePart]: boolean }, -- walls/roof between the camera and the vehicle
}

local session: Session? = nil
local brushing = false
local rotating = false
local touchInput: InputObject? = nil
local pointer: Vector2? = nil
local pointerIsTouch = false
local keys: { [Enum.KeyCode]: boolean } = {}

-- UI
local gui: ScreenGui
local topBar: Frame
local titleLabel: TextLabel
local chips: Frame
local card: Frame
local cardIcon: TextLabel
local cardIconBack: Frame
local cardTitle: TextLabel
local cardHint: TextLabel
local barFill: Frame
local percent: TextLabel
local ring: Frame
local ringStroke: UIStroke
local cheer: TextLabel
local controlsHint: TextLabel

--------------------------------------------------------------------------------
-- Visuals
--------------------------------------------------------------------------------

local function spotWorld(s: Spot): CFrame
	return s.part.CFrame * s.offset
end

local function styleSpot(s: Spot, pop: boolean)
	local look = LOOK[s.state]
	if not look then
		return
	end
	local v = s.visual
	if not v then
		local p = Instance.new("Part")
		p.Name = "Spot"
		p.Shape = Enum.PartType.Cylinder
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Parent = Workspace.CurrentCamera
		s.visual = p
		v = p
	end
	local part = v :: BasePart
	local d = s.size * look.scale
	part.Size = Vector3.new(look.thick, d, d)
	part.Color = look.color
	part.Material = look.material
	part.Transparency = look.transparency or 0
	part.CFrame = spotWorld(s) * CFrame.new(look.thick / 2, 0, 0)
	if pop then
		local small = Vector3.new(look.thick, d * 0.4, d * 0.4)
		part.Size = small
		Kit.tween(part, 0.18, { Size = Vector3.new(look.thick, d, d) }, Enum.EasingStyle.Back)
	end
end

local function markerGui(s: Spot, text: string, color: Color3)
	local g = s.gui
	if not g then
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromOffset(64, 40)
		billboard.AlwaysOnTop = true
		billboard.LightInfluence = 0
		billboard.StudsOffsetWorldSpace = Vector3.new(0, 0.6, 0)
		local label = Kit.label({ Size = UDim2.fromScale(1, 1), Text = text, TextScaled = true, Font = T.FontBlack, TextStrokeTransparency = 0.2 })
		label.Parent = billboard
		billboard.Adornee = s.visual
		billboard.Parent = gui
		s.gui = billboard
		s.label = label
		g = billboard
	end
	local label = s.label :: TextLabel
	label.Text = text
	label.TextColor3 = color
end

local function removeSpot(s: Spot, sparkle: boolean)
	local v = s.visual
	s.visual = nil
	if s.gui then
		local g = s.gui
		s.gui = nil
		if s.label then
			s.label.Text = "✅"
		end
		task.delay(0.5, function()
			g:Destroy()
		end)
	end
	if v then
		if sparkle then
			v.Material = Enum.Material.Neon
			v.Color = Color3.fromRGB(255, 255, 255)
			Kit.tween(v, 0.3, { Size = v.Size * Vector3.new(1, 1.6, 1.6), Transparency = 1 })
			task.delay(0.32, function()
				v:Destroy()
			end)
		else
			v:Destroy()
		end
	end
end

local function clearSpots(sess: Session)
	for _, s in sess.spots do
		removeSpot(s, false)
	end
	table.clear(sess.spots)
end

local function makeSpot(sess: Session, pos: Vector3, normal: Vector3, part: BasePart, size: number, state: string): Spot
	local frame = ServiceModels.alongX(pos, pos + normal)
	frame = CFrame.fromMatrix(pos, frame.XVector, frame.YVector, frame.ZVector)
	local s: Spot = {
		part = part,
		offset = part.CFrame:ToObjectSpace(frame),
		size = size,
		state = state,
		value = 1,
	}
	styleSpot(s, false)
	table.insert(sess.spots, s)
	return s
end

local function engineCast(sess: Session): Workshop.RayFn
	return function(origin, direction)
		local hit = Workspace:Raycast(origin, direction, sess.params)
		if hit and sess.partSet[hit.Instance :: BasePart] then
			return hit.Position, hit.Normal, hit.Instance :: BasePart
		end
		return nil, nil, nil
	end
end

-- The engine raycast sees the exact shapes; the box fallback keeps the game
-- playable where raycasts against the vehicle don't work (and in tests).
local function castFor(sess: Session): Workshop.RayFn
	local biggest: BasePart? = nil
	for _, part in sess.parts do
		if not biggest or part.Size.Magnitude > biggest.Size.Magnitude then
			biggest = part
		end
	end
	if biggest then
		local target = biggest.Position
		local origin = target + Vector3.new(0, biggest.Size.Magnitude + 10, 0)
		local pos = engineCast(sess)(origin, target - origin)
		if pos then
			return engineCast(sess)
		end
	end
	return Workshop.boxCast(sess.parts)
end

local function generateSpots(sess: Session, state: string)
	clearSpots(sess)
	local size = sess.size
	if state == "wheel" then
		for _, part in sess.parts do
			local radius = part:GetAttribute("Radius")
			if part:GetAttribute("Wheel") and typeof(radius) == "number" then
				local width = part:GetAttribute("Width") or 0.4
				local localPos = sess.root.CFrame:PointToObjectSpace(part.Position)
				local side = if localPos.X < -0.2 then -1 else 1
				local normal = sess.root.CFrame.RightVector * side
				local pos = part.Position + normal * (width / 2 + 0.06)
				local s = makeSpot(sess, pos, normal, part, radius * 1.8, "wheel")
				markerGui(s, "💨 0%", T.Warn)
			end
		end
		return
	end
	local count = if state == "damage" then DAMAGE_COUNT[sess.sizeId] or 4 else size.spots
	local minDist = if state == "damage" then size.spotSize * 3 else size.spotSize * 1.05
	local placed = Workshop.placeSpots(sess.parts, sess.root.CFrame, count, minDist, castFor(sess), sess.rng)
	for _, p in placed do
		local d = size.spotSize * sess.rng:NextNumber(0.8, 1.25)
		if state == "damage" then
			d = size.spotSize * 1.3
		end
		local s = makeSpot(sess, p.pos, p.normal, p.part, d, state)
		if state == "damage" then
			markerGui(s, "⚠", T.Bad)
		end
	end
end

local function buildPaintUnits(sess: Session)
	table.clear(sess.paint)
	for _, part in sess.parts do
		if part:GetAttribute("Role") == "Paint" then
			local s = part.Size
			table.insert(sess.paint, {
				part = part,
				area = 2 * (s.X * s.Y + s.Y * s.Z + s.X * s.Z),
				progress = 0,
				from = part.Color,
				to = sess.target,
			})
		end
	end
end

--------------------------------------------------------------------------------
-- Tools (3D model that follows the cursor + particles)
--------------------------------------------------------------------------------

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function toolPart(model: Model, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): BasePart
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	if shape then
		p.Shape = shape
	end
	p.Parent = model
	return p
end

-- Tools are built pointing at -Z (the tip touches the surface at the origin).
local function buildTool(stepId: string, target: Color3): (Model, Attachment)
	local model = Instance.new("Model")
	model.Name = "WorkshopTool"
	local cyl = Enum.PartType.Cylinder
	local along = CFrame.Angles(0, math.pi / 2, 0) -- cylinder axis along Z
	local tip: BasePart
	if stepId == "foam" then
		tip = toolPart(model, Vector3.new(0.9, 0.22, 0.22), CFrame.new(0, 0, 0.45) * along, Color3.fromRGB(40, 40, 46), nil, cyl)
		toolPart(model, Vector3.new(1.1, 0.5, 0.5), CFrame.new(0, 0, 1.3) * along, Color3.fromRGB(255, 205, 40), nil, cyl)
		toolPart(model, Vector3.new(0.9, 0.75, 0.75), CFrame.new(0, -0.55, 1.4) * along, Color3.fromRGB(70, 160, 255), Enum.Material.Glass, cyl)
		toolPart(model, Vector3.new(0.25, 0.7, 0.3), CFrame.new(0, -0.45, 1.85), Color3.fromRGB(30, 30, 34))
	elseif stepId == "scrub" then
		tip = toolPart(model, Vector3.new(1.2, 0.8, 0.5), CFrame.new(0, 0, 0.3), Color3.fromRGB(255, 214, 50), Enum.Material.Sand)
		toolPart(model, Vector3.new(1.22, 0.82, 0.14), CFrame.new(0, 0, 0.02), Color3.fromRGB(60, 170, 80), Enum.Material.Fabric)
	elseif stepId == "rinse" then
		tip = toolPart(model, Vector3.new(0.9, 0.2, 0.2), CFrame.new(0, 0, 0.45) * along, Color3.fromRGB(200, 205, 214), Enum.Material.Metal, cyl)
		toolPart(model, Vector3.new(0.7, 0.35, 0.35), CFrame.new(0, 0, 1.1) * along, Color3.fromRGB(40, 120, 230), nil, cyl)
		toolPart(model, Vector3.new(0.25, 0.8, 0.35), CFrame.new(0, -0.45, 1.35), Color3.fromRGB(30, 30, 34))
		toolPart(model, Vector3.new(1.6, 0.18, 0.18), CFrame.new(0, -0.9, 2.0) * along, Color3.fromRGB(240, 200, 40), nil, cyl)
	elseif stepId == "dry" then
		tip = toolPart(model, Vector3.new(1.4, 1.0, 0.16), CFrame.new(0, 0, 0.08), Color3.fromRGB(110, 220, 170), Enum.Material.Fabric)
		toolPart(model, Vector3.new(1.4, 0.5, 0.16), CFrame.new(0, -0.62, 0.2) * CFrame.Angles(math.rad(-30), 0, 0), Color3.fromRGB(90, 200, 150), Enum.Material.Fabric)
	elseif stepId == "wrench" then
		tip = toolPart(model, Vector3.new(0.5, 0.18, 0.5), CFrame.new(0, 0, 0.25), Color3.fromRGB(205, 210, 220), Enum.Material.Metal)
		toolPart(model, Vector3.new(0.18, 1.6, 0.14), CFrame.new(0, 0.9, 0.3), Color3.fromRGB(205, 210, 220), Enum.Material.Metal)
		toolPart(model, Vector3.new(0.24, 0.6, 0.2), CFrame.new(0, 1.55, 0.3), Color3.fromRGB(220, 60, 50))
	elseif stepId == "pump" then
		tip = toolPart(model, Vector3.new(0.6, 0.16, 0.16), CFrame.new(0, 0, 0.3) * along, Color3.fromRGB(200, 205, 214), Enum.Material.Metal, cyl)
		toolPart(model, Vector3.new(0.8, 0.4, 0.4), CFrame.new(0, 0, 0.9) * along, Color3.fromRGB(30, 30, 34), nil, cyl)
		toolPart(model, Vector3.new(0.12, 0.5, 0.5), CFrame.new(0.26, 0.2, 0.9), Color3.fromRGB(230, 60, 50), nil, cyl)
		toolPart(model, Vector3.new(1.5, 0.12, 0.12), CFrame.new(0, -0.3, 1.6) * along, Color3.fromRGB(30, 30, 34), nil, cyl)
	elseif stepId == "sand" then
		tip = toolPart(model, Vector3.new(1.1, 0.7, 0.12), CFrame.new(0, 0, 0.06), Color3.fromRGB(170, 160, 140), Enum.Material.Sand)
		toolPart(model, Vector3.new(1.0, 0.6, 0.45), CFrame.new(0, 0, 0.35), Color3.fromRGB(255, 130, 40))
		toolPart(model, Vector3.new(0.7, 0.2, 0.3), CFrame.new(0, 0, 0.7), Color3.fromRGB(30, 30, 34))
	else -- spray
		tip = toolPart(model, Vector3.new(0.6, 0.16, 0.16), CFrame.new(0, 0, 0.3) * along, Color3.fromRGB(200, 205, 214), Enum.Material.Metal, cyl)
		toolPart(model, Vector3.new(0.8, 0.45, 0.45), CFrame.new(0, 0, 0.9) * along, Color3.fromRGB(200, 205, 214), Enum.Material.Metal, cyl)
		toolPart(model, Vector3.new(0.6, 0.55, 0.55), CFrame.new(0, 0.5, 0.8), target, nil, cyl).CFrame = CFrame.new(0, 0.55, 0.85) * CFrame.Angles(0, 0, math.pi / 2)
		toolPart(model, Vector3.new(0.22, 0.8, 0.3), CFrame.new(0, -0.5, 1.15), Color3.fromRGB(30, 30, 34))
	end
	tip.Name = "Tip"
	model.WorldPivot = CFrame.new() -- the tip touches the surface at the origin
	local attachment = Instance.new("Attachment")
	attachment.CFrame = CFrame.new(0, 0, -0.1) * CFrame.Angles(-math.pi / 2, 0, 0) -- particles shoot along -Z
	attachment.Parent = tip
	return model, attachment
end

local function buildEmitter(stepId: string, target: Color3, attachment: Attachment): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.LightInfluence = 0
	e.Rate = 60
	e.Lifetime = NumberRange.new(0.25, 0.5)
	e.Speed = NumberRange.new(6, 10)
	e.SpreadAngle = Vector2.new(14, 14)
	e.Texture = SPARKLE
	e.Size = NumberSequence.new(0.3, 0.1)
	e.Transparency = NumberSequence.new(0.1, 1)
	if stepId == "foam" or stepId == "scrub" then
		e.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
		e.Texture = SMOKE
		e.Size = NumberSequence.new(0.5, 0.9)
		e.Speed = NumberRange.new(if stepId == "foam" then 8 else 1, if stepId == "foam" then 12 else 3)
		e.SpreadAngle = Vector2.new(25, 25)
	elseif stepId == "rinse" then
		e.Color = ColorSequence.new(Color3.fromRGB(120, 200, 255))
		e.Rate = 120
		e.Speed = NumberRange.new(14, 18)
		e.Size = NumberSequence.new(0.25, 0.15)
	elseif stepId == "dry" then
		e.Color = ColorSequence.new(Color3.fromRGB(255, 255, 220))
		e.Rate = 25
		e.Speed = NumberRange.new(1, 3)
		e.SpreadAngle = Vector2.new(80, 80)
	elseif stepId == "wrench" then
		e.Color = ColorSequence.new(Color3.fromRGB(255, 190, 60))
		e.Rate = 40
		e.Speed = NumberRange.new(4, 9)
		e.SpreadAngle = Vector2.new(70, 70)
		e.Lifetime = NumberRange.new(0.15, 0.3)
	elseif stepId == "pump" then
		e.Color = ColorSequence.new(Color3.fromRGB(230, 240, 255))
		e.Texture = SMOKE
		e.Rate = 30
		e.Size = NumberSequence.new(0.3, 0.8)
		e.Transparency = NumberSequence.new(0.5, 1)
	elseif stepId == "sand" then
		e.Color = ColorSequence.new(Color3.fromRGB(200, 180, 140))
		e.Texture = SMOKE
		e.Rate = 40
		e.Speed = NumberRange.new(1, 4)
		e.SpreadAngle = Vector2.new(90, 90)
		e.Size = NumberSequence.new(0.3, 0.9)
	else
		e.Color = ColorSequence.new(target)
		e.Texture = SMOKE
		e.Rate = 90
		e.Speed = NumberRange.new(9, 13)
		e.Size = NumberSequence.new(0.3, 1.2)
		e.Transparency = NumberSequence.new(0.2, 1)
	end
	e.Parent = attachment
	return e
end

--------------------------------------------------------------------------------
-- HUD
--------------------------------------------------------------------------------

local function stepName(stepId: string): string
	return Strings.get("Step_" .. stepId)
end

local function vehicleName(job: any): string
	if job.source == "model" then
		local def = ServiceModels.get(job.vehicle)
		return if def then Strings.pick(def.name) else tostring(job.vehicle)
	end
	local def = CarCatalog.get(job.vehicle)
	return if def then def.name else tostring(job.vehicle)
end
Workshop.vehicleName = vehicleName

local function renderChips(sess: Session)
	for _, c in chips:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	for i, stepId in sess.steps do
		local def = ServiceConfig.Steps[stepId]
		local done = i < sess.step
		local current = i == sess.step
		local chip = Kit.new("Frame", {
			Size = UDim2.fromOffset(if current then 58 else 46, if current then 58 else 46),
			BackgroundColor3 = if done then T.Good elseif current then def.color else T.Card,
			BackgroundTransparency = if current or done then 0 else 0.2,
			BorderSizePixel = 0,
			LayoutOrder = i,
			Parent = chips,
		})
		Kit.corner(chip, 29)
		Kit.stroke(chip, Color3.new(1, 1, 1), if current then 3 else 1, if current then 0.1 else 0.7)
		Kit.label({ Size = UDim2.fromScale(1, 1), Text = if done then "✓" else def.icon, TextSize = if current then 30 else 22, Font = T.FontBlack, Parent = chip })
	end
end

local function renderCard(sess: Session)
	local stepId = sess.steps[sess.step]
	if not stepId then
		return
	end
	local def = ServiceConfig.Steps[stepId]
	cardIcon.Text = def.icon
	cardIconBack.BackgroundColor3 = def.color
	cardTitle.Text = string.format("%s %d/%d · %s", Strings.get("ServiceStep"), sess.step, #sess.steps, stepName(stepId))
	local touch = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	cardHint.Text = Strings.get("StepHint_" .. stepId) .. "\n" .. Strings.get(if touch then "ServiceHowTouch" else "ServiceHowMouse")
	barFill.BackgroundColor3 = def.color
	barFill.Size = UDim2.fromScale(0, 1)
	percent.Text = "0%"
	ringStroke.Color = def.color
	card.Position = UDim2.new(0.5, 0, 1, 40)
	Kit.tween(card, 0.3, { Position = UDim2.new(0.5, 0, 1, -24) }, Enum.EasingStyle.Back)
end

local function showCheer(text: string, color: Color3)
	cheer.Text = text
	cheer.TextColor3 = color
	cheer.Visible = true
	cheer.TextTransparency = 0
	cheer.TextStrokeTransparency = 0.3
	cheer.Size = UDim2.fromOffset(200, 50)
	Kit.tween(cheer, 0.25, { Size = UDim2.fromOffset(600, 110) }, Enum.EasingStyle.Back)
	task.delay(0.9, function()
		Kit.tween(cheer, 0.3, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
end

