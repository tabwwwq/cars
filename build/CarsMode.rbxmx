      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[-- Types: shared type definitions that cross the client/server boundary.

export type Localized = { ru: string, en: string }

export type DriveType = "RWD" | "FWD" | "AWD"

export type SuspensionSpec = {
	rest: number, -- spring travel in studs
	freq: number?, -- natural frequency (Hz)
	damping: number?, -- damping ratio
}

export type CarStats = {
	maxSpeed: number, -- studs/s
	accel: number, -- studs/s^2
	grip: number, -- tire friction coefficient (~1)
	steer: number, -- max steering angle, degrees
	brake: number, -- braking deceleration, studs/s^2
	drift: number, -- 0..1, how easily the rear lets go
	nitro: number, -- nitro power multiplier
	offroad: number, -- 0..1, how little rough surfaces slow the car
	mass: number, -- relative mass (1 = a normal car)
	drive: DriveType,
	suspension: SuspensionSpec,
}

export type AxleSpec = {
	z: number, -- axle position along the car (front is negative)
	steer: boolean,
	drive: boolean,
	radius: number?,
	width: number?,
	track: number?,
}

export type WheelSpec = {
	radius: number,
	width: number,
	base: number, -- wheelbase (front axle to rear axle)
	track: number, -- distance between left and right wheel centers
	offset: number?, -- shifts both axles along z
	rearRadius: number?,
	rearWidth: number?,
	rearTrack: number?,
	axles: { AxleSpec }?, -- full override (trucks with 3 axles, etc.)
	rim: string?, -- "steel" | "disc" | "spoke" | "star" | "offroad" | "aero"
}

export type CabinSpec = {
	start: number, -- distance from the front of the car to the windshield base
	wind: number, -- windshield length (z)
	roof: number, -- flat roof length (z)
	back: number, -- rear glass length (z); 0 = vertical back
	height: number, -- roof height above the belt line
	inset: number, -- glasshouse inset from the body sides
	open: boolean?, -- convertible
	sideWindows: number?, -- only the first N studs of the roof section are glass (vans)
	windowPillars: number?, -- spacing of pillars along long side windows (bus, limo)
	glassRoof: boolean?,
}

export type BodySpec = {
	style: string, -- "car" | "pickup" | "box" | "semi" | "openwheel" | "kart" | "buggy" | "tractor"
	length: number,
	width: number,
	floor: number, -- body bottom height
	belt: number, -- hood/shoulder height
	nose: number?,
	noseDrop: number?,
	tail: number?,
	tailDrop: number?,
	cabin: CabinSpec?,
	bed: { start: number }?,
	box: { start: number, top: number, length: number? }?,
}

export type CarColors = { paint: number, accent: number, rim: number }

export type SeatSpec = { x: number, z: number, y: number?, driver: boolean? }

export type CarDef = {
	id: string,
	name: string,
	class: string,
	price: number,
	description: Localized,
	stats: CarStats,
	wheels: WheelSpec,
	body: BodySpec,
	colors: CarColors,
	features: { [string]: any },
	seats: { SeatSpec }?,
	maxSeats: number?,
	-- optional: name of a template model in ReplicatedStorage.CarsAssets.Cars
	-- used as the visual body (see CarBuilder.findTemplate)
	customModel: string?,
}

-- Saved per-car customization and upgrades
export type CarSave = {
	paint: number,
	accent: number,
	rim: number,
	finish: string,
	glow: number, -- 0 = no underglow, otherwise palette index
	glowOwned: boolean,
	engine: number,
	tires: number,
	nitro: number,
}

export type Profile = {
	version: number,
	cash: number,
	owned: { [string]: boolean },
	cars: { [string]: CarSave },
	selected: string,
	bestTimes: { [string]: number },
	medals: { [string]: string },
	topSpeed: number,
	stats: {
		distance: number,
		drifts: number,
		airtime: number,
		races: number,
		earned: number,
	},
	daily: { last: number, streak: number },
	finishes: { [string]: boolean },
	service: ServiceProfile,
}

-- Car-service progress (see ServiceConfig)
export type ServiceProfile = {
	level: number,
	xp: number,
	orders: number,
	earned: number,
	stars: number,
	upgrades: { [string]: number },
	tutorial: number,
}

-- Effective (upgraded) stats the physics actually uses
export type EffectiveStats = {
	maxSpeed: number,
	accel: number,
	grip: number,
	steer: number,
	brake: number,
	drift: number,
	nitroPower: number,
	nitroRecharge: number,
	offroad: number,
	drive: DriveType,
	suspRest: number,
	suspFreq: number,
	suspDamping: number,
}

export type RequestResult = { ok: boolean, message: string?, args: { any }? }

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="56">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[-- Format: number/time/speed formatting shared by the HUD, garage and boards.

local Config = require(script.Parent.Parent.Config)

local Format = {}

-- 1234567 -> "1,234,567"
function Format.int(n: number): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return if n < 0 then "-" .. out else out
end

function Format.money(n: number): string
	return "$" .. Format.int(n)
end

-- Short form for big prices: 1250000 -> "$1.25M", 48000 -> "$48K"
function Format.moneyShort(n: number): string
	if n >= 1e6 then
		return (string.format("$%.2fM", n / 1e6):gsub("%.?0+M$", "M"))
	elseif n >= 1e4 then
		return string.format("$%dK", math.floor(n / 1000))
	end
	return Format.money(n)
end

-- 83.456 -> "1:23.46"
function Format.time(seconds: number): string
	if seconds ~= seconds or seconds == math.huge then
		return "--:--.--"
	end
	local m = math.floor(seconds / 60)
	local s = seconds - m * 60
	return string.format("%d:%05.2f", m, s)
end

-- studs/s -> displayed km/h
function Format.speed(studsPerSecond: number): number
	return math.floor(math.abs(studsPerSecond) * Config.SpeedDisplayFactor + 0.5)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Path</string>
            <string name="Source"><![CDATA[-- Path: smooth movement for service customers and staff. The server stores a
-- path as model attributes once (MovePath, MoveStart, MoveSpeed, MoveReverse,
-- MoveY) and parks the model at the end; every client animates the trip
-- locally, so nothing is replicated per frame.

local Spline = require(script.Parent.Spline)

local Path = {}

export type Track = { samples: { Spline.Sample }, length: number }

function Path.encode(points: { Vector3 }): string
	local parts = table.create(#points)
	for i, p in points do
		parts[i] = string.format("%.1f,%.1f", p.X, p.Z)
	end
	return table.concat(parts, ";")
end

function Path.decode(text: string): { Vector3 }
	local out = {}
	for x, z in string.gmatch(text, "(-?[%d%.]+),(-?[%d%.]+)") do
		table.insert(out, Vector3.new(tonumber(x) :: number, 0, tonumber(z) :: number))
	end
	return out
end

function Path.new(points: { Vector3 }): Track
	if #points < 2 then
		local p = points[1] or Vector3.zero
		return { samples = { { pos = p, dir = Vector3.new(0, 0, -1), dist = 0 } }, length = 0 }
	end
	local samples, length = Spline.sample(points, false, 1)
	return { samples = samples, length = length }
end

-- Position and travel direction `d` studs along the track.
function Path.at(track: Track, d: number): (Vector3, Vector3)
	local s = track.samples
	if #s == 1 or d <= 0 then
		return s[1].pos, s[1].dir
	end
	if d >= track.length then
		return s[#s].pos, s[#s].dir
	end
	-- samples are evenly spaced
	local step = track.length / (#s - 1)
	local i = math.clamp(math.floor(d / step) + 1, 1, #s - 1)
	local a, b = s[i], s[i + 1]
	local t = math.clamp((d - a.dist) / step, 0, 1)
	local dir = a.dir:Lerp(b.dir, t)
	return a.pos:Lerp(b.pos, t), if dir.Magnitude > 1e-4 then dir.Unit else a.dir
end

-- Seconds a trip takes (eased start and stop).
function Path.duration(length: number, speed: number): number
	if length <= 0 or speed <= 0 then
		return 0
	end
	return length / speed + math.min(1.2, length / speed * 0.5)
end

-- Distance travelled after `elapsed` seconds (smooth start and stop).
function Path.distanceAt(length: number, speed: number, elapsed: number): number
	local total = Path.duration(length, speed)
	if total <= 0 or elapsed >= total then
		return length
	end
	if elapsed <= 0 then
		return 0
	end
	local t = elapsed / total
	return length * (t * t * (3 - 2 * t))
end

-- Ground CFrame for a model at distance d (reverse = driving backwards).
function Path.groundCFrame(track: Track, d: number, y: number, reverse: boolean?): CFrame
	local pos, dir = Path.at(track, d)
	local facing = if reverse then -dir else dir
	local flat = Vector3.new(facing.X, 0, facing.Z)
	if flat.Magnitude < 1e-4 then
		flat = Vector3.new(0, 0, -1)
	end
	local at = Vector3.new(pos.X, y, pos.Z)
	return CFrame.lookAt(at, at + flat.Unit)
end

return Path
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[-- Signal: a tiny synchronous event object for module-to-module communication.

export type Connection = { Connected: boolean, Disconnect: (self: Connection) -> () }

local Signal = {}
Signal.__index = Signal

export type Signal<T...> = typeof(setmetatable({} :: { _handlers: { [Connection]: (T...) -> () } }, Signal))

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal.Connect(self, fn: (...any) -> ()): Connection
	local handlers = self._handlers
	local conn = { Connected = true } :: any
	function conn.Disconnect(c)
		c.Connected = false
		handlers[c] = nil
	end
	handlers[conn] = fn
	return conn
end

function Signal.Once(self, fn: (...any) -> ()): Connection
	local conn
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal.Fire(self, ...: any)
	for conn, fn in table.clone(self._handlers) do
		if conn.Connected then
			local ok, err = pcall(fn, ...)
			if not ok then
				warn("[Signal] handler error: " .. tostring(err))
			end
		end
	end
end

function Signal.DisconnectAll(self)
	for conn in self._handlers do
		conn.Connected = false
	end
	table.clear(self._handlers)
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Spline</string>
            <string name="Source"><![CDATA[-- Spline: Catmull-Rom curves used to lay out race tracks and their checkpoints.

local Spline = {}

local function catmull(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3
	local t2, t3 = t * t, t * t * t
	return (p1 * 2 + (p2 - p0) * t + (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2 + (p1 * 3 - p0 - p2 * 3 + p3) * t3) * 0.5
end

-- Samples the curve densely, then resamples at an even spacing.
-- Returns { { pos: Vector3, dir: Vector3, dist: number } }
export type Sample = { pos: Vector3, dir: Vector3, dist: number }

function Spline.sample(points: { Vector3 }, closed: boolean, spacing: number): ({ Sample }, number)
	local n = #points
	assert(n >= 2, "Spline needs at least two points")
	local function at(i: number): Vector3
		if closed then
			return points[((i - 1) % n) + 1]
		end
		return points[math.clamp(i, 1, n)]
	end
	local dense: { Vector3 } = {}
	local segments = if closed then n else n - 1
	local per = 24
	for i = 1, segments do
		for k = 0, per - 1 do
			table.insert(dense, catmull(at(i - 1), at(i), at(i + 1), at(i + 2), k / per))
		end
	end
	table.insert(dense, if closed then dense[1] else points[n])

	-- cumulative length
	local cum = { 0 }
	for i = 2, #dense do
		cum[i] = cum[i - 1] + (dense[i] - dense[i - 1]).Magnitude
	end
	local total = cum[#dense]
	local count = math.max(2, math.floor(total / spacing + 0.5))
	local step = total / count
	local out: { Sample } = {}
	local j = 1
	local last = if closed then count - 1 else count
	for i = 0, last do
		local d = i * step
		while j < #dense - 1 and cum[j + 1] < d do
			j += 1
		end
		local segLen = cum[j + 1] - cum[j]
		local t = if segLen > 0 then (d - cum[j]) / segLen else 0
		local pos = dense[j]:Lerp(dense[j + 1], math.clamp(t, 0, 1))
		local dir = dense[j + 1] - dense[j]
		dir = if dir.Magnitude > 1e-6 then dir.Unit else Vector3.new(0, 0, -1)
		table.insert(out, { pos = pos, dir = dir, dist = d })
	end
	return out, total
end

return Spline
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">WorldLayout</string>
          <string name="Source"><![CDATA[-- Layout: where everything in the world lives. All values are world studs,
-- y = 0 is the ground, -Z is north. Roads sit on top of the ground at ROAD_TOP.

local Layout = {}

Layout.Half = 1952 -- terrain half size (multiple of 4)
Layout.WallHalf = 1940 -- invisible boundary walls
Layout.RoadTop = 0.2

local function v(x: number, z: number): Vector3
	return Vector3.new(x, 0, z)
end
Layout.v = v

-- Areas (center + size on the ground plane)
Layout.Plaza = { center = v(0, 0), size = Vector2.new(320, 240) }
Layout.StuntPark = { center = v(-1200, -100), size = Vector2.new(600, 600) }
Layout.DriftArena = { center = v(700, 0), size = Vector2.new(360, 300) }
Layout.SpeedTrap = { x = 1500, z = 450, halfWidth = 32 }

-- City grid
Layout.CityX = { -700, -350, 0, 350, 700 }
Layout.CityZ = { -450, -800, -1150, -1500 }
Layout.CityStreetWidth = 40

-- Road segments { a, b, width, style } ("city" streets are generated from the grid)
Layout.Roads = {
	{ a = v(0, -120), b = v(0, -430), w = 44, style = "avenue" },
	{ a = v(0, 120), b = v(0, 420), w = 44, style = "avenue" },
	{ a = v(-160, 0), b = v(-900, 0), w = 40, style = "street", lamps = false }, -- the service plots light it
	{ a = v(160, 0), b = v(520, 0), w = 40, style = "street" },
	{ a = v(-1800, 450), b = v(0, 450), w = 60, style = "highway" },
	{ a = v(0, 450), b = v(1800, 450), w = 60, style = "highway" },
	{ a = v(-1200, 420), b = v(-1200, 200), w = 40, style = "street" },
	{ a = v(700, 420), b = v(700, 150), w = 40, style = "street" },
	{ a = v(1150, 420), b = v(1150, -276), w = 40, style = "street" },
}

-- Spawn pads in the plaza (cars face south, towards the exit)
Layout.SpawnPads = {}
for i = 0, 9 do
	local x = -135 + i * 30
	table.insert(Layout.SpawnPads, CFrame.new(x, Layout.RoadTop, 82) * CFrame.Angles(0, math.pi, 0))
end

Layout.PlayerSpawn = v(0, 10)
Layout.GarageKiosks = { v(-120, 30), v(120, 30) }
Layout.Showroom = { min = v(-152, -116), max = v(-36, -42) }

-- Mesh for terrain hills: masks are 0 on the flat playfield, 1 in the hills.
Layout.SouthHills = { start = 640, full = 880 }
Layout.NorthHills = { start = -1620, full = -1780 }
Layout.Rim = { width = 140, height = 70 }

-- Car-service plots on both sides of the west street (z = 0). In plot space
-- +Z points at the street and the plot spans x -100..100, z -85..85; north
-- plots use the identity rotation, south plots are turned around.
Layout.ServicePlotSize = Vector2.new(200, 170)
Layout.ServicePlots = {} :: { CFrame }
for _, x in { -310, -530, -750 } do
	table.insert(Layout.ServicePlots, CFrame.new(x, Layout.RoadTop, -115))
	table.insert(Layout.ServicePlots, CFrame.new(x, Layout.RoadTop, 115) * CFrame.Angles(0, math.pi, 0))
end

-- Driving zones with bonus rewards
Layout.Zones = {
	drift = { center = Layout.DriftArena.center, size = Vector3.new(360, 60, 300), multiplier = 2 },
	stunt = { center = Layout.StuntPark.center, size = Vector3.new(600, 400, 600), multiplier = 2 },
}

return Layout
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="62">
      <Properties>
        <string name="Name">Installer</string>
        <string name="Source"><![CDATA[-- Installer for an existing place. In Roblox Studio:
--   1. Right-click Workspace > Insert from File... > build/CarsMode.rbxmx
--   2. In the Command Bar run:
--        require(workspace.CarsModeInstall.Installer)()
-- It moves the three Cars folders into their services. If something with the
-- same name already exists it is kept as "<Name>_old" instead of being deleted.

return function()
	local root = script.Parent
	local StarterPlayer = game:GetService("StarterPlayer")
	local targets = {
		CarsShared = game:GetService("ReplicatedStorage"),
		CarsAssets = game:GetService("ReplicatedStorage"),
		CarsServer = game:GetService("ServerScriptService"),
		CarsClient = StarterPlayer:FindFirstChildOfClass("StarterPlayerScripts")
			or Instance.new("StarterPlayerScripts", StarterPlayer),
	}
	for name, service in targets do
		local item = root:FindFirstChild(name)
		if item then
			local existing = service:FindFirstChild(name)
			if existing then
				existing.Name = name .. "_old"
				warn("[Cars] kept the previous " .. name .. " as " .. existing.Name)
			end
			item.Parent = service
		end
	end
	workspace.StreamingEnabled = false
	root:Destroy()
	print("[Cars] installed. Press Play to try it.")
end
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>