			cabin = { start = 5.6, wind = 2.4, roof = 10.6, back = 1.8, height = 2.15, inset = 0.5, windowPillars = 3.6 },
		},
		colors = { paint = 4, accent = 2, rim = 2 },
		features = { exhaust = 2, doors = 6, chromeTrim = true, ornament = true },
		seats = {
			{ x = -1.6, z = -4.4, driver = true },
			{ x = 1.6, z = -4.4 },
			{ x = -1.6, z = -0.4 },
			{ x = 1.6, z = -0.4 },
			{ x = -1.6, z = 3.4 },
			{ x = 1.6, z = 3.4 },
			{ x = 0, z = 6.0 },
		},
		maxSeats = 7,
	},
	{
		id = "harvester",
		name = "Harvester",
		class = "Special",
		price = 14000,
		description = {
			ru = "Трактор с огромными задними колёсами. Медленный, но пройдёт везде.",
			en = "A tractor with huge rear wheels. Slow, but goes anywhere.",
		},
		stats = stats(70, 30, 1.2, 36, 90, 0.05, 0.7, 1.0, 1.6, "RWD", 1.2, 2.4),
		wheels = {
			radius = 1.3,
			width = 1.0,
			base = 8.6,
			track = 5.8,
			rearRadius = 2.6,
			rearWidth = 1.8,
			rearTrack = 7.6,
			rim = "offroad",
		},
		body = { style = "tractor", length = 12.4, width = 3.8, floor = 1.6, belt = 4.4 },
		colors = { paint = 10, accent = 8, rim = 8 },
		features = { exhaust = 1 },
		seats = { { x = 0, z = 3.2, driver = true } },
	},
}

CarCatalog.List = cars

local byId: { [string]: CarDef } = {}
for i, def in cars do
	assert(byId[def.id] == nil, "Duplicate car id " .. def.id)
	byId[def.id] = def
	;(def :: any).order = i
end

function CarCatalog.get(id: any): CarDef?
	if typeof(id) ~= "string" then
		return nil
	end
	return byId[id]
end

function CarCatalog.getClass(id: string)
	for _, class in CarCatalog.Classes do
		if class.id == id then
			return class
		end
	end
	return CarCatalog.Classes[1]
end

-- Resolves the axle layout of a car (shared by the builder and physics).
export type Axle = { z: number, steer: boolean, drive: boolean, radius: number, width: number, track: number }

function CarCatalog.getAxles(def: CarDef): { Axle }
	local w = def.wheels
	local result: { Axle } = {}
	local drive = def.stats.drive
	if w.axles then
		for _, a in w.axles do
			table.insert(result, {
				z = a.z,
				steer = a.steer,
				drive = a.drive,
				radius = a.radius or w.radius,
				width = a.width or w.width,
				track = a.track or w.track,
			})
		end
		return result
	end
	local offset = w.offset or 0
	table.insert(result, {
		z = -w.base / 2 + offset,
		steer = true,
		drive = drive ~= "RWD",
		radius = w.radius,
		width = w.width,
		track = w.track,
	})
	table.insert(result, {
		z = w.base / 2 + offset,
		steer = false,
		drive = drive ~= "FWD",
		radius = w.rearRadius or w.radius,
		width = w.rearWidth or w.width,
		track = w.rearTrack or w.track,
	})
	return result
end

-- Default customization for a freshly bought car.
function CarCatalog.defaultSave(def: CarDef): CarSave
	return {
		paint = def.colors.paint,
		accent = def.colors.accent,
		rim = def.colors.rim,
		finish = "Gloss",
		glow = 0,
		glowOwned = false,
		engine = 0,
		tires = 0,
		nitro = 0,
	}
end

-- Stats after upgrades. Used by the server (authoritative, written to the model)
-- and by the garage UI (preview only).
function CarCatalog.getEffectiveStats(def: CarDef, save: CarSave?): EffectiveStats
	local s = def.stats
	local up = Config.Upgrades
	local engine = if save then save.engine else 0
	local tires = if save then save.tires else 0
	local nitro = if save then save.nitro else 0
	local susp = s.suspension
	return {
		maxSpeed = s.maxSpeed * (1 + engine * up.Engine.MaxSpeedPerLevel),
		accel = s.accel * (1 + engine * up.Engine.AccelPerLevel),
		grip = s.grip * (1 + tires * up.Tires.GripPerLevel),
		steer = s.steer,
		brake = s.brake,
		drift = s.drift,
		nitroPower = s.nitro * (1 + nitro * up.Nitro.PowerPerLevel),
		nitroRecharge = 1 + nitro * up.Nitro.RechargePerLevel,
		offroad = math.min(1, s.offroad + tires * up.Tires.OffroadPerLevel),
		drive = s.drive,
		suspRest = susp.rest,
		suspFreq = susp.freq or Config.Physics.SuspensionFrequency,
		suspDamping = susp.damping or Config.Physics.SuspensionDamping,
	}
end

-- 0..10 ratings for the garage bars.
function CarCatalog.getRatings(stats: EffectiveStats)
	local function scale(v: number, lo: number, hi: number): number
		return math.clamp((v - lo) / (hi - lo) * 10, 0.3, 10)
	end
	return {
		speed = scale(stats.maxSpeed, 60, 300),
		accel = scale(stats.accel, 20, 125),
		handling = scale(stats.grip * 0.7 + stats.steer / 40 * 0.3, 0.75, 1.5),
		offroad = scale(stats.offroad, -0.05, 1.05),
		nitro = scale(stats.nitroPower, 0.6, 1.8),
	}
end

function CarCatalog.getUpgradePrice(def: CarDef, kind: string, level: number): number?
	local up = (Config.Upgrades :: any)[kind]
	if not up or level < 1 or level > up.MaxLevel then
		return nil
	end
	local scale = (Config.UpgradePriceScale :: any)[def.class] or 1
	return math.floor(up.Prices[level] * scale / 50 + 0.5) * 50
end

return CarCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">CarPhysics</string>
          <string name="Source"><![CDATA[-- CarPhysics: arcade raycast vehicle simulation.
--
-- Runs on the client that owns the car (network owner). Every physics step it
-- casts one ray per wheel, computes spring/damper suspension and tire forces
-- and applies them to the chassis as impulses. Gravity and collisions are left
-- to the Roblox engine.
--
-- Tire forces are impulse based and integrated internally at ~240 Hz: each
-- wheel removes a share of its sideways slip per sub step, scaled by the
-- effective mass at the contact point, and limited by a friction circle
-- (grip * load). The result is stable and identical at 30, 60 or 144 FPS.

local Config = require(script.Parent.Config)
local CarCatalog = require(script.Parent.CarCatalog)
local Types = require(script.Parent.Types)

type EffectiveStats = Types.EffectiveStats

export type Input = {
	throttle: number, -- -1..1 (negative = brake / reverse)
	steer: number, -- -1..1 (positive = right)
	handbrake: boolean,
	nitro: boolean,
	parked: boolean?, -- nobody driving: hold the car still
}

export type Wheel = {
	part: BasePart?,
	motor: Motor6D?,
	mount: Vector3, -- chassis space, top of the suspension travel
	radius: number,
	steer: boolean,
	drive: boolean,
	side: number,
	staticLen: number,
	-- state (also read by the visuals)
	springLen: number,
	grounded: boolean,
	contact: Vector3,
	normal: Vector3,
	material: Enum.Material?,
	spin: number,
	steerAngle: number,
	slipping: boolean,
	load: number,
}

export type Telemetry = {
	speed: number,
	forwardSpeed: number,
	gear: number,
	rpm: number,
	nitro: number,
	nitroActive: boolean,
	drifting: boolean,
	driftAngle: number,
	airborne: boolean,
	airTime: number,
	grounded: number,
	surface: string,
	braking: boolean,
	slipping: boolean,
}

local CarPhysics = {}
CarPhysics.__index = CarPhysics

export type Sim = typeof(setmetatable(
	{} :: {
		chassis: BasePart,
		model: Model?,
		stats: EffectiveStats,
		wheels: { Wheel },
		steer: number,
		nitro: number,
		nitroActive: boolean,
		airTime: number,
		telemetry: Telemetry,
		raycast: (origin: Vector3, direction: Vector3) -> RaycastResult?,
		rayParams: RaycastParams?,
		inertiaLocal: Vector3,
	},
	CarPhysics
))

local P = Config.Physics
local GEAR_STARTS = { 0, 0.16, 0.31, 0.47, 0.63, 0.8 }

local surfaceCache: { [Enum.Material]: { grip: number, drag: number } } = {}
local function surfaceOf(material: Enum.Material?)
	if not material then
		return Config.Surfaces.Default
	end
	local s = surfaceCache[material]
	if not s then
		s = (Config.Surfaces :: any)[material.Name] or Config.Surfaces.Default
		surfaceCache[material] = s
	end
	return s
end

local function moveTowards(current: number, target: number, maxDelta: number): number
	if math.abs(target - current) <= maxDelta then
		return target
	end
	return current + math.sign(target - current) * maxDelta
end

-- Reads effective stats from model attributes (written by the server) and
-- falls back to the catalog definition.
function CarPhysics.readStats(model: Model): EffectiveStats
	local def = CarCatalog.get(model:GetAttribute("CarId"))
	local base = if def then CarCatalog.getEffectiveStats(def, nil) else nil
	local function num(name: string, fallback: number): number
		local v = model:GetAttribute(name)
		if typeof(v) == "number" then
			return v
		end
		return fallback
	end
	local fallback = base
		or {
			maxSpeed = 100,
			accel = 35,
			grip = 1,
			steer = 32,
			brake = 100,
			drift = 0.2,
			nitroPower = 1,
			nitroRecharge = 1,
			offroad = 0.2,
			drive = "RWD",
			suspRest = 1.3,
			suspFreq = P.SuspensionFrequency,
			suspDamping = P.SuspensionDamping,
		}
	return {
		maxSpeed = num("MaxSpeed", fallback.maxSpeed),
		accel = num("Accel", fallback.accel),
		grip = num("Grip", fallback.grip),
		steer = num("SteerAngle", fallback.steer),
		brake = num("Brake", fallback.brake),
		drift = num("Drift", fallback.drift),
		nitroPower = num("NitroPower", fallback.nitroPower),
		nitroRecharge = num("NitroRecharge", fallback.nitroRecharge),
		offroad = num("Offroad", fallback.offroad),
		drive = (model:GetAttribute("Drive") or fallback.drive) :: any,
		suspRest = num("SuspRest", fallback.suspRest),
		suspFreq = num("SuspFreq", fallback.suspFreq),
		suspDamping = num("SuspDamping", fallback.suspDamping),
	}
end

function CarPhysics.writeStats(model: Model, stats: EffectiveStats)
	model:SetAttribute("MaxSpeed", stats.maxSpeed)
	model:SetAttribute("Accel", stats.accel)
	model:SetAttribute("Grip", stats.grip)
	model:SetAttribute("SteerAngle", stats.steer)
	model:SetAttribute("Brake", stats.brake)
	model:SetAttribute("Drift", stats.drift)
	model:SetAttribute("NitroPower", stats.nitroPower)
	model:SetAttribute("NitroRecharge", stats.nitroRecharge)
	model:SetAttribute("Offroad", stats.offroad)
	model:SetAttribute("Drive", stats.drive)
	model:SetAttribute("SuspRest", stats.suspRest)
	model:SetAttribute("SuspFreq", stats.suspFreq)
	model:SetAttribute("SuspDamping", stats.suspDamping)
end

-- Collects the wheel rig (mount points etc.) from the tire parts of a car model.
function CarPhysics.readWheels(model: Model): { Wheel }
	local wheels: { Wheel } = {}
	for _, child in model:GetChildren() do
		if child:IsA("BasePart") and child:GetAttribute("Wheel") then
			local motor = child:FindFirstChild("Axle")
			table.insert(wheels, {
				part = child,
				motor = if motor and motor:IsA("Motor6D") then motor else nil,
				mount = child:GetAttribute("Mount") :: Vector3,
				radius = child:GetAttribute("Radius") :: number,
				steer = child:GetAttribute("Steer") == true,
				drive = child:GetAttribute("Drive") == true,
				side = child:GetAttribute("Side") :: number,
				staticLen = child:GetAttribute("StaticLen") :: number,
				springLen = child:GetAttribute("StaticLen") :: number,
				grounded = false,
				contact = Vector3.zero,
				normal = Vector3.yAxis,
				material = nil,
				spin = 0,
				steerAngle = 0,
				slipping = false,
				load = 0,
				index = child:GetAttribute("Index"),
			} :: any)
		end
	end
	table.sort(wheels, function(a: any, b: any)
		return (a.index or 0) < (b.index or 0)
	end)
	return wheels
end

function CarPhysics.new(chassis: BasePart, wheels: { Wheel }, stats: EffectiveStats, model: Model?): Sim
	local self = setmetatable({
		chassis = chassis,
		model = model,
		stats = stats,
		wheels = wheels,
		steer = 0,
		nitro = 1,
		nitroActive = false,
		airTime = 0,
		telemetry = {
			speed = 0,
			forwardSpeed = 0,
			gear = 1,
			rpm = 0,
			nitro = 1,
			nitroActive = false,
			drifting = false,
			driftAngle = 0,
			airborne = false,
			airTime = 0,
			grounded = 0,
			surface = "Default",
			braking = false,
			slipping = false,
		},
		raycast = nil :: any,
		rayParams = nil,
		inertiaLocal = Vector3.one,
	}, CarPhysics)

	if model then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { model }
		params.IgnoreWater = true
		params.RespectCanCollide = true
		params.CollisionGroup = "WheelRays"
		self.rayParams = params
		self.raycast = function(origin: Vector3, direction: Vector3)
			return workspace:Raycast(origin, direction, params)
		end
	end
	self:refreshInertia()
	return self
end

-- Inertia of the chassis box (the only part with mass) in chassis space.
function CarPhysics.refreshInertia(self: Sim)
	local s = self.chassis.Size
	local m = 1 / 12
	self.inertiaLocal = Vector3.new(m * (s.Y * s.Y + s.Z * s.Z), m * (s.X * s.X + s.Z * s.Z), m * (s.X * s.X + s.Y * s.Y))
end

-- Excludes extra instances (e.g. the driver's character) from wheel rays.
function CarPhysics.setIgnoreList(self: Sim, list: { Instance })
	if self.rayParams then
		self.rayParams.FilterDescendantsInstances = list
	end
end

local function curve(x: number): number
	if x >= 1 then
		return 0
	end
	if x <= 0 then
		return 1
	end
	return 1 - x * x
end

function CarPhysics.step(self: Sim, dtRaw: number, input: Input)
	local chassis = self.chassis
	local dt = math.clamp(dtRaw, 1 / 240, 1 / 20)
	local st = self.stats
	local wheels = self.wheels
	local n = #wheels
	if n == 0 then
		return
	end

	local cf = chassis.CFrame
	local up = cf.UpVector
	local look = cf.LookVector
	local right = cf.RightVector
	local mass = chassis.AssemblyMass
	local com = chassis.AssemblyCenterOfMass
	local vel = chassis.AssemblyLinearVelocity
	local angVel = chassis.AssemblyAngularVelocity
	local gravity = workspace.Gravity
	local gravityVec = Vector3.new(0, -gravity, 0)

	local mShare = mass / n
	local omega = 2 * math.pi * st.suspFreq
	local springK = mShare * omega * omega
	local damperC = 2 * st.suspDamping * mShare * omega
	local rest = st.suspRest

	local fwdSpeed = vel:Dot(look)
	local speed = vel.Magnitude
	local maxSpeed = math.max(st.maxSpeed, 1)

	-- inverse inertia (world) and effective mass at a point
	local invI = Vector3.new(
		1 / (self.inertiaLocal.X * mass),
		1 / (self.inertiaLocal.Y * mass),
		1 / (self.inertiaLocal.Z * mass)
	)
	local function invInertia(v: Vector3): Vector3
		return cf:VectorToWorldSpace(cf:VectorToObjectSpace(v) * invI)
	end
	local function effMass(r: Vector3, dir: Vector3): number
		local rn = r:Cross(dir)
		return 1 / (1 / mass + rn:Dot(invInertia(rn)))
	end

	-- 1) suspension rays (once per frame)
	local grounded = 0
	local drivenGrounded = 0
	local rearCount = 0
	for _, w in wheels do
		local mount = cf:PointToWorldSpace(w.mount)
		local hit = self.raycast(mount, -up * (rest + w.radius))
		if hit then
			w.grounded = true
			w.springLen = math.clamp(hit.Distance - w.radius, 0, rest)
			w.contact = hit.Position
			w.normal = hit.Normal
			w.material = hit.Material
			grounded += 1
			if w.drive then
				drivenGrounded += 1
			end
		else
			w.grounded = false
			w.springLen = moveTowards(w.springLen, rest, dt * 12)
			w.material = nil
			w.load = 0
		end
		if not w.steer then
			rearCount += 1
		end
	end

	-- 2) driver input
	local throttle = math.clamp(input.throttle, -1, 1)
	local steerInput = math.clamp(input.steer, -1, 1)
	local speedFrac = math.clamp(math.abs(fwdSpeed) / maxSpeed, 0, 1)
	local maxSteer = math.rad(st.steer) * (1 - (1 - P.HighSpeedSteer) * speedFrac)
	local target = steerInput * maxSteer
	local rate = if math.abs(target) < math.abs(self.steer) then P.SteerReturnRate else P.SteerRate
	self.steer = moveTowards(self.steer, target, rate * dt)

	local wantsNitro = input.nitro and throttle > 0.1 and not input.parked
	if wantsNitro and self.nitro > 0.01 then
		self.nitroActive = true
		self.nitro = math.max(0, self.nitro - P.NitroDrain * dt)
	else
		self.nitroActive = false
		self.nitro = math.min(1, self.nitro + P.NitroRecharge * st.nitroRecharge * dt)
	end
	local boost = if self.nitroActive then st.nitroPower else 0
	local vmax = maxSpeed * (1 + P.NitroSpeedBonus * boost)
	local accel = st.accel * (1 + P.NitroAccelBonus * boost)

	local driveAccel = 0
	local brakeAmount = 0
	if input.parked then
		brakeAmount = 1
	elseif throttle > 0.05 then
		if fwdSpeed < -1.5 then
			brakeAmount = throttle
		else
			driveAccel = accel * throttle * curve(fwdSpeed / vmax)
		end
	elseif throttle < -0.05 then
		if fwdSpeed > 1.5 then
			brakeAmount = -throttle
		else
			driveAccel = accel * 0.7 * throttle * curve(-fwdSpeed / (vmax * P.ReverseShare))
		end
	end
	local handbrake = input.handbrake or input.parked == true

	-- body slip (drift) and assisted wheel angle
	local planarVel = vel - up * vel:Dot(up)
	local planarSpeed = planarVel.Magnitude
	local bodySlip = 0
	local wheelAngle = self.steer
	if planarSpeed > 5 then
		local vRight, vLook = planarVel:Dot(right), planarVel:Dot(look)
		bodySlip = math.deg(math.atan2(math.abs(vRight), math.max(math.abs(vLook), 1e-3)))
		if vLook > 5 and grounded > 0 and not input.parked then
			-- auto counter-steer: while sliding, the front wheels follow the direction of travel
			local signedSlip = math.atan2(vRight, vLook)
			local assist = P.CounterSteer * math.clamp((bodySlip - 6) / 14, 0, 1)
			local limit = math.rad(st.steer) + math.rad(15)
			wheelAngle = math.clamp(self.steer + signedSlip * assist, -limit, limit)
		end
	end
	local steerRot = CFrame.fromAxisAngle(up, -wheelAngle)

	local driftLoss = 0
	if throttle > 0 and speed > 25 then
		driftLoss = st.drift * 0.45 * math.abs(steerInput) * throttle * math.clamp((speed - 25) / 40, 0, 1)
	end
	-- the rear regains grip as the slide gets too wide, so slides settle at a
	-- controllable angle instead of spinning the car around
	local recover = math.clamp((bodySlip - P.DriftMaxAngle) / 20, 0, 1)
	local hbGrip = 0.55 - 0.37 * st.drift

	-- per-wheel constants for this frame
	local surfaceName = "Default"
	for _, w in wheels do
		w.steerAngle = if w.steer then wheelAngle else 0
		w.slipping = false
		if not w.grounded then
			continue
		end
		local wheelLook = if w.steer then steerRot:VectorToWorldSpace(look) else look
		local normal = w.normal
		local fwd = wheelLook - normal * wheelLook:Dot(normal)
		if fwd.Magnitude < 1e-3 then
			fwd = look
		end
		fwd = fwd.Unit
		local side = fwd:Cross(normal)
		local r = w.contact - com
		local tirePoint = w.contact + up * ((com - w.contact):Dot(up) * P.AntiRoll)
		local rt = tirePoint - com
		local surface = surfaceOf(w.material)
		local surfaceGrip = 1 - (1 - surface.grip) * (1 - st.offroad * 0.85)
		if surface.grip > 1 then
			surfaceGrip = surface.grip
		end
		if w.material then
			surfaceName = w.material.Name
		end
		local latGrip = 1
		if not w.steer then
			if handbrake then
				latGrip = hbGrip
			end
			latGrip *= 1 - driftLoss
			latGrip += (1 - latGrip) * recover
		end
		local stopForce = 0
		if brakeAmount > 0 then
			stopForce += st.brake * brakeAmount * mass / grounded
		elseif driveAccel == 0 then
			stopForce += P.CoastDecel * mass / grounded
		end
		if input.parked then
			stopForce += st.brake * mass / grounded
		elseif handbrake and not w.steer then
			-- a light lock at speed (to start slides), a firm one when crawling
			local lock = if planarSpeed > 20 then 0.15 else 0.8
			stopForce += st.brake * lock * mass / math.max(rearCount, 1)
		end
		stopForce += surface.drag * (1 - st.offroad) * mass / grounded
		local driveForce = 0
		if w.drive and drivenGrounded > 0 and driveAccel ~= 0 and not (handbrake and not w.steer) then
			driveForce = driveAccel * mass / drivenGrounded
		end
		local cache = w :: any
		cache._fwd = fwd
		cache._side = side
		cache._r = r
		cache._rt = rt
		cache._mUp = effMass(r, up)
		cache._mSide = effMass(rt, side)
		cache._mFwd = effMass(rt, fwd)
		cache._gripLimit = st.grip * surfaceGrip
		cache._latGrip = latGrip
		cache._stop = stopForce
		cache._drive = driveForce
		cache._len = w.springLen
	end

	-- 3) wheel forces, integrated internally at ~240 Hz so the result does not
	-- depend on the client's frame rate. The engine receives the sum once.
	local steps = math.clamp(math.floor(dt * 240 + 0.5), 1, 12)
	local h = dt / steps
	local latRate = 1 - (1 - P.LateralGripRate) ^ (h * 60)
	local linImpulse = Vector3.zero
	local angImpulse = Vector3.zero
	local tireSum = Vector3.zero
	local anySlip = false
	local pVel, pAng = vel, angVel
	local gStep = math.max(grounded, 1)

	for _ = 1, steps do
		local stepLin = Vector3.zero
		local stepAng = Vector3.zero
		for _, w in wheels do
			if not w.grounded then
				continue
			end
			local c = w :: any
			local r: Vector3 = c._r
			local rt: Vector3 = c._rt
			local pointVel = pVel + pAng:Cross(r)

			-- suspension
			local len: number = c._len
			local vUp = pointVel:Dot(up)
			local compression = rest - len
			local damper = damperC * vUp
			local maxDamper = math.abs(vUp) * c._mUp * 0.9 / (gStep * h)
			if math.abs(damper) > maxDamper then
				damper = math.sign(damper) * maxDamper
			end
			local springF = springK * compression - damper
			if springF < 0 then
				springF = 0
			end
			local suspImpulse = up * (springF * h)
			if len <= 0.02 and vUp < 0 then
				-- bump stop: never let the wheel sink through the body
				suspImpulse += up * (-vUp * c._mUp / gStep)
			end
			w.load = springF

			-- tires
			local fwd: Vector3 = c._fwd
			local side: Vector3 = c._side
			local tireVel = pVel + pAng:Cross(rt)
			local vF = tireVel:Dot(fwd)
			local vS = tireVel:Dot(side)
			local limit = c._gripLimit * springF
			local fLat = -vS * c._mSide * latRate / (gStep * h)
			local fLong = c._drive
			local stop = c._stop
			if stop > 0 then
				local maxStop = math.abs(vF) * c._mFwd / (gStep * h)
				fLong -= math.sign(vF) * math.min(stop, maxStop)
			end
			local latLimit = limit * c._latGrip
			local longLimit = limit * 1.05
			local fLatC = math.clamp(fLat, -latLimit, latLimit)
			local fLongC = math.clamp(fLong, -longLimit, longLimit)
			local combined = math.sqrt((fLatC / math.max(latLimit, 1e-6)) ^ 2 + (fLongC / math.max(longLimit, 1e-6)) ^ 2)
			if combined > 1 then
				fLatC /= combined
				fLongC /= combined
			end
			if math.abs(fLat) > latLimit * 1.02 or math.abs(fLong) > longLimit * 1.02 then
				w.slipping = true
				anySlip = true
			end
			local tireImpulse = (side * fLatC + fwd * fLongC) * h
			stepLin += suspImpulse + tireImpulse
			stepAng += r:Cross(suspImpulse) + rt:Cross(tireImpulse)
			tireSum += tireImpulse

			-- predicted spring length for the next sub step
			c._len = math.clamp(len + vUp * h, 0, rest)
		end
		linImpulse += stepLin
		angImpulse += stepAng
		pVel += stepLin / mass + gravityVec * h
		pAng += invInertia(stepAng)
	end

	-- visual wheel spin
	for _, w in wheels do
		local c = w :: any
		local vF = if w.grounded then (vel + angVel:Cross(c._rt)):Dot(c._fwd) else 0
		local locked = handbrake and not w.steer -- a locked wheel does not turn
		if not w.grounded then
			if w.drive and math.abs(throttle) > 0.05 and not handbrake then
				w.spin += throttle * 30 * dt
			end
		elseif not locked then
			if w.slipping and w.drive and driveAccel ~= 0 then
				w.spin += (vF + math.sign(driveAccel) * 25) / w.radius * dt
			else
				w.spin += vF / w.radius * dt
			end
		end
	end

	-- 4) holding still, drifting, aero, air control
	local hold = input.parked or (math.abs(throttle) < 0.05 and planarSpeed < 2.5)
	if hold and grounded >= 3 then
		-- static friction: cancel gravity along the ground and any creeping
		local nSum = Vector3.zero
		for _, w in wheels do
			if w.grounded then
				nSum += w.normal
			end
		end
		local nrm = nSum.Unit
		local gTan = gravityVec - nrm * gravityVec:Dot(nrm)
		local holdLimit = st.grip * gravity * nrm.Y
		if gTan.Magnitude <= holdLimit then
			-- aim for a velocity that gravity brings back to zero halfway through the step
			local vAfter = vel + linImpulse / mass
			local vTan = vAfter - nrm * vAfter:Dot(nrm)
			local targetVel = -gTan * (dt * 0.5)
			linImpulse += (targetVel - vTan) * mass
		end
	end
	if grounded >= 2 and bodySlip > 10 and planarSpeed > 15 and not input.parked then
		-- sliding tires scrub off a lot of speed; give most of it back so drifts flow
		local dir = planarVel.Unit
		local along = tireSum:Dot(dir)
		if along < 0 then
			local keep = P.DriftScrubKeep * math.clamp((bodySlip - 10) / 20, 0, 1)
			linImpulse += dir * (-along * keep)
		end
	end
	if grounded >= 2 and bodySlip > 8 and throttle > 0 and planarSpeed < vmax * 0.92 and planarSpeed > 10 then
		-- keep momentum through slides
		local keep = math.clamp(bodySlip / 30, 0, 1) * throttle
		linImpulse += planarVel.Unit * (st.accel * P.DriftThrust * keep * mass * dt)
	end
	if grounded >= 2 then
		-- yaw limiter: arcade cars never spin faster than this
		local yawRate = angVel:Dot(up)
		if math.abs(yawRate) > P.MaxYawRate then
			local excess = (math.abs(yawRate) - P.MaxYawRate) * math.sign(yawRate)
			local Iy = self.inertiaLocal.Y * mass
			angImpulse -= up * (excess * (1 - 0.2 ^ (dt * 60)) * Iy)
		end
		local df = P.DownforceG * gravity * (speed / maxSpeed) ^ 2 * mass
		linImpulse += -up * (df * dt)
	end
	local worldUp = Vector3.yAxis
	local I = self.inertiaLocal * mass
	if grounded == 0 then
		self.airTime += dt
		local levelAxis = up:Cross(worldUp)
		local desired = levelAxis * P.AirLevelling
		if not input.parked then
			desired += right * (-throttle * P.AirControl) + up * (-steerInput * P.AirControl)
		end
		-- damp pitch/roll spin a little
		local spinNoYaw = angVel - up * angVel:Dot(up)
		desired -= spinNoYaw * 0.6
		angImpulse += cf:VectorToWorldSpace(cf:VectorToObjectSpace(desired * dt) * I)
	else
		self.airTime = 0
		-- gently pull a car lying on its side back to its wheels at low speed
		if up.Y < 0.3 and speed < 8 then
			local axis = up:Cross(worldUp)
			angImpulse += cf:VectorToWorldSpace(cf:VectorToObjectSpace(axis * (3 * dt)) * I)
		end
	end

	-- clamp crazy spins (after collisions)
	local predicted = angVel + invInertia(angImpulse)
	local predictedSpeed = predicted.Magnitude
	if predictedSpeed > P.MaxAngularSpeed then
		local excess = predicted * (1 - P.MaxAngularSpeed / predictedSpeed)
		angImpulse -= cf:VectorToWorldSpace(cf:VectorToObjectSpace(excess) * I)
	end

	chassis:ApplyImpulse(linImpulse)
	chassis:ApplyAngularImpulse(angImpulse)

	-- 5) telemetry
	local t = self.telemetry
	t.speed = speed
	t.forwardSpeed = fwdSpeed
	t.grounded = grounded
	t.airborne = grounded == 0
	t.airTime = self.airTime
	t.nitro = self.nitro
	t.nitroActive = self.nitroActive
	t.braking = brakeAmount > 0 or (handbrake and not input.parked)
	t.slipping = anySlip
	t.surface = surfaceName
	t.driftAngle = bodySlip
	t.drifting = grounded >= 2 and planarSpeed > P.DriftMinSpeed and bodySlip > P.DriftSlipAngle and bodySlip < 110
	if t.drifting then
		self.nitro = math.min(1, self.nitro + P.NitroDriftRecharge * dt)
	elseif grounded == 0 and self.airTime > 0.3 then
		self.nitro = math.min(1, self.nitro + P.NitroAirRecharge * dt)
	end
	local frac = math.clamp(math.abs(fwdSpeed) / vmax, 0, 1)
	local gear = 1
	for i = #GEAR_STARTS, 1, -1 do
		if frac >= GEAR_STARTS[i] then
			gear = i
			break
		end
	end
	local gStart = GEAR_STARTS[gear]
	local gEnd = GEAR_STARTS[gear + 1] or 1.05
	local within = math.clamp((frac - gStart) / (gEnd - gStart), 0, 1)
	local rpm = 0.22 + 0.78 * within
	if fwdSpeed < -1 then
		gear = 0 -- reverse
		rpm = 0.25 + 0.6 * math.clamp(-fwdSpeed / (vmax * P.ReverseShare), 0, 1)
	end
	if t.slipping and driveAccel ~= 0 then
		rpm = math.min(1, rpm + 0.25)
	end
	t.gear = gear
	t.rpm = t.rpm + (rpm - t.rpm) * math.clamp(dt * 10, 0, 1)
end

-- Positions the visual wheels (Motor6D.Transform) from the current wheel state.
function CarPhysics.updateVisuals(self: Sim)
	for _, w in self.wheels do
		local motor = w.motor
		if motor then
			local offset = w.staticLen - w.springLen
			motor.Transform = CFrame.new(0, offset, 0) * CFrame.Angles(0, -w.steerAngle, 0) * CFrame.Angles(-w.spin, 0, 0)
		end
	end
end

return CarPhysics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Config: all gameplay tunables in one place.
-- NOTE: this module replicates to clients, so it holds nothing secret.
-- Every number that matters for the economy is re-checked on the server.

local Config = {}

Config.Version = "2.0.0"

-- Data ----------------------------------------------------------------------
Config.DataStoreName = "CarsMode_PlayerData_v1"
Config.AutosaveInterval = 90 -- seconds
Config.SessionLockTimeout = 600 -- a lock older than this is considered dead
Config.StartingCash = 7500
Config.StarterCarId = "pebble" -- given for free to every new player

-- Admins (UserIds) may use the dev panel in live servers. In Studio it is always on.
Config.Admins = {} :: { number }

-- Vehicles ------------------------------------------------------------------
Config.SpawnCooldown = 3 -- seconds between spawns
Config.FlipCooldown = 2
Config.VoidY = -80 -- cars below this height are rescued to a spawn pad
Config.SpeedDisplayFactor = 1.3 -- studs/s -> "km/h" on the HUD
Config.MaxPassengerSeats = 3

-- Physics defaults (overridden per car in CarCatalog)
Config.Physics = {
	SuspensionFrequency = 2.6, -- Hz
	SuspensionDamping = 0.55, -- damping ratio (1 = critically damped)
	LateralGripRate = 0.62, -- 0..1 share of sideways slip removed each step
	AntiRoll = 0.72, -- 0 = forces at contact point, 1 = at center of mass height
	SteerRate = 4.2, -- rad/s the front wheels turn towards the target angle
	SteerReturnRate = 6.0,
	HighSpeedSteer = 0.38, -- share of max steer left at top speed
	CoastDecel = 7, -- studs/s^2 when no throttle
	ReverseShare = 0.42, -- reverse top speed as share of max speed
	DownforceG = 0.45, -- extra downforce at top speed, in g
	AirControl = 2.2, -- rad/s^2 of player pitch/yaw control in the air
	AirLevelling = 1.6, -- how strongly the car rights itself in the air
	MaxAngularSpeed = 14,
	NitroDrain = 0.28, -- share of the tank per second
	NitroRecharge = 0.05, -- per second while not boosting
	NitroDriftRecharge = 0.12, -- extra per second while drifting
	NitroAirRecharge = 0.1,
	NitroSpeedBonus = 0.28, -- top speed multiplier while boosting
	NitroAccelBonus = 0.9, -- acceleration multiplier added while boosting
	DriftSlipAngle = 14, -- degrees of slip before a slide counts as a drift
	DriftMinSpeed = 30,
	DriftMaxAngle = 32, -- past this slip angle the rear tires start to bite again
	DriftThrust = 0.45, -- share of acceleration that pushes along the slide
	DriftScrubKeep = 0.7, -- share of tire scrub returned while sliding
	CorneringDrag = 0.03, -- speed lost per unit of cornering force
	MaxYawRate = 3.0, -- rad/s
	CounterSteer = 0.85, -- 0..1 automatic counter-steer while sliding
}

-- Grip and rolling drag per surface. `offroad` stat on the car shrinks the penalty.
Config.Surfaces = {
	Default = { grip = 1.0, drag = 0 },
	Asphalt = { grip = 1.05, drag = 0 },
	Concrete = { grip = 1.0, drag = 0 },
	SmoothPlastic = { grip = 1.0, drag = 0 },
	Plastic = { grip = 1.0, drag = 0 },
	Pavement = { grip = 1.0, drag = 0 },
	Slate = { grip = 0.95, drag = 1 },
	Brick = { grip = 0.95, drag = 1 },
	Cobblestone = { grip = 0.9, drag = 3 },
	Wood = { grip = 0.9, drag = 1 },
	WoodPlanks = { grip = 0.9, drag = 1 },
	Metal = { grip = 0.9, drag = 0 },
	DiamondPlate = { grip = 0.95, drag = 0 },
	Grass = { grip = 0.78, drag = 7 },
	LeafyGrass = { grip = 0.75, drag = 8 },
	Ground = { grip = 0.8, drag = 6 },
	Rock = { grip = 0.85, drag = 4 },
	Basalt = { grip = 0.85, drag = 4 },
	Sand = { grip = 0.62, drag = 16 },
	Sandstone = { grip = 0.8, drag = 5 },
	Mud = { grip = 0.55, drag = 22 },
	Snow = { grip = 0.5, drag = 12 },
	Ice = { grip = 0.22, drag = 0 },
	Glacier = { grip = 0.25, drag = 0 },
}

-- Economy -------------------------------------------------------------------
Config.Earnings = {
	PerStud = 0.08, -- cash per stud driven (100 studs/s = $480 per minute)
	MinSpeed = 12, -- below this nothing is paid for distance
	PayoutInterval = 5, -- seconds between distance payouts
	DriftPerSecond = 30,
	DriftMinDuration = 1.2,
	AirPerSecond = 45,
	AirMinDuration = 0.9,
	SpeedTrapThresholds = { 120, 160, 200, 240 }, -- studs/s
	SpeedTrapRewards = { 300, 700, 1500, 3000 },
	MaxPerMinute = 12000, -- hard cap on passive earnings (distance/drift/air)
}

Config.Daily = {
	Base = 2000,
	StreakBonus = 750,
	MaxStreak = 7,
}

Config.Races = {
	CountdownSeconds = 3,
	CheckpointTimeout = 75, -- seconds without a checkpoint -> DNF
	FinishReward = 600,
	MedalRewards = { Gold = 3500, Silver = 1800, Bronze = 900 },
	RepeatMedalShare = 0.25, -- medals already earned pay this share again
}

-- Upgrades: level 0..MaxLevel, price for level n is Prices[n]
Config.Upgrades = {
	Engine = {
		MaxLevel = 5,
		Prices = { 2500, 6000, 12000, 22000, 40000 },
		MaxSpeedPerLevel = 0.045,
		AccelPerLevel = 0.07,
	},
	Tires = {
		MaxLevel = 5,
		Prices = { 1500, 4000, 8500, 15000, 26000 },
		GripPerLevel = 0.045,
		OffroadPerLevel = 0.04,
	},
	Nitro = {
		MaxLevel = 5,
		Prices = { 2000, 5000, 10000, 18000, 32000 },
		PowerPerLevel = 0.08,
		RechargePerLevel = 0.12,
	},
}
Config.UpgradePriceScale = { -- multiplier by car class so hypercars cost more to tune
	Starter = 0.6,
	Street = 0.8,
	Utility = 0.8,
	Offroad = 1.0,
	Sport = 1.0,
	Muscle = 1.0,
	Emergency = 1.1,
	Super = 1.6,
	Hyper = 2.4,
	Special = 1.4,
}

Config.Customization = {
	PaintPrice = 400,
	AccentPrice = 250,
	RimPrice = 300,
	UnderglowPrice = 2500, -- first time; changing color after that costs PaintPrice
	FinishPrices = { Gloss = 0, Matte = 1200, Metallic = 2500, Pearl = 4000, Chrome = 9000, Neon = 15000 },
}

-- World ---------------------------------------------------------------------
Config.DayNight = {
	Enabled = true,
	MinutesPerDay = 18, -- real minutes for a full 24h cycle
	StartClock = 13.5,
	NightStart = 18.4,
	NightEnd = 6.2,
}

Config.Leaderboards = {
	RefreshInterval = 120,
	Size = 10,
}

-- UI ------------------------------------------------------------------------
Config.Language = "auto" -- "auto" (by player locale), "ru" or "en"

Config.Keys = {
	Handbrake = { Enum.KeyCode.Space, Enum.KeyCode.ButtonX },
	Nitro = { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonR1 },
	Flip = { Enum.KeyCode.R, Enum.KeyCode.DPadUp },
	Lights = { Enum.KeyCode.L, Enum.KeyCode.DPadRight },
	Siren = { Enum.KeyCode.K, Enum.KeyCode.DPadLeft },
	Horn = { Enum.KeyCode.H, Enum.KeyCode.ButtonL3 },
	Exit = { Enum.KeyCode.F, Enum.KeyCode.ButtonB },
	Garage = { Enum.KeyCode.G, Enum.KeyCode.ButtonSelect },
	Camera = { Enum.KeyCode.V, Enum.KeyCode.ButtonR3 },
}

-- Optional sounds. Paste asset ids ("rbxassetid://123") from the Creator Store.
-- Empty strings are skipped, so the game works without any audio.
Config.Sounds = {
	Engine = "", -- looped engine tone, pitch follows RPM
	Horn = "",
	Siren = "",
	Nitro = "",
	Skid = "",
	Checkpoint = "",
	Countdown = "",
	Finish = "",
	Purchase = "",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Net: the one place where remotes are declared, created and wired.
--
-- Server: Net.init() creates the remotes; Net.handle(action, fn) registers a
-- request handler; Net.onEvent(name, fn, ratePerSecond) listens to a client event.
-- Client: Net.request(action, ...) -> { ok, message, args }; Net.on(name, fn).
--
-- Every client -> server call passes through a per-player token bucket and a
-- type check on the action name. Handlers still validate their own arguments.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local FOLDER_NAME = "CarsRemotes"

-- server -> client
Net.ServerEvents = {
	"Profile", -- full public profile snapshot
	"Notify", -- (key, args, kind)
	"Reward", -- (kind, amount, detail)
	"RaceState", -- race updates for one player
	"ServiceState", -- the owner's service plot: orders, bays, staff
	"ServiceEvent", -- (kind, data): arrived / ready / done / levelup
}
-- client -> server
Net.ClientEvents = {
	"VehicleAction", -- (action, value)
}

local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder
	end
	folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
	return folder :: Folder
end

--------------------------------------------------------------------------------
-- Rate limiting
--------------------------------------------------------------------------------

type Bucket = { tokens: number, last: number }
local buckets: { [Player]: { [string]: Bucket } } = {}

local function allow(player: Player, key: string, perSecond: number, burst: number): boolean
	local byKey = buckets[player]
	if not byKey then
		byKey = {}
		buckets[player] = byKey
	end
	local now = os.clock()
	local b = byKey[key]
	if not b then
		b = { tokens = burst, last = now }
		byKey[key] = b
	end
	b.tokens = math.min(burst, b.tokens + (now - b.last) * perSecond)
	b.last = now
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	return false
end
Net.allow = allow

--------------------------------------------------------------------------------
-- Server
--------------------------------------------------------------------------------

export type Result = { ok: boolean, message: string?, args: { any }? }
type Handler = (player: Player, ...any) -> Result

local handlers: { [string]: Handler } = {}

function Net.init()
	assert(RunService:IsServer(), "Net.init is server only")
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing then
		existing:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = FOLDER_NAME
	for _, name in Net.ServerEvents do
		local e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = f
	end
	for _, name in Net.ClientEvents do
		local e = Instance.new("RemoteEvent")
		e.Name = name
		e.Parent = f
	end
	local request = Instance.new("RemoteFunction")
	request.Name = "Request"
	request.Parent = f
	f.Parent = ReplicatedStorage
	folder = f

	request.OnServerInvoke = function(player: Player, action: any, ...: any): Result
		if typeof(action) ~= "string" or #action > 40 then
			return { ok = false }
		end
		local handler = handlers[action]
		if not handler then
			return { ok = false }
		end
		if not allow(player, "request", 6, 12) then
			return { ok = false, message = "TooManyRequests" }
		end
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[Net] %s failed for %s: %s", action, player.Name, tostring(result)))
			return { ok = false }
		end
		return result or { ok = true }
	end

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

function Net.handle(action: string, handler: Handler)
	assert(handlers[action] == nil, "Duplicate handler " .. action)
	handlers[action] = handler
end

function Net.onEvent(name: string, handler: (Player, ...any) -> (), perSecond: number?)
	local remote = getFolder():FindFirstChild(name) :: RemoteEvent
	assert(remote, "Unknown client event " .. name)
	local rate = perSecond or 10
	remote.OnServerEvent:Connect(function(player, ...)
		if not allow(player, "event:" .. name, rate, rate * 2) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(string.format("[Net] event %s failed for %s: %s", name, player.Name, tostring(err)))
		end
	end)
end

function Net.fire(player: Player, name: string, ...: any)
	local remote = getFolder():FindFirstChild(name) :: RemoteEvent
	remote:FireClient(player, ...)
end

function Net.fireAll(name: string, ...: any)
	local remote = getFolder():FindFirstChild(name) :: RemoteEvent
	remote:FireAllClients(...)
end

function Net.notify(player: Player, key: string, args: { any }?, kind: string?)
	Net.fire(player, "Notify", key, args or {}, kind or "info")
end

--------------------------------------------------------------------------------
-- Client
--------------------------------------------------------------------------------

function Net.request(action: string, ...: any): Result
	local remote = getFolder():WaitForChild("Request") :: RemoteFunction
	local ok, result = pcall(remote.InvokeServer, remote, action, ...)
	if not ok or typeof(result) ~= "table" then
		return { ok = false }
	end
	return result
end

function Net.on(name: string, handler: (...any) -> ())
	local remote = getFolder():WaitForChild(name) :: RemoteEvent
	return remote.OnClientEvent:Connect(handler)
end

function Net.send(name: string, ...: any)
	local remote = getFolder():WaitForChild(name) :: RemoteEvent
	remote:FireServer(...)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">Paints</string>
          <string name="Source"><![CDATA[-- Paints: color palette and paint finishes shared by the builder, garage UI and server validation.

export type Swatch = { name: { ru: string, en: string }, color: Color3 }
export type Finish = {
	id: string,
	name: { ru: string, en: string },
	material: Enum.Material,
	reflectance: number,
}

local Paints = {}

local function c(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

Paints.Palette = {
	{ name = { ru = "Снежный", en = "Snow" }, color = c(240, 242, 245) },
	{ name = { ru = "Серебро", en = "Silver" }, color = c(176, 182, 190) },
	{ name = { ru = "Графит", en = "Graphite" }, color = c(70, 74, 82) },
	{ name = { ru = "Чёрный", en = "Black" }, color = c(22, 23, 27) },
	{ name = { ru = "Красный", en = "Red" }, color = c(214, 32, 40) },
	{ name = { ru = "Вишня", en = "Cherry" }, color = c(130, 14, 32) },
	{ name = { ru = "Оранжевый", en = "Orange" }, color = c(255, 116, 24) },
	{ name = { ru = "Жёлтый", en = "Yellow" }, color = c(255, 206, 28) },
	{ name = { ru = "Лайм", en = "Lime" }, color = c(150, 222, 40) },
	{ name = { ru = "Зелёный", en = "Green" }, color = c(32, 150, 72) },
	{ name = { ru = "Хаки", en = "Olive" }, color = c(96, 104, 58) },
	{ name = { ru = "Бирюза", en = "Teal" }, color = c(18, 170, 170) },
	{ name = { ru = "Голубой", en = "Sky" }, color = c(80, 180, 255) },
	{ name = { ru = "Синий", en = "Blue" }, color = c(28, 82, 214) },
	{ name = { ru = "Ночной", en = "Midnight" }, color = c(20, 30, 74) },
	{ name = { ru = "Фиолетовый", en = "Purple" }, color = c(120, 52, 206) },
	{ name = { ru = "Розовый", en = "Pink" }, color = c(255, 92, 178) },
	{ name = { ru = "Песочный", en = "Sand" }, color = c(214, 186, 138) },
	{ name = { ru = "Коричневый", en = "Brown" }, color = c(108, 66, 38) },
	{ name = { ru = "Бронза", en = "Bronze" }, color = c(176, 120, 62) },
	{ name = { ru = "Золото", en = "Gold" }, color = c(222, 176, 52) },
	{ name = { ru = "Мята", en = "Mint" }, color = c(150, 236, 200) },
	{ name = { ru = "Лаванда", en = "Lavender" }, color = c(186, 166, 240) },
	{ name = { ru = "Кислотный", en = "Toxic" }, color = c(198, 255, 0) },
} :: { Swatch }

Paints.Finishes = {
	{ id = "Gloss", name = { ru = "Глянец", en = "Gloss" }, material = Enum.Material.SmoothPlastic, reflectance = 0.12 },
	{ id = "Matte", name = { ru = "Мат", en = "Matte" }, material = Enum.Material.SmoothPlastic, reflectance = 0 },
	{ id = "Metallic", name = { ru = "Металлик", en = "Metallic" }, material = Enum.Material.Foil, reflectance = 0.05 },
	{ id = "Pearl", name = { ru = "Перламутр", en = "Pearl" }, material = Enum.Material.Glass, reflectance = 0.25 },
	{ id = "Chrome", name = { ru = "Хром", en = "Chrome" }, material = Enum.Material.Metal, reflectance = 0.55 },
	{ id = "Neon", name = { ru = "Неон", en = "Neon" }, material = Enum.Material.Neon, reflectance = 0 },
} :: { Finish }

local finishById: { [string]: Finish } = {}
for _, f in Paints.Finishes do
	finishById[f.id] = f
end

function Paints.getColor(index: number?): Color3
	local swatch = Paints.Palette[index or 1]
	return if swatch then swatch.color else Paints.Palette[1].color
end

function Paints.isValidIndex(index: any): boolean
	return typeof(index) == "number" and index == math.floor(index) and Paints.Palette[index] ~= nil
end

function Paints.getFinish(id: string?): Finish
	return finishById[id or "Gloss"] or finishById.Gloss
end

function Paints.isValidFinish(id: any): boolean
	return typeof(id) == "string" and finishById[id] ~= nil
end

return Paints
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">ServiceConfig</string>
          <string name="Source"><![CDATA[-- ServiceConfig: the car-service mode. Customers park at your plot, you take
-- their order, wash / repair / paint the vehicle by hand (mouse or finger) and
-- level up from bicycles to hypercars. Later you buy more bays and hire staff.
--
-- Everything here is plain data plus a few pure helpers, so the server, the
-- client UI and the tests all agree on prices, unlocks and rewards.

local ServiceConfig = {}

ServiceConfig.MaxLevel = 30
ServiceConfig.Plots = 6

-- XP needed to go from `level` to `level + 1`.
function ServiceConfig.xpToNext(level: number): number
	return math.floor(60 * level ^ 1.35)
end

--------------------------------------------------------------------------------
-- Vehicle sizes: drive the minigame (spot count/size, camera) and the timing
--------------------------------------------------------------------------------

export type Size = {
	minStep: number, -- fastest legal step, seconds (server check, divided by tool power)
	par: number, -- "3 stars" seconds per step at tool level 0
	spots: number, -- dirt spots on the body
	spotSize: number, -- spot diameter in studs
	brush: number, -- tool radius in studs at tool level 0
	camera: number, -- orbit distance
	workerStep: number, -- seconds a worker needs per step at training level 0
	speed: number, -- studs/s when driving in and out
}

ServiceConfig.Sizes = {
	tiny = { minStep = 1.2, par = 7, spots = 16, spotSize = 0.75, brush = 0.9, camera = 9, workerStep = 5, speed = 11 },
	small = { minStep = 1.5, par = 9, spots = 20, spotSize = 1.0, brush = 1.2, camera = 12, workerStep = 6, speed = 14 },
	car = { minStep = 2.0, par = 12, spots = 28, spotSize = 1.5, brush = 2.0, camera = 21, workerStep = 8, speed = 18 },
	big = { minStep = 2.6, par = 15, spots = 34, spotSize = 2.1, brush = 2.8, camera = 30, workerStep = 10, speed = 16 },
} :: { [string]: Size }

--------------------------------------------------------------------------------
-- Vehicle tiers (unlocked by level)
--------------------------------------------------------------------------------

export type Tier = {
	id: string,
	level: number,
	icon: string,
	name: { ru: string, en: string },
	size: string,
	reward: number, -- base cash for one service
	xp: number,
	models: { string }?, -- ServiceModels ids
	cars: { string }?, -- CarCatalog ids
}

ServiceConfig.Tiers = {
	{
		id = "bikes",
		level = 1,
		icon = "🚲",
		name = { ru = "Велосипеды", en = "Bicycles" },
		size = "tiny",
		reward = 45,
		xp = 10,
		models = { "citybike", "mtb", "bmx", "roadbike", "kidsbike" },
	},
	{
		id = "scooters",
		level = 2,
		icon = "🛴",
		name = { ru = "Самокаты", en = "Scooters" },
		size = "tiny",
		reward = 60,
		xp = 13,
		models = { "kickscooter", "escooter" },
	},
	{
		id = "mopeds",
		level = 3,
		icon = "🛵",
		name = { ru = "Мопеды", en = "Mopeds" },
		size = "small",
		reward = 95,
		xp = 18,
		models = { "moped", "deliverymoped" },
	},
	{
		id = "moto",
		level = 4,
		icon = "🏍",
		name = { ru = "Мотоциклы", en = "Motorcycles" },
		size = "small",
		reward = 150,
		xp = 25,
		models = { "sportbike", "chopper", "dirtbike", "classicbike" },
	},
	{
		id = "atv",
		level = 5,
		icon = "⛳",
		name = { ru = "Квадроциклы и гольф-кары", en = "Quads & golf carts" },
		size = "small",
		reward = 210,
		xp = 32,
		models = { "quad", "golfcart" },
	},
	{
		id = "compact",
		level = 6,
		icon = "🚗",
		name = { ru = "Городские машины", en = "City cars" },
		size = "car",
		reward = 360,
		xp = 44,
		cars = { "pebble", "dart", "zippy", "cruiser", "taxi" },
	},
	{
		id = "work",
		level = 8,
		icon = "🚚",
		name = { ru = "Рабочие машины", en = "Work vehicles" },
		size = "car",
		reward = 500,
		xp = 58,
		cars = { "courier", "hauler", "frosty", "harvester", "ranger", "sandhopper" },
	},
	{
		id = "sport",
		level = 10,
		icon = "🏎",
		name = { ru = "Спорткары", en = "Sports cars" },
		size = "car",
		reward = 780,
		xp = 78,
		cars = { "stinger", "comet", "kitsune", "thunder", "bandit", "rallyfox", "medic", "interceptor" },
	},
	{
		id = "luxury",
		level = 13,
		icon = "💎",
		name = { ru = "Люкс и суперкары", en = "Luxury & super" },
		size = "car",
		reward = 1300,
		xp = 105,
		cars = { "sunset", "volt", "prestige", "zephyr", "vortex" },
	},
	{
		id = "hyper",
		level = 16,
		icon = "🚀",
		name = { ru = "Гиперкары", en = "Hypercars" },
		size = "car",
		reward = 2400,
		xp = 150,
		cars = { "nebula", "quasar", "apex" },
	},
	{
		id = "heavy",
		level = 19,
		icon = "🚌",
		name = { ru = "Автобусы и грузовики", en = "Buses & trucks" },
		size = "big",
		reward = 2900,
		xp = 185,
		cars = { "metroliner", "titan", "goliath", "blaze" },
	},
} :: { Tier }

local tierById: { [string]: Tier } = {}
for _, t in ServiceConfig.Tiers do
	tierById[t.id] = t
end

function ServiceConfig.getTier(id: any): Tier?
	return if typeof(id) == "string" then tierById[id] else nil
end

--------------------------------------------------------------------------------
-- Services and their hands-on steps
--------------------------------------------------------------------------------

export type Step = {
	id: string,
	icon: string,
	target: "spots" | "damage" | "wheels" | "paint",
	work: number, -- seconds of brushing one spot needs at tool power 1
	color: Color3, -- tool / cursor color
}

ServiceConfig.Steps = {
	wrench = { id = "wrench", icon = "🔧", target = "damage", work = 1.1, color = Color3.fromRGB(255, 170, 60) },
	pump = { id = "pump", icon = "💨", target = "wheels", work = 1.0, color = Color3.fromRGB(120, 200, 255) },
	sand = { id = "sand", icon = "🧤", target = "spots", work = 0.4, color = Color3.fromRGB(230, 190, 120) },
	spray = { id = "spray", icon = "🎨", target = "paint", work = 0.55, color = Color3.fromRGB(255, 110, 200) },
	foam = { id = "foam", icon = "🧼", target = "spots", work = 0.3, color = Color3.fromRGB(240, 246, 255) },
	scrub = { id = "scrub", icon = "🧽", target = "spots", work = 0.4, color = Color3.fromRGB(255, 220, 60) },
	rinse = { id = "rinse", icon = "🚿", target = "spots", work = 0.28, color = Color3.fromRGB(90, 190, 255) },
	dry = { id = "dry", icon = "🧻", target = "spots", work = 0.32, color = Color3.fromRGB(120, 230, 170) },
} :: { [string]: Step }

export type Service = {
	id: string,
	level: number,
	icon: string,
	mult: number, -- reward multiplier
	weight: number, -- how often customers ask for it
	steps: { string },
	color: Color3,
}

-- Listed in the order the steps are done when an order has several services.
ServiceConfig.Services = {
	{
		id = "repair",
		level = 2,
		icon = "🔧",
		mult = 1.3,
		weight = 2,
		steps = { "wrench", "pump" },
		color = Color3.fromRGB(255, 160, 50),
	},
	{
		id = "paint",
		level = 4,
		icon = "🎨",
		mult = 1.7,
		weight = 1.5,
		steps = { "sand", "spray" },
		color = Color3.fromRGB(230, 90, 220),
	},
	{
		id = "wash",
		level = 1,
		icon = "🧽",
		mult = 1.0,
		weight = 3,
		steps = { "foam", "scrub", "rinse", "dry" },
		color = Color3.fromRGB(70, 180, 255),
	},
} :: { Service }

local serviceById: { [string]: Service } = {}
for _, s in ServiceConfig.Services do
	serviceById[s.id] = s
end

function ServiceConfig.getService(id: any): Service?
	return if typeof(id) == "string" then serviceById[id] else nil
end

-- Steps of an order, in work order.
function ServiceConfig.stepsFor(services: { string }): { string }
	local wanted = {}
	for _, id in services do
		wanted[id] = true
	end
	local out = {}
	for _, s in ServiceConfig.Services do
		if wanted[s.id] then
			for _, step in s.steps do
				table.insert(out, step)
			end
		end
	end
	return out
end

-- Which service a step belongs to.
function ServiceConfig.serviceOfStep(stepId: string): string?
	for _, s in ServiceConfig.Services do
		if table.find(s.steps, stepId) then
			return s.id
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Upgrades and staff
--------------------------------------------------------------------------------

export type UpgradeLevel = { price: number, level: number }
export type Upgrade = { id: string, icon: string, levels: { UpgradeLevel } }

ServiceConfig.Upgrades = {
	{
		id = "bays",
		icon = "🏗",
		levels = { { price = 1500, level = 2 }, { price = 9000, level = 5 }, { price = 30000, level = 9 } },
	},
	{
		id = "parking",
		icon = "🅿",
		levels = { { price = 800, level = 1 }, { price = 3500, level = 3 }, { price = 12000, level = 6 } },
	},
	{
		id = "tools",
		icon = "🛠",
		levels = {
			{ price = 600, level = 1 },
			{ price = 2500, level = 3 },
			{ price = 7000, level = 5 },
			{ price = 18000, level = 8 },
			{ price = 45000, level = 12 },
		},
	},
	{
		id = "marketing",
		icon = "📣",
		levels = {
			{ price = 1000, level = 2 },
			{ price = 4000, level = 4 },
			{ price = 11000, level = 7 },
			{ price = 26000, level = 10 },
			{ price = 60000, level = 14 },
		},
	},
	{
		id = "staff",
		icon = "👷",
		levels = { { price = 2500, level = 4 }, { price = 10000, level = 7 }, { price = 35000, level = 11 } },
	},
	{
		id = "training",
		icon = "🎓",
		levels = {
			{ price = 3000, level = 5 },
			{ price = 9000, level = 8 },
			{ price = 20000, level = 11 },
			{ price = 42000, level = 14 },
			{ price = 80000, level = 18 },
		},
	},
} :: { Upgrade }

local upgradeById: { [string]: Upgrade } = {}
for _, u in ServiceConfig.Upgrades do
	upgradeById[u.id] = u
end

function ServiceConfig.getUpgrade(id: any): Upgrade?
	return if typeof(id) == "string" then upgradeById[id] else nil
end

-- The next purchasable level of an upgrade, or nil at max.
function ServiceConfig.nextLevel(id: string, current: number): UpgradeLevel?
	local u = upgradeById[id]
	return if u then u.levels[current + 1] else nil
end

ServiceConfig.BaseBays = 1
ServiceConfig.BaseParking = 3

function ServiceConfig.bayCount(upgrades: { [string]: number }): number
	return ServiceConfig.BaseBays + (upgrades.bays or 0)
end

function ServiceConfig.parkingCount(upgrades: { [string]: number }): number
	return ServiceConfig.BaseParking + (upgrades.parking or 0)
end

function ServiceConfig.toolPower(level: number): number
	return 1 + 0.3 * level
end

function ServiceConfig.toolRadius(level: number): number
	return 1 + 0.12 * level
end

function ServiceConfig.arrivalInterval(marketing: number): number
	return ServiceConfig.ArrivalInterval * 0.82 ^ marketing
end

function ServiceConfig.tipBonus(marketing: number): number
	return 0.05 * marketing
end

function ServiceConfig.workerSpeed(training: number): number
	return 1 + 0.3 * training
end

ServiceConfig.ArrivalInterval = 14 -- seconds between customers (marketing makes it shorter)
ServiceConfig.FirstArrival = 2
ServiceConfig.Patience = 300 -- a waiting customer leaves after this many seconds
ServiceConfig.WorkerShare = 0.7 -- the owner keeps 70% of what a worker earns
ServiceConfig.WorkerXp = 0.5
ServiceConfig.WorkerPickDelay = 8 -- staff only take orders that waited this long (you get first pick)
ServiceConfig.StarTips = { 0, 0.1, 0.25 } -- tip for 1/2/3 stars

ServiceConfig.WorkerNames = {
	{ ru = "Вася", en = "Vasya" },
	{ ru = "Аня", en = "Anya" },
	{ ru = "Дима", en = "Dima" },
	{ ru = "Катя", en = "Katya" },
}

--------------------------------------------------------------------------------
-- Orders
--------------------------------------------------------------------------------

export type Order = {
	tier: string,
	source: "model" | "car",
	vehicle: string,
	services: { string },
	paint: number, -- current body color (palette index)
	target: number?, -- requested color for paint orders
	reward: number,
	xp: number,
}

function ServiceConfig.unlockedTiers(level: number): { Tier }
	local out = {}
	for _, t in ServiceConfig.Tiers do
		if level >= t.level then
			table.insert(out, t)
		end
	end
	return out
end

function ServiceConfig.unlockedServices(level: number): { Service }
	local out = {}
	for _, s in ServiceConfig.Services do
		if level >= s.level then
			table.insert(out, s)
		end
	end
	return out
end

-- What a level unlocks (for the level-up screen).
function ServiceConfig.unlocksAt(level: number): { { kind: string, id: string, icon: string } }
	local out = {}
	for _, t in ServiceConfig.Tiers do
		if t.level == level then
			table.insert(out, { kind = "tier", id = t.id, icon = t.icon })
		end
	end
	for _, s in ServiceConfig.Services do
		if s.level == level then
			table.insert(out, { kind = "service", id = s.id, icon = s.icon })
		end
	end
	for _, u in ServiceConfig.Upgrades do
		for _, l in u.levels do
			if l.level == level then
				table.insert(out, { kind = "upgrade", id = u.id, icon = u.icon })
				break
			end
		end
	end
	return out
end

local function weightedPick<T>(rng: Random, items: { T }, weightOf: (T, number) -> number): T
	local total = 0
	for i, item in items do
		total += weightOf(item, i)
	end
	local roll = rng:NextNumber() * total
	for i, item in items do
		roll -= weightOf(item, i)
		if roll <= 0 then
			return item
		end
	end
	return items[#items]
end

-- Rolls a new customer for a service of the given level.
function ServiceConfig.makeOrder(level: number, rng: Random, marketing: number?): Order
	local tiers = ServiceConfig.unlockedTiers(level)
	local tier = weightedPick(rng, tiers, function(_, i)
		-- the newest tiers come most often, older ones still show up
		local fromTop = #tiers - i
		return if fromTop == 0 then 4 elseif fromTop == 1 then 2.5 else 1
	end)
	local pool = if tier.models then tier.models else tier.cars :: { string }
	local vehicle = pool[rng:NextInteger(1, #pool)]

	local available = ServiceConfig.unlockedServices(level)
	local count = 1
	if level >= 12 and #available >= 3 and rng:NextNumber() < 0.12 then
		count = 3
	elseif level >= 6 and #available >= 2 and rng:NextNumber() < 0.28 then
		count = 2
	end
	local chosen: { string } = {}
	local left = table.clone(available)
	for _ = 1, count do
		local s = weightedPick(rng, left, function(item)
			return item.weight
		end)
		table.insert(chosen, s.id)
		table.remove(left, table.find(left, s) :: number)
	end

	local mult = 0
	for _, id in chosen do
		mult += (serviceById[id] :: Service).mult
	end
	local tip = 1 + ServiceConfig.tipBonus(marketing or 0)
	local reward = math.floor(tier.reward * mult * rng:NextNumber(0.9, 1.15) * tip / 5 + 0.5) * 5
	local xp = math.floor(tier.xp * (1 + 0.5 * (count - 1)) + 0.5)

	local paint = rng:NextInteger(1, 24)
	local target: number? = nil
	if table.find(chosen, "paint") then
		local t = rng:NextInteger(1, 23)
		target = if t >= paint then t + 1 else t
	end
	return {
		tier = tier.id,
		source = if tier.models then "model" else "car",
		vehicle = vehicle,
		services = chosen,
		paint = paint,
		target = target,
		reward = reward,
		xp = xp,
	}
end

-- Seconds an order should take for 3 stars.
function ServiceConfig.parTime(size: Size, steps: number, toolLevel: number): number
	return size.par * steps / ServiceConfig.toolPower(toolLevel)
end

function ServiceConfig.stars(elapsed: number, par: number): number
	if elapsed <= par then
		return 3
	elseif elapsed <= par * 1.7 then
		return 2
	end
	return 1
end

return ServiceConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">ServiceModels</string>
          <string name="Source"><![CDATA[-- ServiceModels: procedural two-wheelers, quads, golf carts and people for the
-- car-service mode. Same conventions as CarBuilder: y = 0 is the ground, the
-- front is -Z, +X is right, cylinders have their axis along local X.
--
-- Every model has an invisible anchored "Root" part at the ground origin
-- (PrimaryPart), visual parts carry a "Role" attribute (Paint, Accent, Trim,
-- Dark, Chrome, Tire, Rim, Seat, Light, Taillight, Glass, ...) and wheel parts
-- carry Wheel/Radius/Width attributes like CarBuilder wheels.
-- People have limbs joined with Motor6Ds (Joint_<Limb>) for simple animation.

local Paints = require(script.Parent.Paints)

local ServiceModels = {}

export type Colors = { paint: number?, accent: number? }

type Ctx = {
	model: Model,
	root: BasePart,
	paint: Color3,
	accent: Color3,
}

local STYLE: { [string]: { Color3 | Enum.Material | number } } = {
	Trim = { Color3.fromRGB(44, 46, 52), Enum.Material.SmoothPlastic, 0 },
	Dark = { Color3.fromRGB(20, 20, 24), Enum.Material.SmoothPlastic, 0 },
	Chrome = { Color3.fromRGB(214, 218, 226), Enum.Material.Metal, 0.45 },
	Tire = { Color3.fromRGB(28, 28, 31), Enum.Material.SmoothPlastic, 0 },
	Rim = { Color3.fromRGB(186, 190, 198), Enum.Material.SmoothPlastic, 0.25 },
	Seat = { Color3.fromRGB(38, 34, 32), Enum.Material.Fabric, 0 },
	Light = { Color3.fromRGB(255, 250, 230), Enum.Material.Neon, 0 },
	Taillight = { Color3.fromRGB(170, 12, 18), Enum.Material.Neon, 0 },
	Indicator = { Color3.fromRGB(255, 150, 24), Enum.Material.Neon, 0 },
	Glass = { Color3.fromRGB(60, 84, 110), Enum.Material.Glass, 0.2 },
	White = { Color3.fromRGB(242, 242, 244), Enum.Material.SmoothPlastic, 0 },
	Basket = { Color3.fromRGB(156, 110, 62), Enum.Material.WoodPlanks, 0 },
	-- people
	Skin = { Color3.fromRGB(234, 184, 146), Enum.Material.SmoothPlastic, 0 },
	Hair = { Color3.fromRGB(70, 46, 30), Enum.Material.SmoothPlastic, 0 },
	Shirt = { Color3.fromRGB(240, 240, 236), Enum.Material.Fabric, 0 },
	Overalls = { Color3.fromRGB(40, 88, 170), Enum.Material.Fabric, 0 },
	Shoe = { Color3.fromRGB(40, 32, 28), Enum.Material.SmoothPlastic, 0 },
	Cap = { Color3.fromRGB(255, 128, 32), Enum.Material.Fabric, 0 },
	Face = { Color3.fromRGB(30, 24, 22), Enum.Material.SmoothPlastic, 0 },
}

--------------------------------------------------------------------------------
-- Part helpers
--------------------------------------------------------------------------------

local function style(ctx: Ctx, part: BasePart, role: string)
	if role == "Paint" then
		part.Color = ctx.paint
		part.Material = Enum.Material.SmoothPlastic
		part.Reflectance = 0.1
	elseif role == "Accent" then
		part.Color = ctx.accent
		part.Material = Enum.Material.SmoothPlastic
		part.Reflectance = 0.05
	elseif role == "NeonAccent" then
		part.Color = ctx.accent
		part.Material = Enum.Material.Neon
	else
		local s = STYLE[role]
		if s then
			part.Color = s[1] :: Color3
			part.Material = s[2] :: Enum.Material
			part.Reflectance = s[3] :: number
			if role == "Glass" then
				part.Transparency = 0.35
			end
		end
	end
end

local function make(ctx: Ctx, className: string, role: string, size: Vector3, cf: CFrame): BasePart
	local part = Instance.new(className) :: BasePart
	part.Name = role
	part.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	part.CFrame = cf
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CastShadow = size.X * size.Y * size.Z > 0.05
	part:SetAttribute("Role", role)
	style(ctx, part, role)
	part.Parent = ctx.model
	return part
end

local function box(ctx: Ctx, role: string, size: Vector3, at: Vector3 | CFrame): BasePart
	return make(ctx, "Part", role, size, if typeof(at) == "CFrame" then at else CFrame.new(at))
end

local function cyl(ctx: Ctx, role: string, length: number, diameter: number, cf: CFrame): BasePart
	local p = make(ctx, "Part", role, Vector3.new(length, diameter, diameter), cf);
	(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

local function ball(ctx: Ctx, role: string, diameter: number, pos: Vector3): BasePart
	local p = make(ctx, "Part", role, Vector3.new(diameter, diameter, diameter), CFrame.new(pos));
	(p :: Part).Shape = Enum.PartType.Ball
	return p
end

-- Wedge whose slope rises from -Z (low) to +Z (high) in the given frame.
local function wedge(ctx: Ctx, role: string, size: Vector3, cf: CFrame): BasePart
	return make(ctx, "WedgePart", role, size, cf)
end

-- CFrame at the middle of a..b whose X axis points from a to b.
local function alongX(a: Vector3, b: Vector3): CFrame
	local dir = (b - a).Unit
	local up = if math.abs(dir.Y) > 0.95 then Vector3.zAxis else Vector3.yAxis
	local z = dir:Cross(up).Unit
	local y = z:Cross(dir).Unit
	return CFrame.fromMatrix((a + b) / 2, dir, y, z)
end
ServiceModels.alongX = alongX

-- Round tube from a to b.
local function tube(ctx: Ctx, role: string, a: Vector3, b: Vector3, d: number): BasePart?
	local len = (b - a).Magnitude
	if len < 0.02 then
		return nil
	end
	return cyl(ctx, role, len + d * 0.3, d, alongX(a, b))
end

-- Polyline of tubes.
local function path(ctx: Ctx, role: string, points: { Vector3 }, d: number)
	for i = 1, #points - 1 do
		tube(ctx, role, points[i], points[i + 1], d)
		if i > 1 then
			ball(ctx, role, d, points[i])
		end
	end
end

-- Arc of blocks around an axis along X through `center`. Angles start at the
-- top (+Y) and grow towards the rear (+Z).
local function arc(ctx: Ctx, role: string, center: Vector3, radius: number, a0: number, a1: number, n: number, width: number, thick: number)
	local step = (a1 - a0) / n
	local seg = radius * math.abs(step) * 1.12
	for k = 0, n - 1 do
		local a = a0 + step * (k + 0.5)
		box(ctx, role, Vector3.new(width, thick, seg), CFrame.new(center) * CFrame.Angles(a, 0, 0) * CFrame.new(0, radius, 0))
	end
end

local function p(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end

local function markWheel(part: BasePart, radius: number, width: number)
	part:SetAttribute("Wheel", true)
	part:SetAttribute("Radius", radius)
	part:SetAttribute("Width", width)
end

type WheelStyle = "spoke" | "solid" | "knobby" | "small"

local function wheel(ctx: Ctx, center: Vector3, r: number, w: number, kind: WheelStyle, tubeThick: number?)
	if kind == "spoke" then
		local thick = tubeThick or 0.2
		local n = if r > 1 then 18 else 14
		arc(ctx, "Tire", center, r - thick / 2, 0, math.pi * 2, n, w, thick)
		arc(ctx, "Rim", center, r - thick - 0.04, 0, math.pi * 2, n, w * 0.7, 0.08)
		for k = 0, 5 do
			box(ctx, "Chrome", Vector3.new(0.035, (r - thick) * 2, 0.035), CFrame.new(center) * CFrame.Angles(k * math.pi / 6, 0, 0))
		end
		local hub = cyl(ctx, "Chrome", w + 0.12, 0.28, CFrame.new(center))
		markWheel(hub, r, w)
		return hub
	end
	local tire = cyl(ctx, "Tire", w, r * 2, CFrame.new(center))
	markWheel(tire, r, w)
	local rimD = r * 2 * (if kind == "small" then 0.5 else 0.6)
	cyl(ctx, "Rim", w + 0.04, rimD, CFrame.new(center))
	cyl(ctx, "Chrome", w + 0.1, math.max(0.18, r * 0.25), CFrame.new(center))
	if kind == "knobby" then
		for k = 0, 13 do
			box(ctx, "Tire", Vector3.new(w * 1.06, 0.14, r * 0.3), CFrame.new(center) * CFrame.Angles(k * math.pi / 7, 0, 0) * CFrame.new(0, r - 0.03, 0))
		end
	elseif kind == "solid" then
		for k = 0, 4 do
			box(ctx, "Rim", Vector3.new(w + 0.06, rimD * 0.42, 0.12), CFrame.new(center) * CFrame.Angles(k * math.pi * 2 / 5, 0, 0) * CFrame.new(0, rimD * 0.22, 0))
		end
	end
	return tire
end

--------------------------------------------------------------------------------
-- Bicycles
--------------------------------------------------------------------------------

type BikeSpec = {
	r: number,
	tire: number,
	base: number, -- half wheelbase
	bb: Vector3, -- bottom bracket (x = 0)
	seat: Vector3, -- top of the seat tube
	headTop: Vector3,
	headBottom: Vector3,
	stepThrough: boolean?,
	bar: "upright" | "flat" | "drop" | "bmx",
	fenders: boolean?,
	basket: boolean?,
	rack: boolean?,
	suspension: boolean?,
	discs: boolean?,
	training: boolean?,
	pegs: boolean?,
	lamp: boolean?,
	streamers: boolean?,
	tubeD: number?,
}

local function bicycle(ctx: Ctx, s: BikeSpec)
	local r = s.r
	local R = p(0, r, s.base)
	local F = p(0, r, -s.base)
	local BB, S, HT, HB = s.bb, s.seat, s.headTop, s.headBottom
	local d = s.tubeD or 0.2

	wheel(ctx, R, r, s.tire, "spoke", s.tire)
	wheel(ctx, F, r, s.tire, "spoke", s.tire)

	-- frame
	tube(ctx, "Paint", BB, S, d)
	tube(ctx, "Paint", HB, HT, d * 1.3)
	if s.stepThrough then
		local low = p(0, BB.Y + 0.3, (BB.Z + HB.Z) / 2 - 0.2)
		path(ctx, "Paint", { BB, low, HB }, d * 1.1)
		path(ctx, "Paint", { BB:Lerp(S, 0.45), low:Lerp(HB, 0.45) + p(0, 0.35, 0), HB:Lerp(HT, 0.6) }, d * 0.9)
	else
		tube(ctx, "Paint", BB, HB, d * 1.1)
		tube(ctx, "Paint", S:Lerp(BB, 0.08), HT:Lerp(HB, 0.15), d)
	end
	for _, side in { -1, 1 } do
		tube(ctx, "Paint", BB + p(side * 0.06, 0, 0), R + p(side * 0.16, 0, 0), d * 0.6)
		tube(ctx, "Paint", S:Lerp(BB, 0.1) + p(side * 0.05, 0, 0), R + p(side * 0.16, 0, 0), d * 0.6)
		if s.suspension then
			local mid = HB:Lerp(F, 0.5)
			tube(ctx, "Dark", HB + p(side * 0.16, 0, 0), mid + p(side * 0.2, 0, 0), 0.26)
			tube(ctx, "Chrome", mid + p(side * 0.2, 0, 0), F + p(side * 0.2, 0, 0), 0.16)
		else
			tube(ctx, "Paint", HB + p(side * 0.12, 0, 0), F + p(side * 0.17, 0, 0), d * 0.7)
		end
	end
	if s.suspension then
		box(ctx, "Dark", Vector3.new(0.5, 0.14, 0.3), HB:Lerp(F, 0.05))
	end

	-- saddle
	local postTop = S + (S - BB).Unit * 0.45
	tube(ctx, "Chrome", S, postTop, 0.12)
	box(ctx, "Seat", Vector3.new(0.5, 0.16, 0.55), postTop + p(0, 0.1, 0.12))
	box(ctx, "Seat", Vector3.new(0.24, 0.13, 0.5), postTop + p(0, 0.1, -0.35))

	-- bars
	local stemTop = HT + p(0, 0.35, -0.12)
	tube(ctx, "Chrome", HT, stemTop, 0.13)
	if s.bar == "upright" then
		path(ctx, "Chrome", { stemTop + p(-0.95, 0.05, 0.4), stemTop + p(-0.4, 0, 0), stemTop + p(0.4, 0, 0), stemTop + p(0.95, 0.05, 0.4) }, 0.1)
		for _, side in { -1, 1 } do
			tube(ctx, "Dark", stemTop + p(side * 0.8, 0.04, 0.32), stemTop + p(side * 1.05, 0.06, 0.45), 0.16)
		end
	elseif s.bar == "flat" then
		tube(ctx, "Dark", stemTop + p(-1.05, 0, 0), stemTop + p(1.05, 0, 0), 0.1)
		for _, side in { -1, 1 } do
			tube(ctx, "Dark", stemTop + p(side * 0.8, 0, 0), stemTop + p(side * 1.08, 0, 0), 0.17)
			box(ctx, "Trim", Vector3.new(0.08, 0.06, 0.4), stemTop + p(side * 0.7, 0.02, -0.2))
		end
	elseif s.bar == "drop" then
		tube(ctx, "Dark", stemTop + p(-0.6, 0, 0), stemTop + p(0.6, 0, 0), 0.11)
		for _, side in { -1, 1 } do
			path(ctx, "Dark", {
				stemTop + p(side * 0.6, 0, 0),
				stemTop + p(side * 0.62, -0.05, -0.35),
				stemTop + p(side * 0.62, -0.45, -0.32),
				stemTop + p(side * 0.62, -0.55, 0.05),
			}, 0.12)
			box(ctx, "Trim", Vector3.new(0.1, 0.3, 0.12), stemTop + p(side * 0.62, -0.12, -0.38))
		end
	else -- bmx
		for _, side in { -1, 1 } do
			tube(ctx, "Chrome", stemTop + p(side * 0.2, 0, 0), stemTop + p(side * 0.5, 0.65, 0.12), 0.1)
			tube(ctx, "Dark", stemTop + p(side * 0.8, 0.65, 0.12), stemTop + p(side * 1.05, 0.65, 0.12), 0.18)
		end
		tube(ctx, "Chrome", stemTop + p(-0.35, 0.35, 0.06), stemTop + p(0.35, 0.35, 0.06), 0.08)
		tube(ctx, "Chrome", stemTop + p(-1.0, 0.65, 0.12), stemTop + p(1.0, 0.65, 0.12), 0.1)
		box(ctx, "Accent", Vector3.new(0.6, 0.18, 0.18), stemTop + p(0, 0.35, 0.06))
	end
	if s.streamers then
		for _, side in { -1, 1 } do
			for k = -1, 1 do
				box(ctx, "NeonAccent", Vector3.new(0.04, 0.7, 0.06), stemTop + p(side * (1.08 + k * 0.04), -0.32, 0.45 + k * 0.05))
			end
		end
	end

	-- drivetrain
	local ringD = math.max(0.6, r * 0.62)
	cyl(ctx, "Chrome", 0.06, ringD, CFrame.new(BB + p(0.22, 0, 0)))
	cyl(ctx, "Dark", 0.08, ringD * 0.45, CFrame.new(BB + p(0.24, 0, 0)))
	cyl(ctx, "Chrome", 0.06, ringD * 0.45, CFrame.new(R + p(0.22, 0, 0)))
	tube(ctx, "Dark", BB + p(0.24, ringD / 2, 0), R + p(0.24, ringD * 0.22, 0), 0.05)
	tube(ctx, "Dark", BB + p(0.24, -ringD / 2, 0), R + p(0.24, -ringD * 0.22, 0), 0.05)
	local crank = r * 0.42
	for _, side in { -1, 1 } do
		local tip = BB + p(side * 0.32, -side * crank * 0.5, side * crank * 0.86)
		tube(ctx, "Trim", BB + p(side * 0.3, 0, 0), tip, 0.09)
		box(ctx, "Dark", Vector3.new(0.4, 0.07, 0.24), tip + p(side * 0.2, 0, 0))
	end

	-- extras
	if s.fenders then
		arc(ctx, "Accent", F, r + 0.15, -1.9, 0.5, 7, s.tire + 0.14, 0.06)
		arc(ctx, "Accent", R, r + 0.15, -0.35, 1.9, 7, s.tire + 0.14, 0.06)
	end
	if s.basket then
		local c = F + p(0, r + 0.75, -0.15)
		box(ctx, "Basket", Vector3.new(1.1, 0.06, 0.85), c - p(0, 0.32, 0))
		for _, side in { -1, 1 } do
			box(ctx, "Basket", Vector3.new(0.06, 0.65, 0.85), c + p(side * 0.55, 0, 0))
			box(ctx, "Basket", Vector3.new(1.1, 0.65, 0.06), c + p(0, 0, side * 0.42))
		end
		tube(ctx, "Trim", c - p(0, 0.34, 0), HB, 0.06)
	end
	if s.rack then
		local top = R + p(0, r + 0.32, -0.05)
		box(ctx, "Trim", Vector3.new(0.65, 0.06, 1.3), top)
		for _, side in { -1, 1 } do
			tube(ctx, "Trim", top + p(side * 0.3, 0, 0.45), R + p(side * 0.18, 0, 0), 0.06)
		end
		box(ctx, "Taillight", Vector3.new(0.3, 0.14, 0.06), top + p(0, -0.05, 0.68))
	else
		box(ctx, "Taillight", Vector3.new(0.18, 0.12, 0.06), S:Lerp(BB, 0.05) + p(0, 0, 0.14))
	end
	if s.lamp then
		local at = HT:Lerp(HB, 0.4) + p(0, 0, -0.2)
		cyl(ctx, "Trim", 0.22, 0.3, CFrame.new(at) * CFrame.Angles(0, math.pi / 2, 0))
		ball(ctx, "Light", 0.24, at + p(0, 0, -0.1))
		ball(ctx, "Chrome", 0.16, stemTop + p(-0.55, 0.12, 0.05))
	end
	if s.discs then
		for _, c in { F, R } do
			cyl(ctx, "Chrome", 0.03, r * 0.5, CFrame.new(c + p(-0.2, 0, 0)))
			box(ctx, "Dark", Vector3.new(0.1, 0.25, 0.3), c + p(-0.22, r * 0.25, -0.12))
		end
		cyl(ctx, "Dark", 0.5, 0.2, alongX(BB:Lerp(HB, 0.3), BB:Lerp(HB, 0.6)) * CFrame.new(0, 0.14, 0))
	end
	if s.training then
		for _, side in { -1, 1 } do
			local c = R + p(side * 0.85, -r + 0.32, 0.15)
			wheel(ctx, c, 0.32, 0.14, "small")
			tube(ctx, "Chrome", c, R + p(side * 0.18, 0, 0), 0.07)
		end
	end
	if s.pegs then
		for _, c in { F, R } do
			cyl(ctx, "Chrome", 0.9, 0.14, CFrame.new(c))
		end
	end
	-- kickstand
	tube(ctx, "Trim", BB:Lerp(R, 0.35) + p(-0.15, 0, 0), BB:Lerp(R, 0.15) + p(-0.55, -BB.Y + 0.05, 0), 0.07)
end

local function citybike(ctx: Ctx)
	bicycle(ctx, {
		r = 1.25,
		tire = 0.2,
		base = 2.05,
		bb = p(0, 0.95, 0.3),
		seat = p(0, 2.95, 0.85),
		headTop = p(0, 3.35, -1.35),
		headBottom = p(0, 2.55, -1.55),
		stepThrough = true,
		bar = "upright",
		fenders = true,
		basket = true,
		rack = true,
		lamp = true,
	})
end

local function mtb(ctx: Ctx)
	bicycle(ctx, {
		r = 1.3,
		tire = 0.34,
		base = 2.15,
		bb = p(0, 1.1, 0.25),
		seat = p(0, 2.85, 0.75),
		headTop = p(0, 3.25, -1.4),
		headBottom = p(0, 2.55, -1.6),
		bar = "flat",
		suspension = true,
		discs = true,
		tubeD = 0.26,
	})
end

local function bmx(ctx: Ctx)
	bicycle(ctx, {
		r = 0.95,
		tire = 0.3,
		base = 1.65,
		bb = p(0, 0.85, 0.2),
		seat = p(0, 2.2, 0.55),
		headTop = p(0, 2.6, -1.1),
		headBottom = p(0, 2.05, -1.25),
		bar = "bmx",
		pegs = true,
		tubeD = 0.24,
	})
end

local function roadbike(ctx: Ctx)
	bicycle(ctx, {
		r = 1.3,
		tire = 0.15,
		base = 2.0,
		bb = p(0, 0.95, 0.3),
		seat = p(0, 3.05, 0.95),
		headTop = p(0, 3.25, -1.3),
		headBottom = p(0, 2.65, -1.45),
		bar = "drop",
		tubeD = 0.18,
	})
end

local function kidsbike(ctx: Ctx)
	bicycle(ctx, {
		r = 0.85,
		tire = 0.22,
		base = 1.4,
		bb = p(0, 0.7, 0.2),
		seat = p(0, 1.9, 0.55),
		headTop = p(0, 2.2, -0.9),
		headBottom = p(0, 1.7, -1.05),
		stepThrough = true,
		bar = "upright",
		fenders = true,
		basket = true,
		training = true,
		streamers = true,
		tubeD = 0.18,
	})
end

--------------------------------------------------------------------------------
-- Scooters
--------------------------------------------------------------------------------

local function kickscooter(ctx: Ctx)
	local r = 0.42
	wheel(ctx, p(0, r, -1.65), r, 0.24, "small")
	wheel(ctx, p(0, r, 1.6), r, 0.24, "small")
	box(ctx, "Paint", Vector3.new(0.62, 0.16, 2.5), p(0, 0.55, 0.1))
	box(ctx, "Dark", Vector3.new(0.56, 0.03, 2.3), p(0, 0.645, 0.1))
	arc(ctx, "Trim", p(0, r, 1.6), r + 0.1, -0.6, 1.4, 4, 0.3, 0.05)
	tube(ctx, "Paint", p(0, 0.55, -1.15), p(0, 0.9, -1.55), 0.22)
	local base = p(0, 0.95, -1.6)
	local top = p(0, 3.6, -1.95)
	tube(ctx, "Paint", base, top, 0.18)
	box(ctx, "Accent", Vector3.new(0.3, 0.3, 0.3), base:Lerp(top, 0.45))
	for _, side in { -1, 1 } do
		tube(ctx, "Chrome", base + p(side * 0.08, 0, 0), p(side * 0.16, r, -1.65), 0.09)
	end
	tube(ctx, "Chrome", top + p(-0.75, 0, 0), top + p(0.75, 0, 0), 0.1)
	for _, side in { -1, 1 } do
		tube(ctx, "Dark", top + p(side * 0.55, 0, 0), top + p(side * 0.8, 0, 0), 0.17)
	end
	box(ctx, "Trim", Vector3.new(0.08, 0.06, 0.35), top + p(0.5, 0.02, -0.18))
	tube(ctx, "Trim", p(-0.2, 0.5, 0.6), p(-0.45, 0.04, 0.9), 0.06)
end

local function escooter(ctx: Ctx)
	local r = 0.55
	wheel(ctx, p(0, r, -1.8), r, 0.3, "solid")
	wheel(ctx, p(0, r, 1.75), r, 0.3, "solid")
	box(ctx, "Paint", Vector3.new(0.78, 0.26, 2.6), p(0, 0.66, 0.05))
	box(ctx, "Dark", Vector3.new(0.7, 0.03, 2.4), p(0, 0.8, 0.05))
	box(ctx, "Trim", Vector3.new(0.6, 0.2, 2.2), p(0, 0.45, 0.05))
	for _, side in { -1, 1 } do
		box(ctx, "NeonAccent", Vector3.new(0.03, 0.06, 2.3), p(side * 0.4, 0.66, 0.05))
	end
	arc(ctx, "Paint", p(0, r, 1.75), r + 0.12, -0.5, 1.5, 4, 0.36, 0.07)
	box(ctx, "Taillight", Vector3.new(0.3, 0.1, 0.05), p(0, 1.05, 2.42))
	arc(ctx, "Paint", p(0, r, -1.8), r + 0.12, -1.3, 0.4, 4, 0.36, 0.07)
	tube(ctx, "Paint", p(0, 0.7, -1.2), p(0, 1.1, -1.6), 0.3)
	local base = p(0, 1.1, -1.62)
	local top = p(0, 3.75, -1.95)
	tube(ctx, "Paint", base, top, 0.26)
	cyl(ctx, "Chrome", 0.36, 0.34, CFrame.new(base:Lerp(top, 0.12)))
	for _, side in { -1, 1 } do
		tube(ctx, "Trim", base + p(side * 0.1, 0, 0), p(side * 0.2, r, -1.8), 0.12)
	end
	local lamp = base:Lerp(top, 0.55) + p(0, 0, -0.16)
	box(ctx, "Trim", Vector3.new(0.3, 0.22, 0.12), lamp)
	box(ctx, "Light", Vector3.new(0.22, 0.12, 0.04), lamp + p(0, 0, -0.07))
	tube(ctx, "Trim", top + p(-0.8, 0, 0), top + p(0.8, 0, 0), 0.12)
	for _, side in { -1, 1 } do
		tube(ctx, "Dark", top + p(side * 0.58, 0, 0), top + p(side * 0.85, 0, 0), 0.18)
	end
	box(ctx, "Dark", Vector3.new(0.5, 0.08, 0.3), top + p(0, 0.08, 0.02))
	box(ctx, "NeonAccent", Vector3.new(0.36, 0.02, 0.18), top + p(0, 0.13, 0.02))
end

--------------------------------------------------------------------------------
-- Mopeds
--------------------------------------------------------------------------------

local function moped(ctx: Ctx, delivery: boolean)
	local r = 0.78
	local front, rear = -2.15, 2.0
	wheel(ctx, p(0, r, front), r, 0.42, "solid")
	wheel(ctx, p(0, r, rear), r, 0.46, "solid")
	-- floor and leg shield
	box(ctx, "Paint", Vector3.new(1.25, 0.22, 1.9), p(0, 0.95, -0.25))
	box(ctx, "Dark", Vector3.new(1.1, 0.03, 1.7), p(0, 1.07, -0.25))
	box(ctx, "Paint", Vector3.new(1.5, 2.0, 0.22), CFrame.new(0, 2.0, -1.3) * CFrame.Angles(math.rad(10), 0, 0))
	for _, side in { -1, 1 } do
		cyl(ctx, "Paint", 2.0, 0.3, CFrame.new(side * 0.72, 2.0, -1.3) * CFrame.Angles(math.rad(10), 0, 0) * CFrame.Angles(0, 0, math.pi / 2))
	end
	box(ctx, "Chrome", Vector3.new(1.5, 0.06, 0.26), CFrame.new(0, 3.0, -1.12) * CFrame.Angles(math.rad(10), 0, 0))
	-- steering head and handlebar cover
	box(ctx, "Paint", Vector3.new(0.5, 1.1, 0.45), p(0, 2.7, -1.62))
	box(ctx, "Paint", Vector3.new(1.45, 0.38, 0.55), p(0, 3.3, -1.6))
	cyl(ctx, "Trim", 0.18, 0.55, CFrame.new(0, 3.33, -1.92) * CFrame.Angles(0, math.pi / 2, 0))
	cyl(ctx, "Light", 0.06, 0.44, CFrame.new(0, 3.33, -2.02) * CFrame.Angles(0, math.pi / 2, 0))
	box(ctx, "Dark", Vector3.new(0.4, 0.06, 0.3), p(0, 3.5, -1.5))
	for _, side in { -1, 1 } do
		tube(ctx, "Dark", p(side * 0.7, 3.32, -1.58), p(side * 0.98, 3.32, -1.55), 0.17)
		tube(ctx, "Chrome", p(side * 0.55, 3.45, -1.6), p(side * 0.8, 3.95, -1.62), 0.05)
		cyl(ctx, "Chrome", 0.06, 0.28, CFrame.new(side * 0.82, 4.02, -1.62) * CFrame.Angles(0, math.pi / 2, 0))
		box(ctx, "Indicator", Vector3.new(0.12, 0.08, 0.06), p(side * 0.66, 3.27, -1.9))
	end
	-- front fender and fork (single sided)
	arc(ctx, "Paint", p(0, r, front), r + 0.12, -1.1, 0.9, 5, 0.6, 0.1)
	tube(ctx, "Trim", p(0.25, 2.2, -1.68), p(0.3, r, front), 0.2)
	-- rear body
	cyl(ctx, "Paint", 1.95, 1.35, CFrame.new(0, 1.55, 1.45) * CFrame.Angles(0, math.pi / 2, 0))
	box(ctx, "Paint", Vector3.new(1.35, 0.7, 1.9), p(0, 1.9, 1.45))
	for _, side in { -1, 1 } do
		ball(ctx, "Paint", 1.15, p(side * 0.42, 1.48, 1.55))
	end
	box(ctx, "Seat", Vector3.new(0.92, 0.32, 1.75), p(0, 2.38, 1.05))
	box(ctx, "Seat", Vector3.new(0.7, 0.28, 0.4), p(0, 2.34, 0.05))
	box(ctx, "Chrome", Vector3.new(1.0, 0.05, 0.08), p(0, 2.3, 1.95))
	box(ctx, "Taillight", Vector3.new(0.5, 0.18, 0.08), p(0, 1.95, 2.42))
	-- engine and exhaust
	box(ctx, "Dark", Vector3.new(0.5, 0.6, 1.1), p(0.3, 0.95, 1.45))
	cyl(ctx, "Chrome", 1.1, 0.26, CFrame.new(0.55, 0.75, 2.05) * CFrame.Angles(0, math.pi / 2, 0))
	tube(ctx, "Trim", p(-0.3, 0.8, 0.4), p(-0.45, 0.05, 0.75), 0.07)
	-- rack
	local rackY = 2.5
	box(ctx, "Chrome", Vector3.new(0.9, 0.05, 0.8), p(0, rackY, 2.15))
	if delivery then
		local c = p(0, rackY + 0.8, 2.15)
		box(ctx, "Accent", Vector3.new(1.6, 1.5, 1.4), c)
		box(ctx, "Paint", Vector3.new(1.64, 0.18, 1.44), c + p(0, 0.75, 0))
		for _, side in { -1, 1 } do
			cyl(ctx, "White", 0.04, 0.8, CFrame.new(c + p(side * 0.81, 0, 0)))
		end
		box(ctx, "Chrome", Vector3.new(0.5, 0.1, 0.05), c + p(0, 0.2, 0.71))
	end
end

--------------------------------------------------------------------------------
-- Motorcycles
--------------------------------------------------------------------------------

local function sportbike(ctx: Ctx)
	local rf, rr = 1.02, 1.04
	local zf, zr = -2.7, 2.55
	wheel(ctx, p(0, rf, zf), rf, 0.55, "solid")
	wheel(ctx, p(0, rr, zr), rr, 0.7, "solid")
	for _, side in { -1, 1 } do
		tube(ctx, "Trim", p(side * 0.42, 3.0, -1.7), p(side * 0.42, 1.6, 0.6), 0.28)
		tube(ctx, "Trim", p(side * 0.4, 1.5, 0.6), p(side * 0.4, rr, zr), 0.22)
		tube(ctx, "Dark", p(side * 0.3, 3.2, -1.78), p(side * 0.3, 2.1, -2.25), 0.26)
		tube(ctx, "Chrome", p(side * 0.3, 2.1, -2.25), p(side * 0.3, rf, zf), 0.18)
		tube(ctx, "Dark", p(side * 0.32, 3.38, -1.6), p(side * 0.62, 3.32, -1.5), 0.15)
		box(ctx, "Trim", Vector3.new(0.4, 0.08, 0.18), p(side * 0.45, 1.85, 0.75))
	end
	box(ctx, "Dark", Vector3.new(1.0, 1.0, 1.4), p(0, 1.65, -0.55))
	for k = -1, 1 do
		cyl(ctx, "Chrome", 0.2, 0.32, CFrame.new(k * 0.3, 2.2, -0.95) * CFrame.Angles(0, 0, math.pi / 2))
	end
	-- tank and fairing
	box(ctx, "Paint", Vector3.new(1.1, 0.72, 1.45), p(0, 3.15, -0.75))
	cyl(ctx, "Paint", 1.45, 1.1, CFrame.new(0, 3.42, -0.75) * CFrame.Angles(0, math.pi / 2, 0))
	box(ctx, "Paint", Vector3.new(1.2, 1.15, 0.75), p(0, 3.0, -2.0))
	wedge(ctx, "Paint", Vector3.new(1.2, 0.9, 0.85), CFrame.new(0, 3.12, -2.78))
	box(ctx, "Paint", Vector3.new(1.1, 0.45, 0.5), p(0, 2.3, -2.3))
	wedge(ctx, "Glass", Vector3.new(0.95, 0.55, 0.75), CFrame.new(0, 3.85, -2.05))
	for _, side in { -1, 1 } do
		box(ctx, "Paint", Vector3.new(0.1, 1.3, 2.1), p(side * 0.62, 2.25, -1.05))
		box(ctx, "Accent", Vector3.new(0.12, 0.25, 2.0), p(side * 0.63, 2.05, -1.05))
		box(ctx, "Light", Vector3.new(0.32, 0.18, 0.08), p(side * 0.27, 3.05, -3.2))
		tube(ctx, "Trim", p(side * 0.55, 3.55, -2.1), p(side * 0.85, 3.7, -2.0), 0.05)
		box(ctx, "Trim", Vector3.new(0.3, 0.16, 0.08), p(side * 0.92, 3.72, -2.0))
	end
	box(ctx, "Accent", Vector3.new(1.0, 0.25, 1.6), p(0, 1.1, -0.8))
	-- seat and tail
	box(ctx, "Seat", Vector3.new(0.85, 0.22, 1.1), p(0, 3.08, 0.5))
	wedge(ctx, "Paint", Vector3.new(0.95, 0.75, 1.7), CFrame.new(0, 3.05, 1.55))
	box(ctx, "Paint", Vector3.new(0.95, 0.35, 1.7), p(0, 2.55, 1.55))
	box(ctx, "Taillight", Vector3.new(0.45, 0.14, 0.06), p(0, 2.95, 2.42))
	box(ctx, "Dark", Vector3.new(0.7, 0.05, 0.6), CFrame.new(0, 2.3, 2.55) * CFrame.Angles(math.rad(-30), 0, 0))
	-- exhaust
	tube(ctx, "Chrome", p(0.35, 1.2, -0.3), p(0.55, 1.55, 1.1), 0.22)
	cyl(ctx, "Chrome", 1.2, 0.46, alongX(p(0.6, 1.6, 1.0), p(0.62, 2.05, 2.1)))
	arc(ctx, "Paint", p(0, rf, zf), rf + 0.12, -1.0, 0.5, 4, 0.5, 0.08)
end

local function chopper(ctx: Ctx)
	local rf, rr = 1.0, 1.15
	local zf, zr = -3.75, 2.3
	wheel(ctx, p(0, rf, zf), rf, 0.3, "solid")
	wheel(ctx, p(0, rr, zr), rr, 0.85, "solid")
	local head = p(0, 3.35, -1.85)
	path(ctx, "Paint", { head, p(0, 2.9, -0.6), p(0, 2.2, 0.8), p(0, rr + 0.2, zr) }, 0.24)
	for _, side in { -1, 1 } do
		path(ctx, "Paint", { head + p(side * 0.1, -0.2, 0), p(side * 0.35, 0.7, -0.8), p(side * 0.4, 0.75, 1.2), p(side * 0.42, rr, zr) }, 0.18)
		tube(ctx, "Chrome", head + p(side * 0.28, 0.25, -0.05), p(side * 0.3, rf, zf), 0.18)
		-- ape hangers
		path(ctx, "Chrome", { head + p(side * 0.25, 0.35, -0.1), head + p(side * 0.48, 1.55, 0.05), head + p(side * 0.8, 1.55, 0.3) }, 0.1)
		tube(ctx, "Dark", head + p(side * 0.75, 1.55, 0.28), head + p(side * 1.0, 1.55, 0.38), 0.17)
		-- exhausts
		path(ctx, "Chrome", { p(0.5, 1.5, -0.3), p(0.6, 1.0 + side * 0.18, 0.4), p(0.62, 1.15 + side * 0.18, 2.6) }, 0.2)
		box(ctx, "Chrome", Vector3.new(0.5, 0.06, 0.3), p(side * 0.55, 1.0, -1.5))
	end
	cyl(ctx, "Chrome", 0.7, 0.55, CFrame.new(head + p(0, 0.05, -0.35)) * CFrame.Angles(0, math.pi / 2, 0))
	cyl(ctx, "Light", 0.05, 0.46, CFrame.new(head + p(0, 0.05, -0.71)) * CFrame.Angles(0, math.pi / 2, 0))
	-- tank
	ball(ctx, "Paint", 1.0, p(0, 3.1, -1.2))
	cyl(ctx, "Paint", 1.0, 0.95, alongX(p(0, 3.1, -1.2), p(0, 2.95, -0.25)))
	box(ctx, "Accent", Vector3.new(0.12, 0.4, 0.9), p(0.47, 3.05, -0.75))
	box(ctx, "Accent", Vector3.new(0.12, 0.4, 0.9), p(-0.47, 3.05, -0.75))
	-- V-twin
	box(ctx, "Dark", Vector3.new(0.8, 0.8, 1.1), p(0, 1.2, -0.25))
	for _, ang in { -0.5, 0.5 } do
		local base = p(0, 1.5, -0.25)
		local top = base + p(0, math.cos(ang) * 1.2, math.sin(ang) * 1.2)
		tube(ctx, "Chrome", base, top, 0.6)
		for k = 1, 3 do
			cyl(ctx, "Chrome", 0.06, 0.75, alongX(base:Lerp(top, 0.25 * k), top))
		end
	end
	-- seat, sissy bar, fender
	box(ctx, "Seat", Vector3.new(1.0, 0.28, 1.25), p(0, 2.3, 0.75))
	box(ctx, "Seat", Vector3.new(0.6, 0.25, 0.6), p(0, 2.55, 1.35))
	path(ctx, "Chrome", { p(-0.45, 2.2, 1.6), p(-0.4, 3.9, 1.85), p(0.4, 3.9, 1.85), p(0.45, 2.2, 1.6) }, 0.1)
	arc(ctx, "Paint", p(0, rr, zr), rr + 0.15, -0.6, 1.7, 6, 0.95, 0.1)
	box(ctx, "Taillight", Vector3.new(0.4, 0.14, 0.08), p(0, 2.0, 3.45))
end

local function dirtbike(ctx: Ctx)
	local rf, rr = 1.2, 1.12
	local zf, zr = -2.75, 2.3
	wheel(ctx, p(0, rf, zf), rf, 0.4, "knobby")
	wheel(ctx, p(0, rr, zr), rr, 0.52, "knobby")
	for _, side in { -1, 1 } do
		tube(ctx, "Trim", p(side * 0.25, 3.3, -1.55), p(side * 0.3, 1.2, -0.3), 0.18)
		tube(ctx, "Trim", p(side * 0.3, 1.5, 0.4), p(side * 0.38, rr, zr), 0.2)
		tube(ctx, "Accent", p(side * 0.3, 3.4, -1.6), p(side * 0.3, 2.2, -2.2), 0.28)
		tube(ctx, "Chrome", p(side * 0.3, 2.2, -2.2), p(side * 0.3, rf, zf), 0.18)
	end
	box(ctx, "Dark", Vector3.new(0.75, 0.9, 1.0), p(0, 1.55, -0.2))
	cyl(ctx, "Chrome", 0.3, 0.45, CFrame.new(0, 2.15, -0.5) * CFrame.Angles(0, 0, math.pi / 2))
	box(ctx, "Paint", Vector3.new(1.0, 0.7, 1.15), p(0, 3.15, -0.9))
	for _, side in { -1, 1 } do
		wedge(ctx, "Paint", Vector3.new(0.12, 1.0, 1.0), CFrame.new(side * 0.55, 2.85, -1.25) * CFrame.Angles(0, math.pi, 0))
		box(ctx, "Paint", Vector3.new(0.1, 0.8, 1.2), p(side * 0.42, 2.85, 1.0))
	end
	box(ctx, "Seat", Vector3.new(0.7, 0.24, 2.6), CFrame.new(0, 3.45, 0.4) * CFrame.Angles(math.rad(-3), 0, 0))
	wedge(ctx, "Paint", Vector3.new(0.6, 0.5, 1.4), CFrame.new(0, 3.35, 2.4))
	box(ctx, "Taillight", Vector3.new(0.3, 0.1, 0.05), p(0, 3.3, 3.12))
	-- beak fender and plate
	box(ctx, "Paint", Vector3.new(0.6, 0.08, 1.7), CFrame.new(0, 3.05, -2.8) * CFrame.Angles(math.rad(8), 0, 0))
	box(ctx, "White", Vector3.new(1.0, 0.8, 0.08), CFrame.new(0, 3.55, -2.05) * CFrame.Angles(math.rad(-20), 0, 0))
	box(ctx, "Light", Vector3.new(0.3, 0.18, 0.04), CFrame.new(0, 3.45, -2.12) * CFrame.Angles(math.rad(-20), 0, 0))
	-- bars
	local bar = p(0, 4.0, -1.45)
	tube(ctx, "Dark", bar + p(-1.1, 0, 0), bar + p(1.1, 0, 0), 0.1)
	box(ctx, "Accent", Vector3.new(0.6, 0.16, 0.16), bar + p(0, 0.12, 0))
	for _, side in { -1, 1 } do
		tube(ctx, "Dark", bar + p(side * 0.85, 0, 0), bar + p(side * 1.12, 0, 0), 0.17)
	end
	tube(ctx, "Trim", bar, p(0, 3.4, -1.6), 0.15)
	-- high exhaust
	path(ctx, "Chrome", { p(0.2, 1.8, -0.7), p(0.45, 2.3, 0.2), p(0.5, 2.75, 1.4) }, 0.2)
	cyl(ctx, "Trim", 1.2, 0.4, alongX(p(0.5, 2.75, 1.4), p(0.5, 3.0, 2.55)))
end

local function classicbike(ctx: Ctx)
	local r = 1.05
	local zf, zr = -2.6, 2.4
	wheel(ctx, p(0, r, zf), r, 0.34, "spoke", 0.3)
	wheel(ctx, p(0, r, zr), r, 0.38, "spoke", 0.32)
	for _, side in { -1, 1 } do
		path(ctx, "Dark", { p(side * 0.2, 3.1, -1.65), p(side * 0.3, 1.1, -0.9), p(side * 0.35, 1.0, 1.1), p(side * 0.35, r, zr) }, 0.16)
		tube(ctx, "Dark", p(side * 0.3, 2.75, 1.0), p(side * 0.35, r, zr), 0.14)
		tube(ctx, "Chrome", p(side * 0.25, 3.15, -1.7), p(side * 0.3, r, zf), 0.17)
		tube(ctx, "Chrome", p(side * 0.42, 1.25, -0.3), p(side * 0.48, 1.25, 2.9), 0.24)
		cyl(ctx, "Chrome", 0.8, 0.34, CFrame.new(side * 0.48, 1.25, 2.6) * CFrame.Angles(0, math.pi / 2, 0))
	end
	tube(ctx, "Dark", p(0, 3.1, -1.65), p(0, 2.85, 0.9), 0.18)
	box(ctx, "Dark", Vector3.new(0.8, 0.8, 1.0), p(0, 1.4, -0.2))
	for _, z in { -0.45, 0.05 } do
		cyl(ctx, "Chrome", 0.9, 0.5, CFrame.new(0, 2.1, z) * CFrame.Angles(0, 0, math.pi / 2))
	end
	-- tank with stripe and knee pads
	box(ctx, "Paint", Vector3.new(0.95, 0.7, 1.4), p(0, 3.05, -0.85))
	cyl(ctx, "Paint", 1.4, 0.95, CFrame.new(0, 3.35, -0.85) * CFrame.Angles(0, math.pi / 2, 0))
	box(ctx, "Accent", Vector3.new(0.97, 0.12, 1.42), p(0, 3.1, -0.85))
	for _, side in { -1, 1 } do
		box(ctx, "Dark", Vector3.new(0.06, 0.35, 0.45), p(side * 0.48, 2.95, -0.4))
		box(ctx, "Paint", Vector3.new(0.12, 0.6, 0.75), p(side * 0.38, 2.3, 0.65))
	end
	box(ctx, "Seat", Vector3.new(0.85, 0.28, 1.8), p(0, 2.95, 0.7))
	arc(ctx, "Chrome", p(0, r, zf), r + 0.14, -1.2, 0.9, 6, 0.42, 0.06)
	arc(ctx, "Chrome", p(0, r, zr), r + 0.14, -0.5, 1.7, 6, 0.46, 0.06)
	-- headlight and gauges
	cyl(ctx, "Chrome", 0.45, 0.62, CFrame.new(0, 3.05, -2.05) * CFrame.Angles(0, math.pi / 2, 0))
	cyl(ctx, "Light", 0.05, 0.52, CFrame.new(0, 3.05, -2.29) * CFrame.Angles(0, math.pi / 2, 0))
	for _, side in { -1, 1 } do
		cyl(ctx, "Dark", 0.1, 0.24, CFrame.new(side * 0.18, 3.55, -1.65) * CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(0, 0, math.rad(25)))
	end
	path(ctx, "Chrome", { p(-0.95, 3.6, -1.35), p(-0.4, 3.5, -1.6), p(0.4, 3.5, -1.6), p(0.95, 3.6, -1.35) }, 0.1)
	for _, side in { -1, 1 } do
		tube(ctx, "Dark", p(side * 0.75, 3.58, -1.4), p(side * 1.0, 3.62, -1.3), 0.16)
	end
	box(ctx, "Taillight", Vector3.new(0.3, 0.16, 0.1), p(0, 1.95, 3.35))
end

--------------------------------------------------------------------------------
-- Quad bike and golf cart
--------------------------------------------------------------------------------

local function quad(ctx: Ctx)
	local r = 0.85
	for _, z in { -1.95, 2.0 } do
		for _, side in { -1, 1 } do
			wheel(ctx, p(side * 1.6, r, z), r, 0.85, "knobby")
		end
	end
	box(ctx, "Trim", Vector3.new(1.1, 0.5, 4.3), p(0, 1.05, 0))
	box(ctx, "Dark", Vector3.new(0.9, 0.8, 1.2), p(0, 1.35, 0.4))
	-- front body
	box(ctx, "Paint", Vector3.new(1.5, 0.6, 1.4), p(0, 2.05, -1.2))
	wedge(ctx, "Paint", Vector3.new(1.5, 0.5, 0.8), CFrame.new(0, 2.0, -2.2))
	for _, side in { -1, 1 } do
		box(ctx, "Paint", Vector3.new(1.05, 0.12, 2.0), CFrame.new(side * 1.45, 2.0, -1.9) * CFrame.Angles(0, 0, side * math.rad(-8)))
		box(ctx, "Paint", Vector3.new(1.05, 0.12, 2.0), CFrame.new(side * 1.45, 2.0, 2.0) * CFrame.Angles(0, 0, side * math.rad(-8)))
		box(ctx, "Light", Vector3.new(0.35, 0.2, 0.05), p(side * 0.45, 2.0, -2.62))
		box(ctx, "Taillight", Vector3.new(0.3, 0.14, 0.05), p(side * 0.5, 1.95, 2.85))
	end
	box(ctx, "Paint", Vector3.new(1.5, 0.55, 1.4), p(0, 2.0, 2.15))
	box(ctx, "Seat", Vector3.new(0.9, 0.35, 1.8), p(0, 2.48, 0.55))
	-- racks
	for _, z in { -2.25, 2.5 } do
		box(ctx, "Chrome", Vector3.new(1.4, 0.06, 0.9), p(0, 2.48, z))
		for _, side in { -1, 1 } do
			box(ctx, "Chrome", Vector3.new(0.06, 0.12, 0.9), p(side * 0.7, 2.56, z))
		end
	end
	-- bumpers
	box(ctx, "Dark", Vector3.new(1.6, 0.25, 0.2), p(0, 1.3, -2.75))
	box(ctx, "Dark", Vector3.new(1.6, 0.25, 0.2), p(0, 1.3, 2.95))
	-- steering
	tube(ctx, "Trim", p(0, 1.9, -0.95), p(0, 2.95, -0.75), 0.18)
	tube(ctx, "Dark", p(-0.95, 3.0, -0.7), p(0.95, 3.0, -0.7), 0.12)
	for _, side in { -1, 1 } do
		tube(ctx, "Dark", p(side * 0.7, 3.0, -0.7), p(side * 0.98, 3.0, -0.7), 0.18)
	end
	box(ctx, "Accent", Vector3.new(0.5, 0.18, 0.18), p(0, 3.05, -0.72))
end

local function golfcart(ctx: Ctx)
	local r = 0.62
	for _, z in { -2.4, 2.15 } do
		for _, side in { -1, 1 } do
			wheel(ctx, p(side * 1.62, r, z), r, 0.55, "solid")
		end
	end
	box(ctx, "Paint", Vector3.new(3.3, 0.85, 5.5), p(0, 1.2, 0))
	box(ctx, "Dark", Vector3.new(3.0, 0.05, 2.0), p(0, 1.65, -0.9))
	wedge(ctx, "Paint", Vector3.new(3.3, 1.2, 1.4), CFrame.new(0, 2.2, -2.15))
	box(ctx, "Trim", Vector3.new(3.1, 0.7, 0.3), p(0, 2.2, -1.35))
	for _, side in { -1, 1 } do
		box(ctx, "Light", Vector3.new(0.45, 0.22, 0.05), p(side * 1.0, 1.85, -2.77))
		box(ctx, "Taillight", Vector3.new(0.35, 0.18, 0.05), p(side * 1.3, 1.5, 2.77))
	end
	box(ctx, "Seat", Vector3.new(3.0, 0.4, 1.3), p(0, 2.25, 0.55))
	box(ctx, "Seat", Vector3.new(3.0, 1.2, 0.3), p(0, 2.95, 1.25))
	-- canopy
	box(ctx, "White", Vector3.new(3.6, 0.22, 4.7), p(0, 6.4, 0.35))
	box(ctx, "Accent", Vector3.new(3.65, 0.12, 4.75), p(0, 6.25, 0.35))
	for _, side in { -1, 1 } do
		tube(ctx, "Trim", p(side * 1.5, 1.7, -1.35), p(side * 1.5, 6.3, -1.75), 0.14)
		tube(ctx, "Trim", p(side * 1.5, 1.7, 1.4), p(side * 1.5, 6.3, 2.2), 0.14)
	end
	box(ctx, "Glass", Vector3.new(3.0, 2.1, 0.06), CFrame.new(0, 4.9, -1.62) * CFrame.Angles(math.rad(-5), 0, 0))
	-- steering wheel
	tube(ctx, "Trim", p(-0.75, 2.2, -1.25), p(-0.75, 3.15, -0.85), 0.1)
	cyl(ctx, "Dark", 0.1, 0.9, CFrame.new(-0.75, 3.2, -0.82) * CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(0, 0, math.rad(55)))
	-- golf bags
	box(ctx, "Trim", Vector3.new(2.6, 0.12, 1.0), p(0, 1.85, 3.1))
	for i, x in { -0.6, 0.6 } do
		local base = p(x, 1.95, 3.15)
		local top = base + p(0, 2.3, 0.35)
		tube(ctx, if i == 1 then "Accent" else "Paint", base, top, 0.75)
		for k = -1, 1 do
			tube(ctx, "Chrome", top + p(k * 0.15, 0, 0), top + p(k * 0.18, 0.6, 0.12), 0.06)
			box(ctx, "Dark", Vector3.new(0.16, 0.12, 0.26), top + p(k * 0.18, 0.66, 0.05))
		end
	end
end

--------------------------------------------------------------------------------
-- Catalog
--------------------------------------------------------------------------------

export type ModelDef = {
	id: string,
	name: { ru: string, en: string },
	colors: { paint: number, accent: number },
	build: (Ctx) -> (),
}

ServiceModels.List = {
	{ id = "citybike", name = { ru = "Городской велосипед", en = "City bike" }, colors = { paint = 13, accent = 1 }, build = citybike },
	{ id = "mtb", name = { ru = "Горный велосипед", en = "Mountain bike" }, colors = { paint = 9, accent = 4 }, build = mtb },
	{ id = "bmx", name = { ru = "BMX", en = "BMX" }, colors = { paint = 17, accent = 8 }, build = bmx },
	{ id = "roadbike", name = { ru = "Шоссейный велосипед", en = "Road bike" }, colors = { paint = 5, accent = 1 }, build = roadbike },
	{ id = "kidsbike", name = { ru = "Детский велосипед", en = "Kids bike" }, colors = { paint = 23, accent = 17 }, build = kidsbike },
	{ id = "kickscooter", name = { ru = "Самокат", en = "Kick scooter" }, colors = { paint = 12, accent = 8 }, build = kickscooter },
	{ id = "escooter", name = { ru = "Электросамокат", en = "E-scooter" }, colors = { paint = 3, accent = 13 }, build = escooter },
	{
		id = "moped",
		name = { ru = "Мопед", en = "Moped" },
		colors = { paint = 22, accent = 1 },
		build = function(ctx)
			moped(ctx, false)
		end,
	},
	{
		id = "deliverymoped",
		name = { ru = "Мопед доставки", en = "Delivery moped" },
		colors = { paint = 1, accent = 7 },
		build = function(ctx)
			moped(ctx, true)
		end,
	},
	{ id = "sportbike", name = { ru = "Спортбайк", en = "Sport bike" }, colors = { paint = 14, accent = 1 }, build = sportbike },
	{ id = "chopper", name = { ru = "Чоппер", en = "Chopper" }, colors = { paint = 6, accent = 21 }, build = chopper },
	{ id = "dirtbike", name = { ru = "Кроссовый мотоцикл", en = "Dirt bike" }, colors = { paint = 7, accent = 4 }, build = dirtbike },
	{ id = "classicbike", name = { ru = "Классический мотоцикл", en = "Classic bike" }, colors = { paint = 15, accent = 21 }, build = classicbike },
	{ id = "quad", name = { ru = "Квадроцикл", en = "Quad bike" }, colors = { paint = 10, accent = 8 }, build = quad },
	{ id = "golfcart", name = { ru = "Гольф-кар", en = "Golf cart" }, colors = { paint = 1, accent = 10 }, build = golfcart },
} :: { ModelDef }

local byId: { [string]: ModelDef } = {}
for _, def in ServiceModels.List do
	byId[def.id] = def
end

function ServiceModels.get(id: any): ModelDef?
	return if typeof(id) == "string" then byId[id] else nil
end

local function newCtx(name: string, paint: Color3, accent: Color3): Ctx
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.CFrame = CFrame.new()
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Parent = model
	model.PrimaryPart = root
	return { model = model, root = root, paint = paint, accent = accent }
end

-- Builds an anchored model at the origin (ground level, facing -Z).
function ServiceModels.build(id: string, colors: Colors?): Model?
	local def = byId[id]
	if not def then
		return nil
	end
	local c = colors or {}
	local ctx = newCtx(id, Paints.getColor(c.paint or def.colors.paint), Paints.getColor(c.accent or def.colors.accent))
	def.build(ctx)
	ctx.model:SetAttribute("ServiceModel", id)
	return ctx.model
end

--------------------------------------------------------------------------------
-- People (workers and customers)
--------------------------------------------------------------------------------

export type PersonLook = {
	skin: Color3?,
	hair: Color3?,
	shirt: Color3?,
	pants: Color3?,
	cap: Color3?, -- nil = no cap
}

-- A blocky person standing on the ground at the origin, facing -Z. Limbs are
-- Motor6D-jointed to the torso: Joint_ArmL/ArmR/LegL/LegR (swing around X).
function ServiceModels.person(name: string, look: PersonLook?): Model
	local l = look or {}
	local ctx = newCtx(name, Color3.new(1, 1, 1), Color3.new(1, 1, 1))
	local function tint(part: BasePart, color: Color3?)
		if color then
			part.Color = color
		end
	end
	local torso = box(ctx, "Overalls", Vector3.new(2, 2, 1), p(0, 3, 0))
	torso.Name = "Torso"
	tint(torso, l.pants)
	local shirt = box(ctx, "Shirt", Vector3.new(2.02, 0.9, 1.02), p(0, 3.56, 0))
	tint(shirt, l.shirt)
	for _, side in { -1, 1 } do
		box(ctx, "Overalls", Vector3.new(0.3, 0.92, 1.04), p(side * 0.55, 3.56, 0)).Color = torso.Color
	end
	local head = box(ctx, "Skin", Vector3.new(1.15, 1.15, 1.15), p(0, 4.6, 0))
	head.Name = "Head"
	tint(head, l.skin)
	local hair = box(ctx, "Hair", Vector3.new(1.2, 0.35, 1.2), p(0, 5.1, 0.03))
	tint(hair, l.hair)
	box(ctx, "Hair", Vector3.new(1.2, 0.6, 0.2), p(0, 4.85, 0.53)).Color = hair.Color
	for _, side in { -1, 1 } do
		box(ctx, "Face", Vector3.new(0.14, 0.2, 0.05), p(side * 0.24, 4.72, -0.58))
	end
	box(ctx, "Face", Vector3.new(0.4, 0.07, 0.05), p(0, 4.38, -0.58))
	if l.cap then
		local cap = box(ctx, "Cap", Vector3.new(1.24, 0.36, 1.24), p(0, 5.25, 0))
		cap.Color = l.cap
		local brim = box(ctx, "Cap", Vector3.new(1.1, 0.08, 0.55), p(0, 5.1, -0.82))
		brim.Color = l.cap
	end

	local function limb(limbName: string, size: Vector3, center: Vector3, joint: Vector3, role: string, color: Color3?)
		local part = box(ctx, role, size, center)
		part.Name = limbName
		tint(part, color)
		part:SetAttribute("Jointed", true)
		local motor = Instance.new("Motor6D")
		motor.Name = "Joint_" .. limbName
		motor.Part0 = torso
		motor.Part1 = part
		motor.C0 = torso.CFrame:ToObjectSpace(CFrame.new(joint))
		motor.C1 = part.CFrame:ToObjectSpace(CFrame.new(joint))
		motor.Parent = part
		return part
	end
	for _, side in { -1, 1 } do
		local tag = if side < 0 then "L" else "R"
		local arm = limb("Arm" .. tag, Vector3.new(0.9, 2, 0.9), p(side * 1.47, 3, 0), p(side * 1.47, 3.85, 0), "Shirt", l.shirt)
		local hand = box(ctx, "Skin", Vector3.new(0.92, 0.4, 0.92), p(side * 1.47, 2.15, 0))
		tint(hand, l.skin)
		hand:SetAttribute("JointedTo", arm.Name)
		local leg = limb("Leg" .. tag, Vector3.new(0.95, 2, 0.95), p(side * 0.5, 1, 0), p(side * 0.5, 2, 0), "Overalls", l.pants)
		local shoe = box(ctx, "Shoe", Vector3.new(0.97, 0.35, 1.1), p(side * 0.5, 0.17, -0.07))
		shoe:SetAttribute("JointedTo", leg.Name)
	end
	ctx.model:SetAttribute("Person", true)
	return ctx.model
end

-- Joins every part to the anchored Root so moving Root moves the model
-- (cheap to replicate). Parts marked JointedTo are welded to their limb.
function ServiceModels.weldToRoot(model: Model)
	local root = model.PrimaryPart :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			local jointedTo = d:GetAttribute("JointedTo")
			if d:GetAttribute("Jointed") then
				d.Anchored = false -- held by its Motor6D
			else
				local target = root
				if typeof(jointedTo) == "string" then
					target = (model:FindFirstChild(jointedTo, true) :: BasePart?) or root
				end
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = target
				weld.Part1 = d
				weld.Parent = d
				d.Anchored = false
			end
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Massless = true
		end
	end
	root.Anchored = true
end

return ServiceModels
]]></string>
