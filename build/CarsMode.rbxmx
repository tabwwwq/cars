		Size = UDim2.new(1, 0, 0, 30),
		Text = "",
		TextSize = 24,
		Font = T.FontBlack,
		Parent = topBar,
	})
	chips = Kit.new("Frame", {
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundTransparency = 1,
		Parent = topBar,
	})
	local chipLayout = Kit.list(chips, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
