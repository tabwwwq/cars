	BoardEmpty = "Пока пусто — будь первым!",
	SignGarage = "ГАРАЖ",
	SignRaces = "ГОНКИ",
	SignStunts = "СТАНТ-ПАРК",
	SignDrift = "ДРИФТ-АРЕНА",
	SignCity = "ГОРОД",
	SignHighway = "ШОССЕ",
	SignTrail = "БЕЗДОРОЖЬЕ",
	SignSpeedTrap = "РАДАР",
	SignWelcome = "CARS",
	-- Dev
	DevPanel = "Тест-панель",
	DevCash = "+100 000",
	DevReset = "Сбросить прогресс",
}

local en: { [string]: string } = {
