    <Item class="LocalScript" referent="4">
      <Properties>
        <string name="Name">CarsClient</string>
        <string name="Source"><![CDATA[-- Client entry point. Controllers are ModuleScripts in Controllers/ with an
-- optional init() (build UI, synchronous) and start() (connect events).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Strings = require(Shared.Strings)

local ClientState = require(script:WaitForChild("ClientState"))

-- language: from the player's locale unless Config forces one
local player = Players.LocalPlayer
local language = if Config.Language == "auto" then Strings.languageForLocale(player.LocaleId) else Config.Language
Strings.setLanguage(language)

-- profile snapshots arrive as soon as the save is loaded
Net.on("Profile", function(profile)
	ClientState.setProfile(profile)
end)

local Controllers = script:WaitForChild("Controllers")
local ORDER = {
	"Notifications",
	"Hud",
	"Drive",
	"VehicleFX",
	"Garage",
	"RaceUI",
	"WorldText",
}

local loaded: { [string]: any } = {}
for _, name in ORDER do
	local module = Controllers:WaitForChild(name, 10)
	if module and module:IsA("ModuleScript") then
		loaded[name] = require(module)
	else
		warn("[Client] missing controller " .. name)
	end
end
for _, module in Controllers:GetChildren() do
	if module:IsA("ModuleScript") and not loaded[module.Name] then
		loaded[module.Name] = require(module)
		table.insert(ORDER, module.Name)
	end
end

for _, name in ORDER do
	local c = loaded[name]
	if c and typeof(c.init) == "function" then
		local ok, err = pcall(c.init)
		if not ok then
			warn(string.format("[Client] %s.init failed: %s", name, tostring(err)))
		end
	end
end
for _, name in ORDER do
	local c = loaded[name]
	if c and typeof(c.start) == "function" then
		task.spawn(function()
			local ok, err = pcall(c.start)
			if not ok then
				warn(string.format("[Client] %s.start failed: %s", name, tostring(err)))
			end
		end)
	end
end

-- first-time hint
task.delay(4, function()
	loaded.Notifications.notifyKey("Welcome", {}, "info")
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">ClientState</string>
          <string name="Source"><![CDATA[-- ClientState: what the local client knows — the profile snapshot from the
-- server, live driving telemetry and whether the player is driving.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Signal = require(Shared.Util.Signal)

local ClientState = {}

ClientState.profile = nil :: any
ClientState.ProfileChanged = Signal.new() -- (profile)

ClientState.car = nil :: Model?
ClientState.CarChanged = Signal.new() -- (car?)

ClientState.driving = false
ClientState.DrivingChanged = Signal.new() -- (isDriving)

ClientState.telemetry = nil :: any -- CarPhysics telemetry of the own car
ClientState.racing = false

function ClientState.setProfile(p)
	ClientState.profile = p
	ClientState.ProfileChanged:Fire(p)
end

function ClientState.setCar(car: Model?)
	if ClientState.car == car then
		return
	end
	ClientState.car = car
	ClientState.CarChanged:Fire(car)
end

function ClientState.setDriving(v: boolean)
	if ClientState.driving == v then
		return
	end
	ClientState.driving = v
	ClientState.DrivingChanged:Fire(v)
end

return ClientState
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="6">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Drive</string>
            <string name="Source"><![CDATA[-- Drive: simulates the local player's own car (the client is its network
-- owner), reads driving input on every platform, binds driver actions with
-- touch buttons, and adds speed feel to the camera.

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local CarPhysics = require(Shared.CarPhysics)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Strings = require(Shared.Strings)

local ClientState = require(script.Parent.Parent.ClientState)

local Drive = {}

local player = Players.LocalPlayer
local car: Model? = nil
local sim: CarPhysics.Sim? = nil
local carConns: { RBXScriptConnection } = {}
local keys = { handbrake = false, nitro = false }
local lastNitroSent = false
local actionsBound = false
local cameraMode = 0
local CAMERA_MODES = { 0, 22, 34 } -- 0 = free zoom
local baseFov = 70

local STAT_ATTRIBUTES = {
	"MaxSpeed",
	"Accel",
	"Grip",
	"SteerAngle",
	"Brake",
	"Drift",
	"NitroPower",
	"NitroRecharge",
	"Offroad",
	"SuspRest",
	"SuspFreq",
	"SuspDamping",
}

local function detach()
	for _, c in carConns do
		c:Disconnect()
	end
	table.clear(carConns)
	car = nil
	sim = nil
	ClientState.telemetry = nil
	ClientState.setCar(nil)
end

local function attach(model: Model)
	detach()
	local chassis = model:WaitForChild("Chassis", 10) :: BasePart?
	if not chassis or not model.Parent then
		return
	end
	-- wait until all wheels are here
	local deadline = os.clock() + 5
	local wheels = CarPhysics.readWheels(model)
	while #wheels < 4 and os.clock() < deadline do
		task.wait(0.1)
		wheels = CarPhysics.readWheels(model)
	end
	car = model
	local s = CarPhysics.new(chassis, wheels, CarPhysics.readStats(model), model)
	sim = s
	for _, name in STAT_ATTRIBUTES do
		table.insert(
			carConns,
			model:GetAttributeChangedSignal(name):Connect(function()
				s.stats = CarPhysics.readStats(model)
			end)
		)
	end
	table.insert(
		carConns,
		model.AncestryChanged:Connect(function(_, parent)
			if parent == nil and car == model then
				detach()
			end
		end)
	)
	ClientState.setCar(model)
end

local function isMine(model: Instance): boolean
	return model:IsA("Model") and model:GetAttribute("OwnerUserId") == player.UserId
end

local function onCarAdded(model: Instance)
	if isMine(model) then
		task.spawn(attach, model :: Model)
	end
end

--------------------------------------------------------------------------------
-- Actions
--------------------------------------------------------------------------------

local function send(action: string, value: any?)
	Net.send("VehicleAction", action, value)
end

local function setCameraMode(index: number)
	cameraMode = index
	local d = CAMERA_MODES[index + 1] or 0
	if d == 0 then
		player.CameraMinZoomDistance = 0.5
		player.CameraMaxZoomDistance = 400
	else
		player.CameraMaxZoomDistance = d
		player.CameraMinZoomDistance = d
	end
end

local function handle(name: string, state: Enum.UserInputState): Enum.ContextActionResult
	local began = state == Enum.UserInputState.Begin
	if name == "CarsHandbrake" then
		keys.handbrake = began or state == Enum.UserInputState.Change
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			keys.handbrake = false
		end
	elseif name == "CarsNitro" then
		keys.nitro = began or state == Enum.UserInputState.Change
		if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			keys.nitro = false
		end
	elseif began then
		if name == "CarsFlip" then
			send("Flip")
		elseif name == "CarsExit" then
			send("Exit")
		elseif name == "CarsLights" then
			send("Lights")
		elseif name == "CarsSiren" then
			send("Siren")
		elseif name == "CarsHorn" then
			send("Horn")
		elseif name == "CarsCamera" then
			setCameraMode((cameraMode + 1) % #CAMERA_MODES)
		end
	end
	return Enum.ContextActionResult.Sink
end

local ACTIONS = {
	{ name = "CarsHandbrake", keys = Config.Keys.Handbrake, title = "Handbrake", touch = true, pos = UDim2.new(1, -170, 1, -170) },
	{ name = "CarsNitro", keys = Config.Keys.Nitro, title = "Nitro", touch = true, pos = UDim2.new(1, -95, 1, -230) },
	{ name = "CarsFlip", keys = Config.Keys.Flip, title = "Flip", touch = true, pos = UDim2.new(1, -245, 1, -110) },
	{ name = "CarsExit", keys = Config.Keys.Exit, title = "Exit", touch = true, pos = UDim2.new(1, -95, 1, -310) },
	{ name = "CarsLights", keys = Config.Keys.Lights, title = "Lights", touch = false },
	{ name = "CarsSiren", keys = Config.Keys.Siren, title = "Siren", touch = true, pos = UDim2.new(1, -170, 1, -280), sirenOnly = true },
	{ name = "CarsHorn", keys = Config.Keys.Horn, title = "Horn", touch = true, pos = UDim2.new(1, -245, 1, -200) },
	{ name = "CarsCamera", keys = Config.Keys.Camera, title = "Camera", touch = false },
}

local function bindActions()
	if actionsBound then
		return
	end
	actionsBound = true
	local hasSiren = car ~= nil and car:GetAttribute("HasSiren") == true
	for _, a in ACTIONS do
		if a.sirenOnly and not hasSiren then
			continue
		end
		ContextActionService:BindActionAtPriority(a.name, handle, a.touch, Enum.ContextActionPriority.High.Value, table.unpack(a.keys))
		if a.touch then
			ContextActionService:SetTitle(a.name, Strings.get(a.title))
			if a.pos then
				ContextActionService:SetPosition(a.name, a.pos)
			end
		end
	end
end

local function unbindActions()
	if not actionsBound then
		return
	end
	actionsBound = false
	for _, a in ACTIONS do
		ContextActionService:UnbindAction(a.name)
	end
	keys.handbrake = false
	keys.nitro = false
end

--------------------------------------------------------------------------------
-- Simulation loop
--------------------------------------------------------------------------------

local parkedInput = { throttle = 0, steer = 0, handbrake = true, nitro = false, parked = true }
local driveInput = { throttle = 0, steer = 0, handbrake = false, nitro = false, parked = false }

local function step(dt: number)
	local s = sim
	local model = car
	if not s or not model or not model.Parent then
		ClientState.setDriving(false)
		return
	end
	local chassis = s.chassis
	if not chassis.Parent then
		return
	end
	local seat = model:FindFirstChild("DriveSeat") :: VehicleSeat?
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local driving = hum ~= nil and seat ~= nil and hum.SeatPart == seat and hum.Health > 0
	ClientState.setDriving(driving)

	local input = parkedInput
	if driving and seat then
		driveInput.throttle = seat.ThrottleFloat
		driveInput.steer = seat.SteerFloat
		driveInput.handbrake = keys.handbrake
		driveInput.nitro = keys.nitro
		input = driveInput
	end

	if not chassis.Anchored then
		s:step(dt, input)
	end
	s:updateVisuals()
	ClientState.telemetry = s.telemetry

	if driving and s.nitroActive ~= lastNitroSent then
		lastNitroSent = s.nitroActive
		send("Nitro", lastNitroSent)
	elseif not driving and lastNitroSent then
		lastNitroSent = false
		send("Nitro", false)
	end
end

local function updateCamera(dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local target = baseFov
	local s = sim
	if ClientState.driving and s then
		local frac = math.clamp(s.telemetry.speed / math.max(s.stats.maxSpeed, 1), 0, 1.3)
		target = baseFov + 14 * frac + (if s.nitroActive then 9 else 0)
	end
	camera.FieldOfView += (target - camera.FieldOfView) * math.clamp(dt * 4, 0, 1)
end

function Drive.init()
	baseFov = 70
end

function Drive.start()
	for _, model in CollectionService:GetTagged("Car") do
		onCarAdded(model)
	end
	CollectionService:GetInstanceAddedSignal("Car"):Connect(onCarAdded)
	CollectionService:GetInstanceRemovedSignal("Car"):Connect(function(model)
		if model == car then
			detach()
		end
	end)

	ClientState.DrivingChanged:Connect(function(driving)
		if driving then
			bindActions()
		else
			unbindActions()
			setCameraMode(0)
		end
	end)

	RunService.PreSimulation:Connect(function(dt)
		local ok, err = pcall(step, dt)
		if not ok then
			warn("[Drive] " .. tostring(err))
		end
	end)
	RunService.PreRender:Connect(updateCamera)
end

function Drive.getSim(): CarPhysics.Sim?
	return sim
end

return Drive
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Garage</string>
            <string name="Source"><![CDATA[-- Garage: the dealership/garage window. Browse every car by class with a 3D
-- preview and stats, buy and spawn cars, paint them and buy upgrades.

local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local CarBuilder = require(Shared.CarBuilder)
local CarCatalog = require(Shared.CarCatalog)
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Paints = require(Shared.Paints)
local Strings = require(Shared.Strings)

local ClientState = require(script.Parent.Parent.ClientState)
local Kit = require(script.Parent.Parent.UI.Kit)
local Hud = require(script.Parent.Hud)
local Notifications = require(script.Parent.Notifications)
local T = Kit.Theme

local Garage = {}

local gui: ScreenGui
local window: Frame
local grid: ScrollingFrame
local chips: Frame
local viewport: ViewportFrame
local worldModel: WorldModel
local camera: Camera
local nameLabel: TextLabel
local classLabel: TextLabel
local tabContent: Frame
local primaryButton: TextButton
local secondaryButton: TextButton
local tabButtons: { [string]: TextButton } = {}
local cards: { [string]: Frame } = {}

local selectedId: string = Config.StarterCarId
local classFilter: string? = nil
local currentTab = "Info"
local paintSlot = "paint"
local previewModel: Model? = nil
local previewKey = ""
local orbit = 0
local previewOverride: { [string]: any }? = nil
local busy = false

local function profile()
	return ClientState.profile
end

local function owned(id: string): boolean
	local p = profile()
	return p ~= nil and p.owned[id] == true
end

local function saveFor(id: string)
	local p = profile()
	local def = CarCatalog.get(id)
	local save = if p and p.cars[id] then table.clone(p.cars[id]) else (if def then CarCatalog.defaultSave(def) else nil)
	if save and previewOverride and previewOverride.id == id then
		for k, v in previewOverride do
			if k ~= "id" then
				save[k] = v
			end
		end
	end
	return save
end

local function request(action: string, ...: any)
	if busy then
		return { ok = false }
	end
	busy = true
	local r = Net.request(action, ...)
	busy = false
	if r.message then
		Notifications.notifyKey(r.message, r.args, if r.ok then "success" else "warning")
	end
	return r
end

--------------------------------------------------------------------------------
-- Preview
--------------------------------------------------------------------------------

local function refreshPreview(force: boolean?)
	local def = CarCatalog.get(selectedId)
	if not def then
		return
	end
	local save = saveFor(def.id)
	local key = def.id .. ":" .. (if save then string.format("%d/%d/%d/%s/%d", save.paint, save.accent, save.rim, save.finish, save.glow) else "")
	if key == previewKey and not force then
		return
	end
	previewKey = key
	if previewModel then
		previewModel:Destroy()
	end
	local model = CarBuilder.build(def, { preview = true, save = save })
	model:PivotTo(CFrame.new(0, 0, 0) * (model.PrimaryPart :: BasePart).CFrame)
	model.Parent = worldModel
	previewModel = model
end

local function updateCamera(dt: number)
	if not previewModel then
		return
	end
	local def = CarCatalog.get(selectedId)
	if not def then
		return
	end
	orbit += dt * 0.45
	local ext = CarBuilder.getExtents(def)
	local dist = math.max(ext.Z, ext.X * 1.6) * 1.05 + 6
	local center = Vector3.new(0, ext.Y * 0.4, 0)
	local pos = center + Vector3.new(math.sin(orbit) * dist, ext.Y * 0.55 + dist * 0.22, math.cos(orbit) * dist)
	camera.CFrame = CFrame.lookAt(pos, center)
end

--------------------------------------------------------------------------------
-- Right panel
--------------------------------------------------------------------------------

local function clearTab()
	for _, c in tabContent:GetChildren() do
		if not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
end

local function statRow(parent: Instance, order: number, label: string, value: number, color: Color3)
	local row = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	Kit.label({ Size = UDim2.new(0, 150, 1, 0), Text = label, TextSize = 15, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Parent = row })
	local holder = Kit.new("Frame", { Position = UDim2.new(0, 150, 0.5, -4), Size = UDim2.new(1, -200, 0, 8), BackgroundTransparency = 1, Parent = row })
	local _, set = Kit.bar(holder, color)
	set(value)
	Kit.label({
		Position = UDim2.new(1, -44, 0, 0),
		Size = UDim2.new(0, 44, 1, 0),
		Text = string.format("%.1f", value),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
end

local function drawInfo()
	local def = CarCatalog.get(selectedId)
	if not def then
		return
	end
	local list = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = tabContent })
	Kit.list(list, Enum.FillDirection.Vertical, 6)
	Kit.label({
		Size = UDim2.new(1, 0, 0, 40),
		Text = Strings.pick(def.description),
		TextWrapped = true,
		TextSize = 15,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 0,
		Parent = list,
	})
	local p = profile()
	local stats = CarCatalog.getEffectiveStats(def, if p then p.cars[def.id] else nil)
	local r = CarCatalog.getRatings(stats)
	statRow(list, 1, Strings.get("StatSpeed"), r.speed, T.Accent)
	statRow(list, 2, Strings.get("StatAccel"), r.accel, T.Warn)
	statRow(list, 3, Strings.get("StatHandling"), r.handling, T.Accent2)
	statRow(list, 4, Strings.get("StatOffroad"), r.offroad, Color3.fromRGB(190, 150, 90))
	statRow(list, 5, Strings.get("StatNitro"), r.nitro, Color3.fromRGB(170, 100, 255))
	local seats = #CarBuilder.getSeats(def)
	Kit.label({
		Size = UDim2.new(1, 0, 0, 22),
		Text = Strings.get("TopSpeed", Format.speed(stats.maxSpeed)) .. "   ·   " .. Strings.get("DriveType", stats.drive) .. "   ·   " .. Strings.get(
			"Seats",
			seats
		),
		TextSize = 15,
		TextColor3 = T.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 6,
		Parent = list,
	})
end

local SLOT_KEYS = { paint = "PaintBody", accent = "PaintAccent", rim = "PaintRims", glow = "PaintGlow", finish = "PaintFinish" }
local SLOT_ORDER = { "paint", "accent", "rim", "glow", "finish" }

local function slotPrice(slot: string, value: any, save): number
	local c = Config.Customization
	local p = profile()
	if slot == "paint" then
		return c.PaintPrice
	elseif slot == "accent" then
		return c.AccentPrice
	elseif slot == "rim" then
		return c.RimPrice
	elseif slot == "glow" then
		if value == 0 then
			return 0
		end
		return if save and save.glowOwned then c.PaintPrice else c.UnderglowPrice
	elseif slot == "finish" then
		if value == "Gloss" or (p and p.finishes[value]) then
			return 0
		end
		return (c.FinishPrices :: any)[value] or 0
	end
	return 0
end

local drawTab: () -> ()

local function drawPaint()
	local def = CarCatalog.get(selectedId)
	if not def then
		return
	end
	if not owned(def.id) then
		Kit.label({ Size = UDim2.fromScale(1, 1), Text = Strings.get("BuyCarFirst"), TextColor3 = T.Muted, TextSize = 18, Parent = tabContent })
		return
	end
	local save = saveFor(def.id)
	local slots = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Parent = tabContent })
	Kit.list(slots, Enum.FillDirection.Horizontal, 6)
	for i, slot in SLOT_ORDER do
		Kit.button({
			Size = UDim2.new(0, 108, 1, 0),
			Text = Strings.get(SLOT_KEYS[slot]),
			TextSize = 14,
			LayoutOrder = i,
			BackgroundColor3 = if slot == paintSlot then T.Accent else T.Card,
			onClick = function()
				paintSlot = slot
				drawTab()
			end,
			Parent = slots,
		})
	end
	local area = Kit.new("Frame", {
		Position = UDim2.new(0, 0, 0, 44),
		Size = UDim2.new(1, 0, 1, -76),
		BackgroundTransparency = 1,
		Parent = tabContent,
	})
	local priceLabel = Kit.label({
		Position = UDim2.new(0, 0, 1, -24),
		Size = UDim2.new(1, 0, 0, 24),
		Text = "",
		TextSize = 15,
		TextColor3 = T.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = tabContent,
	})

	local function apply(value: any)
		previewOverride = { id = def.id, [paintSlot] = value }
		refreshPreview()
		task.spawn(function()
			local r = request("SetPaint", def.id, paintSlot, value)
			previewOverride = nil
			if not r.ok then
				refreshPreview(true)
			end
		end)
	end

	if paintSlot == "finish" then
		local list = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = area })
		Kit.new("UIGridLayout", {
			CellSize = UDim2.new(0, 186, 0, 44),
			CellPadding = UDim2.new(0, 8, 0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = list,
		})
		for i, f in Paints.Finishes do
			local price = slotPrice("finish", f.id, save)
			local current = save and save.finish == f.id
			Kit.button({
				Text = Strings.pick(f.name) .. (if price > 0 then "  " .. Format.moneyShort(price) else ""),
				TextSize = 15,
				LayoutOrder = i,
				BackgroundColor3 = if current then T.Accent else T.Card,
				onClick = function()
					apply(f.id)
				end,
				Parent = list,
			})
		end
		priceLabel.Text = ""
	else
		local list = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = area })
		Kit.new("UIGridLayout", {
			CellSize = UDim2.new(0, 40, 0, 40),
			CellPadding = UDim2.new(0, 7, 0, 7),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = list,
		})
		if paintSlot == "glow" then
			local off = Kit.button({
				Text = Strings.get("GlowOff"),
				TextSize = 11,
				LayoutOrder = 0,
				BackgroundColor3 = T.Card,
				onClick = function()
					apply(0)
				end,
				Parent = list,
			})
			if save and save.glow == 0 then
				Kit.stroke(off, T.Accent, 3, 0)
			end
		end
		for i, swatch in Paints.Palette do
			local b = Kit.button({
				Text = "",
				LayoutOrder = i,
				BackgroundColor3 = swatch.color,
				cornerRadius = 20,
				onClick = function()
					apply(i)
				end,
				Parent = list,
			})
			local current = save and (save :: any)[paintSlot] == i
			Kit.stroke(b, if current then Color3.new(1, 1, 1) else Color3.new(0, 0, 0), if current then 3 else 1, if current then 0 else 0.6)
		end
		priceLabel.Text = Strings.get("PriceEach", Format.money(slotPrice(paintSlot, 1, save)))
	end
end

local UPGRADES = {
	{ kind = "Engine", field = "engine", title = "UpgradeEngine", desc = "UpgradeEngineDesc", color = T.Accent },
	{ kind = "Tires", field = "tires", title = "UpgradeTires", desc = "UpgradeTiresDesc", color = T.Accent2 },
	{ kind = "Nitro", field = "nitro", title = "UpgradeNitro", desc = "UpgradeNitroDesc", color = Color3.fromRGB(170, 100, 255) },
}

local function drawTuning()
	local def = CarCatalog.get(selectedId)
	if not def then
		return
	end
	if not owned(def.id) then
		Kit.label({ Size = UDim2.fromScale(1, 1), Text = Strings.get("BuyCarFirst"), TextColor3 = T.Muted, TextSize = 18, Parent = tabContent })
		return
	end
	local save = saveFor(def.id)
	local list = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = tabContent })
	Kit.list(list, Enum.FillDirection.Vertical, 10)
	for i, u in UPGRADES do
		local spec = (Config.Upgrades :: any)[u.kind]
		local level = if save then (save :: any)[u.field] else 0
		local row = Kit.new("Frame", {
			Size = UDim2.new(1, 0, 0, 62),
			BackgroundColor3 = T.Card,
			BorderSizePixel = 0,
			LayoutOrder = i,
			Parent = list,
		})
		Kit.corner(row, 10)
		Kit.label({
			Position = UDim2.new(0, 14, 0, 8),
			Size = UDim2.new(0, 220, 0, 22),
			Text = Strings.get(u.title),
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		Kit.label({
			Position = UDim2.new(0, 14, 0, 32),
			Size = UDim2.new(0, 230, 0, 18),
			Text = Strings.get(u.desc),
			TextSize = 13,
			TextColor3 = T.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local pips = Kit.new("Frame", {
			Position = UDim2.new(0, 250, 0.5, -8),
			Size = UDim2.new(0, 130, 0, 16),
			BackgroundTransparency = 1,
			Parent = row,
		})
		Kit.list(pips, Enum.FillDirection.Horizontal, 4)
		for k = 1, spec.MaxLevel do
			local pip = Kit.new("Frame", {
				Size = UDim2.new(0, 22, 1, 0),
				BackgroundColor3 = if k <= level then u.color else Color3.fromRGB(70, 76, 96),
				BorderSizePixel = 0,
				LayoutOrder = k,
				Parent = pips,
			})
			Kit.corner(pip, 4)
		end
		local maxed = level >= spec.MaxLevel
		local price = if maxed then 0 else CarCatalog.getUpgradePrice(def, u.kind, level + 1)
		Kit.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.new(0, 170, 0, 40),
			Text = if maxed then Strings.get("MaxLevel") else Strings.get("Upgrade", Format.money(price :: number)),
			TextSize = 15,
			BackgroundColor3 = if maxed then T.PanelAlt else T.Good,
			onClick = function()
				if not maxed then
					task.spawn(request, "BuyUpgrade", def.id, u.kind)
				end
			end,
			Parent = row,
		})
	end
end

drawTab = function()
	clearTab()
	for name, b in tabButtons do
		Kit.setButtonColor(b, if name == currentTab then T.Accent else T.Card)
	end
	if currentTab == "Info" then
		drawInfo()
	elseif currentTab == "Paint" then
		drawPaint()
	else
		drawTuning()
	end
end

local function updateActions()
	local def = CarCatalog.get(selectedId)
	if not def then
		return
	end
	local p = profile()
	local isOwned = owned(def.id)
	local spawned = ClientState.car ~= nil and ClientState.car.Parent ~= nil
	local spawnedThis = spawned and (ClientState.car :: Model):GetAttribute("CarId") == def.id
	if isOwned then
		primaryButton.Text = if spawnedThis then Strings.get("Respawn") else Strings.get("Spawn")
		Kit.setButtonColor(primaryButton, T.Good)
	else
		local price = if def.price == 0 then Strings.get("Free") else Format.money(def.price)
		primaryButton.Text = Strings.get("Buy", price)
		local afford = p ~= nil and p.cash >= def.price
		Kit.setButtonColor(primaryButton, if afford then T.Accent else Color3.fromRGB(110, 70, 50))
	end
	secondaryButton.Visible = spawned
	nameLabel.Text = def.name
	local class = CarCatalog.getClass(def.class)
	classLabel.Text = Strings.pick(class.name)
	classLabel.TextColor3 = class.color
end

--------------------------------------------------------------------------------
-- Car list
--------------------------------------------------------------------------------

local function styleCard(id: string)
	local card = cards[id]
	if not card then
		return
	end
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if id == selectedId then T.Accent else Color3.new(1, 1, 1)
		stroke.Transparency = if id == selectedId then 0 else 0.88
		stroke.Thickness = if id == selectedId then 2 else 1
	end
	local def = CarCatalog.get(id)
	local status = card:FindFirstChild("Status") :: TextLabel?
	if def and status then
		if owned(id) then
			local p = profile()
			status.Text = if p and p.selected == id then "✓ " .. Strings.get("Owned") else Strings.get("Owned")
			status.TextColor3 = T.Good
		else
			status.Text = if def.price == 0 then Strings.get("Free") else Format.money(def.price)
			local p = profile()
			status.TextColor3 = if p and p.cash >= def.price then T.Gold else T.Muted
		end
	end
end

local function selectCar(id: string)
	local previous = selectedId
	selectedId = id
	styleCard(previous)
	styleCard(id)
	previewOverride = nil
	refreshPreview()
	updateActions()
	drawTab()
end

local function buildCards()
	for _, c in grid:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	table.clear(cards)
	for i, def in CarCatalog.List do
		if classFilter and def.class ~= classFilter then
			continue
		end
		local class = CarCatalog.getClass(def.class)
		local card = Kit.new("Frame", {
			Name = def.id,
			BackgroundColor3 = T.Card,
			BorderSizePixel = 0,
			LayoutOrder = i,
			Parent = grid,
		})
		Kit.corner(card, 10)
		Kit.stroke(card)
		local strip = Kit.new("Frame", {
			Size = UDim2.new(0, 6, 1, -16),
			Position = UDim2.new(0, 8, 0, 8),
			BackgroundColor3 = class.color,
			BorderSizePixel = 0,
			Parent = card,
		})
		Kit.corner(strip, 3)
		Kit.label({
			Position = UDim2.new(0, 22, 0, 10),
			Size = UDim2.new(1, -30, 0, 24),
			Text = def.name,
			TextSize = 19,
			Font = T.FontBlack,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		Kit.label({
			Position = UDim2.new(0, 22, 0, 34),
			Size = UDim2.new(1, -30, 0, 18),
			Text = Strings.pick(class.name),
			TextSize = 13,
			TextColor3 = class.color,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		Kit.label({
			Name = "Status",
			Position = UDim2.new(0, 22, 1, -30),
			Size = UDim2.new(0.6, 0, 0, 22),
			Text = "",
			TextSize = 16,
			Font = T.FontBlack,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = card,
		})
		local stats = CarCatalog.getEffectiveStats(def, nil)
		local speedHolder = Kit.new("Frame", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -12, 1, -16),
			Size = UDim2.new(0.35, 0, 0, 6),
			BackgroundTransparency = 1,
			Parent = card,
		})
		local _, set = Kit.bar(speedHolder, class.color)
		set(CarCatalog.getRatings(stats).speed)
		local hit = Kit.new("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 5,
			Parent = card,
		})
		hit.MouseEnter:Connect(function()
			Kit.tween(card, 0.1, { BackgroundColor3 = T.CardHover })
		end)
		hit.MouseLeave:Connect(function()
			Kit.tween(card, 0.1, { BackgroundColor3 = T.Card })
		end)
		hit.Activated:Connect(function()
			selectCar(def.id)
		end)
		cards[def.id] = card
		styleCard(def.id)
	end
end

local function buildChips()
	local entries = { { id = nil, name = Strings.get("AllClasses"), color = T.Text } }
	for _, c in CarCatalog.Classes do
		table.insert(entries, { id = c.id, name = Strings.pick(c.name), color = c.color })
	end
	for i, e in entries do
		local chip = Kit.button({
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = "  " .. e.name .. "  ",
			TextSize = 14,
			Font = T.Font,
			LayoutOrder = i,
			BackgroundColor3 = if e.id == classFilter then T.Accent else T.Card,
			onClick = function()
				classFilter = e.id
				for _, c in chips:GetChildren() do
					if c:IsA("TextButton") then
						Kit.setButtonColor(c, if c:GetAttribute("ClassId") == classFilter then T.Accent else T.Card)
					end
				end
				buildCards()
			end,
			Parent = chips,
		})
		chip:SetAttribute("ClassId", e.id)
		chip.TextColor3 = if e.id then e.color else T.Text
	end
end

--------------------------------------------------------------------------------
-- Window
--------------------------------------------------------------------------------

local function buildWindow()
	gui = Kit.screen("CarsGarage", 10)
	gui.Enabled = false
	Kit.new("TextButton", {
		Name = "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Parent = gui,
	})
	window = Kit.panel({
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 1180, 0, 700),
		BackgroundColor3 = T.Bg,
		BackgroundTransparency = 0.04,
		Parent = gui,
	})
	-- header
	Kit.label({
		Position = UDim2.new(0, 22, 0, 12),
		Size = UDim2.new(0, 300, 0, 40),
		Text = Strings.get("GarageTitle"),
		Font = T.FontBlack,
		TextSize = 32,
		TextColor3 = T.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = window,
	})
	Kit.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.new(0, 44, 0, 40),
		Text = "✕",
		TextSize = 22,
		BackgroundColor3 = T.PanelAlt,
		onClick = function()
			Garage.close()
		end,
		Parent = window,
	})

	-- left: class chips + grid
	chips = Kit.new("ScrollingFrame", {
		Position = UDim2.new(0, 16, 0, 64),
		Size = UDim2.new(0, 540, 0, 40),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		Parent = window,
	})
	Kit.list(chips, Enum.FillDirection.Horizontal, 6)
	grid = Kit.new("ScrollingFrame", {
		Position = UDim2.new(0, 16, 0, 112),
		Size = UDim2.new(0, 540, 1, -128),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = T.Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = window,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.new(0, 260, 0, 92),
		CellPadding = UDim2.new(0, 10, 0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	Kit.padding(grid, 2)

	-- right: preview + tabs + actions
	local right = Kit.new("Frame", {
		Position = UDim2.new(0, 572, 0, 64),
		Size = UDim2.new(1, -588, 1, -80),
		BackgroundTransparency = 1,
		Parent = window,
	})
	viewport = Kit.new("ViewportFrame", {
		Size = UDim2.new(1, 0, 0, 270),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0,
		Ambient = Color3.fromRGB(150, 150, 160),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, -0.6),
		Parent = right,
	})
	Kit.corner(viewport, 12)
	worldModel = Kit.new("WorldModel", { Parent = viewport })
	camera = Kit.new("Camera", { FieldOfView = 40, Parent = viewport })
	viewport.CurrentCamera = camera
	-- floor disc under the preview
	local floor = Instance.new("Part")
	floor.Shape = Enum.PartType.Cylinder
	floor.Size = Vector3.new(0.4, 40, 40)
	floor.CFrame = CFrame.new(0, -0.2, 0) * CFrame.Angles(0, 0, math.pi / 2)
	floor.Color = Color3.fromRGB(40, 44, 58)
	floor.Material = Enum.Material.SmoothPlastic
	floor.Anchored = true
	floor.Parent = viewport

	nameLabel = Kit.label({
		Position = UDim2.new(0, 16, 0, 10),
		Size = UDim2.new(1, -32, 0, 36),
		Text = "",
		Font = T.FontBlack,
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStrokeTransparency = 0.6,
		ZIndex = 3,
		Parent = viewport,
	})
	classLabel = Kit.label({
		Position = UDim2.new(0, 18, 0, 44),
		Size = UDim2.new(1, -32, 0, 20),
		Text = "",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStrokeTransparency = 0.6,
		ZIndex = 3,
		Parent = viewport,
	})

	local tabs = Kit.new("Frame", {
		Position = UDim2.new(0, 0, 0, 280),
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		Parent = right,
	})
	Kit.list(tabs, Enum.FillDirection.Horizontal, 8)
	for i, name in { "Info", "Paint", "Tuning" } do
		local key = if name == "Info" then "TabCars" elseif name == "Paint" then "TabPaint" else "TabTuning"
		tabButtons[name] = Kit.button({
			Size = UDim2.new(0, 150, 1, 0),
			Text = Strings.get(key),
			TextSize = 16,
			LayoutOrder = i,
			BackgroundColor3 = T.Card,
			onClick = function()
				currentTab = name
				drawTab()
			end,
			Parent = tabs,
		})
	end
	tabContent = Kit.new("Frame", {
		Position = UDim2.new(0, 0, 0, 326),
		Size = UDim2.new(1, 0, 1, -396),
		BackgroundTransparency = 1,
		Parent = right,
	})
	Kit.padding(tabContent, 4)

	primaryButton = Kit.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(0.62, -6, 0, 58),
		Text = "",
		TextSize = 22,
		onClick = function()
			local def = CarCatalog.get(selectedId)
			if not def then
				return
			end
			if owned(def.id) then
				local r = request("SpawnCar", def.id)
				if r.ok then
					Garage.close()
				end
			else
				request("BuyCar", def.id)
			end
		end,
		Parent = right,
	})
	secondaryButton = Kit.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, 0),
		Size = UDim2.new(0.38, -6, 0, 58),
		Text = Strings.get("Despawn"),
		TextSize = 18,
		BackgroundColor3 = T.PanelAlt,
		onClick = function()
			request("DespawnCar")
			task.wait(0.2)
			updateActions()
		end,
		Parent = right,
	})
end

function Garage.isOpen(): boolean
	return gui ~= nil and gui.Enabled
end

function Garage.open()
	if not gui then
		return
	end
	local p = profile()
	if ClientState.car and ClientState.car.Parent then
		selectedId = ClientState.car:GetAttribute("CarId") or selectedId
	elseif p and p.selected then
		selectedId = p.selected
	end
	gui.Enabled = true
	window.Size = UDim2.new(0, 1100, 0, 650)
	Kit.tween(window, 0.22, { Size = UDim2.new(0, 1180, 0, 700) }, Enum.EasingStyle.Back)
	buildCards()
	selectCar(selectedId)
end

function Garage.close()
	if gui then
		gui.Enabled = false
	end
end

function Garage.toggle()
	if Garage.isOpen() then
		Garage.close()
	else
		Garage.open()
	end
end

function Garage.init()
	buildWindow()
	buildChips()
end

function Garage.start()
	Hud.GarageRequested:Connect(Garage.toggle)
	ContextActionService:BindAction("CarsGarage", function(_, state)
		if state == Enum.UserInputState.Begin then
			Garage.toggle()
		end
		return Enum.ContextActionResult.Pass
	end, false, table.unpack(Config.Keys.Garage))
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt:GetAttribute("Action") == "OpenGarage" then
			Garage.open()
		end
	end)
	ClientState.ProfileChanged:Connect(function()
		if Garage.isOpen() then
			for id in cards do
				styleCard(id)
			end
			refreshPreview()
			updateActions()
			drawTab()
		end
	end)
	ClientState.CarChanged:Connect(function()
		if Garage.isOpen() then
			updateActions()
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		if Garage.isOpen() then
			updateCamera(dt)
		end
	end)
end

return Garage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- Hud: cash, garage/daily buttons, the speedometer with gear/RPM/nitro, live
-- drift and air meters, the controls hint and the Studio test panel.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Strings = require(Shared.Strings)

local ClientState = require(script.Parent.Parent.ClientState)
local Kit = require(script.Parent.Parent.UI.Kit)
local T = Kit.Theme

local Hud = {}
Hud.GarageRequested = Signal.new()

local gui: ScreenGui
local cashLabel: TextLabel
local displayedCash = 0
local targetCash = 0
local dailyButton: TextButton
local dailyDot: Frame
local speedo: Frame
local speedLabel: TextLabel
local gearLabel: TextLabel
local rpmCells: { Frame } = {}
local nitroFill: Frame
local nitroLabel: TextLabel
local meter: TextLabel
local hint: TextLabel

local RPM_CELLS = 20

local function buildTopLeft()
	local cash = Kit.panel({
		Name = "Cash",
		Position = UDim2.new(0, 20, 0, 18),
		Size = UDim2.new(0, 230, 0, 54),
		Parent = gui,
	})
	Kit.gradient(cash, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 205, 220), 90)
	local icon = Kit.new("Frame", {
		Size = UDim2.new(0, 38, 0, 38),
		Position = UDim2.new(0, 8, 0.5, -19),
		BackgroundColor3 = T.Good,
		BorderSizePixel = 0,
		Parent = cash,
	})
	Kit.corner(icon, 19)
	Kit.label({ Size = UDim2.fromScale(1, 1), Text = "$", Font = T.FontBlack, TextSize = 26, Parent = icon })
	cashLabel = Kit.label({
		Size = UDim2.new(1, -60, 1, 0),
		Position = UDim2.new(0, 54, 0, 0),
		Text = "$0",
		Font = T.FontBlack,
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = cash,
	})
end

local function buildTopRight()
	local holder = Kit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 18),
		Size = UDim2.new(0, 520, 0, 54),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local layout = Kit.list(holder, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	local garage = Kit.button({
		Name = "GarageButton",
		Size = UDim2.new(0, 170, 0, 50),
		Text = Strings.get("Garage") .. "  [G]",
		LayoutOrder = 3,
		onClick = function()
			Hud.GarageRequested:Fire()
		end,
		Parent = holder,
	})
	Kit.stroke(garage, Color3.new(1, 1, 1), 2, 0.7)

	dailyButton = Kit.button({
		Name = "DailyButton",
		Size = UDim2.new(0, 150, 0, 50),
		Text = Strings.get("Daily"),
		BackgroundColor3 = T.PanelAlt,
		LayoutOrder = 2,
		onClick = function()
			local r = Net.request("ClaimDaily")
			if r.message then
				require(script.Parent.Notifications).notifyKey(r.message, r.args, if r.ok then "success" else "info")
			end
		end,
		Parent = holder,
	})
	dailyDot = Kit.new("Frame", {
		Size = UDim2.new(0, 14, 0, 14),
		Position = UDim2.new(1, -10, 0, -4),
		BackgroundColor3 = T.Bad,
		BorderSizePixel = 0,
		Visible = false,
		Parent = dailyButton,
	})
	Kit.corner(dailyDot, 7)

	local function addDevButton()
		if holder:FindFirstChild("DevCash") or not Players.LocalPlayer:GetAttribute("IsDev") then
			return
		end
		local dev = Kit.button({
			Name = "DevCash",
			Size = UDim2.new(0, 120, 0, 40),
			Text = Strings.get("DevCash"),
			TextSize = 15,
			BackgroundColor3 = Color3.fromRGB(110, 60, 200),
			LayoutOrder = 1,
			onClick = function()
				Net.request("DevCash")
			end,
			Parent = holder,
		})
		dev:SetAttribute("Dev", true)
	end
	addDevButton()
	Players.LocalPlayer:GetAttributeChangedSignal("IsDev"):Connect(addDevButton)
end

local function buildSpeedo()
	speedo = Kit.panel({
		Name = "Speedometer",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -22),
		Size = UDim2.new(0, 380, 0, 128),
		Visible = false,
		Parent = gui,
	})
	speedLabel = Kit.label({
		Position = UDim2.new(0, 18, 0, 6),
		Size = UDim2.new(0, 170, 0, 70),
		Text = "0",
		Font = T.FontBlack,
		TextSize = 64,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = speedo,
	})
	Kit.label({
		Position = UDim2.new(0, 20, 0, 70),
		Size = UDim2.new(0, 120, 0, 20),
		Text = Strings.get("SpeedUnit"),
		TextColor3 = T.Muted,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = speedo,
	})
	local gearBox = Kit.new("Frame", {
		Position = UDim2.new(0, 186, 0, 14),
		Size = UDim2.new(0, 56, 0, 56),
		BackgroundColor3 = T.PanelAlt,
		BorderSizePixel = 0,
		Parent = speedo,
	})
	Kit.corner(gearBox, 10)
	Kit.stroke(gearBox, T.Accent, 2, 0.3)
	gearLabel = Kit.label({ Size = UDim2.fromScale(1, 1), Text = "1", Font = T.FontBlack, TextSize = 34, Parent = gearBox })

	-- RPM cells
	local rpm = Kit.new("Frame", {
		Position = UDim2.new(0, 256, 0, 14),
		Size = UDim2.new(0, 108, 0, 56),
		BackgroundTransparency = 1,
		Parent = speedo,
	})
	Kit.list(rpm, Enum.FillDirection.Horizontal, 1, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom)
	for i = 1, RPM_CELLS do
		local cell = Kit.new("Frame", {
			Size = UDim2.new(0, 4.3, 0, 16 + i * 2),
			BackgroundColor3 = if i > 16 then T.Bad elseif i > 12 then T.Warn else T.Accent2,
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
			LayoutOrder = i,
			Parent = rpm,
		})
		table.insert(rpmCells, cell)
	end

	-- nitro bar
	local nitroBack = Kit.new("Frame", {
		Position = UDim2.new(0, 18, 1, -28),
		Size = UDim2.new(1, -36, 0, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		Parent = speedo,
	})
	Kit.corner(nitroBack, 7)
	nitroFill = Kit.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = T.Accent2,
		BorderSizePixel = 0,
		Parent = nitroBack,
	})
	Kit.corner(nitroFill, 7)
	Kit.gradient(nitroFill, Color3.fromRGB(70, 196, 255), Color3.fromRGB(170, 90, 255), 0)
	nitroLabel = Kit.label({
		Position = UDim2.new(0, 0, 0, -18),
		Size = UDim2.new(1, 0, 0, 16),
		Text = Strings.get("Nitro"),
		TextColor3 = T.Muted,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = nitroBack,
	})

	meter = Kit.label({
		Name = "Meter",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -160),
		Size = UDim2.new(0, 400, 0, 44),
		Text = "",
		Font = T.FontBlack,
		TextSize = 34,
		TextColor3 = T.Gold,
		TextStrokeTransparency = 0.4,
		Visible = false,
		Parent = gui,
	})
end

local function buildHint()
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local text = if touch
		then Strings.get("ControlsBodyTouch")
		elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then Strings.get("ControlsBodyGamepad")
		else Strings.get("ControlsBody")
	hint = Kit.label({
		Name = "Hint",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 20, 1, -20),
		Size = UDim2.new(0, 520, 0, 50),
		Text = text,
		TextWrapped = true,
		TextSize = 14,
		TextColor3 = T.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextStrokeTransparency = 0.6,
		Visible = false,
		Parent = gui,
	})
end

local function updateDaily(profile)
	if not profile or not dailyButton then
		return
	end
	local today = math.floor((profile.serverTime or os.time()) / 86400)
	local last = math.floor((profile.daily and profile.daily.last or 0) / 86400)
	local ready = profile.daily == nil or profile.daily.last == 0 or today > last
	dailyDot.Visible = ready
	dailyButton.Text = if ready then Strings.get("DailyReady") else Strings.get("Daily")
	Kit.setButtonColor(dailyButton, if ready then T.Good else T.PanelAlt)
end

function Hud.init()
	gui = Kit.screen("CarsHud", 5)
	buildTopLeft()
	buildTopRight()
	buildSpeedo()
	buildHint()
end

function Hud.start()
	ClientState.ProfileChanged:Connect(function(p)
		targetCash = p.cash
		updateDaily(p)
	end)
	if ClientState.profile then
		targetCash = ClientState.profile.cash
		updateDaily(ClientState.profile)
	end
	ClientState.DrivingChanged:Connect(function(driving)
		speedo.Visible = driving
		hint.Visible = driving
		if driving then
			hint.TextTransparency = 0
			task.delay(12, function()
				if hint.Visible then
					Kit.tween(hint, 1, { TextTransparency = 1 })
				end
			end)
		end
	end)

	local lit = -1
	RunService.RenderStepped:Connect(function(dt)
		-- cash count-up
		if displayedCash ~= targetCash then
			local diff = targetCash - displayedCash
			local step = math.max(1, math.abs(diff) * math.min(1, dt * 8))
			if math.abs(diff) <= step then
				displayedCash = targetCash
			else
				displayedCash += math.sign(diff) * step
			end
			cashLabel.Text = Format.money(displayedCash)
		end
		local tel = ClientState.telemetry
		if not ClientState.driving or not tel then
			meter.Visible = false
			return
		end
		speedLabel.Text = tostring(Format.speed(tel.speed))
		gearLabel.Text = if tel.gear == 0 then Strings.get("GearReverse") else tostring(tel.gear)
		local cells = math.floor(tel.rpm * RPM_CELLS + 0.5)
		if cells ~= lit then
			lit = cells
			for i, cell in rpmCells do
				cell.BackgroundTransparency = if i <= cells then 0 else 0.82
			end
		end
		nitroFill.Size = UDim2.fromScale(math.clamp(tel.nitro, 0, 1), 1)
		nitroLabel.TextColor3 = if tel.nitroActive then T.Accent2 else T.Muted
		if tel.drifting then
			meter.Visible = true
			meter.Text = Strings.get("DriftScore", math.floor(tel.driftAngle))
			meter.TextColor3 = T.Gold
		elseif tel.airborne and tel.airTime > 0.4 then
			meter.Visible = true
			meter.Text = Strings.get("AirScore", string.format("%.1f", tel.airTime))
			meter.TextColor3 = T.Accent2
		else
			meter.Visible = false
		end
	end)

end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Notifications</string>
            <string name="Source"><![CDATA[-- Notifications: toasts at the top of the screen and "+$" reward popups.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Strings = require(Shared.Strings)

local Kit = require(script.Parent.Parent.UI.Kit)
local T = Kit.Theme

local Notifications = {}

local toastHolder: Frame
local rewardHolder: Frame

local KIND_COLORS = {
	info = T.Accent2,
	success = T.Good,
	warning = T.Warn,
	error = T.Bad,
}

-- Translates arguments that are themselves string keys.
local function localizeArgs(args: { any }?): { any }
	local out = {}
	for i, a in args or {} do
		if typeof(a) == "string" and Strings.Tables.en[a] then
			out[i] = Strings.get(a)
		else
			out[i] = a
		end
	end
	return out
end

function Notifications.show(text: string, kind: string?)
	local color = KIND_COLORS[kind or "info"] or T.Accent2
	local toast = Kit.panel({
		Size = UDim2.new(0, 460, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.05,
		Parent = toastHolder,
	})
	Kit.padding(toast, 14, 10)
	local strip = Kit.new("Frame", {
		Size = UDim2.new(0, 4, 1, 0),
		Position = UDim2.new(0, -10, 0, 0),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = toast,
	})
	Kit.corner(strip, 2)
	local label = Kit.label({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = text,
		TextWrapped = true,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = toast,
	})
	label.TextTransparency = 1
	toast.BackgroundTransparency = 1
	Kit.tween(label, 0.2, { TextTransparency = 0 })
	Kit.tween(toast, 0.2, { BackgroundTransparency = 0.05 })
	-- keep at most 4 toasts
	local children = {}
	for _, c in toastHolder:GetChildren() do
		if c:IsA("Frame") then
			table.insert(children, c)
		end
	end
	if #children > 4 then
		children[1]:Destroy()
	end
	task.delay(3.6, function()
		if toast.Parent then
			Kit.tween(label, 0.3, { TextTransparency = 1 })
			Kit.tween(toast, 0.3, { BackgroundTransparency = 1 })
			local s = toast:FindFirstChildOfClass("UIStroke")
			if s then
				Kit.tween(s, 0.3, { Transparency = 1 })
			end
			strip:Destroy()
			task.wait(0.32)
			toast:Destroy()
		end
	end)
end

function Notifications.notifyKey(key: string, args: { any }?, kind: string?)
	Notifications.show(Strings.get(key, table.unpack(localizeArgs(args))), kind)
end

local REWARD_KEYS = {
	distance = "RewardDistance",
	drift = "RewardDrift",
	air = "RewardAir",
	race = "RewardRace",
}

function Notifications.reward(kind: string, amount: number, detail: any)
	local title
	if kind == "speedtrap" then
		title = Strings.get("RewardSpeedTrap", detail)
	elseif kind == "drift" or kind == "air" then
		title = Strings.get(REWARD_KEYS[kind]) .. " " .. tostring(detail) .. "s"
	else
		title = Strings.get(REWARD_KEYS[kind] or "Cash")
	end
	local big = kind ~= "distance"
	local label = Kit.label({
		Size = UDim2.new(1, 0, 0, if big then 30 else 22),
		Text = string.format("+%s  %s", Format.money(amount), title),
		TextColor3 = if big then T.Gold else T.Good,
		Font = T.FontBlack,
		TextSize = if big then 24 else 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStrokeTransparency = 0.5,
		Parent = rewardHolder,
	})
	label.TextTransparency = 1
	label.TextStrokeTransparency = 1
	Kit.tween(label, 0.15, { TextTransparency = 0, TextStrokeTransparency = 0.5 })
	task.delay(if big then 2.6 else 1.6, function()
		Kit.tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		task.wait(0.45)
		label:Destroy()
	end)
end

function Notifications.init()
	local gui = Kit.screen("CarsNotifications", 20)
	toastHolder = Kit.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 200), -- below the race panel
		Size = UDim2.new(0, 460, 0, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Kit.list(toastHolder, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center)
	rewardHolder = Kit.new("Frame", {
		Name = "Rewards",
		Position = UDim2.new(0, 24, 0, 86),
		Size = UDim2.new(0, 360, 0, 200),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Kit.list(rewardHolder, Enum.FillDirection.Vertical, 2)
end

function Notifications.start()
	Net.on("Notify", function(key, args, kind)
		if typeof(key) == "string" then
			Notifications.notifyKey(key, args, kind)
		end
	end)
	Net.on("Reward", function(kind, amount, detail)
		if typeof(kind) == "string" and typeof(amount) == "number" then
			Notifications.reward(kind, amount, detail)
		end
	end)
end

return Notifications
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">RaceUI</string>
            <string name="Source"><![CDATA[-- RaceUI: countdown, race timer, lap/checkpoint counters, the guide arrow to
-- the next checkpoint, gate highlighting and the results screen.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Strings = require(Shared.Strings)
local Tracks = require(Shared.Tracks)

local ClientState = require(script.Parent.Parent.ClientState)
local Kit = require(script.Parent.Parent.UI.Kit)
local Notifications = require(script.Parent.Notifications)
local T = Kit.Theme

local RaceUI = {}

local gui: ScreenGui
local panel: Frame
local trackLabel: TextLabel
local timerLabel: TextLabel
local progressLabel: TextLabel
local bestLabel: TextLabel
local medalsLabel: TextLabel
local countdownLabel: TextLabel
local results: Frame

type RaceInfo = {
	trackId: string,
	goAt: number,
	checkpoints: { { cf: CFrame, width: number } },
	laps: number,
	medals: { gold: number, silver: number, bronze: number },
	best: number?,
	nextIndex: number,
	lap: number,
	running: boolean,
}

local race: RaceInfo? = nil
local arrow: Model? = nil
local highlighted: Model? = nil
local highlight: Highlight? = nil
local lastFinished: string? = nil

local MEDAL_COLORS = { Gold = T.Gold, Silver = T.Silver, Bronze = T.Bronze }

local function trackName(id: string): string
	local t = Tracks.get(id)
	return if t then Strings.pick(t.name) else id
end

local function findGate(trackId: string, index: number): Model?
	for _, g in CollectionService:GetTagged("CheckpointGate") do
		if g:GetAttribute("Track") == trackId and g:GetAttribute("Index") == index then
			return g :: Model
		end
	end
	return nil
end

local function clearHighlight()
	if highlight then
		highlight:Destroy()
		highlight = nil
	end
	if highlighted then
		local banner = highlighted:FindFirstChild("Banner") :: BasePart?
		if banner then
			banner.Transparency = 0.35
		end
	end
	highlighted = nil
end

local function highlightGate()
	clearHighlight()
	local r = race
	if not r then
		return
	end
	local gate = findGate(r.trackId, r.nextIndex)
	if not gate then
		return
	end
	highlighted = gate
	local banner = gate:FindFirstChild("Banner") :: BasePart?
	if banner then
		banner.Transparency = 0
	end
	local h = Instance.new("Highlight")
	h.FillColor = T.Gold
	h.FillTransparency = 0.5
	h.OutlineColor = Color3.new(1, 1, 1)
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Adornee = gate
	h.Parent = gate
	highlight = h
end

local function makeArrow(): Model
	local model = Instance.new("Model")
	model.Name = "RaceArrow"
	local shaft = Instance.new("Part")
	shaft.Name = "Shaft"
	shaft.Size = Vector3.new(1.4, 0.6, 4)
	shaft.Color = T.Gold
	shaft.Material = Enum.Material.Neon
	shaft.Anchored = true
	shaft.CanCollide = false
	shaft.CanQuery = false
	shaft.CanTouch = false
	shaft.CastShadow = false
	shaft.Parent = model
	for _, name in { "HeadL", "HeadR" } do
		local head = Instance.new("Part")
		head.Name = name
		head.Size = Vector3.new(1.2, 0.6, 3.6)
		head.Color = T.Gold
		head.Material = Enum.Material.Neon
		head.Anchored = true
		head.CanCollide = false
		head.CanQuery = false
		head.CanTouch = false
		head.CastShadow = false
		head.Parent = model
	end
	model.PrimaryPart = shaft
	model.Parent = Workspace
	return model
end

local function updateTexts()
	local r = race
	if not r then
		return
	end
	trackLabel.Text = trackName(r.trackId)
	local cps = #r.checkpoints
	local parts = {}
	if r.laps > 1 then
		table.insert(parts, Strings.get("RaceLap", r.lap, r.laps))
	end
	table.insert(parts, Strings.get("RaceCheckpoint", math.min(r.nextIndex, cps), cps))
	progressLabel.Text = table.concat(parts, "   ")
	bestLabel.Text = Strings.get("RaceBest") .. ": " .. (if r.best then Format.time(r.best) else "--:--.--")
	medalsLabel.Text = Strings.get("MedalTargets", Format.time(r.medals.gold), Format.time(r.medals.silver), Format.time(r.medals.bronze))
end

local function stopRace()
	race = nil
	ClientState.racing = false
	panel.Visible = false
	countdownLabel.Visible = false
	clearHighlight()
	if arrow then
		arrow:Destroy()
		arrow = nil
	end
end

local function showResults(payload)
	for _, c in results:GetChildren() do
		if not c:IsA("UICorner") and not c:IsA("UIStroke") and not c:IsA("UIPadding") and not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	local medal = payload.medal
	Kit.label({ Size = UDim2.new(1, 0, 0, 30), Text = trackName(payload.trackId), TextSize = 22, TextColor3 = T.Muted, LayoutOrder = 1, Parent = results })
	Kit.label({ Size = UDim2.new(1, 0, 0, 64), Text = Format.time(payload.time), Font = T.FontBlack, TextSize = 60, LayoutOrder = 2, Parent = results })
	Kit.label({
		Size = UDim2.new(1, 0, 0, 34),
		Text = if medal then "★ " .. Strings.get("Medal" .. medal) .. " ★" else Strings.get("MedalNone"),
		Font = T.FontBlack,
		TextSize = 30,
		TextColor3 = if medal then MEDAL_COLORS[medal] else T.Muted,
		LayoutOrder = 3,
		Parent = results,
	})
	if payload.newRecord then
		Kit.label({ Size = UDim2.new(1, 0, 0, 26), Text = Strings.get("RaceNewRecord"), TextSize = 20, TextColor3 = T.Good, LayoutOrder = 4, Parent = results })
	end
	Kit.label({
		Size = UDim2.new(1, 0, 0, 26),
		Text = Strings.get("RaceReward", Format.money(payload.reward or 0)),
		TextSize = 20,
		TextColor3 = T.Gold,
		LayoutOrder = 5,
		Parent = results,
	})
	local row = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1, LayoutOrder = 6, Parent = results })
	Kit.list(row, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	Kit.button({
		Size = UDim2.new(0, 190, 1, 0),
		Text = Strings.get("RaceStart"),
		BackgroundColor3 = T.Good,
		onClick = function()
			results.Visible = false
			local trackId = lastFinished
			if trackId then
				local r = Net.request("StartRace", trackId)
				if r.message then
					Notifications.notifyKey(r.message, r.args, "warning")
				end
			end
		end,
		Parent = row,
	})
	Kit.button({
		Size = UDim2.new(0, 150, 1, 0),
		Text = Strings.get("Close"),
		BackgroundColor3 = T.PanelAlt,
		onClick = function()
			results.Visible = false
		end,
		Parent = row,
	})
	results.Visible = true
	results.Size = UDim2.new(0, 400, 0, 0)
	Kit.tween(results, 0.25, { Size = UDim2.new(0, 460, 0, 0) }, Enum.EasingStyle.Back)
	task.delay(12, function()
		if results.Visible and lastFinished == payload.trackId then
			results.Visible = false
		end
	end)
end

local function onState(payload)
	if typeof(payload) ~= "table" then
		return
	end
	local phase = payload.phase
	if phase == "countdown" then
		results.Visible = false
		race = {
			trackId = payload.trackId,
			goAt = payload.goAt,
			checkpoints = payload.checkpoints or {},
			laps = payload.laps or 1,
			medals = payload.medals,
			best = payload.best,
			nextIndex = 1,
			lap = 1,
			running = false,
		}
		ClientState.racing = true
		panel.Visible = true
		countdownLabel.Visible = true
		if not arrow then
			arrow = makeArrow()
		end
		updateTexts()
		highlightGate()
	elseif phase == "racing" and race then
		race.running = true
		race.nextIndex = payload.nextIndex or race.nextIndex
		race.lap = payload.lap or race.lap
		updateTexts()
		highlightGate()
	elseif phase == "finished" then
		lastFinished = payload.trackId
		stopRace()
		showResults(payload)
	elseif phase == "cancelled" then
		stopRace()
		Notifications.notifyKey(payload.reason or "RaceCancelled", {}, "warning")
	end
end

local function build()
	gui = Kit.screen("CarsRace", 8)
	panel = Kit.panel({
		Name = "RacePanel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.new(0, 420, 0, 150),
		Visible = false,
		Parent = gui,
	})
	trackLabel = Kit.label({ Position = UDim2.new(0, 0, 0, 8), Size = UDim2.new(1, 0, 0, 22), Text = "", TextSize = 18, TextColor3 = T.Accent, Parent = panel })
	timerLabel = Kit.label({ Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(1, 0, 0, 52), Text = "0:00.00", Font = T.FontBlack, TextSize = 48, Parent = panel })
	progressLabel = Kit.label({ Position = UDim2.new(0, 0, 0, 82), Size = UDim2.new(1, 0, 0, 20), Text = "", TextSize = 16, Parent = panel })
	bestLabel = Kit.label({ Position = UDim2.new(0, 0, 0, 102), Size = UDim2.new(1, 0, 0, 18), Text = "", TextSize = 14, TextColor3 = T.Muted, Parent = panel })
	medalsLabel = Kit.label({ Position = UDim2.new(0, 0, 0, 120), Size = UDim2.new(1, 0, 0, 18), Text = "", TextSize = 12, TextColor3 = T.Muted, Parent = panel })
	Kit.button({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 8),
		Size = UDim2.new(0, 170, 0, 34),
		Text = Strings.get("RaceLeave"),
		TextSize = 14,
		BackgroundColor3 = T.Bad,
		onClick = function()
			Net.request("LeaveRace")
		end,
		Parent = panel,
	})
	countdownLabel = Kit.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.new(0, 400, 0, 160),
		Text = "",
		Font = T.FontBlack,
		TextSize = 140,
		TextColor3 = T.Gold,
		TextStrokeTransparency = 0.3,
		Visible = false,
		Parent = gui,
	})
	results = Kit.panel({
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(0, 460, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = gui,
	})
	Kit.padding(results, 20, 18)
	Kit.list(results, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center)
end

local function frame()
	local r = race
	if not r then
		return
	end
	local now = Workspace:GetServerTimeNow()
	local elapsed = now - r.goAt
	if elapsed < 0 then
		countdownLabel.Visible = true
		countdownLabel.Text = tostring(math.ceil(-elapsed))
		timerLabel.Text = Format.time(0)
	else
		if elapsed < 0.9 then
			countdownLabel.Visible = true
			countdownLabel.Text = Strings.get("RaceGo")
		else
			countdownLabel.Visible = false
		end
		timerLabel.Text = Format.time(elapsed)
	end
	-- guide arrow above the car
	local car = ClientState.car
	local cp = r.checkpoints[r.nextIndex]
	if arrow and car and car.PrimaryPart and cp then
		local chassis = car.PrimaryPart
		local size = car:GetExtentsSize()
		local base = chassis.Position + Vector3.new(0, size.Y + 3, 0)
		local target = cp.cf.Position
		local dir = Vector3.new(target.X - base.X, 0, target.Z - base.Z)
		if dir.Magnitude > 1 then
			local cf = CFrame.lookAt(base, base + dir)
			local shaft = arrow:FindFirstChild("Shaft") :: BasePart
			shaft.CFrame = cf * CFrame.new(0, 0, 1)
			-- chevron tip: two bars from the tip back to each side
			for side, name in { [-1] = "HeadL", [1] = "HeadR" } do
				local bar = arrow:FindFirstChild(name) :: BasePart
				local tip = Vector3.new(0, 0, -2.6)
				local back = Vector3.new(side * 2.2, 0, -0.2)
				local mid = (tip + back) / 2
				bar.CFrame = cf * CFrame.lookAt(mid, tip)
			end
		end
	end
end

function RaceUI.init()
	build()
end

function RaceUI.start()
	Net.on("RaceState", onState)
	RunService.RenderStepped:Connect(frame)
end

return RaceUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">VehicleFX</string>
            <string name="Source"><![CDATA[-- VehicleFX: everything visual about cars, for every car near the camera:
-- wheel animation of other players' cars, head/brake lights, sirens,
-- exhaust smoke, nitro flames, skid marks, tire smoke, optional sounds and
-- the visibility of seat prompts.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local CarBuilder = require(Shared.CarBuilder)
local CarPhysics = require(Shared.CarPhysics)
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)

local Drive = require(script.Parent.Drive)

local VehicleFX = {}

local player = Players.LocalPlayer
local MAX_DISTANCE = 450
local TAIL_OFF = Color3.fromRGB(120, 8, 12)
local TAIL_ON = Color3.fromRGB(255, 40, 40)
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

type Rig = {
	model: Model,
	chassis: BasePart,
	wheels: { CarPhysics.Wheel },
	rays: RaycastParams,
	heads: { BasePart },
	tails: { BasePart },
	beam: Light?,
	brakeGlow: Light?,
	sirens: { BasePart },
	sirenLights: { Light },
	exhausts: { ParticleEmitter },
	flames: { ParticleEmitter },
	trails: { Trail },
	smokes: { ParticleEmitter },
	lastSpeed: number,
	brakeHold: number,
	sirenClock: number,
	engine: Sound?,
	conns: { RBXScriptConnection },
	isMine: boolean,
	prompts: { ProximityPrompt },
}

local rigs: { [Model]: Rig } = {}

local function emitter(parent: Instance, texture: string, color: Color3, size: number, rate: number): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.4), NumberSequenceKeypoint.new(1, size) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(2, 5)
	e.SpreadAngle = Vector2.new(18, 18)
	e.Rate = rate
	e.LightInfluence = 0.8
	e.Enabled = false
	e.Parent = parent
	return e
end

local function sound(parent: Instance, id: string, looped: boolean, volume: number): Sound?
	if id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = looped
	s.Volume = volume
	s.RollOffMaxDistance = 260
	s.RollOffMinDistance = 12
	s.Parent = parent
	return s
end

local function updatePrompts(rig: Rig)
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	local seated = hum ~= nil and hum.SeatPart ~= nil
	for _, prompt in rig.prompts do
		local seat = prompt.Parent :: Seat
		local free = seat.Occupant == nil
		if seat.Name == "DriveSeat" then
			prompt.Enabled = rig.isMine and free and not seated
		else
			prompt.Enabled = free and not seated
		end
		prompt.ActionText = Strings.get(prompt:GetAttribute("LocAction") or "PromptSit")
	end
end

local function build(model: Model)
	if rigs[model] then
		return
	end
	local chassis = model:WaitForChild("Chassis", 10) :: BasePart?
	if not chassis or not model.Parent then
		return
	end
	local rays = RaycastParams.new()
	rays.FilterType = Enum.RaycastFilterType.Exclude
	rays.FilterDescendantsInstances = { model }
	rays.CollisionGroup = "WheelRays"
	rays.IgnoreWater = true
	local rig: Rig = {
		model = model,
		chassis = chassis,
		wheels = CarPhysics.readWheels(model),
		rays = rays,
		heads = {},
		tails = {},
		beam = nil,
		brakeGlow = nil,
		sirens = {},
		sirenLights = {},
		exhausts = {},
		flames = {},
		trails = {},
		smokes = {},
		lastSpeed = 0,
		brakeHold = 0,
		sirenClock = 0,
		engine = nil,
		conns = {},
		isMine = model:GetAttribute("OwnerUserId") == player.UserId,
		prompts = {},
	}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local role = d:GetAttribute("Role")
			if role == "Headlight" then
				table.insert(rig.heads, d)
			elseif role == "Taillight" then
				table.insert(rig.tails, d)
			elseif role == "SirenA" or role == "SirenB" then
				table.insert(rig.sirens, d)
				local l = d:FindFirstChildOfClass("PointLight")
				if l then
					table.insert(rig.sirenLights, l)
				end
			end
		elseif d:IsA("ProximityPrompt") and d.Name == "SitPrompt" then
			table.insert(rig.prompts, d)
		end
	end
	local beamPart = model:FindFirstChild("HeadlightBeam", true)
	rig.beam = beamPart and beamPart:FindFirstChildWhichIsA("Light")
	local tailPart = model:FindFirstChild("TailGlow", true)
	rig.brakeGlow = tailPart and tailPart:FindFirstChildWhichIsA("Light")

	-- exhaust + nitro
	for _, a in chassis:GetChildren() do
		if a:IsA("Attachment") and string.sub(a.Name, 1, 7) == "Exhaust" then
			local smoke = emitter(a, SMOKE, Color3.fromRGB(150, 150, 155), 1.6, 12)
			smoke.EmissionDirection = Enum.NormalId.Back
			table.insert(rig.exhausts, smoke)
			local flame = emitter(a, FIRE, Color3.fromRGB(90, 170, 255), 1.4, 60)
			flame.LightEmission = 1
			flame.Lifetime = NumberRange.new(0.12, 0.22)
			flame.Speed = NumberRange.new(14, 20)
			flame.EmissionDirection = Enum.NormalId.Back
			flame.Transparency = NumberSequence.new(0.1, 1)
			table.insert(rig.flames, flame)
		end
	end
	-- skid marks and tire smoke on the rear wheels
	for _, w in rig.wheels do
		local index = w.part and w.part:GetAttribute("Index")
		local a0 = chassis:FindFirstChild("SkidA_" .. tostring(index))
		local a1 = chassis:FindFirstChild("SkidB_" .. tostring(index))
		if a0 and a1 then
			local trail = Instance.new("Trail")
			trail.Attachment0 = a0 :: Attachment
			trail.Attachment1 = a1 :: Attachment
			trail.Color = ColorSequence.new(Color3.fromRGB(20, 20, 22))
			trail.Transparency = NumberSequence.new(0.35, 1)
			trail.Lifetime = 3
			trail.MinLength = 0.2
			trail.FaceCamera = false
			trail.LightInfluence = 1
			trail.Enabled = false
			trail.Parent = chassis
			table.insert(rig.trails, trail)
			local smoke = emitter(a0, SMOKE, Color3.fromRGB(225, 225, 228), 4, 40)
			smoke.Lifetime = NumberRange.new(0.8, 1.6)
			smoke.Speed = NumberRange.new(1, 3)
			smoke.Acceleration = Vector3.new(0, 3, 0)
			table.insert(rig.smokes, smoke)
		end
	end

	-- optional sounds
	rig.engine = sound(chassis, Config.Sounds.Engine, true, 0.45)
	if rig.engine then
		rig.engine:Play()
	end
	local horn = sound(chassis, Config.Sounds.Horn, false, 0.8)
	local siren = sound(chassis, Config.Sounds.Siren, true, 0.6)
	table.insert(
		rig.conns,
		model:GetAttributeChangedSignal("Horn"):Connect(function()
			if horn then
				horn:Play()
			end
		end)
	)

	local function applyLights()
		local on = model:GetAttribute("Lights") == true
		for _, h in rig.heads do
			h.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
		if rig.beam then
			rig.beam.Enabled = on
		end
	end
	applyLights()
	table.insert(rig.conns, model:GetAttributeChangedSignal("Lights"):Connect(applyLights))
	table.insert(
		rig.conns,
		model:GetAttributeChangedSignal("Siren"):Connect(function()
			local on = model:GetAttribute("Siren") == true
			if siren then
				if on then
					siren:Play()
				else
					siren:Stop()
				end
			end
			if not on then
				for _, p in rig.sirens do
					p.Material = Enum.Material.SmoothPlastic
				end
				for _, l in rig.sirenLights do
					l.Enabled = false
				end
			end
		end)
	)
	for _, prompt in rig.prompts do
		local seat = prompt.Parent :: Seat
		table.insert(
			rig.conns,
			seat:GetPropertyChangedSignal("Occupant"):Connect(function()
				updatePrompts(rig)
			end)
		)
	end
	updatePrompts(rig)
	rigs[model] = rig
end

local function remove(model: Instance)
	local rig = rigs[model :: Model]
	if rig then
		for _, c in rig.conns do
			c:Disconnect()
		end
		rigs[model :: Model] = nil
	end
end

local function setEnabled(list: { any }, on: boolean)
	for _, e in list do
		if e.Enabled ~= on then
			e.Enabled = on
		end
	end
end

local function updateRig(rig: Rig, dt: number, camPos: Vector3)
	local chassis = rig.chassis
	if not chassis.Parent then
		return
	end
	local cf = chassis.CFrame
	local dist = (cf.Position - camPos).Magnitude
	local near = dist < MAX_DISTANCE
	local vel = chassis.AssemblyLinearVelocity
	local look = cf.LookVector
	local fwd = vel:Dot(look)
	local speed = vel.Magnitude
	local up = cf.UpVector
	local planar = vel - up * vel:Dot(up)
	local slip = 0
	if planar.Magnitude > 5 then
		slip = math.deg(math.atan2(math.abs(planar:Dot(cf.RightVector)), math.max(math.abs(planar:Dot(look)), 1e-3)))
	end

	local sim = if rig.isMine then Drive.getSim() else nil
	local grounded = true
	local braking, nitro, drifting, throttleish
	if sim and sim.chassis == chassis then
		local t = sim.telemetry
		braking = t.braking
		nitro = sim.nitroActive
		drifting = t.drifting or (t.slipping and t.grounded >= 2 and math.abs(t.forwardSpeed) < 25 and t.rpm > 0.6)
		throttleish = t.rpm
		grounded = t.grounded >= 2
	else
		-- other cars: animate wheels locally and infer the rest from motion
		if near then
			local yawRate = chassis.AssemblyAngularVelocity:Dot(up)
			local steer = 0
			if math.abs(fwd) > 3 then
				-- yaw rate is negative in a right turn, steer is positive to the right
				steer = math.clamp(math.atan(-yawRate * 9 / fwd), -0.6, 0.6)
			end
			local hits = 0
			for _, w in rig.wheels do
				local mount = cf:PointToWorldSpace(w.mount)
				local rest = (rig.model:GetAttribute("SuspRest") or 1.4) :: number
				local hit = Workspace:Raycast(mount, -up * (rest + w.radius), rig.rays)
				if hit then
					hits += 1
					w.springLen = math.clamp(hit.Distance - w.radius, 0, rest)
				else
					w.springLen += (rest - w.springLen) * math.clamp(dt * 8, 0, 1)
				end
				w.steerAngle = if w.steer then steer else 0
				w.spin += fwd / w.radius * dt
				if w.motor then
					w.motor.Transform = CFrame.new(0, w.staticLen - w.springLen, 0)
						* CFrame.Angles(0, -w.steerAngle, 0)
						* CFrame.Angles(-w.spin, 0, 0)
				end
			end
			grounded = hits >= 2
		end
		local decel = (rig.lastSpeed - math.abs(fwd)) / math.max(dt, 1e-3)
		if decel > 30 and math.abs(fwd) > 3 then
			rig.brakeHold = 0.25
		end
		rig.brakeHold -= dt
		braking = rig.brakeHold > 0
		nitro = rig.model:GetAttribute("Nitro") == true
		drifting = grounded and planar.Magnitude > 28 and slip > 14 and slip < 110
		throttleish = math.clamp(speed / 120, 0.2, 1)
	end
	rig.lastSpeed = math.abs(fwd)

	if not near then
		setEnabled(rig.exhausts, false)
		setEnabled(rig.flames, false)
		setEnabled(rig.trails, false)
		setEnabled(rig.smokes, false)
		return
	end

	-- brake lights
	for _, p in rig.tails do
		local c = if braking then TAIL_ON else TAIL_OFF
		if p.Color ~= c then
			p.Color = c
		end
	end
	if rig.brakeGlow then
		rig.brakeGlow.Brightness = if braking then 3 else 0
	end

	-- exhaust, nitro, skids
	for _, e in rig.exhausts do
		e.Rate = 6 + throttleish * 26
	end
	setEnabled(rig.exhausts, speed < 160)
	setEnabled(rig.flames, nitro)
	setEnabled(rig.trails, drifting and grounded)
	setEnabled(rig.smokes, drifting and grounded)

	-- siren
	if rig.model:GetAttribute("Siren") == true and #rig.sirens > 0 then
		rig.sirenClock += dt
		local phase = math.floor(rig.sirenClock * 6) % 2
		local sirenType = rig.model:GetAttribute("SirenType") or "police"
		local colors = CarBuilder.SirenColors[sirenType] or CarBuilder.SirenColors.police
		for _, p in rig.sirens do
			local isA = p:GetAttribute("Role") == "SirenA"
			local lit = (isA and phase == 0) or (not isA and phase == 1)
			p.Material = if lit then Enum.Material.Neon else Enum.Material.SmoothPlastic
			p.Color = (if isA then colors[1] else colors[2]):Lerp(Color3.new(0, 0, 0), if lit then 0 else 0.55)
			local l = p:FindFirstChildOfClass("PointLight")
			if l then
				l.Enabled = lit
			end
		end
	end

	-- engine sound pitch
	if rig.engine then
		rig.engine.PlaybackSpeed = 0.7 + throttleish * 1.1
	end
end

function VehicleFX.start()
	for _, m in CollectionService:GetTagged("Car") do
		task.spawn(build, m)
	end
	CollectionService:GetInstanceAddedSignal("Car"):Connect(function(m)
		task.spawn(build, m)
	end)
	CollectionService:GetInstanceRemovedSignal("Car"):Connect(remove)

	-- seat prompts depend on whether the local player sits
	local function watchCharacter(character: Model)
		local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if hum then
			hum:GetPropertyChangedSignal("SeatPart"):Connect(function()
				for _, rig in rigs do
					updatePrompts(rig)
				end
			end)
		end
		for _, rig in rigs do
			updatePrompts(rig)
		end
	end
	if player.Character then
		task.spawn(watchCharacter, player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)

	RunService.PreSimulation:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		local camPos = if camera then camera.CFrame.Position else Vector3.zero
		for model, rig in rigs do
			if not model.Parent then
				remove(model)
			else
				local ok, err = pcall(updateRig, rig, dt, camPos)
				if not ok then
					warn("[VehicleFX] " .. tostring(err))
					remove(model)
				end
			end
		end
	end)
end

return VehicleFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">WorldText</string>
            <string name="Source"><![CDATA[-- WorldText: translates signs, boards and prompts in the world to the
-- player's language, and spins the showroom cars.

local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Strings = require(Shared.Strings)
local Tracks = require(Shared.Tracks)

local WorldText = {}

local function trackName(id: any): string
	local t = Tracks.get(id)
	return if t then Strings.pick(t.name) else tostring(id or "")
end

local function translate(label: Instance)
	if not label:IsA("TextLabel") then
		return
	end
	local key = label:GetAttribute("LocKey")
	if typeof(key) ~= "string" then
		return
	end
	local track = label:GetAttribute("LocTrack")
	if track then
		label.Text = Strings.get(key, trackName(track))
	else
		label.Text = Strings.get(key)
	end
end

local function translatePrompt(prompt: ProximityPrompt)
	local action = prompt:GetAttribute("LocAction")
	if typeof(action) == "string" then
		prompt.ActionText = Strings.get(action)
	end
	local track = prompt:GetAttribute("LocTrack")
	if track then
		prompt.ObjectText = trackName(track)
	end
	local object = prompt:GetAttribute("LocObject")
	if typeof(object) == "string" then
		prompt.ObjectText = Strings.get(object)
	end
end

-- showroom turntables
type Spinner = { model: Model, center: Vector3, offset: CFrame, angle: number, speed: number }
local spinners: { [Model]: Spinner } = {}

local function addSpinner(model: Instance)
	if not model:IsA("Model") or spinners[model] then
		return
	end
	local center = model:GetAttribute("SpinCenter")
	if typeof(center) ~= "Vector3" then
		return
	end
	local pivot = model:GetPivot()
	spinners[model] = {
		model = model,
		center = center,
		offset = CFrame.new(center):ToObjectSpace(pivot),
		angle = 0,
		speed = model:GetAttribute("SpinSpeed") or 0.25,
	}
end

function WorldText.start()
	for _, label in CollectionService:GetTagged("LocText") do
		translate(label)
	end
	CollectionService:GetInstanceAddedSignal("LocText"):Connect(translate)
	-- leaderboards switch rows between "empty" and names at runtime
	CollectionService:GetInstanceAddedSignal("LocText"):Connect(function(label)
		label:GetAttributeChangedSignal("LocKey"):Connect(function()
			translate(label)
		end)
	end)

	ProximityPromptService.PromptShown:Connect(function(prompt)
		translatePrompt(prompt)
	end)

	for _, m in CollectionService:GetTagged("Showcase") do
		addSpinner(m)
	end
	CollectionService:GetInstanceAddedSignal("Showcase"):Connect(addSpinner)
	CollectionService:GetInstanceRemovedSignal("Showcase"):Connect(function(m)
		spinners[m :: Model] = nil
	end)
	RunService.RenderStepped:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local camPos = camera.CFrame.Position
		for model, s in spinners do
			if not model.Parent then
				spinners[model] = nil
			elseif (s.center - camPos).Magnitude < 250 then
				s.angle += dt * s.speed
				model:PivotTo(CFrame.new(s.center) * CFrame.Angles(0, s.angle, 0) * s.offset)
			end
		end
	end)
end

return WorldText
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[-- Kit: tiny UI toolkit so every screen shares one look (dark glass panels,
-- orange accent, rounded corners) and one way of building instances.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Kit = {}

Kit.Theme = {
	Bg = Color3.fromRGB(14, 17, 26),
	Panel = Color3.fromRGB(20, 24, 36),
	PanelAlt = Color3.fromRGB(28, 33, 48),
	Card = Color3.fromRGB(32, 38, 56),
	CardHover = Color3.fromRGB(42, 50, 72),
	Stroke = Color3.fromRGB(255, 255, 255),
	Accent = Color3.fromRGB(255, 128, 32),
	Accent2 = Color3.fromRGB(70, 196, 255),
	Good = Color3.fromRGB(70, 214, 120),
	Warn = Color3.fromRGB(255, 196, 60),
	Bad = Color3.fromRGB(255, 76, 76),
	Text = Color3.fromRGB(240, 242, 248),
	Muted = Color3.fromRGB(150, 158, 178),
	Gold = Color3.fromRGB(255, 208, 70),
	Silver = Color3.fromRGB(205, 212, 224),
	Bronze = Color3.fromRGB(214, 140, 84),
	Font = Enum.Font.GothamBold,
	FontBlack = Enum.Font.GothamBlack,
	FontMedium = Enum.Font.GothamMedium,
}
local T = Kit.Theme

-- Kit.new("Frame", { Size = ..., Parent = ... }, { children })
function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(parent: Instance, radius: number?): UICorner
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function Kit.stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Kit.new("UIStroke", {
		Color = color or T.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Kit.padding(parent: Instance, px: number, py: number?): UIPadding
	return Kit.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, py or px),
		PaddingBottom = UDim.new(0, py or px),
		Parent = parent,
	})
end

function Kit.list(parent: Instance, direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?): UIListLayout
	return Kit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function Kit.gradient(parent: Instance, a: Color3, b: Color3, rotation: number?): UIGradient
	return Kit.new("UIGradient", {
		Color = ColorSequence.new(a, b),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

-- A dark rounded panel.
function Kit.panel(props: { [string]: any }): Frame
	local p = table.clone(props)
	p.BackgroundColor3 = p.BackgroundColor3 or T.Panel
	p.BackgroundTransparency = p.BackgroundTransparency or 0.08
	p.BorderSizePixel = 0
	local frame = Kit.new("Frame", p)
	Kit.corner(frame, 14)
	Kit.stroke(frame)
	return frame
end

function Kit.label(props: { [string]: any }): TextLabel
	local p = table.clone(props)
	p.BackgroundTransparency = p.BackgroundTransparency or 1
	p.Font = p.Font or T.Font
	p.TextColor3 = p.TextColor3 or T.Text
	p.TextSize = p.TextSize or 18
	p.BorderSizePixel = 0
	if p.TextScaled == nil and p.TextWrapped == nil then
		p.TextTruncate = p.TextTruncate or Enum.TextTruncate.AtEnd
	end
	return Kit.new("TextLabel", p)
end

-- Button with hover/press animation. `onClick` is connected to Activated.
function Kit.button(props: { [string]: any }): TextButton
	local p = table.clone(props)
	local onClick = p.onClick
	local radius = p.cornerRadius
	p.onClick = nil
	p.cornerRadius = nil
	local color = p.BackgroundColor3 or T.Accent
	p.BackgroundColor3 = color
	p.AutoButtonColor = false
	p.Font = p.Font or T.FontBlack
	p.TextColor3 = p.TextColor3 or Color3.new(1, 1, 1)
	p.TextSize = p.TextSize or 18
	p.BorderSizePixel = 0
	local button = Kit.new("TextButton", p)
	Kit.corner(button, radius or 10)
	local scale = Kit.new("UIScale", { Parent = button })
	local hoverColor = color:Lerp(Color3.new(1, 1, 1), 0.12)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = hoverColor }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.12), { BackgroundColor3 = button:GetAttribute("BaseColor") or color }):Play()
		TweenService:Create(scale, TweenInfo.new(0.1), { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.95 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.1, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

-- Changes a Kit.button's base color (keeps hover behaviour right).
function Kit.setButtonColor(button: TextButton, color: Color3)
	button:SetAttribute("BaseColor", color)
	button.BackgroundColor3 = color
end

-- Horizontal stat bar 0..10.
function Kit.bar(parent: Instance, color: Color3?): (Frame, (value: number) -> ())
	local back = Kit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		Parent = parent,
	})
	Kit.corner(back, 4)
	local fill = Kit.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color or T.Accent,
		BorderSizePixel = 0,
		Parent = back,
	})
	Kit.corner(fill, 4)
	local function set(value: number)
		TweenService:Create(fill, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(math.clamp(value / 10, 0, 1), 1) })
			:Play()
	end
	return back, set
end

-- ScreenGui with a UIScale that adapts to the screen size.
function Kit.screen(name: string, displayOrder: number?): (ScreenGui, UIScale)
	local player = Players.LocalPlayer
	local gui = Kit.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder or 0,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local scale = Kit.new("UIScale", { Parent = gui })
	local function update()
		local camera = Workspace.CurrentCamera
		if not camera then
			return
		end
		local vp = camera.ViewportSize
		scale.Scale = math.clamp(math.min(vp.X / 1500, vp.Y / 860), 0.38, 1.35)
	end
	update()
	local function watch()
		local camera = Workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		end
	end
	watch()
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		watch()
		update()
	end)
	return gui, scale
end

function Kit.tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

return Kit
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">CarsServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Server entry point. Every system is a ModuleScript in Systems/ with an
-- optional init() (synchronous setup, runs in ORDER) and start() (long-running
-- work, runs after every init has finished).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("CarsShared"):WaitForChild("Net"))

local Systems = script:WaitForChild("Systems")

-- Order matters for init(): later systems may use earlier ones.
local ORDER = {
	"Characters", -- disables auto spawning before anyone joins
	"World", -- builds the map in start(); characters spawn when it's done
	"PlayerData",
	"Environment",
	"Vehicles",
	"Shop",
	"Leaderboards",
	"Economy",
	"Races",
	"DevTools",
}

Net.init()

local loaded: { [string]: any } = {}
for _, name in ORDER do
	local module = Systems:FindFirstChild(name)
	if module and module:IsA("ModuleScript") then
		loaded[name] = require(module)
	else
		warn("[Server] missing system " .. name)
	end
end
-- any extra system dropped into Systems/ is picked up too (merged work from other places)
for _, module in Systems:GetChildren() do
	if module:IsA("ModuleScript") and not loaded[module.Name] then
		loaded[module.Name] = require(module)
		table.insert(ORDER, module.Name)
	end
end

for _, name in ORDER do
	local system = loaded[name]
	if system and typeof(system.init) == "function" then
		local ok, err = pcall(system.init)
		if not ok then
			warn(string.format("[Server] %s.init failed: %s", name, tostring(err)))
		end
	end
end

for _, name in ORDER do
	local system = loaded[name]
	if system and typeof(system.start) == "function" then
		task.spawn(function()
			local ok, err = pcall(system.start)
			if not ok then
				warn(string.format("[Server] %s.start failed: %s", name, tostring(err)))
			end
		end)
	end
end

print("[Server] Cars mode ready")
]]></string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Systems</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Characters</string>
            <string name="Source"><![CDATA[-- Characters: spawns characters only after the world and the save are ready,
-- respawns them after death, and puts character parts in the "Players"
-- collision group (so wheel rays ignore people).

local Players = game:GetService("Players")

local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local Characters = {}

local RESPAWN_DELAY = 3

-- LoadCharacterAsync replaces the deprecated LoadCharacter on newer engines.
local function loadCharacter(player: Player)
	local hasAsync, method = pcall(function()
		return (player :: any).LoadCharacterAsync
	end)
	if hasAsync and typeof(method) == "function" then
		method(player)
	else
		(player :: any):LoadCharacter() -- api-ok: fallback for older engines
	end
end

local function setGroup(part: Instance)
	if part:IsA("BasePart") then
		part.CollisionGroup = "Players"
	end
end

local function onCharacter(player: Player, character: Model)
	for _, d in character:GetDescendants() do
		setGroup(d)
	end
	character.DescendantAdded:Connect(setGroup)
	local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if hum then
		hum.Died:Connect(function()
			task.delay(RESPAWN_DELAY, function()
				if player.Parent and player.Character == character then
					loadCharacter(player)
				end
			end)
		end)
	end
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function(c)
		onCharacter(player, c)
	end)
	if player.Character then
		-- spawned before this script ran (Studio play solo)
		onCharacter(player, player.Character)
	end
	World.waitUntilReady()
	PlayerData.waitFor(player, 60)
	if player.Parent then
		-- (re)spawn on the plaza now that the world exists
		loadCharacter(player)
	end
end

function Characters.init()
	Players.CharacterAutoLoads = false
end

function Characters.start()
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayer, p)
	end
end

return Characters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">DevTools</string>
            <string name="Source"><![CDATA[-- DevTools: gated test helpers (Studio or Config.Admins only) for quick QA:
-- free cash and a progress reset. Never available to normal players.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local PlayerData = require(script.Parent.PlayerData)
local Vehicles = require(script.Parent.Vehicles)

local DevTools = {}

local function isDev(player: Player): boolean
	if RunService:IsStudio() then
		return true
	end
	return table.find(Config.Admins, player.UserId) ~= nil
end
DevTools.isDev = isDev

function DevTools.init()
	Net.handle("DevCash", function(player)
		if not isDev(player) then
			return { ok = false }
		end
		PlayerData.addCash(player, 100000, "dev")
		return { ok = true }
	end)
	Net.handle("DevReset", function(player)
		if not isDev(player) then
			return { ok = false }
		end
		Vehicles.despawn(player)
		PlayerData.reset(player)
		return { ok = true }
	end)
end

function DevTools.start()
	local function mark(player: Player)
		if isDev(player) then
			player:SetAttribute("IsDev", true)
		end
	end
	Players.PlayerAdded:Connect(mark)
	for _, p in Players:GetPlayers() do
		mark(p)
	end
end

return DevTools
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[-- Economy: server-side scoring of driving. Pays for distance, drifts and air
-- time, and runs the highway speed trap. Everything is measured on the server
-- from the replicated car state, with sanity caps against teleports.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Leaderboards = require(script.Parent.Leaderboards)
local PlayerData = require(script.Parent.PlayerData)
local Vehicles = require(script.Parent.Vehicles)
local World = require(script.Parent.World)

local Economy = {}

local TICK = 0.1
local E = Config.Earnings
local P = Config.Physics

type Track = {
	lastPos: Vector3?,
	distance: number, -- unpaid distance
	sincePayout: number,
	driftTime: number,
	driftGrace: number,
	driftSpeedSum: number,
	airTime: number,
	window: { { t: number, amount: number } }, -- payouts in the last minute
	lastTrapX: number?,
}

local tracking: { [Player]: Track } = {}

local function state(player: Player): Track
	local s = tracking[player]
	if not s then
		s = {
			lastPos = nil,
			distance = 0,
			sincePayout = 0,
			driftTime = 0,
			driftGrace = 0,
			driftSpeedSum = 0,
			airTime = 0,
			window = {},
			lastTrapX = nil,
		}
		tracking[player] = s
	end
	return s
end

-- Pays `amount`, respecting the per-minute cap. Returns what was actually paid.
local function pay(player: Player, s: Track, amount: number, kind: string, detail: any): number
	local now = os.clock()
	local recent = 0
	for i = #s.window, 1, -1 do
		if now - s.window[i].t > 60 then
			table.remove(s.window, i)
		else
			recent += s.window[i].amount
		end
	end
	local allowed = math.max(0, math.min(math.floor(amount), E.MaxPerMinute - recent))
	if allowed <= 0 then
		return 0
	end
	table.insert(s.window, { t = now, amount = allowed })
	PlayerData.addCash(player, allowed, kind)
	Net.fire(player, "Reward", kind, allowed, detail)
	return allowed
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.CollisionGroup = "WheelRays"
groundParams.IgnoreWater = true

local function isGrounded(car: Model, chassis: BasePart): boolean
	groundParams.FilterDescendantsInstances = { car }
	local reach = (car:GetAttribute("SuspRest") or 1.5) + 4.5
	local hit = workspace:Raycast(chassis.Position, -chassis.CFrame.UpVector * reach, groundParams)
	return hit ~= nil
end

local function speedTrap(player: Player, s: Track, pos: Vector3, vel: Vector3)
	local st = World.Layout.SpeedTrap
	local lastX = s.lastTrapX
	s.lastTrapX = pos.X
	if not lastX or math.abs(pos.Z - st.z) > st.halfWidth then
		return
	end
	if (lastX < st.x) == (pos.X < st.x) then
		return
	end
	local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local data = PlayerData.get(player)
	if not data then
		return
	end
	local kmh = Format.speed(speed)
	for _, label in CollectionService:GetTagged("SpeedTrapReadout") do
		if label:IsA("TextLabel") then
			label.Text = string.format("%s  %d", player.DisplayName, kmh)
		end
	end
	local old = data.topSpeed
	if speed <= old then
		Net.notify(player, "SpeedTrapNoReward", { kmh }, "info")
		return
	end
	PlayerData.update(player, function(p)
		p.topSpeed = speed
	end)
	Leaderboards.submitSpeed(player, speed)
	-- one-time rewards for each threshold beaten for the first time
	local reward = 0
	for i, threshold in E.SpeedTrapThresholds do
		if speed >= threshold and old < threshold then
			reward += E.SpeedTrapRewards[i]
		end
	end
	if reward > 0 then
		PlayerData.addCash(player, reward, "speedtrap")
		Net.fire(player, "Reward", "speedtrap", reward, kmh)
	else
		Net.notify(player, "RewardSpeedTrap", { kmh }, "success")
	end
end

local function tickPlayer(player: Player, s: Track, dt: number)
	local car = Vehicles.getCar(player)
	if not car or not Vehicles.isDriving(player) then
		s.lastPos = nil
		s.driftTime, s.airTime = 0, 0
		return
	end
	local chassis = car.PrimaryPart
	if not chassis or chassis.Anchored then
		s.lastPos = nil
		return
	end
	local pos = chassis.Position
	local vel = chassis.AssemblyLinearVelocity
	local maxSpeed = (car:GetAttribute("MaxSpeed") or 150) * 1.6
	local zone, mult = World.zoneAt(pos)

	-- distance
	if s.lastPos then
		local delta = Vector3.new(pos.X - s.lastPos.X, 0, pos.Z - s.lastPos.Z).Magnitude
		local speed = delta / dt
		if speed <= maxSpeed and speed >= E.MinSpeed then
			s.distance += delta
		end
	end
	s.lastPos = pos

	-- speed trap
	speedTrap(player, s, pos, vel)

	-- drift / air
	local grounded = isGrounded(car, chassis)
	local up = chassis.CFrame.UpVector
	local planar = vel - up * vel:Dot(up)
	local speed = planar.Magnitude
	local slip = 0
	if speed > 5 then
		local look = chassis.CFrame.LookVector
		slip = math.deg(math.atan2(math.abs(planar:Dot(chassis.CFrame.RightVector)), math.max(math.abs(planar:Dot(look)), 1e-3)))
	end
	local drifting = grounded and speed > P.DriftMinSpeed and slip > P.DriftSlipAngle and slip < 100 and speed <= maxSpeed
	if drifting then
		s.driftTime += dt
		s.driftSpeedSum += speed * dt
		s.driftGrace = 0.6
	elseif s.driftTime > 0 then
		s.driftGrace -= dt
		if s.driftGrace <= 0 then
			if s.driftTime >= E.DriftMinDuration then
				local avgSpeed = s.driftSpeedSum / s.driftTime
				local speedFactor = math.clamp(avgSpeed / 60, 0.6, 2)
				local zm = if zone == "drift" then mult else 1
				local amount = E.DriftPerSecond * s.driftTime * speedFactor * zm
				pay(player, s, amount, "drift", math.floor(s.driftTime * 10) / 10)
				PlayerData.update(player, function(p)
					p.stats.drifts += 1
				end)
			end
			s.driftTime = 0
			s.driftSpeedSum = 0
		end
	end

	if not grounded and up.Y < 0.2 then
		-- lying on its roof is not air time
		s.airTime = 0
	elseif not grounded then
		s.airTime += dt
	elseif s.airTime > 0 then
		if s.airTime >= E.AirMinDuration then
			local zm = if zone == "stunt" then mult else 1
			local amount = E.AirPerSecond * s.airTime * zm
			local t = s.airTime
			pay(player, s, amount, "air", math.floor(t * 10) / 10)
			PlayerData.update(player, function(p)
				p.stats.airtime += t
			end)
		end
		s.airTime = 0
	end

	-- distance payout
	s.sincePayout += dt
	if s.sincePayout >= E.PayoutInterval then
		s.sincePayout = 0
		local amount = s.distance * E.PerStud
		local dist = s.distance
		s.distance = 0
		if amount >= 1 then
			pay(player, s, amount, "distance", math.floor(dist))
			PlayerData.update(player, function(p)
				p.stats.distance += dist
			end)
		end
	end
end

function Economy.start()
	Players.PlayerRemoving:Connect(function(player)
		tracking[player] = nil
	end)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(TICK)
			local now = os.clock()
			local dt = math.clamp(now - last, 0.01, 0.5)
			last = now
			for _, player in Players:GetPlayers() do
				local ok, err = pcall(tickPlayer, player, state(player), dt)
				if not ok then
					warn("[Economy] " .. tostring(err))
				end
			end
		end
	end)
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Environment</string>
            <string name="Source"><![CDATA[-- Environment: lighting, atmosphere, post effects and the day/night cycle.
-- Street lamps (tag "StreetLight") switch on at night.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Config = require(Shared.Config)

local World = require(script.Parent.World)

local Environment = {}

local function ensure(className: string, name: string): Instance
	local inst = Lighting:FindFirstChild(name)
	if not inst then
		inst = Instance.new(className)
		inst.Name = name
		inst.Parent = Lighting
	end
	return inst
end

local nightLights = false

local function setStreetLights(on: boolean)
	nightLights = on
	for _, head in CollectionService:GetTagged("StreetLight") do
		if head:IsA("BasePart") then
			head.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
			local light = head:FindFirstChildWhichIsA("Light")
			if light then
				light.Enabled = on
			end
		end
	end
end

function Environment.isNight(): boolean
	local t = Lighting.ClockTime
	return t >= Config.DayNight.NightStart or t < Config.DayNight.NightEnd
end

function Environment.init()
	Lighting.ClockTime = Config.DayNight.StartClock
	Lighting.Brightness = 2.6
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 136)
	Lighting.Ambient = Color3.fromRGB(70, 70, 80)
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25
	Lighting.GeographicLatitude = 35
	-- realistic lighting (the successor of Technology = Future); pcall for older engines
	pcall(function()
		(Lighting :: any).LightingStyle = Enum.LightingStyle.Realistic
	end)

	local atmosphere = ensure("Atmosphere", "CarsAtmosphere") :: Atmosphere
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.12
	atmosphere.Color = Color3.fromRGB(199, 214, 228)
	atmosphere.Decay = Color3.fromRGB(106, 112, 125)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2

	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.Name = "CarsSky"
		sky.SunAngularSize = 14
		sky.MoonAngularSize = 9
		sky.Parent = Lighting
	end

	local bloom = ensure("BloomEffect", "CarsBloom") :: BloomEffect
	bloom.Intensity = 0.6
	bloom.Size = 26
	bloom.Threshold = 1.6

	local rays = ensure("SunRaysEffect", "CarsSunRays") :: SunRaysEffect
	rays.Intensity = 0.06
	rays.Spread = 0.6

	local cc = ensure("ColorCorrectionEffect", "CarsColor") :: ColorCorrectionEffect
	cc.Saturation = 0.12
	cc.Contrast = 0.06
	cc.Brightness = 0.01
end

function Environment.start()
	setStreetLights(Environment.isNight())
	-- lamps are created while the world builds
	World.ReadySignal:Connect(function()
		setStreetLights(Environment.isNight())
	end)
	if not Config.DayNight.Enabled then
		return
	end
	local hoursPerSecond = 24 / (Config.DayNight.MinutesPerDay * 60)
	RunService.Heartbeat:Connect(function(dt)
		Lighting.ClockTime = (Lighting.ClockTime + dt * hoursPerSecond) % 24
		local night = Environment.isNight()
		if night ~= nightLights then
			setStreetLights(night)
			local cc = Lighting:FindFirstChild("CarsColor") :: ColorCorrectionEffect?
			if cc then
				cc.TintColor = if night then Color3.fromRGB(205, 215, 255) else Color3.new(1, 1, 1)
			end
			Lighting.OutdoorAmbient = if night then Color3.fromRGB(70, 74, 96) else Color3.fromRGB(128, 128, 136)
		end
	end)
end

return Environment
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Leaderboards</string>
            <string name="Source"><![CDATA[-- Leaderboards: global top lists (OrderedDataStore) for cash, top speed and
-- best race times, drawn on the boards in the plaza. Without DataStore access
-- (Studio) the boards still work for the current session.

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Tracks = require(Shared.Tracks)

local PlayerData = require(script.Parent.PlayerData)

local Leaderboards = {}

type Entry = { userId: number, value: number }

local stores: { [string]: OrderedDataStore } = {}
local session: { [string]: { [number]: number } } = {} -- kind -> userId -> value
local ascending: { [string]: boolean } = {}
local cached: { [string]: { Entry } } = {}
local names: { [number]: string } = {}
local available = true

local function kinds(): { string }
	local list = { "cash", "speed" }
	for _, t in Tracks.List do
		table.insert(list, "track:" .. t.id)
	end
	return list
end

local function storeName(kind: string): string
	if kind == "cash" then
		return "CarsMode_TopCash_v1"
	elseif kind == "speed" then
		return "CarsMode_TopSpeed_v1"
	end
	return "CarsMode_Time_" .. string.sub(kind, 7) .. "_v1"
end

local function nameOf(userId: number): string
	local cachedName = names[userId]
	if cachedName then
		return cachedName
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		names[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local result = if ok and name then name else ("#" .. userId)
	names[userId] = result
	return result
end

local function formatValue(kind: string, value: number): string
	if kind == "cash" then
		return Format.money(value)
	elseif kind == "speed" then
		return tostring(Format.speed(value)) .. " km/h"
	end
	return Format.time(value)
end

-- Stored values are integers: cash as is, speed x100, times in milliseconds.
local function encode(kind: string, value: number): number
	if kind == "cash" then
		return math.floor(value)
	elseif kind == "speed" then
		return math.floor(value * 100)
	end
	return math.floor(value * 1000)
end

local function decode(kind: string, value: number): number
	if kind == "cash" then
		return value
	elseif kind == "speed" then
		return value / 100
	end
	return value / 1000
end

local function write(kind: string, userId: number, value: number)
	session[kind] = session[kind] or {}
	local prev = session[kind][userId]
	local better = prev == nil or (if ascending[kind] then value < prev else value > prev)
	if kind == "cash" or better then
		session[kind][userId] = value
	end
	local store = stores[kind]
	if not store or not available then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			store:UpdateAsync(tostring(userId), function(old)
				local encoded = encode(kind, value)
				if kind ~= "cash" and old ~= nil then
					if ascending[kind] and old <= encoded then
						return nil
					elseif not ascending[kind] and old >= encoded then
						return nil
					end
				end
				return encoded
			end)
		end)
		if not ok then
			warn("[Leaderboards] write failed, using session boards: " .. tostring(err))
			available = false
		end
	end)
	Leaderboards.refreshSoon()
end

function Leaderboards.submitSpeed(player: Player, speed: number)
	write("speed", player.UserId, speed)
end

function Leaderboards.submitTime(player: Player, trackId: string, seconds: number)
	write("track:" .. trackId, player.UserId, seconds)
end

function Leaderboards.submitCash(player: Player)
	local data = PlayerData.get(player)
	if data then
		write("cash", player.UserId, data.cash)
	end
end

local function fetch(kind: string): { Entry }
	local merged: { [number]: number } = {}
	local store = stores[kind]
	if store and available then
		local ok, pages = pcall(function()
			return store:GetSortedAsync(ascending[kind], Config.Leaderboards.Size)
		end)
		if ok and pages then
			for _, item in pages:GetCurrentPage() do
				local id = tonumber(item.key)
				if id then
					merged[id] = decode(kind, item.value)
				end
			end
		end
	end
	for id, v in session[kind] or {} do
		local cur = merged[id]
		if cur == nil or kind == "cash" or (if ascending[kind] then v < cur else v > cur) then
			merged[id] = v
		end
	end
	local list: { Entry } = {}
	for id, v in merged do
		table.insert(list, { userId = id, value = v })
	end
	table.sort(list, function(a, b)
		if ascending[kind] then
			return a.value < b.value
		end
		return a.value > b.value
	end)
	while #list > Config.Leaderboards.Size do
		table.remove(list)
	end
	return list
end

local function draw(board: BasePart, kind: string, list: { Entry })
	local gui = board:FindFirstChild("BoardGui")
	local rows = gui and gui:FindFirstChild("Rows")
	if not rows then
		return
	end
	for _, row in rows:GetChildren() do
		if row:IsA("TextLabel") then
			local i = row.LayoutOrder
			local e = list[i]
			if e then
				if row:GetAttribute("LocKey") then
					row:SetAttribute("LocKey", nil)
					CollectionService:RemoveTag(row, "LocText")
				end
				row.Text = string.format("%d. %s   %s", i, nameOf(e.userId), formatValue(kind, e.value))
			elseif i == 1 then
				row.Text = "BoardEmpty"
				row:SetAttribute("LocKey", "BoardEmpty")
				CollectionService:AddTag(row, "LocText")
			else
				row.Text = ""
			end
		end
	end
end

function Leaderboards.refresh()
	for _, kind in kinds() do
		cached[kind] = fetch(kind)
	end
	for _, board in CollectionService:GetTagged("Leaderboard") do
		local kind = board:GetAttribute("BoardKind")
		if typeof(kind) == "string" and cached[kind] and board:IsA("BasePart") then
			draw(board, kind, cached[kind])
		end
	end
end

local refreshQueued = false
-- Redraws the boards a few seconds after a new record (debounced).
function Leaderboards.refreshSoon()
	if refreshQueued then
		return
	end
	refreshQueued = true
	task.delay(4, function()
		refreshQueued = false
		pcall(Leaderboards.refresh)
	end)
end

function Leaderboards.init()
	for _, kind in kinds() do
		ascending[kind] = string.sub(kind, 1, 6) == "track:"
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(storeName(kind))
		end)
		if ok then
			stores[kind] = store
		else
			available = false
		end
	end
end

function Leaderboards.start()
	-- seed session values from loaded profiles so the boards fill up in Studio too
	PlayerData.Loaded:Connect(function(player, data)
		session.cash = session.cash or {}
		session.cash[player.UserId] = data.cash
		if data.topSpeed > 0 then
			session.speed = session.speed or {}
			session.speed[player.UserId] = math.max(session.speed[player.UserId] or 0, data.topSpeed)
		end
		for trackId, t in data.bestTimes do
			local kind = "track:" .. trackId
			session[kind] = session[kind] or {}
			local cur = session[kind][player.UserId]
			if cur == nil or t < cur then
				session[kind][player.UserId] = t
			end
		end
		names[player.UserId] = player.DisplayName
	end)
	Players.PlayerRemoving:Connect(Leaderboards.submitCash)
	task.spawn(function()
		task.wait(8)
		while true do
			for _, p in Players:GetPlayers() do
				Leaderboards.submitCash(p)
			end
			local ok, err = pcall(Leaderboards.refresh)
			if not ok then
				warn("[Leaderboards] refresh failed: " .. tostring(err))
				available = false
			end
			task.wait(Config.Leaderboards.RefreshInterval)
		end
	end)
end

return Leaderboards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">PlayerData</string>
            <string name="Source"><![CDATA[-- PlayerData: the only module that touches player DataStores.
--
-- * UpdateAsync everywhere, retries with exponential backoff
-- * session lock (JobId + timestamp) so two servers never own one save
-- * autosave (staggered), save on leave and on BindToClose
-- * schema version + migrations + reconcile against the default profile
-- * a failed load kicks the player instead of overwriting real data with a
--   fresh profile (in Studio without API access it runs in session mode)
--
-- Gameplay code reads/writes the in-memory profile through this module only.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local CarCatalog = require(Shared.CarCatalog)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Paints = require(Shared.Paints)
local Signal = require(Shared.Util.Signal)
local Types = require(Shared.Types)

type Profile = Types.Profile

local PlayerData = {}
PlayerData.Loaded = Signal.new() -- (player, profile)
PlayerData.Changed = Signal.new() -- (player, profile)
PlayerData.CashChanged = Signal.new() -- (player, newCash, delta, reason)

local CURRENT_VERSION = 2
local IS_STUDIO = RunService:IsStudio()

type State = {
	data: Profile,
	persistent: boolean, -- false = session only (Studio without API / failed lock)
	released: boolean,
	lastPush: number,
	pushQueued: boolean,
	saving: boolean,
}

local states: { [Player]: State } = {}
local store: DataStore? = nil

--------------------------------------------------------------------------------
-- Profile shape
--------------------------------------------------------------------------------

local function defaultProfile(): Profile
	local starter = CarCatalog.get(Config.StarterCarId)
	local owned = {}
	local cars = {}
	if starter then
		owned[starter.id] = true
		cars[starter.id] = CarCatalog.defaultSave(starter)
	end
	return {
		version = CURRENT_VERSION,
		cash = Config.StartingCash,
		owned = owned,
		cars = cars,
		selected = Config.StarterCarId,
		bestTimes = {},
		medals = {},
		topSpeed = 0,
		stats = { distance = 0, drifts = 0, airtime = 0, races = 0, earned = 0 },
		daily = { last = 0, streak = 0 },
		finishes = {},
	}
end
PlayerData.defaultProfile = defaultProfile

local MIGRATIONS: { [number]: (any) -> any } = {
	-- v1 -> v2: medals and owned finishes were added
	[1] = function(data)
		data.medals = data.medals or {}
		data.finishes = data.finishes or {}
		return data
	end,
}

local function migrate(data: any): any
	data.version = tonumber(data.version) or 1
	while data.version < CURRENT_VERSION do
		local step = MIGRATIONS[data.version]
		if not step then
			error("missing migration from v" .. tostring(data.version))
		end
		data = step(data)
		data.version += 1
	end
	return data
end

local function num(v: any, default: number, lo: number?, hi: number?): number
	local n = tonumber(v)
	if not n or n ~= n then
		return default
	end
	if lo then
		n = math.max(lo, n)
	end
	if hi then
		n = math.min(hi, n)
	end
	return n
end

-- Fills in missing fields and drops garbage so the rest of the game can trust the shape.
local function reconcile(data: any): Profile
	local base = defaultProfile()
	if typeof(data) ~= "table" then
		return base
	end
	local out = base
	out.version = CURRENT_VERSION
	out.cash = math.floor(num(data.cash, base.cash, 0, 1e12))
	out.topSpeed = num(data.topSpeed, 0, 0, 1e4)
	if typeof(data.owned) == "table" then
		for id, v in data.owned do
			if typeof(id) == "string" and v == true then
				out.owned[id] = true
			end
		end
	end
	if typeof(data.cars) == "table" then
		for id, save in data.cars do
			local def = CarCatalog.get(id)
			if def and typeof(save) == "table" then
				local d = CarCatalog.defaultSave(def)
				d.paint = if Paints.isValidIndex(save.paint) then save.paint else d.paint
				d.accent = if Paints.isValidIndex(save.accent) then save.accent else d.accent
				d.rim = if Paints.isValidIndex(save.rim) then save.rim else d.rim
				d.finish = if Paints.isValidFinish(save.finish) then save.finish else "Gloss"
				d.glow = if save.glow == 0 or Paints.isValidIndex(save.glow) then save.glow else 0
				d.glowOwned = save.glowOwned == true
				d.engine = math.floor(num(save.engine, 0, 0, Config.Upgrades.Engine.MaxLevel))
				d.tires = math.floor(num(save.tires, 0, 0, Config.Upgrades.Tires.MaxLevel))
				d.nitro = math.floor(num(save.nitro, 0, 0, Config.Upgrades.Nitro.MaxLevel))
				out.cars[id] = d
			end
		end
	end
	-- every owned car needs a customization entry
	for id in out.owned do
		local def = CarCatalog.get(id)
		if def and not out.cars[id] then
			out.cars[id] = CarCatalog.defaultSave(def)
		end
	end
	if typeof(data.selected) == "string" and out.owned[data.selected] then
		out.selected = data.selected
	end
	for _, key in { "bestTimes", "medals", "finishes" } do
		local src = data[key]
		if typeof(src) == "table" then
			for k, v in src do
				if typeof(k) == "string" and (typeof(v) == "number" or typeof(v) == "string" or v == true) then
					(out :: any)[key][k] = v
				end
			end
		end
	end
	if typeof(data.stats) == "table" then
		for k, v in out.stats do
			(out.stats :: any)[k] = num(data.stats[k], v, 0)
		end
	end
	if typeof(data.daily) == "table" then
		out.daily.last = num(data.daily.last, 0, 0)
		out.daily.streak = math.floor(num(data.daily.streak, 0, 0, 1000))
	end
	return out
end
PlayerData.reconcile = reconcile

--------------------------------------------------------------------------------
-- DataStore helpers
--------------------------------------------------------------------------------

local function withRetry(attempts: number, fn: () -> ()): (boolean, any)
	local delaySeconds = 1
	local lastErr
	for attempt = 1, attempts do
		local ok, err = pcall(fn)
		if ok then
			return true, nil
		end
		lastErr = err
		warn(string.format("[PlayerData] attempt %d/%d failed: %s", attempt, attempts, tostring(err)))
		if attempt < attempts then
			task.wait(delaySeconds)
			delaySeconds = math.min(delaySeconds * 2, 16)
		end
	end
	return false, lastErr
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function lockIsForeign(lock: any): boolean
	if typeof(lock) ~= "table" then
		return false
	end
	if lock.job == game.JobId then
		return false
	end
	local age = os.time() - (tonumber(lock.time) or 0)
	return age < Config.SessionLockTimeout
end

-- Claims the session lock and returns the stored profile.
-- status: "ok" | "locked" | "error"
local function claim(player: Player): (string, Profile?)
	local status = "error"
	local loaded: Profile? = nil
	local ok = withRetry(4, function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old)
			if old ~= nil and lockIsForeign(old.lock) then
				status = "locked"
				return nil -- abort: another server owns this save
			end
			local data = if old == nil then defaultProfile() else reconcile(migrate(old))
			loaded = data
			status = "ok"
			local stored = table.clone(data) :: any
			stored.lock = { job = game.JobId, time = os.time() }
			return stored
		end)
	end)
	if not ok then
		return "error", nil
	end
	return status, loaded
end

-- Writes the profile. `release` clears the lock (leave / shutdown).
local function save(player: Player, release: boolean): boolean
	local state = states[player]
	if not state or not state.persistent or not store then
		return true
	end
	if state.saving and not release then
		return true
	end
	state.saving = true
	local snapshot = HttpService:JSONDecode(HttpService:JSONEncode(state.data))
	local lostLock = false
	local ok = withRetry(if release then 5 else 3, function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old)
			if old ~= nil and lockIsForeign(old.lock) then
				lostLock = true
				return nil
			end
			snapshot.lock = if release then nil else { job = game.JobId, time = os.time() }
			return snapshot
		end)
	end)
	state.saving = false
	if lostLock then
		-- another server took over (e.g. very long lag spike); stop writing to avoid dupes
		warn("[PlayerData] lost session lock for " .. player.Name .. ", disabling saves")
		state.persistent = false
		return false
	end
	return ok
end

--------------------------------------------------------------------------------
-- Client snapshot + leaderstats
--------------------------------------------------------------------------------

function PlayerData.publicSnapshot(data: Profile)
	return {
		cash = data.cash,
		owned = data.owned,
		cars = data.cars,
		selected = data.selected,
		bestTimes = data.bestTimes,
		medals = data.medals,
		topSpeed = data.topSpeed,
		stats = data.stats,
		daily = data.daily,
		finishes = data.finishes,
		serverTime = os.time(),
	}
end

local function pushNow(player: Player)
	local state = states[player]
	if not state or not player.Parent then
		return
	end
	state.lastPush = os.clock()
	state.pushQueued = false
	Net.fire(player, "Profile", PlayerData.publicSnapshot(state.data))
end

-- Sends the snapshot at most 4 times per second.
local function queuePush(player: Player)
	local state = states[player]
	if not state or state.pushQueued then
		return
	end
	local wait = 0.25 - (os.clock() - state.lastPush)
	if wait <= 0 then
		pushNow(player)
	else
		state.pushQueued = true
		task.delay(wait, pushNow, player)
	end
end

local function updateLeaderstats(player: Player, data: Profile)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local cash = Instance.new("IntValue")
		cash.Name = "Cash"
		cash.Parent = ls
		local cars = Instance.new("IntValue")
		cars.Name = "Cars"
		cars.Parent = ls
		ls.Parent = player
	end
	local count = 0
	for _ in data.owned do
		count += 1
	end
	(ls :: any).Cash.Value = math.min(data.cash, 2 ^ 31 - 1);
	(ls :: any).Cars.Value = count
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

function PlayerData.get(player: Player): Profile?
	local state = states[player]
	return if state then state.data else nil
end

function PlayerData.isPersistent(player: Player): boolean
	local state = states[player]
	return state ~= nil and state.persistent
end

function PlayerData.waitFor(player: Player, timeout: number?): Profile?
	local deadline = os.clock() + (timeout or 30)
	while player.Parent and os.clock() < deadline do
		local data = PlayerData.get(player)
		if data then
			return data
		end
		task.wait(0.1)
	end
	return PlayerData.get(player)
end

-- Mutates the profile through a callback, then syncs leaderstats and the client.
function PlayerData.update(player: Player, fn: (Profile) -> ())
	local state = states[player]
	if not state then
		return
	end
	fn(state.data)
	updateLeaderstats(player, state.data)
	queuePush(player)
	PlayerData.Changed:Fire(player, state.data)
end

function PlayerData.addCash(player: Player, amount: number, reason: string?): boolean
	local state = states[player]
	if not state or amount ~= amount then
		return false
	end
	amount = math.floor(amount)
	if amount == 0 then
		return true
	end
	PlayerData.update(player, function(data)
		data.cash = math.max(0, data.cash + amount)
		if amount > 0 then
			data.stats.earned += amount
		end
	end)
	PlayerData.CashChanged:Fire(player, state.data.cash, amount, reason)
	return true
end

-- Atomically checks and spends cash. Returns false if the player can't afford it.
function PlayerData.spend(player: Player, amount: number, reason: string?): boolean
	local state = states[player]
	if not state or amount ~= amount or amount < 0 then
		return false
	end
	amount = math.floor(amount)
	if state.data.cash < amount then
		return false
	end
	PlayerData.update(player, function(data)
		data.cash -= amount
	end)
	PlayerData.CashChanged:Fire(player, state.data.cash, -amount, reason)
	return true
end

function PlayerData.reset(player: Player)
	local state = states[player]
	if not state then
		return
	end
	state.data = defaultProfile()
	PlayerData.update(player, function() end)
end

function PlayerData.forcePush(player: Player)
	pushNow(player)
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	local data: Profile? = nil
	local persistent = false
	local message: string? = nil

	if store then
		local status, loaded
		for _ = 1, 5 do
			status, loaded = claim(player)
			if status ~= "locked" then
				break
			end
			-- the previous server may still be releasing the lock
			task.wait(3)
			if not player.Parent then
				return
			end
		end
		if status == "ok" then
			data = loaded
			persistent = true
		elseif IS_STUDIO then
			data = defaultProfile()
			message = "DataStudio"
		else
			player:Kick(
				if status == "locked"
					then "Ваши данные ещё сохраняются на другом сервере. Перезайдите через минуту. / Your data is still saving on another server, please rejoin in a minute."
					else "Не удалось загрузить сохранение. Перезайдите. / Could not load your save, please rejoin."
			)
			return
		end
	else
		data = defaultProfile()
		message = "DataStudio"
	end

	if not player.Parent then
		-- left while loading: release the lock we just took
		if persistent then
			states[player] = {
				data = data :: Profile,
				persistent = true,
				released = false,
				lastPush = 0,
				pushQueued = false,
				saving = false,
			}
			save(player, true)
			states[player] = nil
		end
		return
	end

	states[player] = {
		data = data :: Profile,
		persistent = persistent,
		released = false,
		lastPush = 0,
		pushQueued = false,
		saving = false,
	}
	updateLeaderstats(player, data :: Profile)
	pushNow(player)
	if message then
		Net.notify(player, message, {}, "warning")
	end
	PlayerData.Loaded:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local state = states[player]
	if not state or state.released then
		states[player] = nil
		return
	end
	state.released = true
	save(player, true)
	states[player] = nil
end

function PlayerData.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStores unavailable: " .. tostring(result))
		store = nil
	end
end

function PlayerData.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	game:BindToClose(function()
		local pending = 0
		for player, state in states do
			if not state.released then
				state.released = true
				pending += 1
				task.spawn(function()
					save(player, true)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + (if IS_STUDIO then 3 else 25)
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	-- staggered autosave: each player saves at their own offset within the interval
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.time()
			for player, state in states do
				if state.persistent and not state.released then
					local offset = player.UserId % Config.AutosaveInterval
					if (now + offset) % Config.AutosaveInterval < 5 then
						task.spawn(save, player, false)
					end
				end
			end
		end
	end)
end

return PlayerData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Races</string>
            <string name="Source"><![CDATA[-- Races: solo time trials on every track. The server teleports the car to the
-- start, runs the countdown, detects checkpoint crossings (plane crossing, so
-- it works at any speed), validates timing and pays medals and records.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)

local Leaderboards = require(script.Parent.Leaderboards)
local PlayerData = require(script.Parent.PlayerData)
local Vehicles = require(script.Parent.Vehicles)
local World = require(script.Parent.World)

local Races = {}

type Race = {
	trackId: string,
	phase: "countdown" | "racing",
	startClock: number,
	nextIndex: number,
	lap: number,
	lastCpClock: number,
	lastPos: Vector3?,
	outOfCarSince: number?,
	car: Model,
	token: number,
}

local races: { [Player]: Race } = {}
local tokens = 0

local MEDALS = { "Gold", "Silver", "Bronze" }

local function send(player: Player, payload: { [string]: any })
	Net.fire(player, "RaceState", payload)
end

local function unfreeze(race: Race, player: Player)
	local chassis = race.car.PrimaryPart
	if chassis and chassis.Parent then
		chassis.Anchored = false
		Vehicles.setOwner(race.car, player)
	end
end

function Races.cancel(player: Player, reason: string?)
	local race = races[player]
	if not race then
		return
	end
	races[player] = nil
	unfreeze(race, player)
	send(player, { phase = "cancelled", reason = reason or "RaceCancelled" })
end

function Races.isRacing(player: Player): boolean
	return races[player] ~= nil
end

local function checkpointPayload(trackId: string)
	local data = World.getTrack(trackId)
	if not data then
		return {}
	end
	local list = {}
	for _, cp in data.checkpoints do
		table.insert(list, { cf = cp.cf, width = cp.width })
	end
	return list
end

function Races.begin(player: Player, trackId: any)
	local track = World.getTrack(trackId)
	if not track then
		return { ok = false }
	end
	local car = Vehicles.getCar(player)
	if not car then
		return { ok = false, message = "NeedCar" }
	end
	if not Vehicles.isDriving(player) then
		return { ok = false, message = "MustDrive" }
	end
	if races[player] then
		Races.cancel(player, "RaceCancelled")
	end
	local data = PlayerData.get(player)
	if not data then
		return { ok = false }
	end

	-- move to the start and hold the car during the countdown
	Vehicles.placeAt(car, track.start)
	local chassis = car.PrimaryPart :: BasePart
	chassis.Anchored = true
	tokens += 1
	local race: Race = {
		trackId = track.id,
		phase = "countdown",
		startClock = 0,
		nextIndex = 1,
		lap = 1,
		lastCpClock = 0,
		lastPos = nil,
		outOfCarSince = nil,
		car = car,
		token = tokens,
	}
	races[player] = race
	local countdown = Config.Races.CountdownSeconds
	send(player, {
		phase = "countdown",
		trackId = track.id,
		goAt = workspace:GetServerTimeNow() + countdown,
		checkpoints = checkpointPayload(track.id),
		laps = track.laps,
		medals = track.medals,
		best = data.bestTimes[track.id],
	})
	local token = race.token
	task.delay(countdown, function()
		local current = races[player]
		if not current or current.token ~= token then
			return
		end
		unfreeze(current, player)
		current.phase = "racing"
		current.startClock = os.clock()
		current.lastCpClock = current.startClock
		current.lastPos = chassis.Position
		send(player, { phase = "racing", nextIndex = 1, lap = 1 })
	end)
	return { ok = true }
end

local function medalFor(seconds: number, medals): string?
	for _, m in MEDALS do
		if seconds <= medals[string.lower(m)] then
			return m
		end
	end
	return nil
end

local function finish(player: Player, race: Race)
	races[player] = nil
	local track = World.getTrack(race.trackId)
	local data = PlayerData.get(player)
	if not track or not data then
		return
	end
	local seconds = os.clock() - race.startClock
	local medal = medalFor(seconds, track.medals)
	local previousBest = data.bestTimes[race.trackId]
	local newRecord = previousBest == nil or seconds < previousBest

	-- rewards: base + medal (full the first time a medal tier is reached)
	local reward = Config.Races.FinishReward
	local medalRank = { Gold = 3, Silver = 2, Bronze = 1 }
	local prevMedal = data.medals[race.trackId]
	if medal then
		local full = (Config.Races.MedalRewards :: any)[medal] :: number
		local firstTime = prevMedal == nil or (medalRank[medal] or 0) > (medalRank[prevMedal] or 0)
		reward += if firstTime then full else math.floor(full * Config.Races.RepeatMedalShare)
	end
	-- longer tracks pay more
	reward = math.floor(reward * math.clamp(track.length / 3000, 0.7, 2.5))

	PlayerData.update(player, function(p)
		p.stats.races += 1
		if newRecord then
			p.bestTimes[race.trackId] = seconds
		end
		if medal and (prevMedal == nil or medalRank[medal] > (medalRank[prevMedal] or 0)) then
			p.medals[race.trackId] = medal
		end
	end)
	PlayerData.addCash(player, reward, "race")
	if newRecord then
		Leaderboards.submitTime(player, race.trackId, seconds)
	end
	send(player, {
		phase = "finished",
		trackId = race.trackId,
		time = seconds,
		medal = medal,
		reward = reward,
		newRecord = newRecord,
		best = if newRecord then seconds else previousBest,
		timeText = Format.time(seconds),
	})
end

-- Did the car cross the checkpoint plane between two positions?
local function crossed(cp, a: Vector3, b: Vector3): boolean
	local la = cp.cf:PointToObjectSpace(a)
	local lb = cp.cf:PointToObjectSpace(b)
	-- gates look along the track: behind = +Z, ahead = -Z
	if not (la.Z > 0 and lb.Z <= 0) then
		return false
	end
	local t = la.Z / (la.Z - lb.Z)
	local hit = la:Lerp(lb, t)
	return math.abs(hit.X) <= cp.width / 2 + 8 and hit.Y > -12 and hit.Y < 40
end

local function tick()
	local now = os.clock()
	for player, race in races do
		if race.phase ~= "racing" then
			continue
		end
		local car = race.car
		local chassis = car.PrimaryPart
		if not car.Parent or not chassis then
			Races.cancel(player, "RaceCancelled")
			continue
		end
		if not Vehicles.isDriving(player) then
			race.outOfCarSince = race.outOfCarSince or now
			if now - race.outOfCarSince > 3 then
				Races.cancel(player, "RaceLeftCar")
			end
			continue
		end
		race.outOfCarSince = nil
		if now - race.lastCpClock > Config.Races.CheckpointTimeout then
			Races.cancel(player, "RaceTimeout")
			continue
		end
		local track = World.getTrack(race.trackId)
		if not track then
			continue
		end
		local pos = chassis.Position
		local prev = race.lastPos or pos
		race.lastPos = pos
		local cp = track.checkpoints[race.nextIndex]
		if cp and crossed(cp, prev, pos) then
			-- sanity: the car can't have covered the distance faster than its top speed allows
			local prevCp = track.checkpoints[race.nextIndex - 1]
			local from = if prevCp then prevCp.cf.Position else track.start.Position
			local dist = (cp.cf.Position - from).Magnitude
			local maxSpeed = (car:GetAttribute("MaxSpeed") or 200) * 1.75
			if now - race.lastCpClock < dist / maxSpeed - 0.3 then
				Races.cancel(player, "RaceInvalid")
				continue
			end
			race.lastCpClock = now
			race.nextIndex += 1
			if race.nextIndex > #track.checkpoints then
				if race.lap >= track.laps then
					finish(player, race)
					continue
				end
				race.lap += 1
				race.nextIndex = 1
			end
			send(player, { phase = "racing", nextIndex = race.nextIndex, lap = race.lap, split = now - race.startClock })
		end
	end
end

function Races.init()
	Net.handle("StartRace", function(player, trackId)
		return Races.begin(player, trackId)
	end)
	Net.handle("LeaveRace", function(player)
		Races.cancel(player, "RaceCancelled")
		return { ok = true }
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local trackId = prompt:GetAttribute("TrackId")
		if typeof(trackId) ~= "string" then
			return
		end
		local result = Races.begin(player, trackId)
		if not result.ok and result.message then
			Net.notify(player, result.message, result.args, "warning")
		end
	end)
	Vehicles.Despawned:Connect(function(player)
		Races.cancel(player, "RaceCancelled")
	end)
	Players.PlayerRemoving:Connect(function(player)
		races[player] = nil
	end)
end

function Races.start()
	task.spawn(function()
		while true do
			task.wait(0.05)
			local ok, err = pcall(tick)
			if not ok then
				warn("[Races] " .. tostring(err))
			end
		end
	end)
end

return Races
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[-- Shop: buying cars, upgrades, paint and the daily reward. Every request is
-- validated here; prices come from the shared catalog/config, never the client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local CarCatalog = require(Shared.CarCatalog)
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Net = require(Shared.Net)
local Paints = require(Shared.Paints)

local PlayerData = require(script.Parent.PlayerData)
local Vehicles = require(script.Parent.Vehicles)

local Shop = {}

local DAY = 86400

local function needMore(player: Player, price: number)
	local data = PlayerData.get(player)
	local missing = price - (if data then data.cash else 0)
	return { ok = false, message = "NotEnoughCash", args = { Format.money(missing) } }
end

function Shop.buyCar(player: Player, carId: any)
	local data = PlayerData.get(player)
	local def = CarCatalog.get(carId)
	if not data or not def then
		return { ok = false }
	end
	if data.owned[def.id] then
		return { ok = false, message = "AlreadyOwned" }
	end
	if not PlayerData.spend(player, def.price, "car:" .. def.id) then
		return needMore(player, def.price)
	end
	PlayerData.update(player, function(p)
		p.owned[def.id] = true
		p.cars[def.id] = p.cars[def.id] or CarCatalog.defaultSave(def)
		p.selected = def.id
	end)
	return { ok = true, message = "Purchased", args = { def.name } }
end

local UPGRADE_FIELD = { Engine = "engine", Tires = "tires", Nitro = "nitro" }

function Shop.buyUpgrade(player: Player, carId: any, kind: any)
	local data = PlayerData.get(player)
	local def = CarCatalog.get(carId)
	if not data or not def or typeof(kind) ~= "string" then
		return { ok = false }
	end
	local field = UPGRADE_FIELD[kind]
	local spec = (Config.Upgrades :: any)[kind]
	if not field or not spec then
		return { ok = false }
	end
	if not data.owned[def.id] then
		return { ok = false, message = "NotOwned" }
	end
	local save = data.cars[def.id]
	local level = (save :: any)[field] :: number
	if level >= spec.MaxLevel then
		return { ok = false, message = "MaxLevel" }
	end
	local price = CarCatalog.getUpgradePrice(def, kind, level + 1) :: number
	if not PlayerData.spend(player, price, "upgrade:" .. kind) then
		return needMore(player, price)
	end
	PlayerData.update(player, function(p)
		local s = p.cars[def.id] :: any
		s[field] = level + 1
	end)
	Vehicles.refresh(player)
	return { ok = true, message = "Upgraded", args = { "Upgrade" .. (if kind == "Nitro" then "Nitro" else kind), level + 1 } }
end

-- slot: "paint" | "accent" | "rim" | "glow" | "finish"
function Shop.setPaint(player: Player, carId: any, slot: any, value: any)
	local data = PlayerData.get(player)
	local def = CarCatalog.get(carId)
	if not data or not def or typeof(slot) ~= "string" then
		return { ok = false }
	end
	if not data.owned[def.id] then
		return { ok = false, message = "NotOwned" }
	end
	local save = data.cars[def.id]
	local cust = Config.Customization
	local price = 0
	local apply: (any) -> ()

	if slot == "paint" or slot == "accent" or slot == "rim" then
		if not Paints.isValidIndex(value) then
			return { ok = false }
		end
		if (save :: any)[slot] == value then
			return { ok = true }
		end
		price = if slot == "paint" then cust.PaintPrice elseif slot == "accent" then cust.AccentPrice else cust.RimPrice
		apply = function(s)
			s[slot] = value
		end
	elseif slot == "glow" then
		if value ~= 0 and not Paints.isValidIndex(value) then
			return { ok = false }
		end
		if save.glow == value then
			return { ok = true }
		end
		if value == 0 then
			price = 0
		elseif not save.glowOwned then
			price = cust.UnderglowPrice
		else
			price = cust.PaintPrice
		end
		apply = function(s)
			s.glow = value
			if value ~= 0 then
				s.glowOwned = true
			end
		end
	elseif slot == "finish" then
		if not Paints.isValidFinish(value) then
			return { ok = false }
		end
		if save.finish == value then
			return { ok = true }
		end
		-- a finish is unlocked once for the whole garage
		price = if data.finishes[value] or value == "Gloss" then 0 else ((cust.FinishPrices :: any)[value] or 0)
		apply = function(s)
			s.finish = value
		end
	else
		return { ok = false }
	end

	if price > 0 and not PlayerData.spend(player, price, "paint:" .. slot) then
		return needMore(player, price)
	end
	local firstGlow = slot == "glow" and value ~= 0 and not save.glowOwned
	PlayerData.update(player, function(p)
		apply(p.cars[def.id])
		if slot == "finish" then
			p.finishes[value] = true
		end
	end)
	Vehicles.refresh(player)
	return { ok = true, message = if firstGlow then "GlowBought" else "PaintApplied" }
end

function Shop.claimDaily(player: Player)
	local data = PlayerData.get(player)
	if not data then
		return { ok = false }
	end
	local now = os.time()
	local today = math.floor(now / DAY)
	local lastDay = math.floor(data.daily.last / DAY)
	if data.daily.last > 0 and lastDay >= today then
		local left = (today + 1) * DAY - now
		return { ok = false, message = "DailyNotReady", args = { string.format("%d:%02d", left // 3600, (left % 3600) // 60) } }
	end
	local streak = if lastDay == today - 1 then math.min(data.daily.streak + 1, Config.Daily.MaxStreak) else 1
	local amount = Config.Daily.Base + Config.Daily.StreakBonus * (streak - 1)
	PlayerData.update(player, function(p)
		p.daily.last = now
		p.daily.streak = streak
	end)
	PlayerData.addCash(player, amount, "daily")
	return { ok = true, message = "DailyClaimed", args = { Format.money(amount), streak } }
end

function Shop.init()
	Net.handle("BuyCar", function(player, carId)
		return Shop.buyCar(player, carId)
	end)
	Net.handle("BuyUpgrade", function(player, carId, kind)
		return Shop.buyUpgrade(player, carId, kind)
	end)
	Net.handle("SetPaint", function(player, carId, slot, value)
		return Shop.setPaint(player, carId, slot, value)
	end)
	Net.handle("ClaimDaily", function(player)
		return Shop.claimDaily(player)
	end)
	Net.handle("SelectCar", function(player, carId)
		local data = PlayerData.get(player)
		if data and typeof(carId) == "string" and data.owned[carId] then
			PlayerData.update(player, function(p)
				p.selected = carId
			end)
			return { ok = true }
		end
		return { ok = false }
	end)
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Vehicles</string>
            <string name="Source"><![CDATA[-- Vehicles: spawning, seating, ownership and driver actions for player cars.
--
-- Every player owns at most one spawned car. The owner's client simulates it
-- (network owner) with CarPhysics; the server keeps ownership, seats and
-- attributes consistent and validates every action.

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local CarBuilder = require(Shared.CarBuilder)
local CarCatalog = require(Shared.CarCatalog)
local CarPhysics = require(Shared.CarPhysics)
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local Vehicles = {}
Vehicles.Spawned = Signal.new() -- (player, model)
Vehicles.Despawned = Signal.new() -- (player)
Vehicles.DriverChanged = Signal.new() -- (player, model, isDriving)

local cars: { [Player]: Model } = {}
local lastSpawn: { [Player]: number } = {}
local lastFlip: { [Player]: number } = {}
local carsFolder: Folder

--------------------------------------------------------------------------------
-- Collision groups
--------------------------------------------------------------------------------

local function setupCollisionGroups()
	for _, name in { "Cars", "Players", "WheelRays" } do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	-- wheel rays only see the world (terrain, roads, ramps)
	PhysicsService:CollisionGroupSetCollidable("WheelRays", "Cars", false)
	PhysicsService:CollisionGroupSetCollidable("WheelRays", "Players", false)
	PhysicsService:CollisionGroupSetCollidable("WheelRays", "WheelRays", false)
end

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

function Vehicles.getCar(player: Player): Model?
	local car = cars[player]
	if car and car.Parent then
		return car
	end
	return nil
end

local function humanoidOf(player: Player): Humanoid?
	local char = player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then
		return hum
	end
	return nil
end

function Vehicles.isDriving(player: Player): boolean
	local car = Vehicles.getCar(player)
	local hum = humanoidOf(player)
	if not car or not hum then
		return false
	end
	local seat = car:FindFirstChild("DriveSeat")
	return seat ~= nil and hum.SeatPart == seat
end

local function ownerOf(car: Model): Player?
	return Players:GetPlayerByUserId(car:GetAttribute("OwnerUserId") or 0)
end

local function setOwner(car: Model, player: Player?)
	local chassis = car.PrimaryPart
	if not chassis or chassis.Anchored or not chassis:IsDescendantOf(workspace) then
		return
	end
	pcall(function()
		if chassis:CanSetNetworkOwnership() then
			chassis:SetNetworkOwner(player)
		end
	end)
end

local function chassisLocal(car: Model): CFrame
	local stored = car:GetAttribute("ChassisLocal")
	if typeof(stored) == "CFrame" then
		return stored
	end
	return CFrame.new(0, 1.5, 0)
end

-- Places a car so its ground contact sits on `groundCf`.
function Vehicles.placeAt(car: Model, groundCf: CFrame)
	local chassis = car.PrimaryPart
	if not chassis then
		return
	end
	car:PivotTo(groundCf * chassisLocal(car) * CFrame.new(0, 0.6, 0))
	chassis.AssemblyLinearVelocity = Vector3.zero
	chassis.AssemblyAngularVelocity = Vector3.zero
end

local function padIsFree(cf: CFrame, ignore: Model?): boolean
	for _, car in carsFolder:GetChildren() do
		if car ~= ignore and car:IsA("Model") and car.PrimaryPart then
			if (car.PrimaryPart.Position - cf.Position).Magnitude < 20 then
				return false
			end
		end
	end
	return true
end

-- A free spot on the ground right next to the player (used away from the plaza).
local function spotNearPlayer(player: Player, def, ignore: Model?): CFrame?
	local char = player.Character
	local root = char and char.PrimaryPart
	if not root then
		return nil
	end
	local extents = CarBuilder.getExtents(def)
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, -1)
	end
	flat = flat.Unit
	local right = Vector3.new(-flat.Z, 0, flat.X)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { char, carsFolder }
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { char, workspace.Terrain, carsFolder }
	overlap.RespectCanCollide = true
	local gap = extents.X / 2 + 6
	for _, offset in { flat * (extents.Z / 2 + 6), right * gap, -right * gap, -flat * (extents.Z / 2 + 6) } do
		local probe = root.Position + offset
		local hit = workspace:Raycast(probe + Vector3.new(0, 10, 0), Vector3.new(0, -40, 0), rayParams)
		if hit and hit.Normal.Y > 0.85 then
			local ground = CFrame.lookAt(hit.Position, hit.Position + flat)
			local boxCf = ground * CFrame.new(0, extents.Y / 2 + 0.8, 0)
			local blocking = workspace:GetPartBoundsInBox(boxCf, extents + Vector3.new(1, 0, 1), overlap)
			if #blocking == 0 and padIsFree(ground, ignore) then
				return ground
			end
		end
	end
	return nil
end

local function findSpawn(player: Player): CFrame?
	local pads = World.Layout.SpawnPads
	local origin = Vector3.zero
	local char = player.Character
	if char and char.PrimaryPart then
		origin = char.PrimaryPart.Position
	end
	local order = table.clone(pads)
	table.sort(order, function(a, b)
		return (a.Position - origin).Magnitude < (b.Position - origin).Magnitude
	end)
	for _, cf in order do
		if padIsFree(cf, nil) then
			return cf
		end
	end
	return nil
end

local function applyStats(car: Model, player: Player)
	local data = PlayerData.get(player)
	local def = CarCatalog.get(car:GetAttribute("CarId"))
	if not data or not def then
		return
	end
	local save = data.cars[def.id]
	CarPhysics.writeStats(car, CarCatalog.getEffectiveStats(def, save))
end

-- Re-applies paint/upgrades after a purchase in the garage.
function Vehicles.refresh(player: Player)
	local car = Vehicles.getCar(player)
	local data = PlayerData.get(player)
	if not car or not data then
		return
	end
	local id = car:GetAttribute("CarId")
	local save = data.cars[id]
	if save then
		CarBuilder.applyPaint(car, save)
	end
	applyStats(car, player)
end

--------------------------------------------------------------------------------
-- Seats
--------------------------------------------------------------------------------

local function seatPlayer(player: Player, seat: Seat | VehicleSeat): boolean
	local hum = humanoidOf(player)
	if not hum or seat.Occupant then
		return false
	end
	local root = (player.Character :: Model).PrimaryPart
	if not root or (root.Position - seat.Position).Magnitude > 60 then
		return false
	end
	if hum.SeatPart then
		local weld = hum.SeatPart:FindFirstChild("SeatWeld")
		if weld then
			weld:Destroy()
		end
	end
	seat:Sit(hum)
	return true
end

local function exitSeat(player: Player)
	local hum = humanoidOf(player)
	if not hum or not hum.SeatPart then
		return
	end
	local seat = hum.SeatPart
	local car = seat:FindFirstAncestorOfClass("Model")
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	hum.Sit = false
	-- step out beside the car instead of on its roof
	local char = player.Character
	if char and car and car.PrimaryPart then
		local size = car:GetExtentsSize()
		local side = if seat.CFrame:PointToObjectSpace(car.PrimaryPart.Position).X > 0 then -1 else 1
		local out = seat.CFrame * CFrame.new(side * (size.X / 2 + 3), 0, 0)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { car, char }
		local hit = workspace:Raycast(out.Position + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), params)
		local y = if hit then hit.Position.Y else out.Position.Y
		local look = car.PrimaryPart.CFrame.LookVector
		local pos = Vector3.new(out.Position.X, y + 3.5, out.Position.Z)
		task.defer(function()
			if char.Parent then
				char:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(look.X, 0, look.Z)))
			end
		end)
	end
end
Vehicles.exitSeat = exitSeat

local function wireCar(car: Model, owner: Player)
	local driveSeat = car:FindFirstChild("DriveSeat") :: VehicleSeat?
	if driveSeat then
		driveSeat:GetPropertyChangedSignal("Occupant"):Connect(function()
			local occ = driveSeat.Occupant
			if occ then
				local p = Players:GetPlayerFromCharacter(occ.Parent)
				if p ~= owner then
					-- only the owner may drive
					local weld = driveSeat:FindFirstChild("SeatWeld")
					if weld then
						weld:Destroy()
					end
					return
				end
				setOwner(car, owner)
				Vehicles.DriverChanged:Fire(owner, car, true)
			else
				Vehicles.DriverChanged:Fire(owner, car, false)
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Spawning
--------------------------------------------------------------------------------

function Vehicles.despawn(player: Player)
	local car = cars[player]
	cars[player] = nil
	if car then
		-- free anyone sitting inside first
		for _, seat in car:GetChildren() do
			if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
				local weld = seat:FindFirstChild("SeatWeld")
				if weld then
					weld:Destroy()
				end
			end
		end
		car:Destroy()
		Vehicles.Despawned:Fire(player)
	end
end

export type SpawnResult = { ok: boolean, message: string?, args: { any }? }

function Vehicles.spawn(player: Player, carId: string): SpawnResult
	local data = PlayerData.get(player)
	local def = CarCatalog.get(carId)
	if not data or not def then
		return { ok = false }
	end
	if not data.owned[def.id] then
		return { ok = false, message = "NotOwned" }
	end
	local now = os.clock()
	local wait = Config.SpawnCooldown - (now - (lastSpawn[player] or -math.huge))
	if wait > 0 then
		return { ok = false, message = "SpawnCooldown", args = { math.ceil(wait) } }
	end

	local old = cars[player]
	local pad = findSpawn(player)
	-- far from the plaza: try to put the car right next to the player
	local char = player.Character
	local root = char and char.PrimaryPart
	if root and (not pad or (pad.Position - root.Position).Magnitude > 150) then
		pad = spotNearPlayer(player, def, old) or pad
	end
	if not pad then
		-- re-use our own pad slot if the old car was blocking one
		if old then
			for _, cf in World.Layout.SpawnPads do
				if padIsFree(cf, old) then
					pad = cf
					break
				end
			end
		end
		if not pad then
			return { ok = false, message = "NoSpawnSpace" }
		end
	end
	lastSpawn[player] = now
	Vehicles.despawn(player)

	local save = data.cars[def.id] or CarCatalog.defaultSave(def)
	local car = CarBuilder.build(def, { save = save, ownerName = player.DisplayName })
	car.Name = player.Name .. "_" .. def.id
	car:SetAttribute("OwnerUserId", player.UserId)
	car:SetAttribute("ChassisLocal", (car.PrimaryPart :: BasePart).CFrame)
	car:SetAttribute("Lights", true)
	car:SetAttribute("Siren", false)
	car:SetAttribute("Nitro", false)
	CarPhysics.writeStats(car, CarCatalog.getEffectiveStats(def, save))
	car.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	Vehicles.placeAt(car, pad)
	car.Parent = carsFolder
	CollectionService:AddTag(car, "Car")
	cars[player] = car
	setOwner(car, player)
	wireCar(car, player)

	PlayerData.update(player, function(p)
		p.selected = def.id
	end)
	Vehicles.Spawned:Fire(player, car)

	-- jump straight in
	local seat = car:FindFirstChild("DriveSeat") :: VehicleSeat?
	if seat then
		task.defer(function()
			if car.Parent then
				seatPlayer(player, seat)
			end
		end)
	end
	return { ok = true, message = "Spawned", args = { def.name } }
end

--------------------------------------------------------------------------------
-- Actions
--------------------------------------------------------------------------------

local function flip(player: Player)
	local car = Vehicles.getCar(player)
	if not car or not car.PrimaryPart or car.PrimaryPart.Anchored then
		return
	end
	local now = os.clock()
	if now - (lastFlip[player] or -math.huge) < Config.FlipCooldown then
		return
	end
	lastFlip[player] = now
	local chassis = car.PrimaryPart
	local look = chassis.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.1 then
		flatLook = Vector3.new(0, 0, -1)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { car }
	for _, p in Players:GetPlayers() do
		if p.Character then
			params:AddToFilter(p.Character)
		end
	end
	local origin = chassis.Position + Vector3.new(0, 30, 0)
	local hit = workspace:Raycast(origin, Vector3.new(0, -80, 0), params)
	local groundY = if hit then hit.Position.Y else chassis.Position.Y - 2
	local pos = Vector3.new(chassis.Position.X, groundY, chassis.Position.Z)
	Vehicles.placeAt(car, CFrame.lookAt(pos, pos + flatLook) * CFrame.new(0, 1.5, 0))
	Net.notify(player, "Flipped", {}, "info")
end

local function onVehicleAction(player: Player, action: any, value: any)
	if typeof(action) ~= "string" then
		return
	end
	local car = Vehicles.getCar(player)
	if action == "Exit" then
		exitSeat(player)
		return
	end
	if not car then
		return
	end
	local driving = Vehicles.isDriving(player)
	if action == "Flip" then
		flip(player)
	elseif action == "Lights" and driving then
		car:SetAttribute("Lights", not car:GetAttribute("Lights"))
	elseif action == "Siren" and driving and car:GetAttribute("HasSiren") then
		car:SetAttribute("Siren", not car:GetAttribute("Siren"))
	elseif action == "Horn" and driving then
		car:SetAttribute("Horn", (car:GetAttribute("Horn") or 0) + 1)
	elseif action == "Nitro" and driving then
		car:SetAttribute("Nitro", value == true)
	end
end

local function onPrompt(prompt: ProximityPrompt, player: Player)
	if prompt.Name ~= "SitPrompt" then
		return
	end
	local seat = prompt.Parent
	if not seat or not (seat:IsA("Seat") or seat:IsA("VehicleSeat")) then
		return
	end
	local car = seat:FindFirstAncestorOfClass("Model")
	if not car or not CollectionService:HasTag(car, "Car") then
		return
	end
	if seat.Name == "DriveSeat" and car:GetAttribute("OwnerUserId") ~= player.UserId then
		return
	end
	seatPlayer(player, seat :: any)
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

function Vehicles.init()
	setupCollisionGroups()
	local existing = workspace:FindFirstChild("Cars")
	if existing then
		existing:Destroy()
	end
	carsFolder = Instance.new("Folder")
	carsFolder.Name = "Cars"
	carsFolder.Parent = workspace

	Net.handle("SpawnCar", function(player, carId)
		if typeof(carId) ~= "string" then
			return { ok = false }
		end
		return Vehicles.spawn(player, carId)
	end)
	Net.handle("DespawnCar", function(player)
		Vehicles.despawn(player)
		return { ok = true, message = "CarParked" }
	end)
	Net.onEvent("VehicleAction", onVehicleAction, 12)
	ProximityPromptService.PromptTriggered:Connect(onPrompt)
end

function Vehicles.start()
	Players.PlayerRemoving:Connect(function(player)
		Vehicles.despawn(player)
		lastSpawn[player] = nil
		lastFlip[player] = nil
	end)

	-- housekeeping: void rescue and network ownership
	task.spawn(function()
		while true do
			task.wait(1)
			for player, car in cars do
				local chassis = car.PrimaryPart
				if not car.Parent or not chassis then
					cars[player] = nil
					continue
				end
				if chassis.Position.Y < Config.VoidY then
					local pad = findSpawn(player) or World.Layout.SpawnPads[1]
					Vehicles.placeAt(car, pad)
					Net.notify(player, "Rescued", {}, "warning")
				end
				if not chassis.Anchored then
					local ok, owner = pcall(chassis.GetNetworkOwner, chassis)
					if ok and owner ~= player then
						setOwner(car, player)
					end
				end
			end
		end
	end)
end

Vehicles.ownerOf = ownerOf
Vehicles.setOwner = setOwner

return Vehicles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- World: builds the map at server start (or uses one baked in Studio) and
-- exposes track data, spawn pads and bonus zones to the other systems.
--
-- Bake the map into the place (to look at or edit it in Studio):
--   require(game.ServerScriptService.CarsServer.Systems.World).bake()
-- in the Studio command bar, then save the place. The server will then skip
-- building and only compute the data.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Signal = require(Shared.Util.Signal)
local Spline = require(Shared.Util.Spline)
local Tracks = require(Shared.Tracks)

local WorldModules = script.Parent.Parent:WaitForChild("World")
local Build = require(WorldModules.Build)
local City = require(WorldModules.City)
local Decor = require(WorldModules.Decor)
local Layout = require(WorldModules.Layout)
local Plaza = require(WorldModules.Plaza)
local Roads = require(WorldModules.Roads)
local Stunts = require(WorldModules.Stunts)
local TerrainGen = require(WorldModules.TerrainGen)
local TrackBuilder = require(WorldModules.TrackBuilder)

local World = {}

World.VERSION = 3
World.Layout = Layout
World.Ready = false
World.ReadySignal = Signal.new()
World.Tracks = {} :: { [string]: TrackBuilder.TrackData }
World.Root = nil :: Folder?

local function trailInfo()
	local def = Tracks.get("trail")
	if not def then
		return nil
	end
	local samples = Spline.sample(def.points, false, 6)
	return { samples = samples, width = def.width }
end

local function buildAll(): Folder
	local existing = workspace:FindFirstChild("CarsWorld")
	if existing then
		existing:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "CarsWorld"
	root.Parent = workspace

	local trail = trailInfo()
	local started = os.clock()
	local trailHeights = TerrainGen.generate(workspace.Terrain, trail)
	print(string.format("[World] terrain %.2fs", os.clock() - started))
	Roads.build(root)
	Plaza.build(root)
	local cityTrees = City.build(root)
	Stunts.buildPark(root)
	Stunts.buildDrift(root)
	World.Tracks = TrackBuilder.build(root, trailHeights, if trail then trail.samples else nil, true)

	local paths = {}
	for _, t in Tracks.List do
		table.insert(paths, { points = t.points, clearance = t.width / 2 + 14 })
	end
	Decor.build(root, cityTrees, paths)
	root:SetAttribute("Version", World.VERSION)
	print(string.format("[World] built in %.2fs, %d instances", os.clock() - started, #root:GetDescendants()))
	return root
end

function World.bake()
	local root = buildAll()
	root:SetAttribute("Baked", true)
	print("[World] baked. Save the place to keep it.")
	return root
end

function World.getTrack(id: string): TrackBuilder.TrackData?
	return World.Tracks[id]
end

-- Name of the bonus zone the position is in ("drift" / "stunt"), if any.
function World.zoneAt(pos: Vector3): (string?, number)
	for name, zone in Layout.Zones do
		local d = pos - zone.center
		if math.abs(d.X) <= zone.size.X / 2 and math.abs(d.Z) <= zone.size.Z / 2 and d.Y <= zone.size.Y then
			return name, zone.multiplier
		end
	end
	return nil, 1
end

function World.waitUntilReady()
	while not World.Ready do
		task.wait(0.1)
	end
end

-- Building takes a few seconds, so it runs in start(); other systems wait on
-- World.Ready / World.ReadySignal where they need the map.
local function setup()
	local root = workspace:FindFirstChild("CarsWorld")
	if root and root:GetAttribute("Baked") and root:GetAttribute("Version") == World.VERSION then
		-- baked in Studio: only compute data
		local trail = trailInfo()
		local heights = if trail then TerrainGen.trailHeights(trail) else nil
		World.Tracks = TrackBuilder.build(root, heights, if trail then trail.samples else nil, false)
		World.Root = root
	else
		World.Root = buildAll()
	end
	World.Ready = true
	World.ReadySignal:Fire()
end

function World.start()
	local ok, err = pcall(setup)
	if not ok then
		warn("[World] build failed: " .. tostring(err))
		World.Ready = true
		World.ReadySignal:Fire()
	end
	-- put knocked-over cones back when nobody is around
	task.spawn(function()
		while true do
			task.wait(45)
			for _, cone in CollectionService:GetTagged("Cone") do
				if cone:IsA("BasePart") then
					local home = cone:GetAttribute("Home")
					if typeof(home) == "CFrame" and (cone.Position - home.Position).Magnitude > 3 then
						local busy = false
						for _, car in CollectionService:GetTagged("Car") do
							local pp = (car :: Model).PrimaryPart
							if pp and (pp.Position - home.Position).Magnitude < 80 then
								busy = true
								break
							end
						end
						if not busy then
							cone.AssemblyLinearVelocity = Vector3.zero
							cone.AssemblyAngularVelocity = Vector3.zero
							cone.CFrame = home
						end
					end
				end
			end
		end
	end)
end

-- keep Build referenced for command bar users who want helpers
World.Build = Build

return World
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[-- Build: small helpers for constructing the static world out of anchored parts.

local CollectionService = game:GetService("CollectionService")

local Build = {}

export type PartProps = {
	size: Vector3,
	cframe: CFrame,
	color: Color3?,
	material: Enum.Material?,
	name: string?,
	shape: Enum.PartType?,
	transparency: number?,
	collide: boolean?,
	shadow: boolean?,
	reflectance: number?,
	class: string?,
}

function Build.folder(name: string, parent: Instance): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Build.part(parent: Instance, p: PartProps): BasePart
	local part = Instance.new(p.class or "Part") :: BasePart
	part.Name = p.name or "Part"
	part.Anchored = true
	part.Size = p.size
	part.CFrame = p.cframe
	part.Color = p.color or Color3.fromRGB(163, 162, 165)
	part.Material = p.material or Enum.Material.SmoothPlastic
	part.Transparency = p.transparency or 0
	part.Reflectance = p.reflectance or 0
	part.CanCollide = if p.collide == nil then true else p.collide
	part.CastShadow = if p.shadow == nil then true else p.shadow
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if p.shape and part:IsA("Part") then
		part.Shape = p.shape
	end
	if not part.CanCollide then
		part.CanTouch = false
		part.CanQuery = false
	end
	part.Parent = parent
	return part
end

function Build.box(parent: Instance, size: Vector3, cf: CFrame, color: Color3?, material: Enum.Material?, name: string?): BasePart
	return Build.part(parent, { size = size, cframe = cf, color = color, material = material, name = name })
end

-- Wedge rising towards the local +Z of `cf`.
function Build.wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3?, material: Enum.Material?): BasePart
	return Build.part(parent, { size = size, cframe = cf, color = color, material = material, class = "WedgePart", name = "Ramp" })
end

-- Cylinder whose axis is the local X of `cf`.
function Build.cylinder(parent: Instance, length: number, diameter: number, cf: CFrame, color: Color3?, material: Enum.Material?): BasePart
	return Build.part(parent, {
		size = Vector3.new(length, diameter, diameter),
		cframe = cf,
		color = color,
		material = material,
		shape = Enum.PartType.Cylinder,
		name = "Cylinder",
	})
end

-- Vertical cylinder standing on `base` (bottom center).
function Build.pole(parent: Instance, base: Vector3, height: number, diameter: number, color: Color3?, material: Enum.Material?): BasePart
	return Build.cylinder(
		parent,
		height,
		diameter,
		CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		color,
		material
	)
end

function Build.ball(parent: Instance, diameter: number, pos: Vector3, color: Color3?, material: Enum.Material?): BasePart
	return Build.part(parent, {
		size = Vector3.new(diameter, diameter, diameter),
		cframe = CFrame.new(pos),
		color = color,
		material = material,
		shape = Enum.PartType.Ball,
		name = "Ball",
	})
end

-- Flat box between two points on the ground plane, top surface at `topY`.
function Build.strip(
	parent: Instance,
	a: Vector3,
	b: Vector3,
	width: number,
	thickness: number,
	topY: number,
	color: Color3?,
	material: Enum.Material?,
	extra: number?
): BasePart?
	local flatA = Vector3.new(a.X, 0, a.Z)
	local flatB = Vector3.new(b.X, 0, b.Z)
	local len = (flatB - flatA).Magnitude
	if len < 0.05 then
		return nil
	end
	local mid = (flatA + flatB) / 2
	local cf = CFrame.lookAt(Vector3.new(mid.X, topY - thickness / 2, mid.Z), Vector3.new(flatB.X, topY - thickness / 2, flatB.Z))
	return Build.part(parent, {
		size = Vector3.new(width, thickness, len + (extra or 0)),
		cframe = cf,
		color = color,
		material = material,
		name = "Strip",
	})
end

-- A SurfaceGui text panel. `locKey` makes the client translate it (see WorldText controller).
function Build.text(
	part: BasePart,
	face: Enum.NormalId,
	text: string,
	opts: {
		color: Color3?,
		background: Color3?,
		font: Enum.Font?,
		locKey: string?,
		locArg: string?,
		pixelsPerStud: number?,
		lightInfluence: number?,
	}?
): TextLabel
	local o = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = o.pixelsPerStud or 30
	gui.LightInfluence = o.lightInfluence or 0
	gui.MaxDistance = 600
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = if o.background then 0 else 1
	label.BackgroundColor3 = o.background or Color3.new(0, 0, 0)
	label.BorderSizePixel = 0
	label.Text = text
	label.TextScaled = true
	label.Font = o.font or Enum.Font.GothamBlack
	label.TextColor3 = o.color or Color3.new(1, 1, 1)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.1, 0)
	pad.PaddingBottom = UDim.new(0.1, 0)
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.Parent = label
	label.Parent = gui
	if o.locKey then
		label:SetAttribute("LocKey", o.locKey)
		if o.locArg then
			label:SetAttribute("LocArg", o.locArg)
		end
		CollectionService:AddTag(label, "LocText")
	end
	gui.Parent = part
	return label
end

-- Billboard style sign on two posts. Returns the board part.
function Build.sign(parent: Instance, base: CFrame, width: number, height: number, text: string, locKey: string?, color: Color3?): BasePart
	local postH = height + 6
	for _, x in { -width / 2 + 1, width / 2 - 1 } do
		Build.pole(parent, (base * CFrame.new(x, 0, 0)).Position, postH, 0.8, Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
	end
	local board = Build.box(parent, Vector3.new(width, height, 0.6), base * CFrame.new(0, 6 + height / 2, 0), color or Color3.fromRGB(24, 28, 40))
	board.Name = "Sign"
	Build.text(board, Enum.NormalId.Front, text, { locKey = locKey, color = Color3.fromRGB(255, 255, 255) })
	Build.text(board, Enum.NormalId.Back, text, { locKey = locKey, color = Color3.fromRGB(255, 255, 255) })
	-- neon frame
	Build.part(parent, {
		size = Vector3.new(width + 0.4, 0.35, 0.7),
		cframe = base * CFrame.new(0, 6 + height + 0.17, 0),
		color = color and color:Lerp(Color3.new(1, 1, 1), 0.3) or Color3.fromRGB(255, 140, 40),
		material = Enum.Material.Neon,
		collide = false,
		shadow = false,
	})
	return board
end

function Build.tag(inst: Instance, tag: string)
	CollectionService:AddTag(inst, tag)
end

-- Deterministic random numbers so every server builds the same world.
function Build.rng(seed: number): Random
	return Random.new(seed)
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">City</string>
            <string name="Source"><![CDATA[-- City: downtown blocks between the street grid — sidewalks, skyscrapers,
-- small parks and parking lots. Deterministic, so every server matches.

local Build = require(script.Parent.Build)
local Layout = require(script.Parent.Layout)

local City = {}

local TOP = Layout.RoadTop
local SIDEWALK_TOP = TOP + 0.25

local FACADES = {
	{ wall = Color3.fromRGB(196, 190, 176), glass = Color3.fromRGB(60, 90, 120), mat = Enum.Material.Concrete },
	{ wall = Color3.fromRGB(150, 74, 56), glass = Color3.fromRGB(40, 50, 64), mat = Enum.Material.Brick },
	{ wall = Color3.fromRGB(70, 96, 130), glass = Color3.fromRGB(120, 170, 210), mat = Enum.Material.Glass },
	{ wall = Color3.fromRGB(44, 46, 54), glass = Color3.fromRGB(90, 140, 180), mat = Enum.Material.SmoothPlastic },
	{ wall = Color3.fromRGB(226, 226, 222), glass = Color3.fromRGB(50, 70, 100), mat = Enum.Material.SmoothPlastic },
	{ wall = Color3.fromRGB(176, 150, 110), glass = Color3.fromRGB(40, 60, 80), mat = Enum.Material.Sandstone },
}

local function building(parent: Instance, rng: Random, cx: number, cz: number, w: number, d: number, h: number)
	local style = FACADES[rng:NextInteger(1, #FACADES)]
	local model = Instance.new("Model")
	model.Name = "Building"
	local base = Build.box(model, Vector3.new(w, h, d), CFrame.new(cx, SIDEWALK_TOP + h / 2, cz), style.wall, style.mat, "Tower")
	base.CastShadow = true
	-- window bands wrap all four sides with one slightly larger box each
	local floorH = 12
	local y = SIDEWALK_TOP + 10
	while y < SIDEWALK_TOP + h - 6 do
		Build.part(model, {
			size = Vector3.new(w + 0.3, 4.5, d + 0.3),
			cframe = CFrame.new(cx, y, cz),
			color = style.glass,
			material = Enum.Material.Glass,
			reflectance = 0.2,
			collide = false,
			shadow = false,
			name = "Windows",
		})
		y += floorH
	end
	-- ground floor shop front
	Build.part(model, {
		size = Vector3.new(w + 0.4, 6, d + 0.4),
		cframe = CFrame.new(cx, SIDEWALK_TOP + 3.2, cz),
		color = Color3.fromRGB(30, 34, 42),
		material = Enum.Material.Glass,
		reflectance = 0.25,
		collide = false,
		name = "ShopFront",
	})
	-- roof: parapet and a few machines
	Build.box(model, Vector3.new(w + 0.6, 1.6, d + 0.6), CFrame.new(cx, SIDEWALK_TOP + h + 0.8, cz), style.wall:Lerp(Color3.new(0, 0, 0), 0.2), style.mat)
	for _ = 1, rng:NextInteger(1, 3) do
		local sx, sz = rng:NextNumber(4, 10), rng:NextNumber(4, 10)
		local px = cx + rng:NextNumber(-w / 2 + sx, w / 2 - sx)
		local pz = cz + rng:NextNumber(-d / 2 + sz, d / 2 - sz)
		Build.box(model, Vector3.new(sx, rng:NextNumber(2, 6), sz), CFrame.new(px, SIDEWALK_TOP + h + 2.5, pz), Color3.fromRGB(150, 152, 158), Enum.Material.Metal)
	end
	if h > 140 then
		-- antenna with a blinking-looking red tip
		Build.pole(model, Vector3.new(cx, SIDEWALK_TOP + h + 1.6, cz), 26, 0.6, Color3.fromRGB(200, 200, 205), Enum.Material.Metal)
		Build.ball(model, 1.6, Vector3.new(cx, SIDEWALK_TOP + h + 28, cz), Color3.fromRGB(255, 40, 40), Enum.Material.Neon).CanCollide = false
	end
	model.PrimaryPart = base
	model.Parent = parent
end

local function park(parent: Instance, rng: Random, cx: number, cz: number, w: number, d: number, treeSpots: { Vector3 })
	Build.box(parent, Vector3.new(w, 0.4, d), CFrame.new(cx, SIDEWALK_TOP + 0.05, cz), Color3.fromRGB(80, 140, 70), Enum.Material.Grass, "Park")
	for _ = 1, 6 do
		table.insert(treeSpots, Vector3.new(cx + rng:NextNumber(-w / 2 + 8, w / 2 - 8), SIDEWALK_TOP + 0.25, cz + rng:NextNumber(-d / 2 + 8, d / 2 - 8)))
	end
	-- fountain
	Build.cylinder(parent, 1.4, 22, CFrame.new(cx, SIDEWALK_TOP + 0.7, cz) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(190, 190, 186), Enum.Material.Concrete)
	Build.cylinder(parent, 0.2, 19, CFrame.new(cx, SIDEWALK_TOP + 1.35, cz) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(70, 150, 220), Enum.Material.Glass).CanCollide = false
	Build.pole(parent, Vector3.new(cx, SIDEWALK_TOP + 1, cz), 5, 1.4, Color3.fromRGB(190, 190, 186), Enum.Material.Concrete)
end

local function parking(parent: Instance, cx: number, cz: number, w: number, d: number)
	Build.box(parent, Vector3.new(w, 0.3, d), CFrame.new(cx, SIDEWALK_TOP + 0.02, cz), Color3.fromRGB(64, 66, 72), Enum.Material.Asphalt, "Parking")
	local n = math.floor((w - 10) / 12)
	for i = 0, n do
		local x = cx - w / 2 + 5 + i * 12
		for _, side in { -1, 1 } do
			Build.part(parent, {
				size = Vector3.new(0.4, 0.05, d / 2 - 12),
				cframe = CFrame.new(x, SIDEWALK_TOP + 0.2, cz + side * (d / 4 + 3)),
				color = Color3.fromRGB(235, 235, 230),
				collide = false,
				shadow = false,
			})
		end
	end
end

-- Returns tree positions for the Decor builder.
function City.build(root: Instance): { Vector3 }
	local folder = Build.folder("City", root)
	local rng = Build.rng(1337)
	local xs, zs = Layout.CityX, Layout.CityZ
	local sw = Layout.CityStreetWidth
	local trees: { Vector3 } = {}
	local function halfWidth(x: number): number
		return (if x == 0 then 44 else sw) / 2
	end
	for i = 1, #xs - 1 do
		for j = 1, #zs - 1 do
			local x0, x1 = xs[i] + halfWidth(xs[i]), xs[i + 1] - halfWidth(xs[i + 1])
			local z1, z0 = zs[j] - sw / 2, zs[j + 1] + sw / 2 -- z decreases northwards
			local bw, bd = x1 - x0, z1 - z0
			local bcx, bcz = (x0 + x1) / 2, (z0 + z1) / 2
			-- sidewalk slab
			Build.box(folder, Vector3.new(bw, 1, bd), CFrame.new(bcx, SIDEWALK_TOP - 0.5, bcz), Color3.fromRGB(190, 188, 182), Enum.Material.Concrete, "Sidewalk")
			-- 2x2 lots
			local lotW, lotD = (bw - 24) / 2, (bd - 24) / 2
			local distToCenter = math.abs(bcx) + math.abs(bcz + 975) * 0.6
			for li = 0, 1 do
				for lj = 0, 1 do
					local lcx = x0 + 12 + lotW / 2 + li * lotW
					local lcz = z0 + 12 + lotD / 2 + lj * lotD
					local roll = rng:NextNumber()
					if roll < 0.12 then
						park(folder, rng, lcx, lcz, lotW - 6, lotD - 6, trees)
					elseif roll < 0.2 then
						parking(folder, lcx, lcz, lotW - 6, lotD - 6)
					else
						local w = lotW * rng:NextNumber(0.62, 0.9)
						local d = lotD * rng:NextNumber(0.62, 0.9)
						local tall = math.clamp(1 - distToCenter / 1100, 0.15, 1)
						local h = math.floor(rng:NextNumber(30, 60) + tall * rng:NextNumber(40, 170))
						building(folder, rng, lcx, lcz, w, d, h)
					end
				end
			end
			-- street trees on the sidewalk corners
			for _, cx in { x0 + 5, x1 - 5 } do
				for _, cz in { z0 + 5, z1 - 5 } do
					table.insert(trees, Vector3.new(cx, SIDEWALK_TOP, cz))
				end
			end
		end
	end
	return trees
end

return City
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Decor</string>
            <string name="Source"><![CDATA[-- Decor: trees, boulders, the speed trap gantry, area signs and map bounds.

local Build = require(script.Parent.Build)
local Layout = require(script.Parent.Layout)

local Decor = {}

local TOP = Layout.RoadTop

local function groundY(x: number, z: number, ignore: { Instance }): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(Vector3.new(x, 400, z), Vector3.new(0, -500, 0), params)
	return if hit then hit.Position.Y else 0
end

local function roundTree(parent: Instance, base: Vector3, rng: Random)
	local h = rng:NextNumber(10, 16)
	Build.pole(parent, base - Vector3.new(0, 0.5, 0), h, rng:NextNumber(1.4, 2), Color3.fromRGB(96, 66, 42), Enum.Material.Wood)
	local green = Color3.fromRGB(56, 128, 52):Lerp(Color3.fromRGB(110, 160, 60), rng:NextNumber())
	for k = 0, 2 do
		local d = rng:NextNumber(9, 13) - k * 1.5
		local off = Vector3.new(rng:NextNumber(-2, 2), h - 1 + k * 3.2, rng:NextNumber(-2, 2))
		local leaf = Build.ball(parent, d, base + off, green:Lerp(Color3.new(0, 0, 0), k * 0.06), Enum.Material.Grass)
		leaf.CanCollide = false
		leaf.CanQuery = false
	end
end

local function pineTree(parent: Instance, base: Vector3, rng: Random)
	local h = rng:NextNumber(14, 22)
	Build.pole(parent, base - Vector3.new(0, 0.5, 0), h * 0.4, 1.6, Color3.fromRGB(86, 58, 38), Enum.Material.Wood)
	local green = Color3.fromRGB(38, 92, 52):Lerp(Color3.fromRGB(60, 110, 60), rng:NextNumber())
	local layers = 4
	for k = 0, layers - 1 do
		local d = (layers - k) * 3.4 + 1
		local y = h * 0.3 + k * (h * 0.7 / layers)
		local p = Build.cylinder(parent, h * 0.7 / layers + 1, d, CFrame.new(base + Vector3.new(0, y, 0)) * CFrame.Angles(0, 0, math.pi / 2), green, Enum.Material.Grass)
		p.CanCollide = false
		p.CanQuery = false
	end
end

-- Distance from point to segment on the ground plane
local function segDist(px: number, pz: number, a: Vector3, b: Vector3): number
	local abx, abz = b.X - a.X, b.Z - a.Z
	local apx, apz = px - a.X, pz - a.Z
	local len2 = abx * abx + abz * abz
	local t = if len2 > 0 then math.clamp((apx * abx + apz * abz) / len2, 0, 1) else 0
	local dx, dz = apx - abx * t, apz - abz * t
	return math.sqrt(dx * dx + dz * dz)
end

local function inRect(x: number, z: number, center: Vector3, size: Vector2, margin: number): boolean
	return math.abs(x - center.X) < size.X / 2 + margin and math.abs(z - center.Z) < size.Y / 2 + margin
end

-- `paths` = list of { points = {Vector3}, clearance = number } (tracks, trail)
function Decor.build(root: Instance, cityTrees: { Vector3 }, paths: { { points: { Vector3 }, clearance: number } })
	local folder = Build.folder("Decor", root)
	local treeFolder = Build.folder("Trees", folder)
	local rng = Build.rng(4242)
	local ignore = { treeFolder }

	for _, p in cityTrees do
		roundTree(treeFolder, p, rng)
	end

	local function free(x: number, z: number): boolean
		if inRect(x, z, Layout.Plaza.center, Layout.Plaza.size, 25) then
			return false
		end
		if inRect(x, z, Layout.StuntPark.center, Layout.StuntPark.size, 25) then
			return false
		end
		if inRect(x, z, Layout.DriftArena.center, Layout.DriftArena.size, 40) then
			return false
		end
		if x > -735 and x < 735 and z > -1535 and z < -415 then
			return false -- city
		end
		if math.abs(z - 450) < 50 then
			return false -- highway band
		end
		for _, r in Layout.Roads do
			if segDist(x, z, r.a, r.b) < r.w / 2 + 14 then
				return false
			end
		end
		for _, path in paths do
			local pts = path.points
			for i = 1, #pts - 1 do
				if segDist(x, z, pts[i], pts[i + 1]) < path.clearance then
					return false
				end
			end
		end
		return true
	end

	local half = Layout.Half - Layout.Rim.width - 20
	local placed = 0
	local attempts = 0
	while placed < 240 and attempts < 4000 do
		attempts += 1
		local x = rng:NextNumber(-half, half)
		local z = rng:NextNumber(-half, half)
		if free(x, z) then
			local y = groundY(x, z, ignore)
			local base = Vector3.new(x, y, z)
			if z > Layout.SouthHills.start or z < Layout.NorthHills.start or y > 8 then
				pineTree(treeFolder, base, rng)
			else
				roundTree(treeFolder, base, rng)
			end
			placed += 1
		end
	end

	-- boulders in the hills
	local rocks = Build.folder("Rocks", folder)
	local count = 0
	attempts = 0
	while count < 45 and attempts < 1500 do
		attempts += 1
		local x = rng:NextNumber(-half, half)
		local z = rng:NextNumber(Layout.SouthHills.start + 80, half)
		if free(x, z) then
			local y = groundY(x, z, ignore)
			local d = rng:NextNumber(5, 14)
			local rock = Build.ball(rocks, d, Vector3.new(x, y + d * 0.2, z), Color3.fromRGB(110, 108, 104):Lerp(Color3.fromRGB(150, 140, 120), rng:NextNumber()), Enum.Material.Slate)
			rock.Size = Vector3.new(d * rng:NextNumber(1, 1.6), d * rng:NextNumber(0.6, 1), d * rng:NextNumber(1, 1.5))
			count += 1
		end
	end

	-- speed trap gantry over the highway
	local st = Layout.SpeedTrap
	local gantry = Build.folder("SpeedTrap", folder)
	for _, side in { -1, 1 } do
		Build.box(gantry, Vector3.new(2.5, 26, 2.5), CFrame.new(st.x, TOP + 13, st.z + side * (st.halfWidth + 4)), Color3.fromRGB(60, 64, 74), Enum.Material.Metal)
	end
	local beam = Build.box(gantry, Vector3.new(4, 7, (st.halfWidth + 5) * 2), CFrame.new(st.x, TOP + 24, st.z), Color3.fromRGB(26, 28, 36), Enum.Material.SmoothPlastic, "SpeedTrapBeam")
	local display = Build.text(beam, Enum.NormalId.Left, "SPEED TRAP", { locKey = "SignSpeedTrap", color = Color3.fromRGB(255, 70, 50) })
	display.Size = UDim2.fromScale(1, 0.45)
	local readout = Build.text(beam, Enum.NormalId.Left, "---", { color = Color3.fromRGB(255, 220, 60), font = Enum.Font.Code })
	readout.Name = "Readout"
	readout.Size = UDim2.fromScale(1, 0.55)
	readout.Position = UDim2.fromScale(0, 0.45)
	readout:SetAttribute("SpeedTrapReadout", true)
	Build.tag(readout, "SpeedTrapReadout")
	for _, side in { -1, 1 } do
		local cam = Build.box(gantry, Vector3.new(2, 1.4, 2), CFrame.new(st.x - 2.5, TOP + 20, st.z + side * 12), Color3.fromRGB(40, 40, 46))
		cam.CanCollide = false
		Build.part(gantry, {
			size = Vector3.new(0.2, 0.8, 0.8),
			cframe = CFrame.new(st.x - 3.6, TOP + 20, st.z + side * 12),
			color = Color3.fromRGB(255, 40, 40),
			material = Enum.Material.Neon,
			collide = false,
		})
	end

	-- area signs
	Build.sign(folder, CFrame.new(-1030, TOP, 492) * CFrame.Angles(0, math.pi / 2, 0), 26, 6, "OFFROAD", "SignTrail", Color3.fromRGB(110, 80, 30))
	Build.sign(folder, CFrame.new(1180, TOP, 380) * CFrame.Angles(0, math.pi / 2, 0), 26, 6, "RACES", "SignRaces", Color3.fromRGB(20, 60, 90))
	Build.sign(folder, CFrame.new(-1600, TOP, 410), 26, 6, "HIGHWAY", "SignHighway", Color3.fromRGB(20, 90, 50))

	-- invisible map bounds
	local bounds = Build.folder("Bounds", folder)
	local wh = Layout.WallHalf
	-- parts are limited to 2048 studs, so each side is two halves
	for _, axis in { "x", "z" } do
		for _, sign in { -1, 1 } do
			for _, halfSign in { -1, 1 } do
				local along = halfSign * wh / 2
				local pos = if axis == "x" then Vector3.new(sign * wh, 300, along) else Vector3.new(along, 300, sign * wh)
				local size = if axis == "x" then Vector3.new(4, 800, wh) else Vector3.new(wh, 800, 4)
				local wall = Build.part(bounds, {
					size = size,
					cframe = CFrame.new(pos),
					transparency = 1,
					name = "Bound",
					shadow = false,
				})
				wall.CanQuery = false
			end
		end
	end
end

return Decor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Layout</string>
            <string name="Source"><![CDATA[-- Layout: where everything in the world lives. All values are world studs,
-- y = 0 is the ground, -Z is north. Roads sit on top of the ground at ROAD_TOP.

local Layout = {}

Layout.Half = 1952 -- terrain half size (multiple of 4)
Layout.WallHalf = 1940 -- invisible boundary walls
Layout.RoadTop = 0.2

local function v(x: number, z: number): Vector3
	return Vector3.new(x, 0, z)
end
Layout.v = v

-- Areas (center + size on the ground plane)
Layout.Plaza = { center = v(0, 0), size = Vector2.new(320, 240) }
Layout.StuntPark = { center = v(-1200, -100), size = Vector2.new(600, 600) }
Layout.DriftArena = { center = v(700, 0), size = Vector2.new(360, 300) }
Layout.SpeedTrap = { x = 1500, z = 450, halfWidth = 32 }

-- City grid
Layout.CityX = { -700, -350, 0, 350, 700 }
Layout.CityZ = { -450, -800, -1150, -1500 }
Layout.CityStreetWidth = 40

-- Road segments { a, b, width, style } ("city" streets are generated from the grid)
Layout.Roads = {
	{ a = v(0, -120), b = v(0, -430), w = 44, style = "avenue" },
	{ a = v(0, 120), b = v(0, 420), w = 44, style = "avenue" },
	{ a = v(-160, 0), b = v(-900, 0), w = 40, style = "street" },
	{ a = v(160, 0), b = v(520, 0), w = 40, style = "street" },
	{ a = v(-1800, 450), b = v(0, 450), w = 60, style = "highway" },
	{ a = v(0, 450), b = v(1800, 450), w = 60, style = "highway" },
	{ a = v(-1200, 420), b = v(-1200, 200), w = 40, style = "street" },
	{ a = v(700, 420), b = v(700, 150), w = 40, style = "street" },
	{ a = v(1150, 420), b = v(1150, -276), w = 40, style = "street" },
}

-- Spawn pads in the plaza (cars face south, towards the exit)
Layout.SpawnPads = {}
for i = 0, 9 do
	local x = -135 + i * 30
	table.insert(Layout.SpawnPads, CFrame.new(x, Layout.RoadTop, 82) * CFrame.Angles(0, math.pi, 0))
end

Layout.PlayerSpawn = v(0, 10)
Layout.GarageKiosks = { v(-120, 30), v(120, 30) }
Layout.Showroom = { min = v(-152, -116), max = v(-36, -42) }

-- Mesh for terrain hills: masks are 0 on the flat playfield, 1 in the hills.
Layout.SouthHills = { start = 640, full = 880 }
Layout.NorthHills = { start = -1620, full = -1780 }
Layout.Rim = { width = 140, height = 70 }

-- Driving zones with bonus rewards
Layout.Zones = {
	drift = { center = Layout.DriftArena.center, size = Vector3.new(360, 60, 300), multiplier = 2 },
	stunt = { center = Layout.StuntPark.center, size = Vector3.new(600, 400, 600), multiplier = 2 },
}

return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Plaza</string>
            <string name="Source"><![CDATA[-- Plaza: the spawn hub. Dealership showroom with rotating cars, spawn pads,
-- garage kiosks, race hub pads, leaderboards and the welcome sign.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Build = require(script.Parent.Build)
local Layout = require(script.Parent.Layout)

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local CarBuilder = require(Shared.CarBuilder)
local CarCatalog = require(Shared.CarCatalog)
local Tracks = require(Shared.Tracks)

local Plaza = {}

local TOP = Layout.RoadTop
local CONCRETE = Color3.fromRGB(176, 176, 172)
local DARK = Color3.fromRGB(32, 34, 42)
local ACCENT = Color3.fromRGB(255, 128, 32)

local SHOWCASE = { "nebula", "zephyr", "goliath", "apex" }

-- A board with a title and N rows for the Leaderboards system to fill in.
function Plaza.board(parent: Instance, cf: CFrame, width: number, height: number, titleKey: string, kind: string, rows: number, locArg: string?): BasePart
	local board = Build.box(parent, Vector3.new(width, height, 0.8), cf, DARK, Enum.Material.SmoothPlastic, "Leaderboard")
	board:SetAttribute("BoardKind", kind)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.MaxDistance = 300
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.fromScale(1, 0.16)
	title.BackgroundColor3 = ACCENT
	title.BorderSizePixel = 0
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Text = titleKey
	title:SetAttribute("LocKey", titleKey)
	if locArg then
		title:SetAttribute("LocTrack", locArg)
	end
	Build.tag(title, "LocText")
	title.Parent = gui
	local list = Instance.new("Frame")
	list.Name = "Rows"
	list.Size = UDim2.fromScale(0.94, 0.8)
	list.Position = UDim2.fromScale(0.03, 0.18)
	list.BackgroundTransparency = 1
	list.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.01, 0)
	layout.Parent = list
	for i = 1, rows do
		local row = Instance.new("TextLabel")
		row.Name = "Row" .. i
		row.LayoutOrder = i
		row.Size = UDim2.fromScale(1, 1 / rows - 0.012)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(40, 44, 56) else Color3.fromRGB(48, 52, 66)
		row.BorderSizePixel = 0
		row.Font = Enum.Font.GothamBold
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = if i == 1
			then Color3.fromRGB(255, 214, 80)
			elseif i == 2 then Color3.fromRGB(220, 224, 232)
			elseif i == 3 then Color3.fromRGB(230, 160, 100)
			else Color3.fromRGB(235, 235, 240)
		row.Text = if i == 1 then "BoardEmpty" else ""
		if i == 1 then
			row:SetAttribute("LocKey", "BoardEmpty")
			Build.tag(row, "LocText")
		end
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0.03, 0)
		pad.PaddingTop = UDim.new(0.12, 0)
		pad.PaddingBottom = UDim.new(0.12, 0)
		pad.Parent = row
		row.Parent = list
	end
	gui.Parent = board
	Build.tag(board, "Leaderboard")
	return board
end

local function spawnPad(parent: Instance, cf: CFrame, index: number)
	local pad = Build.part(parent, {
		size = Vector3.new(24, 0.1, 30),
		cframe = cf * CFrame.new(0, 0.03, 0),
		color = Color3.fromRGB(60, 64, 76),
		material = Enum.Material.SmoothPlastic,
		collide = false,
		shadow = false,
		name = "SpawnPad",
	})
	for _, x in { -12, 12 } do
		Build.part(parent, {
			size = Vector3.new(0.5, 0.12, 30),
			cframe = cf * CFrame.new(x, 0.05, 0),
			color = ACCENT,
			material = Enum.Material.Neon,
			collide = false,
			shadow = false,
		})
	end
	local numberPlate = Build.part(parent, {
		size = Vector3.new(6, 0.12, 3),
		cframe = cf * CFrame.new(0, 0.06, 13),
		color = Color3.fromRGB(60, 64, 76),
		collide = false,
		shadow = false,
	})
	Build.text(numberPlate, Enum.NormalId.Top, tostring(index), { color = ACCENT })
	return pad
end

local function showroom(parent: Instance)
	local folder = Build.folder("Showroom", parent)
	local min, max = Layout.Showroom.min, Layout.Showroom.max
	local size = max - min
	local center = (min + max) / 2
	local h = 18
	-- floor
	Build.box(folder, Vector3.new(size.X, 0.4, size.Z), CFrame.new(center.X, TOP + 0.2, center.Z), Color3.fromRGB(230, 232, 236), Enum.Material.Marble)
	-- back wall + side walls (glass front)
	Build.box(folder, Vector3.new(size.X, h, 1), CFrame.new(center.X, TOP + h / 2, min.Z), Color3.fromRGB(40, 44, 58), Enum.Material.SmoothPlastic)
	for _, x in { min.X, max.X } do
		Build.box(folder, Vector3.new(1, h, size.Z), CFrame.new(x, TOP + h / 2, center.Z), Color3.fromRGB(40, 44, 58), Enum.Material.SmoothPlastic)
	end
	Build.part(folder, {
		size = Vector3.new(size.X, h - 2, 0.4),
		cframe = CFrame.new(center.X, TOP + (h - 2) / 2 + 2, max.Z),
		color = Color3.fromRGB(150, 190, 220),
		material = Enum.Material.Glass,
		transparency = 0.7,
		name = "ShowroomGlass",
	})
	Build.box(folder, Vector3.new(size.X, 2, 0.6), CFrame.new(center.X, TOP + 1, max.Z), Color3.fromRGB(40, 44, 58))
	-- roof with neon edge and sign
	Build.box(folder, Vector3.new(size.X + 4, 1.2, size.Z + 4), CFrame.new(center.X, TOP + h + 0.6, center.Z), Color3.fromRGB(30, 32, 40))
	Build.part(folder, {
		size = Vector3.new(size.X + 4.2, 0.4, 0.4),
		cframe = CFrame.new(center.X, TOP + h + 1.3, max.Z + 2),
		color = ACCENT,
		material = Enum.Material.Neon,
		collide = false,
	})
	local sign = Build.box(folder, Vector3.new(40, 6, 0.8), CFrame.new(center.X, TOP + h + 4.2, max.Z + 1.6), DARK)
	Build.text(sign, Enum.NormalId.Back, "GARAGE", { locKey = "SignGarage", color = ACCENT })

	-- turntables with showcase cars
	local slots = #SHOWCASE
	for i, id in SHOWCASE do
		local def = CarCatalog.get(id)
		if def then
			local x = min.X + size.X * (i - 0.5) / slots
			local z = center.Z + 2
			local base = Vector3.new(x, TOP + 0.4, z)
			Build.cylinder(folder, 0.6, 24, CFrame.new(base + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(40, 42, 50), Enum.Material.Metal)
			Build.cylinder(folder, 0.65, 24.4, CFrame.new(base + Vector3.new(0, 0.28, 0)) * CFrame.Angles(0, 0, math.pi / 2), ACCENT, Enum.Material.Neon).CanCollide = false
			local ok, model = pcall(CarBuilder.build, def, { showroom = true, ownerName = def.name })
			if ok and model then
				local chassis = model.PrimaryPart :: BasePart
				local rel = chassis.CFrame
				local pivot = CFrame.new(base + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, math.rad(35 + i * 50), 0)
				model:PivotTo(pivot * rel)
				model.Name = "Showcase_" .. id
				model:SetAttribute("SpinCenter", base)
				model:SetAttribute("SpinSpeed", 0.25)
				for _, d in model:GetDescendants() do
					if d:IsA("BasePart") then
						d.CanCollide = false
						d.CanQuery = false
					end
				end
				model.Parent = folder
				Build.tag(model, "Showcase")
				local label = Build.part(folder, {
					size = Vector3.new(14, 2.6, 0.3),
					cframe = CFrame.new(x, TOP + 1.6, max.Z - 0.6) * CFrame.Angles(math.rad(-15), 0, 0),
					color = DARK,
					collide = false,
				})
				Build.text(label, Enum.NormalId.Back, def.name, { color = Color3.new(1, 1, 1) })
			end
		end
	end
end

local function kiosk(parent: Instance, pos: Vector3)
	local base = Build.box(parent, Vector3.new(6, 7, 3), CFrame.new(pos.X, TOP + 3.5, pos.Z), DARK, Enum.Material.SmoothPlastic, "GarageKiosk")
	local screen = Build.part(parent, {
		size = Vector3.new(5, 3.2, 0.2),
		cframe = CFrame.new(pos.X, TOP + 4.6, pos.Z + 1.55),
		color = Color3.fromRGB(20, 24, 34),
		material = Enum.Material.SmoothPlastic,
		collide = false,
	})
	Build.text(screen, Enum.NormalId.Back, "GARAGE", { locKey = "SignGarage", color = ACCENT, background = Color3.fromRGB(20, 24, 34) })
	Build.part(parent, {
		size = Vector3.new(6.2, 0.3, 3.2),
		cframe = CFrame.new(pos.X, TOP + 7.1, pos.Z),
		color = ACCENT,
		material = Enum.Material.Neon,
		collide = false,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open garage"
	prompt.ObjectText = "Garage"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Action", "OpenGarage")
	prompt:SetAttribute("LocAction", "PromptGarage")
	prompt:SetAttribute("LocObject", "Garage")
	prompt.Parent = base
end

-- Race hub: one pad per track with a sign, a prompt and a mini leaderboard.
local function raceHub(parent: Instance): { [string]: BasePart }
	local pads = {}
	for _, track in Tracks.List do
		local p = track.hub
		Build.part(parent, {
			size = Vector3.new(24, 0.1, 30),
			cframe = CFrame.new(p.X, TOP + 0.03, p.Z),
			color = Color3.fromRGB(46, 50, 64),
			collide = false,
			shadow = false,
			name = "RacePad_" .. track.id,
		})
		for _, x in { -12, 12 } do
			Build.part(parent, {
				size = Vector3.new(0.5, 0.12, 30),
				cframe = CFrame.new(p.X + x, TOP + 0.05, p.Z),
				color = Color3.fromRGB(80, 200, 255),
				material = Enum.Material.Neon,
				collide = false,
				shadow = false,
			})
		end
		-- sign at the back (north end) of the pad
		local signBase = CFrame.new(p.X, TOP, p.Z - 17)
		local board = Plaza.board(parent, signBase * CFrame.new(0, 11, 0) * CFrame.Angles(0, math.pi, 0), 22, 12, "BoardTrack", "track:" .. track.id, 5, track.id)
		board.Name = "TrackBoard_" .. track.id
		for _, x in { -10, 10 } do
			Build.pole(parent, (signBase * CFrame.new(x, 0, 0)).Position, 17, 0.8, Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
		end
		local trigger = Build.part(parent, {
			size = Vector3.new(8, 4, 8),
			cframe = CFrame.new(p.X, TOP + 2, p.Z),
			transparency = 1,
			collide = false,
			name = "RaceTrigger",
		})
		trigger.CanQuery = false
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "RacePrompt"
		prompt.ActionText = "Start race"
		prompt.ObjectText = track.name.en
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
		prompt.HoldDuration = 0.3
		prompt.MaxActivationDistance = 22
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("TrackId", track.id)
		prompt:SetAttribute("LocAction", "PromptRace")
		prompt:SetAttribute("LocTrack", track.id)
		prompt.Parent = trigger
		pads[track.id] = trigger
	end
	return pads
end

function Plaza.build(root: Instance)
	local folder = Build.folder("Plaza", root)
	local c = Layout.Plaza.center
	local s = Layout.Plaza.size
	Build.box(folder, Vector3.new(s.X, 1, s.Y), CFrame.new(c.X, TOP - 0.5, c.Z), CONCRETE, Enum.Material.Concrete, "PlazaFloor")
	-- curb around the plaza (gaps for the four exits)
	local curbColor = Color3.fromRGB(120, 120, 118)
	local hx, hz = s.X / 2, s.Y / 2
	for _, z in { -hz, hz } do
		for _, seg in { { -hx, -24 }, { 24, hx } } do
			Build.box(folder, Vector3.new(seg[2] - seg[1], 1.2, 2), CFrame.new((seg[1] + seg[2]) / 2, TOP + 0.6, z), curbColor, Enum.Material.Concrete)
		end
	end
	for _, x in { -hx, hx } do
		for _, seg in { { -hz, -22 }, { 22, hz } } do
			Build.box(folder, Vector3.new(2, 1.2, seg[2] - seg[1]), CFrame.new(x, TOP + 0.6, (seg[1] + seg[2]) / 2), curbColor, Enum.Material.Concrete)
		end
	end
	-- painted lanes
	for _, z in { -30, 52 } do
		Build.part(folder, {
			size = Vector3.new(s.X - 20, 0.06, 0.6),
			cframe = CFrame.new(0, TOP + 0.03, z),
			color = Color3.fromRGB(240, 240, 236),
			collide = false,
			shadow = false,
		})
	end

	local pads = Build.folder("SpawnPads", folder)
	for i, cf in Layout.SpawnPads do
		spawnPad(pads, cf, i)
	end

	-- player spawn with a neon ring
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlayerSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 0.4, 14)
	spawn.CFrame = CFrame.new(Layout.PlayerSpawn.X, TOP + 0.2, Layout.PlayerSpawn.Z)
	spawn.Color = Color3.fromRGB(60, 64, 76)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	spawn.Parent = folder
	Build.cylinder(folder, 0.3, 16, CFrame.new(Layout.PlayerSpawn.X, TOP + 0.1, Layout.PlayerSpawn.Z) * CFrame.Angles(0, 0, math.pi / 2), ACCENT, Enum.Material.Neon).CanCollide = false

	-- entrance arch over the north exit with the game logo
	for _, x in { -28, 28 } do
		Build.box(folder, Vector3.new(4, 30, 4), CFrame.new(x, TOP + 15, -117), DARK, Enum.Material.SmoothPlastic, "ArchPillar")
		Build.part(folder, {
			size = Vector3.new(4.3, 30, 0.4),
			cframe = CFrame.new(x, TOP + 15, -114.9),
			color = ACCENT,
			material = Enum.Material.Neon,
			collide = false,
		})
	end
	local arch = Build.box(folder, Vector3.new(62, 9, 3), CFrame.new(0, TOP + 25, -117), Color3.fromRGB(28, 30, 44), Enum.Material.SmoothPlastic, "Arch")
	Build.text(arch, Enum.NormalId.Back, "CARS", { locKey = "SignWelcome", color = ACCENT })
	Build.text(arch, Enum.NormalId.Front, "CITY", { locKey = "SignCity", color = Color3.new(1, 1, 1) })

	-- controls help on the showroom's outer wall, facing the player spawn
	local controls = Build.box(
		folder,
		Vector3.new(34, 11, 0.6),
		CFrame.new(Layout.Showroom.max.X + 0.8, TOP + 9, (Layout.Showroom.min.Z + Layout.Showroom.max.Z) / 2) * CFrame.Angles(0, -math.pi / 2, 0),
		DARK,
		Enum.Material.SmoothPlastic,
		"ControlsBoard"
	)
	local title = Build.text(controls, Enum.NormalId.Front, "ControlsTitle", { locKey = "ControlsTitle", color = ACCENT })
	title.Size = UDim2.fromScale(1, 0.25)
	local label = Build.text(controls, Enum.NormalId.Front, "ControlsBody", { locKey = "ControlsBody", font = Enum.Font.GothamBold, color = Color3.fromRGB(235, 235, 240) })
	label.Size = UDim2.fromScale(1, 0.75)
	label.Position = UDim2.fromScale(0, 0.25)

	showroom(folder)
	for _, p in Layout.GarageKiosks do
		kiosk(folder, p)
	end
	local hubs = raceHub(Build.folder("RaceHub", folder))
	local hubSign = Build.sign(folder, CFrame.new(100, TOP, -112), 30, 6, "RACES", "SignRaces", Color3.fromRGB(20, 60, 90))
	hubSign.Name = "RaceHubSign"

	-- leaderboards on the east and west edges
	Plaza.board(folder, CFrame.new(-hx + 3, TOP + 12, 20) * CFrame.Angles(0, -math.pi / 2, 0), 34, 22, "BoardCash", "cash", 10).Name =
		"CashBoard"
	Plaza.board(folder, CFrame.new(hx - 3, TOP + 12, 20) * CFrame.Angles(0, math.pi / 2, 0), 34, 22, "BoardSpeed", "speed", 10).Name =
		"SpeedBoard"
	for _, x in { -hx + 3, hx - 3 } do
		for _, z in { 4, 36 } do
			Build.pole(folder, Vector3.new(x, TOP, z), 12, 1, Color3.fromRGB(60, 62, 70), Enum.Material.Metal)
		end
	end

	return hubs
end

return Plaza
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Roads</string>
            <string name="Source"><![CDATA[-- Roads: asphalt network with markings, intersections, curbs and street lamps.

local Build = require(script.Parent.Build)
local Layout = require(script.Parent.Layout)

local Roads = {}

local ASPHALT = Color3.fromRGB(58, 60, 66)
local ASPHALT_DARK = Color3.fromRGB(48, 50, 55)
local WHITE = Color3.fromRGB(232, 232, 228)
local YELLOW = Color3.fromRGB(240, 190, 40)
local TOP = Layout.RoadTop
local MARK_Y = TOP + 0.03

local lampPositions: { { pos: Vector3, facing: Vector3 } } = {}

local function mark(parent: Instance, a: Vector3, b: Vector3, width: number, color: Color3)
	local strip = Build.strip(parent, a, b, width, 0.06, MARK_Y, color, Enum.Material.SmoothPlastic)
	if strip then
		strip.CanCollide = false
		strip.CanQuery = false
		strip.CanTouch = false
		strip.CastShadow = false
		strip.Name = "Marking"
	end
end

local function dashed(parent: Instance, a: Vector3, b: Vector3, width: number, color: Color3, dash: number, gap: number)
	local dir = b - a
	local len = dir.Magnitude
	if len < 1 then
		return
	end
	local u = dir / len
	local d = gap / 2
	while d + dash <= len do
		mark(parent, a + u * d, a + u * (d + dash), width, color)
		d += dash + gap
	end
end

-- One straight road from a to b (endpoints exactly where the asphalt starts/ends).
function Roads.segment(parent: Instance, a: Vector3, b: Vector3, w: number, style: string, opts: { lamps: boolean? }?)
	local road = Build.strip(parent, a, b, w, 1, TOP, ASPHALT, Enum.Material.Asphalt)
	if road then
		road.Name = "Road"
	end
	local dir = (b - a)
	local len = dir.Magnitude
	if len < 4 then
		return
	end
	local u = dir / len
	local right = Vector3.new(-u.Z, 0, u.X)
	local inset = 6 -- keep markings out of the junction boxes
	local ma, mb = a + u * inset, b - u * inset
	if (mb - ma):Dot(u) <= 0 then
		return
	end
	if style == "highway" then
		mark(parent, ma + right * 0.6, mb + right * 0.6, 0.45, YELLOW)
		mark(parent, ma - right * 0.6, mb - right * 0.6, 0.45, YELLOW)
		for _, s in { -1, 1 } do
			dashed(parent, ma + right * s * 14.5, mb + right * s * 14.5, 0.5, WHITE, 14, 22)
			mark(parent, ma + right * s * (w / 2 - 1.6), mb + right * s * (w / 2 - 1.6), 0.6, WHITE)
		end
	elseif style == "avenue" then
		mark(parent, ma + right * 0.5, mb + right * 0.5, 0.4, YELLOW)
		mark(parent, ma - right * 0.5, mb - right * 0.5, 0.4, YELLOW)
		for _, s in { -1, 1 } do
			mark(parent, ma + right * s * (w / 2 - 1.5), mb + right * s * (w / 2 - 1.5), 0.5, WHITE)
		end
	else
		dashed(parent, ma, mb, 0.45, WHITE, 10, 14)
		for _, s in { -1, 1 } do
			mark(parent, ma + right * s * (w / 2 - 1.4), mb + right * s * (w / 2 - 1.4), 0.45, WHITE)
		end
	end
	local o = opts or {}
	if o.lamps ~= false then
		local spacing = if style == "highway" then 160 else 130
		local d = spacing / 2
		local side = 1
		while d < len do
			local p = a + u * d + right * side * (w / 2 + 3)
			table.insert(lampPositions, { pos = p, facing = -right * side })
			if style ~= "highway" then
				side = -side
			end
			d += spacing
		end
	end
end

-- Square junction patch without markings.
function Roads.junction(parent: Instance, center: Vector3, size: number)
	local p = Build.box(
		parent,
		Vector3.new(size, 1, size),
		CFrame.new(center.X, TOP - 0.5, center.Z),
		ASPHALT_DARK,
		Enum.Material.Asphalt,
		"Junction"
	)
	return p
end

-- Zebra crossing across a road at `center`, stripes parallel to `along`.
function Roads.crosswalk(parent: Instance, center: Vector3, along: Vector3, roadWidth: number)
	local u = along.Unit
	local right = Vector3.new(-u.Z, 0, u.X)
	local n = math.floor((roadWidth - 4) / 3)
	for i = 0, n - 1 do
		local off = -roadWidth / 2 + 2.5 + i * 3
		local c = center + right * off
		mark(parent, c - u * 4, c + u * 4, 1.6, WHITE)
	end
end

local function buildLamps(parent: Instance)
	for _, l in lampPositions do
		local base = Vector3.new(l.pos.X, TOP, l.pos.Z)
		Build.pole(parent, base, 18, 0.7, Color3.fromRGB(70, 72, 80), Enum.Material.Metal)
		local armEnd = base + Vector3.new(0, 18, 0) + l.facing * 5
		local arm = Build.strip(parent, base + Vector3.new(0, 18, 0), armEnd, 0.4, 0.4, TOP + 18.2, Color3.fromRGB(70, 72, 80), Enum.Material.Metal)
		if arm then
			arm.CanCollide = false
		end
		local head = Build.part(parent, {
			size = Vector3.new(1.6, 0.5, 2.4),
			cframe = CFrame.lookAt(armEnd + Vector3.new(0, -0.1, 0), armEnd + Vector3.new(0, -0.1, 0) + l.facing),
			color = Color3.fromRGB(255, 236, 190),
			material = Enum.Material.SmoothPlastic,
			collide = false,
			shadow = false,
			name = "LampHead",
		})
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Bottom
		light.Angle = 110
		light.Range = 42
		light.Brightness = 2.2
		light.Color = Color3.fromRGB(255, 220, 170)
		light.Shadows = false
		light.Enabled = false
		light.Parent = head
		Build.tag(head, "StreetLight")
	end
	table.clear(lampPositions)
end

function Roads.build(root: Instance)
	local folder = Build.folder("Roads", root)
	local lamps = Build.folder("StreetLights", root)

	for _, r in Layout.Roads do
		Roads.segment(folder, r.a, r.b, r.w, r.style)
	end

	-- city grid: junction boxes at every node, streets between them
	local xs, zs = Layout.CityX, Layout.CityZ
	local sw = Layout.CityStreetWidth
	local function widthAt(x: number): number
		return if x == 0 then 44 else sw
	end
	for _, x in xs do
		for _, z in zs do
			Roads.junction(folder, Vector3.new(x, 0, z), sw).Size = Vector3.new(widthAt(x), 1, sw)
		end
	end
	for _, x in xs do
		local w = widthAt(x)
		for i = 1, #zs - 1 do
			local z0, z1 = zs[i], zs[i + 1]
			local half = sw / 2
			Roads.segment(folder, Vector3.new(x, 0, z0 - half), Vector3.new(x, 0, z1 + half), w, if x == 0 then "avenue" else "street")
		end
	end
	for _, z in zs do
		for i = 1, #xs - 1 do
			local x0, x1 = xs[i], xs[i + 1]
			Roads.segment(folder, Vector3.new(x0 + widthAt(x0) / 2, 0, z), Vector3.new(x1 - widthAt(x1) / 2, 0, z), sw, "street")
		end
	end
	-- crosswalks next to the junctions on the avenue
	for i, z in zs do
		Roads.crosswalk(folder, Vector3.new(0, 0, z + 28), Vector3.new(0, 0, 1), 44)
		if i < #zs then
			Roads.crosswalk(folder, Vector3.new(0, 0, z - 28), Vector3.new(0, 0, 1), 44)
		end
	end

	buildLamps(lamps)
end

return Roads
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Stunts</string>
            <string name="Source"><![CDATA[-- Stunts: the stunt park (kickers, a bus jump, a mega ramp, quarter pipes,
-- bumps) and the drift arena (skid pads, cones, tire walls, grandstand).

local Build = require(script.Parent.Build)
local Layout = require(script.Parent.Layout)

local Stunts = {}

local TOP = Layout.RoadTop
local RAMP = Color3.fromRGB(210, 120, 40)
local RAMP2 = Color3.fromRGB(70, 140, 220)
local CONCRETE = Color3.fromRGB(150, 150, 148)

-- Wedge ramp: `foot` is the bottom-center of the low edge (on the ground),
-- `dir` the horizontal direction it rises towards.
local function ramp(parent: Instance, foot: Vector3, dir: Vector3, width: number, height: number, length: number, color: Color3?)
	local u = Vector3.new(dir.X, 0, dir.Z).Unit
	local center = foot + u * (length / 2) + Vector3.new(0, height / 2, 0)
	-- wedge rises towards its local +Z: point +Z along u
	local cf = CFrame.lookAt(center, center - u)
	local w = Build.wedge(parent, Vector3.new(width, height, length), cf, color or RAMP, Enum.Material.Concrete)
	-- stripes on the lip
	local lip = foot + u * length + Vector3.new(0, height, 0)
	Build.part(parent, {
		size = Vector3.new(width, 0.3, 1),
		cframe = CFrame.lookAt(lip - u * 0.5 + Vector3.new(0, 0.15, 0), lip - u * 0.5 + Vector3.new(0, 0.15, 0) + u),
		color = Color3.fromRGB(250, 250, 250),
		material = Enum.Material.SmoothPlastic,
		collide = false,
		shadow = false,
	})
	return w
end

-- Quarter pipe: a curved wall made of slabs along an arc.
local function quarterPipe(parent: Instance, foot: Vector3, dir: Vector3, width: number, radius: number, maxAngle: number)
	local u = Vector3.new(dir.X, 0, dir.Z).Unit
	local segments = 8
	local step = math.rad(maxAngle) / segments
	local center = foot + u * 0 + Vector3.new(0, radius, 0) -- arc center above the foot
	for i = 0, segments - 1 do
		local a0, a1 = i * step, (i + 1) * step
		-- points on the arc (start at the bottom, curve up towards u)
		local p0 = center + u * (math.sin(a0) * radius) - Vector3.new(0, math.cos(a0) * radius, 0)
		local p1 = center + u * (math.sin(a1) * radius) - Vector3.new(0, math.cos(a1) * radius, 0)
		local mid = (p0 + p1) / 2
		local len = (p1 - p0).Magnitude + 0.6
		local tangent = (p1 - p0).Unit
		local inward = (center - mid).Unit
		local cf = CFrame.lookAt(mid - inward * 0.5, mid - inward * 0.5 + tangent, inward)
		Build.part(parent, {
			size = Vector3.new(width, 1, len),
			cframe = cf,
			color = RAMP2,
			material = Enum.Material.Concrete,
			name = "QuarterPipe",
		})
	end
	-- backing wall
	local top = center + u * radius
	Build.box(parent, Vector3.new(width, radius * math.sin(math.rad(maxAngle)) + 1, 3), CFrame.lookAt(
		Vector3.new(top.X, TOP + radius * 0.5, top.Z) + u * 2,
		Vector3.new(top.X, TOP + radius * 0.5, top.Z) + u * 3
	), CONCRETE, Enum.Material.Concrete)
end

local function barrier(parent: Instance, a: Vector3, b: Vector3)
	local s = Build.strip(parent, a, b, 2, 2.4, TOP + 2.4, Color3.fromRGB(205, 205, 200), Enum.Material.Concrete)
	if s then
		s.Name = "Barrier"
	end
end

local function bus(parent: Instance, cf: CFrame)
	local body = Build.box(parent, Vector3.new(9, 9, 34), cf * CFrame.new(0, 5.5, 0), Color3.fromRGB(245, 190, 30), Enum.Material.SmoothPlastic, "WreckBus")
	Build.box(parent, Vector3.new(9.2, 3, 30), cf * CFrame.new(0, 7.5, 0), Color3.fromRGB(40, 50, 64), Enum.Material.Glass).CanCollide = false
	for _, z in { -11, 11 } do
		for _, x in { -4.6, 4.6 } do
			Build.cylinder(parent, 1.4, 3.6, cf * CFrame.new(x, 1.8, z), Color3.fromRGB(28, 28, 30))
		end
	end
	return body
end

function Stunts.buildPark(root: Instance)
	local folder = Build.folder("StuntPark", root)
	local c = Layout.StuntPark.center
	local s = Layout.StuntPark.size
	local x0, x1 = c.X - s.X / 2, c.X + s.X / 2
	local z0, z1 = c.Z - s.Y / 2, c.Z + s.Y / 2
	Build.box(folder, Vector3.new(s.X, 1, s.Y), CFrame.new(c.X, TOP - 0.5, c.Z), Color3.fromRGB(78, 80, 86), Enum.Material.Asphalt, "ParkFloor")

	-- perimeter barriers with entries (east at z = 0, south at x = -1200)
	barrier(folder, Vector3.new(x0, 0, z0), Vector3.new(x1, 0, z0))
	barrier(folder, Vector3.new(x0, 0, z0), Vector3.new(x0, 0, z1))
	barrier(folder, Vector3.new(x1, 0, z0), Vector3.new(x1, 0, -24))
	barrier(folder, Vector3.new(x1, 0, 24), Vector3.new(x1, 0, z1))
	barrier(folder, Vector3.new(x0, 0, z1), Vector3.new(-1224, 0, z1))
	barrier(folder, Vector3.new(-1176, 0, z1), Vector3.new(x1, 0, z1))

	-- kicker row near the south entry (rising north)
	local north = Vector3.new(0, 0, -1)
	ramp(folder, Vector3.new(-1350, TOP, 150), north, 24, 3, 14)
	ramp(folder, Vector3.new(-1300, TOP, 150), north, 24, 6, 24)
	ramp(folder, Vector3.new(-1245, TOP, 160), north, 28, 10, 36)

	-- bus jump: launch westwards over three buses, land on a down ramp
	ramp(folder, Vector3.new(-980, TOP, -150), Vector3.new(-1, 0, 0), 34, 14, 24)
	for _, x in { -1013, -1024, -1035 } do
		bus(folder, CFrame.new(x, TOP, -150))
	end
	ramp(folder, Vector3.new(-1114, TOP, -150), Vector3.new(1, 0, 0), 34, 12, 70, RAMP2)

	-- mega ramp along the west side: long climb, a deck with a kicker and a
	-- landing slope right behind it (works at any speed thanks to the slope)
	local mx = -1440
	local climbFoot, climbLen, deckH = 150, 200, 42
	local deckStart = climbFoot - climbLen
	ramp(folder, Vector3.new(mx, TOP, climbFoot), north, 40, deckH, climbLen)
	Build.box(folder, Vector3.new(40, deckH, 24), CFrame.new(mx, TOP + deckH / 2, deckStart - 12), RAMP, Enum.Material.Concrete, "MegaDeck")
	ramp(folder, Vector3.new(mx, TOP + deckH, deckStart - 10), north, 40, 4, 14)
	ramp(folder, Vector3.new(mx, TOP, deckStart - 30 - 220), Vector3.new(0, 0, 1), 46, deckH - 2, 220, RAMP2)
	for _, side in { -1, 1 } do
		Build.part(folder, {
			size = Vector3.new(1, 3, climbLen),
			cframe = CFrame.new(mx + side * 20.5, TOP + deckH / 2 + 1.5, climbFoot - climbLen / 2)
				* CFrame.Angles(math.atan2(deckH, climbLen), 0, 0),
			color = Color3.fromRGB(255, 200, 40),
			material = Enum.Material.Neon,
			collide = false,
			shadow = false,
		})
	end

	-- quarter pipes along the north barrier, facing south
	for _, x in { -1300, -1150, -1020 } do
		quarterPipe(folder, Vector3.new(x, TOP, -372), north, 60, 18, 72)
	end

	-- bumps field in the middle
	for i = 0, 9 do
		Build.cylinder(folder, 40, 5, CFrame.new(-1180, TOP - 0.6, 40 - i * 13), Color3.fromRGB(230, 200, 60), Enum.Material.Concrete)
	end

	-- a few container stacks as obstacles
	local rng = Build.rng(99)
	for _, p in { Vector3.new(-1060, 0, 120), Vector3.new(-990, 0, 60), Vector3.new(-1280, 0, -40), Vector3.new(-1080, 0, -280) } do
		local color = Color3.fromHSV(rng:NextNumber(), 0.6, 0.75)
		Build.box(folder, Vector3.new(12, 12, 30), CFrame.new(p.X, TOP + 6, p.Z) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), color, Enum.Material.DiamondPlate, "Container")
	end

	Build.sign(folder, CFrame.new(-890, TOP, -36) * CFrame.Angles(0, -math.pi / 2, 0), 30, 7, "STUNT PARK", "SignStunts", Color3.fromRGB(120, 40, 20))
end

local function cone(parent: Instance, pos: Vector3): BasePart
	local base = Instance.new("Part")
	base.Name = "Cone"
	base.Size = Vector3.new(2, 0.3, 2)
	base.CFrame = CFrame.new(pos + Vector3.new(0, 0.15, 0))
	base.Color = Color3.fromRGB(255, 110, 20)
	base.Material = Enum.Material.SmoothPlastic
	base.TopSurface = Enum.SurfaceType.Smooth
	base.Anchored = false
	base.CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.5, 0.2, 1, 1)
	local body = Instance.new("Part")
	body.Name = "ConeBody"
	body.Shape = Enum.PartType.Cylinder
	body.Size = Vector3.new(2.4, 1.1, 1.1)
	body.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	body.Color = Color3.fromRGB(255, 110, 20)
	body.Material = Enum.Material.SmoothPlastic
	body.Anchored = false
	body.CustomPhysicalProperties = PhysicalProperties.new(0.2, 0.5, 0.2, 1, 1)
	local stripe = Instance.new("Part")
	stripe.Name = "ConeStripe"
	stripe.Shape = Enum.PartType.Cylinder
	stripe.Size = Vector3.new(0.4, 1.15, 1.15)
	stripe.CFrame = CFrame.new(pos + Vector3.new(0, 1.7, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	stripe.Color = Color3.fromRGB(245, 245, 245)
	stripe.Material = Enum.Material.SmoothPlastic
	stripe.Anchored = false
	stripe.Massless = true
	stripe.CanCollide = false
	for _, p in { body, stripe } do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = base
		weld.Part1 = p
		weld.Parent = p
		p.Parent = base
	end
	base:SetAttribute("Home", base.CFrame)
	base.Parent = parent
	Build.tag(base, "Cone")
	return base
end

function Stunts.buildDrift(root: Instance)
	local folder = Build.folder("DriftArena", root)
	local c = Layout.DriftArena.center
	local s = Layout.DriftArena.size
	local x0, x1 = c.X - s.X / 2, c.X + s.X / 2
	local z0, z1 = c.Z - s.Y / 2, c.Z + s.Y / 2
	Build.box(folder, Vector3.new(s.X, 1, s.Y), CFrame.new(c.X, TOP - 0.5, c.Z), Color3.fromRGB(110, 112, 118), Enum.Material.Concrete, "ArenaFloor")
	-- skid pads
	for i, p in { Vector3.new(c.X - 90, 0, c.Z), Vector3.new(c.X + 90, 0, c.Z) } do
		Build.cylinder(folder, 0.06, 110, CFrame.new(p.X, TOP + 0.03, p.Z) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(70, 72, 78), Enum.Material.Asphalt).CanCollide =
			false
		Build.cylinder(folder, 0.08, 16, CFrame.new(p.X, TOP + 0.04, p.Z) * CFrame.Angles(0, 0, math.pi / 2), if i == 1 then Color3.fromRGB(255, 90, 40) else Color3.fromRGB(60, 160, 255), Enum.Material.Neon).CanCollide =
			false
	end
	-- tire walls around the arena (gaps at the west and south entries)
	local function tires(a: Vector3, b: Vector3)
		local d = b - a
		local n = math.floor(d.Magnitude / 4)
		for i = 0, n do
			local p = a + d * (i / math.max(n, 1))
			Build.cylinder(folder, 3, 4, CFrame.new(p.X, TOP + 1.5, p.Z) * CFrame.Angles(0, 0, math.pi / 2), if i % 2 == 0 then Color3.fromRGB(30, 30, 32) else Color3.fromRGB(230, 40, 40), Enum.Material.SmoothPlastic)
		end
	end
	tires(Vector3.new(x0, 0, z0), Vector3.new(x1, 0, z0))
	tires(Vector3.new(x1, 0, z0), Vector3.new(x1, 0, z1))
	tires(Vector3.new(x0, 0, z0), Vector3.new(x0, 0, -26))
	tires(Vector3.new(x0, 0, 26), Vector3.new(x0, 0, z1))
	tires(Vector3.new(x0, 0, z1), Vector3.new(c.X - 26, 0, z1))
	tires(Vector3.new(c.X + 26, 0, z1), Vector3.new(x1, 0, z1))
	-- cone slalom through the middle
	local cones = Build.folder("Cones", folder)
	for i = 0, 9 do
		cone(cones, Vector3.new(c.X - 135 + i * 30, TOP, c.Z + (if i % 2 == 0 then -60 else -80)))
		cone(cones, Vector3.new(c.X - 135 + i * 30, TOP, c.Z + 90))
	end
	-- grandstand on the north side
	for i = 0, 4 do
		Build.box(folder, Vector3.new(120, 2, 6), CFrame.new(c.X, TOP + 1 + i * 2, z0 - 8 - i * 6), Color3.fromRGB(70, 90, 130), Enum.Material.SmoothPlastic, "Stand")
	end
	Build.sign(folder, CFrame.new(x0 - 6, TOP, -40) * CFrame.Angles(0, math.pi / 2, 0), 30, 7, "DRIFT ARENA", "SignDrift", Color3.fromRGB(110, 20, 60))
end

return Stunts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">TerrainGen</string>
            <string name="Source"><![CDATA[-- TerrainGen: grass base, rolling hills (south/north), a mountain rim around
-- the map and the dirt trail carved through the southern hills.
-- Heights come from layered math.noise and are written with WriteVoxels
-- in 64-stud chunks; chunks that are completely flat are skipped.

local Layout = require(script.Parent.Layout)

local TerrainGen = {}

local VOXEL = 4
local CHUNK = 64
local BASE = -8 -- bottom of the terrain

local function smoothstep(e0: number, e1: number, x: number): number
	local t = math.clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end

-- Raw terrain height and surface material at (x, z), before the trail is carved.
function TerrainGen.rawHeight(x: number, z: number): (number, Enum.Material)
	local half = Layout.Half
	local h = 0
	local material = Enum.Material.Grass

	local south = smoothstep(Layout.SouthHills.start, Layout.SouthHills.full, z)
	if south > 0 then
		local n = math.noise(x / 460, z / 460, 1.7) * 0.65 + math.noise(x / 180, z / 180, 8.3) * 0.28 + math.noise(x / 55, z / 55, 3.1) * 0.06
		h = math.max(h, south * (16 + n * 46))
		-- dunes in the south east
		local dune = math.noise(x / 300, z / 300, 21.5)
		if x > 250 and dune > 0.05 then
			material = Enum.Material.Sand
		end
	end
	local north = smoothstep(Layout.NorthHills.start, Layout.NorthHills.full, z)
	if north > 0 then
		local n = math.noise(x / 300, z / 300, 5.5) * 0.7 + math.noise(x / 90, z / 90, 2.2) * 0.2
		h = math.max(h, north * (22 + n * 40))
	end

	-- mountain rim close to the map edge
	local edge = math.min(half - math.abs(x), half - math.abs(z))
	local rim = smoothstep(Layout.Rim.width, 0, edge)
	if rim > 0 then
		local n = math.noise(x / 120, z / 120, 9.9) * 0.5 + 0.5
		local rh = rim * (Layout.Rim.height * (0.6 + 0.6 * n))
		if rh > h then
			h = rh
			if rim > 0.45 then
				material = Enum.Material.Rock
			end
		end
	end
	if h > 52 and material == Enum.Material.Grass then
		material = Enum.Material.Rock
	end
	return math.max(h, 0), material
end

-- Returns true if a chunk can't contain any hills (fast path).
local function chunkIsFlat(x0: number, z0: number): boolean
	local half = Layout.Half
	local x1, z1 = x0 + CHUNK, z0 + CHUNK
	if z1 > Layout.SouthHills.start or z0 < Layout.NorthHills.start then
		return false
	end
	local edge = math.min(half - math.max(math.abs(x0), math.abs(x1)), half - math.max(math.abs(z0), math.abs(z1)))
	return edge > Layout.Rim.width
end

export type TrailInfo = {
	samples: { { pos: Vector3, dir: Vector3, dist: number } },
	width: number,
}

-- Carves the trail: returns a column map { [index] = { h, dist } } and the
-- smoothed trail heights per sample (so checkpoints know where the road is).
local function rasterizeTrail(trail: TrailInfo): ({ [number]: { h: number, d: number } }, { number })
	local samples = trail.samples
	local raw = {}
	for i, s in samples do
		raw[i] = TerrainGen.rawHeight(s.pos.X, s.pos.Z)
	end
	-- smooth twice with a moving average so the road has gentle grades
	local smooth = raw
	for _ = 1, 3 do
		local nxt = {}
		for i = 1, #smooth do
			local sum, n = 0, 0
			for k = -8, 8 do
				local j = math.clamp(i + k, 1, #smooth)
				sum += smooth[j]
				n += 1
			end
			nxt[i] = sum / n
		end
		smooth = nxt
	end

	local half = Layout.Half
	local cols = math.floor(half * 2 / VOXEL)
	local reach = trail.width / 2 + 30
	local map: { [number]: { h: number, d: number } } = {}
	for i, s in samples do
		local cx0 = math.floor((s.pos.X - reach + half) / VOXEL)
		local cx1 = math.floor((s.pos.X + reach + half) / VOXEL)
		local cz0 = math.floor((s.pos.Z - reach + half) / VOXEL)
		local cz1 = math.floor((s.pos.Z + reach + half) / VOXEL)
		for cx = cx0, cx1 do
			for cz = cz0, cz1 do
				local x = cx * VOXEL - half + VOXEL / 2
				local z = cz * VOXEL - half + VOXEL / 2
				local dx, dz = x - s.pos.X, z - s.pos.Z
				local d = math.sqrt(dx * dx + dz * dz)
				if d <= reach then
					local key = cx * cols + cz
					local cur = map[key]
					if not cur or d < cur.d then
						map[key] = { h = smooth[i], d = d }
					end
				end
			end
		end
	end
	return map, smooth
end

-- Final height/material including the trail.
local function finalHeight(x: number, z: number, trailMap, trailWidth: number): (number, Enum.Material)
	local h, mat = TerrainGen.rawHeight(x, z)
	if trailMap then
		local half = Layout.Half
		local cols = math.floor(half * 2 / VOXEL)
		local key = math.floor((x + half) / VOXEL) * cols + math.floor((z + half) / VOXEL)
		local t = trailMap[key]
		if t then
			local inner = trailWidth / 2
			local blend = smoothstep(inner, inner + 30, t.d)
			h = t.h + (h - t.h) * blend
			-- dirt road with a ragged edge
			local edge = inner + 2 + (if math.noise(x / 9, z / 9, 4.4) > 0 then 4 else 0)
			if t.d < edge then
				mat = Enum.Material.Ground
			end
		end
	end
	return h, mat
end

-- Only the smoothed trail heights (used when the world was baked in Studio).
function TerrainGen.trailHeights(trail: TrailInfo): { number }
	local _, heights = rasterizeTrail(trail)
	return heights
end

-- Writes the whole terrain. `trail` may be nil. Returns trail heights (or nil).
function TerrainGen.generate(terrain: Terrain, trail: TrailInfo?): { number }?
	local half = Layout.Half
	terrain:Clear()

	-- flat grass base everywhere (8 studs deep), in tiles
	local tile = 512
	local x = -half
	while x < half do
		local z = -half
		while z < half do
			local sx = math.min(tile, half - x)
			local sz = math.min(tile, half - z)
			terrain:FillBlock(CFrame.new(x + sx / 2, BASE / 2, z + sz / 2), Vector3.new(sx, -BASE, sz), Enum.Material.Grass)
			z += tile
		end
		x += tile
	end

	local trailMap, trailHeights = nil, nil
	local trailWidth = 0
	if trail then
		trailMap, trailHeights = rasterizeTrail(trail)
		trailWidth = trail.width
	end

	local cpc = CHUNK // VOXEL -- columns per chunk
	local cx = -half
	local written = 0
	while cx < half do
		local cz = -half
		while cz < half do
			if not chunkIsFlat(cx, cz) then
				local heights = table.create(cpc * cpc)
				local mats = table.create(cpc * cpc)
				local maxH = 0
				for i = 0, cpc - 1 do
					for k = 0, cpc - 1 do
						local wx = cx + i * VOXEL + VOXEL / 2
						local wz = cz + k * VOXEL + VOXEL / 2
						local h, m = finalHeight(wx, wz, trailMap, trailWidth)
						heights[i * cpc + k + 1] = h
						mats[i * cpc + k + 1] = m
						if h > maxH then
							maxH = h
						end
					end
				end
				if maxH > 0.5 then
					local top = math.ceil((maxH + VOXEL) / VOXEL) * VOXEL
					local layers = (top - BASE) // VOXEL
					local materials = table.create(cpc)
					local occupancy = table.create(cpc)
					for i = 1, cpc do
						local mx = table.create(layers)
						local ox = table.create(layers)
						for j = 1, layers do
							mx[j] = table.create(cpc)
							ox[j] = table.create(cpc)
						end
						for k = 1, cpc do
							local h = heights[(i - 1) * cpc + k]
							local m = mats[(i - 1) * cpc + k]
							for j = 1, layers do
								local y0 = BASE + (j - 1) * VOXEL
								local occ = math.clamp((h - y0) / VOXEL, 0, 1)
								if occ > 0.02 then
									mx[j][k] = m
									ox[j][k] = occ
								else
									mx[j][k] = Enum.Material.Air
									ox[j][k] = 0
								end
							end
						end
						materials[i] = mx
						occupancy[i] = ox
					end
					local region = Region3.new(Vector3.new(cx, BASE, cz), Vector3.new(cx + CHUNK, top, cz + CHUNK))
					terrain:WriteVoxels(region, VOXEL, materials, occupancy)
					written += 1
				end
			end
			cz += CHUNK
		end
		cx += CHUNK
		-- keep the server responsive while generating
		task.wait()
	end
	return trailHeights
end

return TerrainGen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">TrackBuilder</string>
            <string name="Source"><![CDATA[-- TrackBuilder: lays the circuit road from its spline, builds checkpoint gates
-- and start areas for every track, and returns the data RaceService needs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Build = require(script.Parent.Build)
local Layout = require(script.Parent.Layout)

local Shared = ReplicatedStorage:WaitForChild("CarsShared")
local Spline = require(Shared.Util.Spline)
local Tracks = require(Shared.Tracks)

local TrackBuilder = {}

local TOP = Layout.RoadTop
local TRACK_COLOR = Color3.fromRGB(52, 54, 60)

export type Checkpoint = { cf: CFrame, width: number, index: number }
export type TrackData = {
	id: string,
	def: Tracks.Track,
	length: number,
	laps: number,
	start: CFrame,
	checkpoints: { Checkpoint },
	medals: { gold: number, silver: number, bronze: number },
}

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Gate with two pillars and a translucent neon banner.
local function gate(parent: Instance, cf: CFrame, width: number, trackId: string, index: number, isFinish: boolean)
	local model = Instance.new("Model")
	model.Name = "Checkpoint_" .. index
	local color = if isFinish then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(80, 200, 255)
	local half = width / 2 + 3
	for _, side in { -1, 1 } do
		local base = (cf * CFrame.new(side * half, 0, 0)).Position
		Build.pole(model, base, 16, 1.4, Color3.fromRGB(40, 42, 50), Enum.Material.Metal)
		Build.part(model, {
			size = Vector3.new(0.6, 14, 0.6),
			cframe = CFrame.new(base + Vector3.new(0, 8, 0)) * cf.Rotation * CFrame.new(-side * 0.8, 0, 0),
			color = color,
			material = Enum.Material.Neon,
			collide = false,
			shadow = false,
			name = "Glow",
		})
	end
	local banner = Build.part(model, {
		size = Vector3.new(width + 6, 2.6, 0.6),
		cframe = cf * CFrame.new(0, 15, 0),
		color = color,
		material = Enum.Material.Neon,
		transparency = 0.35,
		collide = false,
		shadow = false,
		name = "Banner",
	})
	if isFinish then
		Build.text(banner, Enum.NormalId.Front, "FINISH", { color = Color3.fromRGB(20, 20, 24) })
		Build.text(banner, Enum.NormalId.Back, "FINISH", { color = Color3.fromRGB(20, 20, 24) })
	else
		Build.text(banner, Enum.NormalId.Front, tostring(index), { color = Color3.fromRGB(10, 30, 50) })
		Build.text(banner, Enum.NormalId.Back, tostring(index), { color = Color3.fromRGB(10, 30, 50) })
	end
	model:SetAttribute("Track", trackId)
	model:SetAttribute("Index", index)
	model.PrimaryPart = banner
	model.Parent = parent
	Build.tag(model, "CheckpointGate")
	return model
end

local function checkered(parent: Instance, cf: CFrame, width: number)
	local cols = math.floor(width / 3)
	local size = width / cols
	for row = 0, 1 do
		for col = 0, cols - 1 do
			local black = (row + col) % 2 == 0
			Build.part(parent, {
				size = Vector3.new(size, 0.06, size),
				cframe = cf * CFrame.new(-width / 2 + size * (col + 0.5), 0.03, (row - 0.5) * size),
				color = if black then Color3.fromRGB(20, 20, 22) else Color3.fromRGB(245, 245, 245),
				collide = false,
				shadow = false,
				name = "StartLine",
			})
		end
	end
end

local function startPad(parent: Instance, track: Tracks.Track, cf: CFrame)
	local trigger = Build.part(parent, {
		size = Vector3.new(10, 4, 10),
		cframe = cf * CFrame.new(0, 2, 0),
		transparency = 1,
		collide = false,
		name = "RaceStart_" .. track.id,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RacePrompt"
	prompt.ActionText = "Start race"
	prompt.ObjectText = track.name.en
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonY
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 26
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("TrackId", track.id)
	prompt:SetAttribute("LocAction", "PromptRace")
	prompt:SetAttribute("LocTrack", track.id)
	prompt.Parent = trigger
	-- painted start box
	for _, x in { -1, 1 } do
		Build.part(parent, {
			size = Vector3.new(0.6, 0.06, 26),
			cframe = cf * CFrame.new(x * 9, 0.04, 0),
			color = Color3.fromRGB(80, 200, 255),
			material = Enum.Material.Neon,
			collide = false,
			shadow = false,
		})
	end
end

local function buildCircuitRoad(parent: Instance, track: Tracks.Track, samples)
	local w = track.width
	local n = #samples
	for i = 1, n do
		local a = samples[i]
		local b = samples[(i % n) + 1]
		local seg = Build.strip(parent, a.pos, b.pos, w, 1, TOP, TRACK_COLOR, Enum.Material.SmoothPlastic, 1.2)
		if seg then
			seg.Name = "Track"
		end
		-- curbs where the track bends
		local nextDir = samples[((i + 1) % n) + 1].dir
		local turn = math.abs(a.dir:Cross(nextDir).Y)
		local right = Vector3.new(-a.dir.Z, 0, a.dir.X)
		if turn > 0.035 then
			local color = if i % 2 == 0 then Color3.fromRGB(220, 30, 30) else Color3.fromRGB(245, 245, 245)
			for _, side in { -1, 1 } do
				local off = right * side * (w / 2 + 1.5)
				Build.strip(parent, a.pos + off, b.pos + off, 3, 0.5, TOP + 0.15, color, Enum.Material.SmoothPlastic, 0.4)
			end
		end
	end
end

-- `buildParts = false` only computes the data (for worlds baked in Studio).
function TrackBuilder.build(root: Instance, trailHeights: { number }?, trailSamples, buildParts: boolean): { [string]: TrackData }
	local folder = Build.folder("Tracks", root)
	local result: { [string]: TrackData } = {}
	for _, track in Tracks.List do
		local tf = Build.folder(track.id, folder)
		local closed = track.kind == "circuit"
		local samples, length
		if track.surface == "dirt" and trailSamples then
			samples = trailSamples
			length = samples[#samples].dist
		else
			samples, length = Spline.sample(track.points, closed, 14)
		end

		local function heightAt(i: number): number
			if track.surface == "dirt" and trailHeights then
				return trailHeights[i] or 0
			end
			return TOP
		end

		if track.surface == "road" and buildParts then
			buildCircuitRoad(tf, track, samples)
		end

		-- checkpoints
		local cps: { Checkpoint } = {}
		local gateWidth = track.width
		if track.checkpointSpacing > 0 then
			local nextDist = track.checkpointSpacing
			local lastIndex = #samples
			for i, s in samples do
				if s.dist >= nextDist and (closed or s.dist < length - track.checkpointSpacing * 0.5) then
					local pos = Vector3.new(s.pos.X, heightAt(i), s.pos.Z)
					table.insert(cps, { cf = CFrame.lookAt(pos, pos + flat(s.dir)), width = gateWidth, index = #cps + 1 })
					nextDist += track.checkpointSpacing
				end
				lastIndex = i
			end
			if closed then
				-- finish = the start line
				local s = samples[1]
				local pos = Vector3.new(s.pos.X, TOP, s.pos.Z)
				table.insert(cps, { cf = CFrame.lookAt(pos, pos + flat(s.dir)), width = gateWidth, index = #cps + 1 })
			else
				local s = samples[lastIndex]
				local prev = samples[math.max(lastIndex - 1, 1)]
				local pos = Vector3.new(s.pos.X, heightAt(lastIndex), s.pos.Z)
				local dir = flat(s.pos - prev.pos)
				table.insert(cps, { cf = CFrame.lookAt(pos, pos + dir), width = gateWidth, index = #cps + 1 })
			end
		else
			for i = 2, #track.points do
				local p = track.points[i]
				local prev = track.points[i - 1]
				local dir = flat(p - prev).Unit
				-- these tracks use the street grid: put the gate just before the
				-- junction so its pillars don't stand in the cross street
				local back = math.min(34, (p - prev).Magnitude * 0.4)
				local pos = Vector3.new(p.X, TOP, p.Z) - dir * back
				table.insert(cps, { cf = CFrame.lookAt(pos, pos + dir), width = gateWidth, index = #cps + 1 })
			end
		end

		if buildParts then
			for i, cp in cps do
				gate(tf, cp.cf, cp.width, track.id, i, i == #cps)
			end
		end

		-- start position (cars placed here at race start)
		local first = samples[1]
		local startDir = flat(first.dir)
		local startPos = Vector3.new(first.pos.X, heightAt(1), first.pos.Z)
		if closed then
			startPos -= startDir * 24 -- grid slot behind the line
			if buildParts then
				local lineCf = CFrame.lookAt(Vector3.new(first.pos.X, TOP, first.pos.Z), Vector3.new(first.pos.X, TOP, first.pos.Z) + startDir)
				checkered(tf, lineCf, track.width)
			end
		end
		local startCf = CFrame.lookAt(startPos, startPos + startDir)
		if buildParts then
			startPad(tf, track, startCf)
		end

		local laps = if closed then track.laps else 1
		local total = length * laps
		result[track.id] = {
			id = track.id,
			def = track,
			length = total,
			laps = laps,
			start = startCf,
			checkpoints = cps,
			medals = {
				gold = total / track.medalSpeeds.gold,
				silver = total / track.medalSpeeds.silver,
				bronze = total / track.medalSpeeds.bronze,
			},
		}
	end
	return result
end

return TrackBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="38">
      <Properties>
        <string name="Name">CarsShared</string>
      </Properties>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">CarBuilder</string>
          <string name="Source"><![CDATA[-- CarBuilder: turns a CarCatalog definition into a drivable Model made of parts.
--
-- Layout of the produced model:
--   Model "Car"            PrimaryPart = Chassis, attributes CarId/OwnerUserId/...
--     Chassis              invisible, the only part with mass (center of mass)
--     Hull_*               invisible collision boxes (massless)
--     Body (Folder)        all visual parts, tagged with a "Role" attribute
--     Wheel_<i>            tire parts joined to the chassis with a Motor6D "Axle";
--                          the client animates Axle.Transform for spin/steer/suspension
--     DriveSeat            VehicleSeat for the owner, Seat_<n> for passengers
--
-- The same builder makes garage previews (preview = true: anchored, no seats/joints).

local CarCatalog = require(script.Parent.CarCatalog)
local Paints = require(script.Parent.Paints)
local Types = require(script.Parent.Types)

type CarDef = Types.CarDef
type CarSave = Types.CarSave

export type BuildOptions = {
	preview: boolean?, -- anchored model for ViewportFrames / showrooms
	showroom: boolean?, -- anchored, but keeps decals and lights
	ownerName: string?,
	save: CarSave?,
}

local CarBuilder = {}

local ROLE_STYLE: { [string]: { color: Color3?, material: Enum.Material, reflectance: number?, transparency: number? } } =
	{
		Trim = { color = Color3.fromRGB(34, 35, 40), material = Enum.Material.SmoothPlastic },
		Dark = { color = Color3.fromRGB(14, 14, 17), material = Enum.Material.SmoothPlastic },
		Chrome = { color = Color3.fromRGB(214, 218, 224), material = Enum.Material.SmoothPlastic, reflectance = 0.55 },
		Glass = {
			color = Color3.fromRGB(28, 38, 54),
			material = Enum.Material.Glass,
			reflectance = 0.15,
			transparency = 0.35,
		},
		TintGlass = {
			color = Color3.fromRGB(12, 14, 20),
			material = Enum.Material.Glass,
			reflectance = 0.2,
			transparency = 0.15,
		},
		Tire = { color = Color3.fromRGB(30, 30, 33), material = Enum.Material.SmoothPlastic },
		Interior = { color = Color3.fromRGB(44, 44, 50), material = Enum.Material.Fabric },
		Headlight = { color = Color3.fromRGB(255, 249, 228), material = Enum.Material.Neon },
		Taillight = { color = Color3.fromRGB(120, 8, 12), material = Enum.Material.Neon },
		Indicator = { color = Color3.fromRGB(255, 150, 24), material = Enum.Material.Neon },
		Light = { color = Color3.fromRGB(255, 252, 240), material = Enum.Material.Neon },
		Plate = { color = Color3.fromRGB(236, 238, 240), material = Enum.Material.SmoothPlastic },
		SirenA = { color = Color3.fromRGB(150, 20, 20), material = Enum.Material.SmoothPlastic, transparency = 0.15 },
		SirenB = { color = Color3.fromRGB(20, 40, 160), material = Enum.Material.SmoothPlastic, transparency = 0.15 },
		White = { color = Color3.fromRGB(245, 245, 245), material = Enum.Material.SmoothPlastic },
	}

local SIREN_COLORS = {
	police = { Color3.fromRGB(255, 30, 30), Color3.fromRGB(30, 90, 255) },
	medic = { Color3.fromRGB(255, 30, 30), Color3.fromRGB(255, 255, 255) },
	fire = { Color3.fromRGB(255, 30, 30), Color3.fromRGB(255, 140, 20) },
}

CarBuilder.SirenColors = SIREN_COLORS

local SEATED_HEAD = 3.9 -- seat top to head top of a seated R15 character

-- collision hulls start a little above the visual floor so low cars don't scrape on bumps
CarBuilder.HullLift = 0.3

--------------------------------------------------------------------------------
-- Builder context
--------------------------------------------------------------------------------

type Ctx = {
	def: CarDef,
	save: CarSave,
	opts: BuildOptions,
	model: Model,
	body: Folder,
	chassis: BasePart,
	anchored: boolean,
	decor: boolean, -- SurfaceGuis, lights, attachments
	seatCount: number,
}

local function applyRole(part: BasePart, role: string, save: CarSave)
	if role == "Paint" then
		local finish = Paints.getFinish(save.finish)
		part.Color = Paints.getColor(save.paint)
		part.Material = finish.material
		part.Reflectance = finish.reflectance
		part.Transparency = 0
	elseif role == "Accent" then
		part.Color = Paints.getColor(save.accent)
		part.Material = Enum.Material.SmoothPlastic
		part.Reflectance = 0.1
	elseif role == "NeonAccent" then
		part.Color = Paints.getColor(save.accent)
		part.Material = Enum.Material.Neon
	elseif role == "Rim" then
		part.Color = Paints.getColor(save.rim)
		part.Material = Enum.Material.SmoothPlastic
		part.Reflectance = 0.25
	elseif role == "Glow" then
		local on = save.glow ~= nil and save.glow > 0
		part.Color = Paints.getColor(if on then save.glow else 1)
		part.Material = Enum.Material.Neon
		part.Transparency = if on then 0 else 1
		local light = part:FindFirstChildOfClass("PointLight")
		if light then
			light.Color = part.Color
			light.Enabled = on
		end
	else
		local style = ROLE_STYLE[role]
		if style then
			if style.color then
				part.Color = style.color
			end
			part.Material = style.material
			part.Reflectance = style.reflectance or 0
			part.Transparency = style.transparency or 0
		end
	end
end

local function makePart(ctx: Ctx, className: string, role: string, size: Vector3, cf: CFrame, parent: Instance?): BasePart
	local part = Instance.new(className) :: BasePart
	part.Name = role
	part.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	part.CFrame = cf
	part.Anchored = ctx.anchored
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CastShadow = size.X * size.Y * size.Z > 0.3
	part:SetAttribute("Role", role)
	applyRole(part, role, ctx.save)
	part.Parent = parent or ctx.body
	return part
end

local function box(ctx: Ctx, role: string, size: Vector3, at: Vector3 | CFrame, parent: Instance?): BasePart
	local cf = if typeof(at) == "CFrame" then at else CFrame.new(at)
	return makePart(ctx, "Part", role, size, cf, parent)
end

-- Box spanning two y values and two z values at a given x range.
local function slab(ctx: Ctx, role: string, x0: number, x1: number, y0: number, y1: number, z0: number, z1: number): BasePart?
	if x1 - x0 < 0.02 or y1 - y0 < 0.02 or z1 - z0 < 0.02 then
		return nil
	end
	return box(
		ctx,
		role,
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)
	)
end

-- Wedge whose high side faces +Z (rear) when `risingToRear` is true.
local function wedge(ctx: Ctx, role: string, size: Vector3, center: Vector3, risingToRear: boolean): BasePart
	local cf = CFrame.new(center)
	if not risingToRear then
		cf = cf * CFrame.Angles(0, math.pi, 0)
	end
	local part = Instance.new("WedgePart")
	part.Name = role
	part.Size = size
	part.CFrame = cf
	part.Anchored = ctx.anchored
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = true
	part:SetAttribute("Role", role)
	applyRole(part, role, ctx.save)
	part.Parent = ctx.body
	return part
end

-- Cylinder with its axis along the local X of `cf`.
local function cylinder(ctx: Ctx, role: string, length: number, diameter: number, cf: CFrame, parent: Instance?): BasePart
	local part = makePart(ctx, "Part", role, Vector3.new(length, diameter, diameter), cf, parent);
	(part :: Part).Shape = Enum.PartType.Cylinder
	return part
end

local function ball(ctx: Ctx, role: string, diameter: number, pos: Vector3): BasePart
	local part = makePart(ctx, "Part", role, Vector3.new(diameter, diameter, diameter), CFrame.new(pos));
	(part :: Part).Shape = Enum.PartType.Ball
	return part
end

-- Box stretched between two points (thickness x height across the line).
local function beam(ctx: Ctx, role: string, p0: Vector3, p1: Vector3, thickness: number, height: number?): BasePart?
	local d = p1 - p0
	local len = d.Magnitude
	if len < 0.02 then
		return nil
	end
	local mid = (p0 + p1) / 2
	local up = if math.abs(d.Unit.Y) > 0.98 then Vector3.new(0, 0, -1) else Vector3.new(0, 1, 0)
	local cf = CFrame.lookAt(mid, p1, up)
	return box(ctx, role, Vector3.new(thickness, height or thickness, len), cf)
end

-- Cylinder tube between two points.
local function tube(ctx: Ctx, role: string, p0: Vector3, p1: Vector3, diameter: number): BasePart?
	local d = p1 - p0
	local len = d.Magnitude
	if len < 0.02 then
		return nil
	end
	local mid = (p0 + p1) / 2
	local up = if math.abs(d.Unit.Y) > 0.98 then Vector3.new(0, 0, -1) else Vector3.new(0, 1, 0)
	local cf = CFrame.lookAt(mid, p1, up) * CFrame.Angles(0, math.pi / 2, 0)
	return cylinder(ctx, role, len, diameter, cf)
end

local function hull(ctx: Ctx, size: Vector3, center: Vector3)
	if ctx.opts.preview or ctx.opts.showroom then
		return
	end
	local part = Instance.new("Part")
	part.Name = "Hull"
	part.Size = size
	part.CFrame = CFrame.new(center)
	part.Transparency = 1
	part.CanCollide = true
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Anchored = false
	part.CastShadow = false
	part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.25, 0.15, 1, 1)
	part.Parent = ctx.model
end

local function surfaceText(
	ctx: Ctx,
	part: BasePart,
	face: Enum.NormalId,
	text: string,
	textColor: Color3,
	bg: Color3?,
	font: Enum.Font?
): SurfaceGui?
	if not ctx.decor then
		return nil
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.6
	gui.ZOffset = 1
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = if bg then 0 else 1
	label.BackgroundColor3 = bg or Color3.new(1, 1, 1)
	label.Text = text
	label.TextScaled = true
	label.Font = font or Enum.Font.GothamBlack
	label.TextColor3 = textColor
	label.BorderSizePixel = 0
	label.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.Parent = label
	gui.Parent = part
	return gui
end

local function roundel(ctx: Ctx, part: BasePart, face: Enum.NormalId, text: string)
	if not ctx.decor then
		return
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.6
	local circle = Instance.new("Frame")
	circle.Size = UDim2.fromScale(1, 1)
	circle.BackgroundColor3 = Color3.new(1, 1, 1)
	circle.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = circle
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(0.8, 0.8)
	label.Position = UDim2.fromScale(0.1, 0.1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = Color3.fromRGB(15, 15, 20)
	label.Parent = circle
	circle.Parent = gui
	gui.Parent = part
end

local function attachment(ctx: Ctx, name: string, worldPos: Vector3)
	if not ctx.decor or ctx.opts.preview or ctx.opts.showroom then
		return
	end
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = ctx.chassis.CFrame:PointToObjectSpace(worldPos)
	a.Parent = ctx.chassis
end

--------------------------------------------------------------------------------
-- Shared measurements
--------------------------------------------------------------------------------

type Geo = {
	L: number,
	W: number,
	zF: number,
	zR: number,
	floor: number,
	belt: number,
	nose: number,
	noseDrop: number,
	tail: number,
	tailDrop: number,
	axles: { CarCatalog.Axle },
	innerHalf: number,
	topAt: (z: number) -> number,
	cabin: {
		z0: number,
		z1: number,
		z2: number,
		z3: number,
		yR: number,
		gw: number,
		yBase: number,
	}?,
	hullEnd: number,
	bedStart: number?,
	bedFloor: number?,
	wells: { { z0: number, z1: number, top: number, axle: CarCatalog.Axle } },
}

local ARCH_GAP = 0.3

local function measure(def: CarDef): Geo
	local b = def.body
	local L, W = b.length, b.width
	local zF, zR = -L / 2, L / 2
	local nose = b.nose or 0
	local noseDrop = b.noseDrop or 0
	local tail = b.tail or 0
	local tailDrop = b.tailDrop or 0
	local belt = b.belt
	local axles = CarCatalog.getAxles(def)

	local minInner = math.huge
	for _, a in axles do
		minInner = math.min(minInner, a.track / 2 - a.width / 2 - 0.12)
	end

	local function topAt(z: number): number
		if nose > 0 and z < zF + nose then
			return belt - noseDrop * (1 - (z - zF) / nose)
		elseif tail > 0 and z > zR - tail then
			return belt - tailDrop * ((z - (zR - tail)) / tail)
		end
		return belt
	end

	local wells = {}
	for _, a in axles do
		table.insert(wells, {
			z0 = a.z - a.radius - ARCH_GAP,
			z1 = a.z + a.radius + ARCH_GAP,
			top = a.radius * 2 + ARCH_GAP,
			axle = a,
		})
	end

	local geo: Geo = {
		L = L,
		W = W,
		zF = zF,
		zR = zR,
		floor = b.floor,
		belt = belt,
		nose = nose,
		noseDrop = noseDrop,
		tail = tail,
		tailDrop = tailDrop,
		axles = axles,
		innerHalf = math.max(minInner, 0.5),
		topAt = topAt,
		cabin = nil,
		hullEnd = zR,
		bedStart = nil,
		bedFloor = nil,
		wells = wells,
	}

	if b.style == "semi" and b.box then
		geo.hullEnd = zF + b.box.start + (b.box.length or 2.5)
	end
	if b.bed then
		geo.bedStart = zF + b.bed.start
		local maxTop = 0
		for _, well in wells do
			if well.z1 > geo.bedStart then
				maxTop = math.max(maxTop, well.top)
			end
		end
		geo.bedFloor = math.min(math.max(maxTop + 0.05, b.floor + 0.6), belt - 0.8)
	end

	local c = b.cabin
	if c then
		local z0 = zF + c.start
		local z1 = z0 + c.wind
		local z2 = z1 + c.roof
		local z3 = math.min(z2 + c.back, geo.hullEnd - tail)
		geo.cabin = {
			z0 = z0,
			z1 = z1,
			z2 = z2,
			z3 = z3,
			yR = belt + c.height,
			gw = W - 2 * c.inset,
			yBase = topAt(z0),
		}
	end
	return geo
end

CarBuilder.measure = measure

-- Seat layout (car-space positions of the seat tops).
export type SeatPos = { pos: Vector3, driver: boolean }

function CarBuilder.getSeats(def: CarDef): { SeatPos }
	local geo = measure(def)
	local b = def.body
	local seats: { SeatPos } = {}
	local cab = geo.cabin
	local headroom = if cab then cab.yR - SEATED_HEAD - 0.05 else math.huge
	local function seatY(custom: number?): number
		if custom then
			return custom
		end
		return math.clamp(b.floor + 0.45, 0.35, math.max(headroom, 0.35))
	end
	if def.seats then
		for _, s in def.seats do
			table.insert(seats, { pos = Vector3.new(s.x, seatY(s.y), s.z), driver = s.driver == true })
		end
		return seats
	end
	if not cab then
		table.insert(seats, { pos = Vector3.new(0, seatY(nil), 0), driver = true })
		return seats
	end
	local y = seatY(nil)
	local dz = cab.z1 + 0.9
	local off = math.clamp(cab.gw / 2 - 1.15, 0, 1.6)
	table.insert(seats, { pos = Vector3.new(-off, y, dz), driver = true })
	local limit = def.maxSeats or 4
	if off >= 0.9 and #seats < limit then
		table.insert(seats, { pos = Vector3.new(off, y, dz), driver = false })
	end
	local rearZ = dz + 2.7
	if b.cabin and (cab.z2 + (b.cabin.back * 0.35)) - rearZ > 0.4 then
		if #seats < limit then
			table.insert(seats, { pos = Vector3.new(-off, y, rearZ), driver = false })
		end
		if off >= 0.9 and #seats < limit then
			table.insert(seats, { pos = Vector3.new(off, y, rearZ), driver = false })
		end
	end
	return seats
end

--------------------------------------------------------------------------------
-- Body sections
--------------------------------------------------------------------------------

-- Lower body "loft": slices the body along z, cutting wheel wells into the outer bands.
local function buildLowerBody(ctx: Ctx, geo: Geo)
	local breaks = { geo.zF, geo.hullEnd }
	local function addBreak(z: number)
		if z > geo.zF + 0.01 and z < geo.hullEnd - 0.01 then
			table.insert(breaks, z)
		end
	end
	addBreak(geo.zF + geo.nose)
	addBreak(geo.hullEnd - geo.tail)
	for _, w in geo.wells do
		addBreak(w.z0)
		addBreak(w.z1)
	end
	if geo.bedStart then
		addBreak(geo.bedStart)
	end
	table.sort(breaks)

	local W2 = geo.W / 2
	local inner = geo.innerHalf
	local floor = geo.floor
	local topAt = geo.topAt
	-- the tail chamfer must end at the hull end for semis
	if geo.hullEnd < geo.zR then
		local hullEnd = geo.hullEnd
		local belt, tail, tailDrop = geo.belt, geo.tail, geo.tailDrop
		topAt = function(z: number): number
			if tail > 0 and z > hullEnd - tail then
				return belt - tailDrop * ((z - (hullEnd - tail)) / tail)
			end
			return geo.topAt(math.min(z, hullEnd - tail - 0.001))
		end
	end

	for i = 1, #breaks - 1 do
		local a, b = breaks[i], breaks[i + 1]
		if b - a < 0.02 then
			continue
		end
		local mid = (a + b) / 2
		local ta, tb = topAt(a), topAt(b)
		local inBed = geo.bedStart ~= nil and mid > geo.bedStart
		if inBed then
			ta, tb = geo.bedFloor :: number, geo.bedFloor :: number
		end
		local tMin, tMax = math.min(ta, tb), math.max(ta, tb)
		local well = nil
		for _, w in geo.wells do
			if mid > w.z0 and mid < w.z1 then
				well = w
				break
			end
		end

		local function column(x0: number, x1: number, bottom: number)
			if tMin - bottom > 0.02 then
				slab(ctx, "Paint", x0, x1, bottom, tMin, a, b)
			end
			if tMax - tMin > 0.02 then
				local base = math.max(bottom, tMin)
				local h = tMax - base
				if h > 0.02 then
					wedge(ctx, "Paint", Vector3.new(x1 - x0, h, b - a), Vector3.new((x0 + x1) / 2, base + h / 2, mid), tb > ta)
				end
			end
		end

		if well then
			-- inner core is solid, the outer bands only exist above the arch
			column(-inner, inner, floor)
			local archTop = well.top
			if archTop < tMax - 0.05 then
				column(-W2, -inner, archTop)
				column(inner, W2, archTop)
			end
		else
			column(-W2, W2, floor)
		end
	end

	-- dark liners inside the wheel wells so the arches read as openings
	for _, w in geo.wells do
		if w.z0 < geo.hullEnd - 0.1 then
			local z1 = math.min(w.z1, geo.hullEnd)
			local top = math.min(w.top, geo.belt)
			for _, side in { -1, 1 } do
				box(
					ctx,
					"Dark",
					Vector3.new(0.12, top - floor, z1 - w.z0),
					Vector3.new(side * (inner + 0.06), (top + floor) / 2, (w.z0 + z1) / 2)
				)
			end
			-- flared arch over wheels that poke above the body line
			local lowTop = math.min(topAt(math.max(w.z0, geo.zF)), topAt(math.min(z1, geo.hullEnd)), topAt(w.axle.z))
			if w.top > lowTop - 0.15 then
				local flareTop = w.top + 0.35
				local zLen = z1 - w.z0
				for _, side in { -1, 1 } do
					local x0 = side * inner
					local x1 = side * W2
					local cx = (x0 + x1) / 2
					local wx = math.abs(x1 - x0) + 0.05
					box(ctx, "Paint", Vector3.new(wx, flareTop - w.top, zLen), Vector3.new(cx, (w.top + flareTop) / 2, (w.z0 + z1) / 2))
					-- ramps that blend the arch into the body in front of and behind the wheel
					for _, dir in { -1, 1 } do
						local edge = if dir < 0 then w.z0 else z1
						local room = if dir < 0 then edge - geo.zF else geo.hullEnd - edge
						local base = topAt(math.clamp(edge + dir * 0.4, geo.zF, geo.hullEnd))
						local h = flareTop - base
						local len = math.min(math.clamp(h * 1.3, 0.6, 2.2), room)
						if h > 0.05 and len > 0.1 then
							wedge(ctx, "Paint", Vector3.new(wx, h, len), Vector3.new(cx, base + h / 2, edge + dir * len / 2), dir < 0)
						end
					end
				end
			end
		end
	end
end

local function buildBed(ctx: Ctx, geo: Geo)
	if not geo.bedStart then
		return
	end
	local bedFloor = geo.bedFloor :: number
	local W2 = geo.W / 2
	local zEnd = geo.zR
	local t = 0.35
	-- side walls, front wall, tailgate
	for _, side in { -1, 1 } do
		slab(ctx, "Paint", side > 0 and W2 - t or -W2, side > 0 and W2 or -W2 + t, bedFloor, geo.belt, geo.bedStart, zEnd)
		box(ctx, "Trim", Vector3.new(t + 0.06, 0.12, zEnd - geo.bedStart), Vector3.new(side * (W2 - t / 2), geo.belt + 0.06, (geo.bedStart + zEnd) / 2))
	end
	slab(ctx, "Paint", -W2, W2, bedFloor, geo.belt, geo.bedStart, geo.bedStart + t)
	slab(ctx, "Paint", -W2, W2, bedFloor, geo.belt - 0.05, zEnd - t, zEnd)
	slab(ctx, "Dark", -W2 + t, W2 - t, bedFloor, bedFloor + 0.06, geo.bedStart + t, zEnd - t)
	hull(ctx, Vector3.new(geo.W, bedFloor - geo.floor, zEnd - geo.bedStart), Vector3.new(0, (bedFloor + geo.floor) / 2, (geo.bedStart + zEnd) / 2))
end

local function buildCabin(ctx: Ctx, geo: Geo)
	local cab = geo.cabin
	local spec = ctx.def.body.cabin
	if not cab or not spec then
		return
	end
	local belt = geo.belt
	local z0, z1, z2, z3 = cab.z0, cab.z1, cab.z2, cab.z3
	local yR, gw = cab.yR, cab.gw
	local yB = cab.yBase
	local roofT = 0.3
	local features = ctx.def.features
	local gx = gw / 2

	if spec.open then
		-- convertible: raked windscreen in a frame, no roof
		local p0 = Vector3.new(0, yB, z0)
		local p1 = Vector3.new(0, yR, z1)
		local d = p1 - p0
		local cf = CFrame.lookAt((p0 + p1) / 2, p1)
		box(ctx, "Glass", Vector3.new(gw - 0.3, 0.12, d.Magnitude), cf)
		beam(ctx, "Trim", Vector3.new(-gx + 0.1, yR, z1), Vector3.new(gx - 0.1, yR, z1), 0.22)
		for _, side in { -1, 1 } do
			beam(ctx, "Trim", Vector3.new(side * (gx - 0.1), yB, z0), Vector3.new(side * (gx - 0.1), yR, z1), 0.22)
		end
		-- cockpit tub (recessed look)
		slab(ctx, "Interior", -gx + 0.2, gx - 0.2, belt, belt + 0.04, z1, z2 + 0.5)
		hull(ctx, Vector3.new(gw, 0.8, z2 - z0), Vector3.new(0, belt + 0.4, (z0 + z2) / 2))
		if features.rollHoops then
			for _, side in { -1, 1 } do
				local x = side * math.clamp(gx - 1.15, 0, 1.6)
				local zh = z2 + 0.2
				tube(ctx, "Chrome", Vector3.new(x - 0.7, belt, zh), Vector3.new(x - 0.7, belt + 1.4, zh), 0.22)
				tube(ctx, "Chrome", Vector3.new(x + 0.7, belt, zh), Vector3.new(x + 0.7, belt + 1.4, zh), 0.22)
				tube(ctx, "Chrome", Vector3.new(x - 0.75, belt + 1.4, zh), Vector3.new(x + 0.75, belt + 1.4, zh), 0.22)
			end
		end
		return
	end

	local glassRole = "Glass"
	local roofRole = if spec.glassRoof then "TintGlass" else "Paint"

	-- windshield
	if z1 - z0 > 0.05 then
		wedge(ctx, glassRole, Vector3.new(gw, yR - yB, z1 - z0), Vector3.new(0, (yB + yR) / 2, (z0 + z1) / 2), true)
	end
	-- side windows / panels under the roof
	local sideGlassEnd = z2
	if spec.sideWindows then
		sideGlassEnd = math.min(z2, z1 + spec.sideWindows)
	end
	slab(ctx, glassRole, -gx, gx, belt, yR - roofT, z1, sideGlassEnd)
	if sideGlassEnd < z2 then
		slab(ctx, "Paint", -gx, gx, belt, yR - roofT, sideGlassEnd, z2)
	end
	-- roof panel
	slab(ctx, roofRole, -gx - 0.04, gx + 0.04, yR - roofT, yR, z1 - 0.05, z2 + 0.05)
	if spec.glassRoof then
		for _, side in { -1, 1 } do
			slab(ctx, "Paint", side * gx - 0.2, side * gx + 0.06, yR - roofT - 0.02, yR + 0.02, z1 - 0.05, z2 + 0.05)
		end
	end
	-- rear glass
	if z3 - z2 > 0.05 then
		wedge(ctx, glassRole, Vector3.new(gw, yR - belt, z3 - z2), Vector3.new(0, (belt + yR) / 2, (z2 + z3) / 2), false)
	end

	-- pillars
	for _, side in { -1, 1 } do
		local x = side * (gx + 0.02)
		beam(ctx, "Paint", Vector3.new(x, yB, z0), Vector3.new(x, yR, z1), 0.28)
		if z3 - z2 > 0.05 then
			beam(ctx, "Paint", Vector3.new(x, yR, z2), Vector3.new(x, belt, z3), 0.34)
		else
			beam(ctx, "Paint", Vector3.new(x, belt, z2 - 0.15), Vector3.new(x, yR, z2 - 0.15), 0.34)
		end
		local spacing = spec.windowPillars
		if spacing then
			local z = z1 + spacing
			while z < sideGlassEnd - 0.8 do
				beam(ctx, "Paint", Vector3.new(x, belt, z), Vector3.new(x, yR - roofT, z), 0.3)
				z += spacing
			end
		elseif spec.roof > 3.2 and sideGlassEnd >= z2 then
			local bz = z1 + math.min(spec.roof * 0.48, 2.6)
			beam(ctx, "Paint", Vector3.new(x, belt, bz), Vector3.new(x, yR - roofT, bz), 0.3)
		end
		-- window sill trim
		local trimRole = if features.chromeTrim then "Chrome" else "Trim"
		box(ctx, trimRole, Vector3.new(0.1, 0.08, z2 - z1), Vector3.new(x, belt + 0.04, (z1 + z2) / 2))
	end

	-- dashboard visible through the windshield
	slab(ctx, "Interior", -gx + 0.15, gx - 0.15, belt, belt + 0.4, z0 + 0.1, z0 + (z1 - z0) * 0.7)

	hull(ctx, Vector3.new(gw, yR - belt, math.max(z3 - z0, 1) * 0.85), Vector3.new(0, (belt + yR) / 2, (z0 + z3) / 2))
end

local function buildBox(ctx: Ctx, geo: Geo)
	local spec = ctx.def.body.box
	if not spec then
		return
	end
	local zs = geo.zF + spec.start
	local ze = if spec.length then zs + spec.length else geo.zR
	local W = geo.W - (if ctx.def.body.style == "semi" then 0.3 else 0)
	local yb = geo.belt
	local top = spec.top
	slab(ctx, "Paint", -W / 2, W / 2, yb, top - 0.25, zs, ze)
	-- slightly inset roof cap
	slab(ctx, "Paint", -W / 2 + 0.15, W / 2 - 0.15, top - 0.25, top, zs + 0.1, ze - 0.1)
	-- corner trims
	for _, side in { -1, 1 } do
		beam(ctx, "Trim", Vector3.new(side * W / 2, top - 0.25, zs), Vector3.new(side * W / 2, top - 0.25, ze), 0.18)
	end
	hull(ctx, Vector3.new(W, top - yb, ze - zs), Vector3.new(0, (yb + top) / 2, (zs + ze) / 2))
	if ctx.def.features.sideStripe then
		for _, side in { -1, 1 } do
			box(ctx, "Accent", Vector3.new(0.06, 0.6, ze - zs - 0.4), Vector3.new(side * (W / 2 + 0.03), yb + 1.2, (zs + ze) / 2))
		end
	end
	-- rear doors
	if ctx.def.body.style == "box" then
		box(ctx, "Dark", Vector3.new(0.08, top - yb - 0.6, 0.06), Vector3.new(0, (yb + top) / 2 - 0.2, ze + 0.03))
		box(ctx, "Glass", Vector3.new(W * 0.3, 1.2, 0.06), Vector3.new(-W * 0.22, top - 1.4, ze + 0.03))
		box(ctx, "Glass", Vector3.new(W * 0.3, 1.2, 0.06), Vector3.new(W * 0.22, top - 1.4, ze + 0.03))
	end
end

local function buildSemiFrame(ctx: Ctx, geo: Geo)
	if ctx.def.body.style ~= "semi" then
		return
	end
	local zs = geo.hullEnd - 0.5
	local ze = geo.zR
	local y = geo.floor + 0.4
	for _, side in { -1, 1 } do
		slab(ctx, "Trim", side * 2.2 - 0.35, side * 2.2 + 0.35, y - 0.4, y + 0.5, zs, ze)
	end
	slab(ctx, "Chrome", -2.9, 2.9, y + 0.5, y + 0.7, zs + 0.5, ze - 0.2)
	-- fifth wheel
	local rearMid = 0
	local n = 0
	for _, a in geo.axles do
		if a.drive then
			rearMid += a.z
			n += 1
		end
	end
	rearMid = if n > 0 then rearMid / n else (zs + ze) / 2
	cylinder(ctx, "Dark", 0.35, 3.6, CFrame.new(0, y + 0.85, rearMid) * CFrame.Angles(0, 0, math.pi / 2))
	-- rear fenders and mud flaps
	for _, a in geo.axles do
		if a.z > zs then
			for _, side in { -1, 1 } do
				local x = side * a.track / 2
				box(ctx, "Trim", Vector3.new(a.width + 0.4, 0.2, a.radius * 2 + 0.4), Vector3.new(x, a.radius * 2 + 0.35, a.z))
			end
		end
	end
	for _, side in { -1, 1 } do
		box(ctx, "Dark", Vector3.new(1.6, 1.4, 0.1), Vector3.new(side * geo.axles[1].track / 2, 1.1, ze - 0.2))
	end
	hull(ctx, Vector3.new(5.8, 1.2, ze - zs), Vector3.new(0, y + 0.1, (zs + ze) / 2))
end

local function buildBumpersAndLights(ctx: Ctx, geo: Geo)
	local f = ctx.def.features
	local W2 = geo.W / 2
	local floor = geo.floor
	local zF, zR = geo.zF, geo.zR
	local frontTop = geo.topAt(zF)
	local rearTop = if geo.bedStart then geo.belt else geo.topAt(zR)
	local trimRole = if f.chromeTrim then "Chrome" else "Trim"

	-- bumpers
	local bh = math.min(0.7, (frontTop - floor) * 0.5)
	box(ctx, trimRole, Vector3.new(geo.W - 0.3, bh, 0.45), Vector3.new(0, floor + bh / 2 + 0.05, zF + 0.12))
	local rbh = math.min(0.7, (rearTop - floor) * 0.5)
	box(ctx, trimRole, Vector3.new(geo.W - 0.3, rbh, 0.45), Vector3.new(0, floor + rbh / 2 + 0.05, zR - 0.12))

	-- grille
	local faceH = frontTop - floor
	local lightH = math.clamp(faceH * 0.22, 0.22, 0.5)
	local lightY = math.max(frontTop - lightH / 2 - 0.12, floor + bh + lightH / 2 + 0.08)
	if f.bigGrille then
		box(ctx, "Chrome", Vector3.new(3.6, faceH * 0.75, 0.2), Vector3.new(0, floor + faceH * 0.5, zF - 0.06))
		for i = 1, 5 do
			box(ctx, "Dark", Vector3.new(3.2, 0.12, 0.06), Vector3.new(0, floor + faceH * (0.2 + i * 0.11), zF - 0.17))
		end
	elseif not f.electric then
		box(ctx, "Dark", Vector3.new(math.min(geo.W * 0.4, 3.2), math.max(lightH * 0.9, 0.25), 0.1), Vector3.new(0, lightY - 0.05, zF - 0.03))
	end

	-- headlights / taillights
	local hlW = math.clamp(geo.W * 0.17, 0.8, 1.5)
	local hx = W2 - hlW / 2 - 0.25
	for _, side in { -1, 1 } do
		box(ctx, "Headlight", Vector3.new(hlW, lightH, 0.12), Vector3.new(side * hx, lightY, zF - 0.04))
		box(ctx, "Indicator", Vector3.new(0.35, lightH * 0.6, 0.1), Vector3.new(side * (W2 - 0.12), lightY - lightH * 0.1, zF + 0.05))
	end
	local rearFaceTop = rearTop
	local tH = math.clamp((rearFaceTop - floor) * 0.2, 0.22, 0.5)
	local tY = math.max(rearFaceTop - tH / 2 - 0.15, floor + rbh + tH / 2 + 0.08)
	for _, side in { -1, 1 } do
		box(ctx, "Taillight", Vector3.new(hlW, tH, 0.12), Vector3.new(side * hx, tY, zR + 0.04))
	end
	if f.lightbars then
		box(ctx, "Headlight", Vector3.new(geo.W - 1.2, 0.1, 0.1), Vector3.new(0, lightY + lightH / 2 + 0.08, zF - 0.02))
		box(ctx, "Taillight", Vector3.new(geo.W - 1.0, 0.14, 0.1), Vector3.new(0, tY + tH / 2 + 0.06, zR + 0.03))
	end

	-- plates
	local plateRear = box(ctx, "Plate", Vector3.new(1.9, 0.55, 0.06), Vector3.new(0, floor + rbh + 0.38, zR + 0.03))
	local plateText = string.upper(string.sub(ctx.opts.ownerName or ctx.def.name, 1, 10))
	surfaceText(ctx, plateRear, Enum.NormalId.Back, plateText, Color3.fromRGB(20, 40, 110))
	local plateFront = box(ctx, "Plate", Vector3.new(1.9, 0.5, 0.06), Vector3.new(0, floor + bh + 0.32, zF - 0.03))
	surfaceText(ctx, plateFront, Enum.NormalId.Front, plateText, Color3.fromRGB(20, 40, 110))

	-- light source for the headlights
	if ctx.decor then
		local beamPart = box(ctx, "Trim", Vector3.new(0.2, 0.2, 0.2), Vector3.new(0, lightY, zF + 0.3))
		beamPart.Transparency = 1
		beamPart.Name = "HeadlightBeam"
		local spot = Instance.new("SpotLight")
		spot.Name = "Beam"
		spot.Face = Enum.NormalId.Front
		spot.Angle = 75
		spot.Range = 60
		spot.Brightness = 3
		spot.Shadows = false
		spot.Color = Color3.fromRGB(255, 244, 220)
		spot.Parent = beamPart
		local glow = Instance.new("SurfaceLight")
		glow.Name = "BrakeGlow"
		glow.Face = Enum.NormalId.Back
		glow.Range = 8
		glow.Angle = 120
		glow.Brightness = 0
		glow.Color = Color3.fromRGB(255, 30, 30)
		local tailAnchor = box(ctx, "Trim", Vector3.new(0.2, 0.2, 0.2), Vector3.new(0, tY, zR - 0.3))
		tailAnchor.Transparency = 1
		tailAnchor.Name = "TailGlow"
		glow.Parent = tailAnchor
	end

	-- exhausts
	local n = f.exhaust or 0
	if n > 0 then
		local positions = {}
		if n == 1 then
			positions = { -W2 + 1.3 }
		elseif n == 2 then
			positions = { -W2 + 1.3, W2 - 1.3 }
		else
			positions = { -W2 + 1.1, -W2 + 1.6, W2 - 1.6, W2 - 1.1 }
		end
		for i, x in positions do
			local pipe = cylinder(
				ctx,
				"Chrome",
				0.8,
				0.42,
				CFrame.new(x, floor + 0.28, zR + 0.12) * CFrame.Angles(0, math.pi / 2, 0)
			)
			pipe.Name = "Exhaust"
			attachment(ctx, "Exhaust" .. i, Vector3.new(x, floor + 0.28, zR + 0.55))
		end
	end

	-- underglow (hidden until bought)
	local glow = box(ctx, "Glow", Vector3.new(geo.W - 1.2, 0.08, geo.L * 0.72), Vector3.new(0, floor - 0.02, 0))
	glow.CastShadow = false
	if ctx.decor then
		local light = Instance.new("PointLight")
		light.Range = 14
		light.Brightness = 2.5
		light.Shadows = false
		light.Parent = glow
	end
	applyRole(glow, "Glow", ctx.save)

	-- side mirrors
	local cab = geo.cabin
	if cab then
		for _, side in { -1, 1 } do
			local mx = side * (cab.gw / 2 + 0.45)
			box(ctx, "Accent", Vector3.new(0.5, 0.35, 0.3), Vector3.new(mx, geo.belt + 0.55, cab.z0 + 0.5))
			box(ctx, "Trim", Vector3.new(0.4, 0.12, 0.12), Vector3.new(side * (cab.gw / 2 + 0.2), geo.belt + 0.45, cab.z0 + 0.55))
		end
	end
end

local function buildDoors(ctx: Ctx, geo: Geo)
	local doors = ctx.def.features.doors or 0
	local cab = geo.cabin
	if doors <= 0 or not cab then
		return
	end
	local W2 = geo.W / 2
	local yTop = geo.belt - 0.05
	local yBot = geo.floor + 0.25
	local front = cab.z0 + 0.25
	local perSide = math.max(1, math.floor(doors / 2))
	local doorLen = math.min((cab.z2 - cab.z0) / perSide, 4.2)
	local edges = { front }
	for i = 1, perSide do
		table.insert(edges, front + doorLen * i)
	end
	for _, side in { -1, 1 } do
		local x = side * (W2 + 0.015)
		for _, z in edges do
			box(ctx, "Dark", Vector3.new(0.04, yTop - yBot, 0.06), Vector3.new(x, (yTop + yBot) / 2, z))
		end
		for i = 1, perSide do
			local hz = front + doorLen * i - 0.7
			box(ctx, "Trim", Vector3.new(0.08, 0.14, 0.5), Vector3.new(x + side * 0.03, geo.belt - 0.45, hz))
		end
	end
end

--------------------------------------------------------------------------------
-- Features
--------------------------------------------------------------------------------

local function buildFeatures(ctx: Ctx, geo: Geo)
	local f = ctx.def.features
	local cab = geo.cabin
	local W2 = geo.W / 2
	local belt = geo.belt
	local zF, zR = geo.zF, geo.zR
	local floor = geo.floor
	local hoodStart = zF + geo.nose
	local hoodEnd = if cab then cab.z0 else zF + geo.L * 0.35
	local trunkStart = if cab then cab.z3 else zR - geo.L * 0.3
	local trunkEnd = zR - geo.tail

	-- spoilers
	local spoiler = f.spoiler
	if spoiler == "lip" then
		wedge(ctx, "Accent", Vector3.new(geo.W - 1.2, 0.3, 0.7), Vector3.new(0, geo.topAt(zR - 0.6) + 0.15, zR - 0.6), true)
	elseif spoiler == "ducktail" then
		wedge(ctx, "Paint", Vector3.new(geo.W - 0.8, 0.55, 1.4), Vector3.new(0, geo.topAt(zR - 0.9) + 0.27, zR - 0.9), true)
	elseif spoiler == "roof" and cab then
		box(ctx, "Accent", Vector3.new(cab.gw + 0.1, 0.16, 1.0), CFrame.new(0, cab.yR + 0.02, cab.z2 + 0.35) * CFrame.Angles(math.rad(6), 0, 0))
	elseif spoiler == "wing" or spoiler == "bigwing" then
		local big = spoiler == "bigwing"
		local postH = if big then 1.5 else 0.9
		local zW = zR - (if big then 1.1 else 0.9)
		local baseY = geo.topAt(zW)
		local width = geo.W - (if big then 0.5 else 1.2)
		local px = width / 2 - 1.1
		for _, side in { -1, 1 } do
			box(ctx, "Trim", Vector3.new(0.18, postH, 0.6), Vector3.new(side * px, baseY + postH / 2, zW))
		end
		local plateY = baseY + postH + 0.1
		box(ctx, "Accent", Vector3.new(width, 0.2, if big then 1.7 else 1.3), CFrame.new(0, plateY, zW + 0.1) * CFrame.Angles(math.rad(-8), 0, 0))
		for _, side in { -1, 1 } do
			box(ctx, "Trim", Vector3.new(0.14, if big then 0.8 else 0.55, if big then 1.9 else 1.4), Vector3.new(side * width / 2, plateY + 0.05, zW + 0.1))
		end
	end

	-- hood details
	if f.hoodScoop then
		local big = f.hoodScoop == "big"
		local sw, sh, sl = (if big then 2.2 else 1.6), (if big then 0.7 else 0.35), (if big then 2.6 else 1.8)
		local zc = hoodStart + (hoodEnd - hoodStart) * 0.45
		box(ctx, "Paint", Vector3.new(sw, sh * 0.5, sl), Vector3.new(0, belt + sh * 0.25, zc))
		wedge(ctx, "Paint", Vector3.new(sw, sh * 0.5, sl), Vector3.new(0, belt + sh * 0.75, zc), false)
		box(ctx, "Dark", Vector3.new(sw - 0.3, sh * 0.6, 0.08), Vector3.new(0, belt + sh * 0.45, zc - sl / 2 - 0.02))
		if big then
			box(ctx, "Chrome", Vector3.new(sw - 0.4, 0.1, 0.1), Vector3.new(0, belt + sh * 0.7, zc - sl / 2 - 0.04))
		end
	end
	if f.hoodVents then
		for _, side in { -1, 1 } do
			box(ctx, "Dark", Vector3.new(0.9, 0.06, 1.3), Vector3.new(side * 1.1, belt + 0.03, hoodStart + (hoodEnd - hoodStart) * 0.55))
		end
	end
	if f.stripes then
		for _, side in { -1, 1 } do
			local x = side * 0.55
			slab(ctx, "Accent", x - 0.3, x + 0.3, belt, belt + 0.04, hoodStart, hoodEnd)
			if cab and not (ctx.def.body.cabin and ctx.def.body.cabin.open) then
				slab(ctx, "Accent", x - 0.3, x + 0.3, cab.yR, cab.yR + 0.04, cab.z1, cab.z2)
			end
			if trunkEnd > trunkStart + 0.2 then
				slab(ctx, "Accent", x - 0.3, x + 0.3, belt, belt + 0.04, trunkStart, trunkEnd)
			end
			-- down the nose slope
			if geo.nose > 0.2 then
				local p0 = Vector3.new(x, geo.topAt(zF) + 0.03, zF)
				local p1 = Vector3.new(x, belt + 0.03, hoodStart)
				beam(ctx, "Accent", p0, p1, 0.6, 0.04)
			end
		end
	end
	if f.ornament then
		box(ctx, "Chrome", Vector3.new(0.15, 0.45, 0.4), Vector3.new(0, belt + 0.22, hoodStart + 0.3))
	end

	-- body kit
	if f.sideSkirts or f.neonAccents then
		local role = if f.neonAccents then "NeonAccent" else "Trim"
		local z0 = geo.axles[1].z + geo.axles[1].radius + 0.4
		local z1 = geo.axles[#geo.axles].z - geo.axles[#geo.axles].radius - 0.4
		for _, side in { -1, 1 } do
			slab(ctx, role, side > 0 and W2 - 0.02 or -W2 - 0.18, side > 0 and W2 + 0.18 or -W2 + 0.02, floor, floor + 0.28, z0, z1)
		end
		if f.neonAccents then
			slab(ctx, "NeonAccent", -W2 + 0.5, W2 - 0.5, floor - 0.02, floor + 0.12, zF - 0.25, zF + 0.4)
		end
	end
	if f.diffuser then
		for i = -2, 2 do
			box(ctx, "Dark", Vector3.new(0.1, 0.45, 1.0), Vector3.new(i * 0.9, floor + 0.15, zR - 0.4))
		end
	end
	if f.canards then
		for _, side in { -1, 1 } do
			wedge(ctx, "Trim", Vector3.new(0.9, 0.12, 0.6), Vector3.new(side * (W2 - 0.5), floor + 0.75, zF + 0.25), true)
		end
	end
	if f.sideIntakes and cab then
		for _, side in { -1, 1 } do
			local zc = cab.z2 + 0.4
			local h = math.min(belt - floor - 0.5, 1.2)
			box(ctx, "Dark", Vector3.new(0.1, h, 1.8), Vector3.new(side * (W2 + 0.02), floor + 0.35 + h / 2, zc))
			wedge(ctx, "Paint", Vector3.new(0.4, h, 1.2), CFrame.new(side * (W2 - 0.1), floor + 0.35 + h / 2, zc - 1.4).Position, true)
		end
	end
	if f.fin and cab then
		local p0 = Vector3.new(0, cab.yR, cab.z2)
		local p1 = Vector3.new(0, belt + 0.3, trunkEnd)
		beam(ctx, "Paint", p0, p1, 0.14, 0.6)
	end
	if f.roofScoop and cab then
		box(ctx, "Trim", Vector3.new(1.2, 0.45, 1.4), Vector3.new(0, cab.yR + 0.22, (cab.z1 + cab.z2) / 2 + 0.3))
		box(ctx, "Dark", Vector3.new(1.0, 0.32, 0.06), Vector3.new(0, cab.yR + 0.24, (cab.z1 + cab.z2) / 2 - 0.42))
	end
	if f.sideStripe and not ctx.def.body.box then
		for _, side in { -1, 1 } do
			box(ctx, "Accent", Vector3.new(0.05, 0.35, geo.hullEnd - zF - 1.2), Vector3.new(side * (W2 + 0.02), belt - 0.3, (zF + geo.hullEnd) / 2))
		end
	end
	if f.chromeTrim then
		for _, side in { -1, 1 } do
			box(ctx, "Chrome", Vector3.new(0.06, 0.12, geo.L - 1.6), Vector3.new(side * (W2 + 0.03), belt - 0.5, 0))
		end
	end

	-- utility
	if f.roofRack and cab then
		local y = cab.yR + 0.25
		for _, side in { -1, 1 } do
			beam(ctx, "Trim", Vector3.new(side * (cab.gw / 2 - 0.3), y, cab.z1 + 0.3), Vector3.new(side * (cab.gw / 2 - 0.3), y, cab.z2 - 0.3), 0.2)
			for _, zz in { cab.z1 + 0.5, cab.z2 - 0.5 } do
				box(ctx, "Trim", Vector3.new(0.2, 0.25, 0.2), Vector3.new(side * (cab.gw / 2 - 0.3), cab.yR + 0.12, zz))
			end
		end
		local n = math.max(2, math.floor((cab.z2 - cab.z1) / 2.2))
		for i = 0, n do
			local zz = cab.z1 + 0.4 + (cab.z2 - cab.z1 - 0.8) * i / n
			box(ctx, "Trim", Vector3.new(cab.gw - 0.4, 0.12, 0.18), Vector3.new(0, y + 0.1, zz))
		end
	end
	if f.spareTire then
		local cy = (floor + belt) / 2 + 0.3
		cylinder(ctx, "Tire", 0.7, 2.6, CFrame.new(0, cy, zR + 0.4) * CFrame.Angles(0, math.pi / 2, 0))
		cylinder(ctx, "Rim", 0.74, 1.4, CFrame.new(0, cy, zR + 0.4) * CFrame.Angles(0, math.pi / 2, 0))
	end
	if f.snorkel and cab then
		local x = W2 - 0.2
		tube(ctx, "Trim", Vector3.new(x, belt - 1.0, cab.z0 - 0.3), Vector3.new(x, belt + 0.1, cab.z0 - 0.3), 0.35)
		tube(ctx, "Trim", Vector3.new(x, belt + 0.1, cab.z0 - 0.3), Vector3.new(x, cab.yR + 0.2, cab.z1 - 0.2), 0.35)
		box(ctx, "Trim", Vector3.new(0.45, 0.4, 0.7), Vector3.new(x, cab.yR + 0.3, cab.z1 - 0.4))
	end
	if f.fenderFlares then
		for _, w in geo.wells do
			for _, side in { -1, 1 } do
				box(ctx, "Trim", Vector3.new(0.35, 0.32, w.z1 - w.z0 + 0.3), Vector3.new(side * (W2 + 0.15), math.min(w.top, belt) - 0.12, (w.z0 + w.z1) / 2))
			end
		end
	end
	if f.bullbar then
		local z = zF - 0.55
		local top = geo.topAt(zF) + 0.2
		for _, side in { -1, 1 } do
			tube(ctx, "Trim", Vector3.new(side * 1.2, floor + 0.1, z), Vector3.new(side * 1.2, top, z), 0.28)
			tube(ctx, "Trim", Vector3.new(side * 1.2, floor + 0.3, z), Vector3.new(side * 1.2, floor + 0.3, zF + 0.1), 0.24)
		end
		tube(ctx, "Trim", Vector3.new(-1.25, top, z), Vector3.new(1.25, top, z), 0.28)
		tube(ctx, "Trim", Vector3.new(-W2 + 0.4, (floor + top) / 2, z + 0.1), Vector3.new(W2 - 0.4, (floor + top) / 2, z + 0.1), 0.26)
	end
	if f.pushBumper then
		local z = zF - 0.5
		local top = geo.topAt(zF) + 0.15
		for _, side in { -1, 1 } do
			box(ctx, "Dark", Vector3.new(0.3, top - floor, 0.3), Vector3.new(side * 0.9, (floor + top) / 2, z))
		end
		box(ctx, "Dark", Vector3.new(2.4, 0.3, 0.3), Vector3.new(0, floor + 0.5, z))
		box(ctx, "Dark", Vector3.new(2.4, 0.3, 0.3), Vector3.new(0, top - 0.2, z))
	end
	if f.mudFlaps then
		for _, a in geo.axles do
			for _, side in { -1, 1 } do
				box(ctx, "Dark", Vector3.new(a.width, 0.9, 0.08), Vector3.new(side * a.track / 2, 0.75, a.z + a.radius + 0.35))
			end
		end
	end
	if f.rallyLights and cab then
		for i = -1.5, 1.5 do
			local x = i * 0.85
			local pos = CFrame.new(x, cab.yR + 0.35, cab.z1 + 0.2) * CFrame.Angles(0, math.pi / 2, 0)
			cylinder(ctx, "Trim", 0.4, 0.62, pos)
			cylinder(ctx, "Light", 0.06, 0.5, pos * CFrame.new(0.21, 0, 0))
		end
		box(ctx, "Trim", Vector3.new(3.6, 0.12, 0.25), Vector3.new(0, cab.yR + 0.06, cab.z1 + 0.3))
	end
	if f.roofLights and cab then
		box(ctx, "Trim", Vector3.new(cab.gw - 0.2, 0.15, 0.3), Vector3.new(0, cab.yR + 0.2, cab.z1 + 0.25))
		for i = -2, 2 do
			cylinder(ctx, "Light", 0.3, 0.45, CFrame.new(i * 0.8, cab.yR + 0.5, cab.z1 + 0.15) * CFrame.Angles(0, math.pi / 2, 0))
		end
	end
	if f.antenna then
		tube(ctx, "Dark", Vector3.new(W2 - 1.0, belt, zR - 1.2), Vector3.new(W2 - 1.0, belt + 2.4, zR - 1.3), 0.08)
	end
	if f.raceNumber and ctx.decor then
		local zc = if cab then (cab.z0 + cab.z2) / 2 else 0
		local y = (floor + belt) / 2 + 0.1
		for _, side in { -1, 1 } do
			local p = box(ctx, "Plate", Vector3.new(0.04, 1.3, 1.3), Vector3.new(side * (W2 + 0.03), y, zc))
			p.Transparency = 1
			roundel(ctx, p, if side > 0 then Enum.NormalId.Right else Enum.NormalId.Left, tostring(f.raceNumber))
		end
	end
	if f.taxiSign and cab then
		local sign = box(ctx, "Accent", Vector3.new(2.2, 0.65, 0.8), Vector3.new(0, cab.yR + 0.33, (cab.z1 + cab.z2) / 2))
		surfaceText(ctx, sign, Enum.NormalId.Front, "TAXI", Color3.fromRGB(255, 210, 40), Color3.fromRGB(20, 20, 24))
		surfaceText(ctx, sign, Enum.NormalId.Back, "TAXI", Color3.fromRGB(255, 210, 40), Color3.fromRGB(20, 20, 24))
	end
	if f.checker and ctx.decor then
		for _, side in { -1, 1 } do
			local strip = box(ctx, "Plate", Vector3.new(0.04, 0.5, geo.L - 3.2), Vector3.new(side * (W2 + 0.03), belt - 0.35, 0))
			strip.Transparency = 1
			local gui = Instance.new("SurfaceGui")
			gui.Face = if side > 0 then Enum.NormalId.Right else Enum.NormalId.Left
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 40
			gui.LightInfluence = 0.6
			local grid = Instance.new("UIGridLayout")
			local count = math.floor((geo.L - 3.2) / 0.25)
			grid.CellSize = UDim2.new(1 / count, 0, 0.5, 0)
			grid.CellPadding = UDim2.new()
			grid.SortOrder = Enum.SortOrder.LayoutOrder
			grid.Parent = gui
			for i = 1, count * 2 do
				local cell = Instance.new("Frame")
				cell.BorderSizePixel = 0
				local row = if i > count then 1 else 0
				cell.BackgroundColor3 = if (i + row) % 2 == 0 then Color3.fromRGB(15, 15, 18) else Color3.fromRGB(250, 250, 250)
				cell.LayoutOrder = i
				cell.Parent = gui
			end
			gui.Parent = strip
		end
	end
	if f.livery and cab then
		local zc = (cab.z0 + cab.z2) / 2
		for _, side in { -1, 1 } do
			slab(ctx, "Accent", side > 0 and W2 - 0.02 or -W2 - 0.04, side > 0 and W2 + 0.04 or -W2 + 0.02, floor + 0.3, belt - 0.1, cab.z0 + 0.3, cab.z2 - 0.4)
			if ctx.decor then
				local p = box(ctx, "Plate", Vector3.new(0.04, 0.8, cab.z2 - cab.z0 - 1), Vector3.new(side * (W2 + 0.06), (floor + belt) / 2, zc))
				p.Transparency = 1
				surfaceText(ctx, p, if side > 0 then Enum.NormalId.Right else Enum.NormalId.Left, f.livery, Color3.fromRGB(20, 30, 70))
			end
		end
	end
	if f.medicCross and ctx.def.body.box and ctx.decor then
		local spec = ctx.def.body.box
		local zs = zF + spec.start
		local yc = (belt + spec.top) / 2 + 0.3
		for _, side in { -1, 1 } do
			local p = box(ctx, "Plate", Vector3.new(0.04, 2.4, 2.4), Vector3.new(side * (W2 + 0.05), yc, (zs + zR) / 2))
			p.Transparency = 1
			surfaceText(ctx, p, if side > 0 then Enum.NormalId.Right else Enum.NormalId.Left, "+", Color3.fromRGB(220, 20, 30), nil, Enum.Font.GothamBlack)
		end
		local back = box(ctx, "Plate", Vector3.new(2.0, 2.0, 0.04), Vector3.new(0, spec.top - 1.4, zR + 0.06))
		back.Transparency = 1
		surfaceText(ctx, back, Enum.NormalId.Back, "+", Color3.fromRGB(220, 20, 30))
	end
	if f.routeSign and cab then
		local sign = box(ctx, "Dark", Vector3.new(geo.W - 2.4, 0.8, 0.12), Vector3.new(0, cab.yR - 0.55, zF - 0.02))
		surfaceText(ctx, sign, Enum.NormalId.Front, "42  CITY LOOP", Color3.fromRGB(255, 170, 30), Color3.fromRGB(10, 10, 12), Enum.Font.Code)
	end
	if f.busDoors and cab then
		for _, zc in { zF + 2.6, 1.0 } do
			box(ctx, "TintGlass", Vector3.new(0.08, cab.yR - belt + 2.2, 2.4), Vector3.new(W2 + 0.02, (belt - 2.2 + cab.yR) / 2, zc))
		end
	end

	-- emergency
	if f.siren and cab then
		local colors = SIREN_COLORS[f.siren] or SIREN_COLORS.police
		local roofTop = cab.yR
		local zc = cab.z1 + math.min(1.2, (cab.z2 - cab.z1) / 2)
		box(ctx, "Trim", Vector3.new(math.min(cab.gw - 0.4, 4.6), 0.2, 0.8), Vector3.new(0, roofTop + 0.1, zc))
		local half = math.min(cab.gw - 0.4, 4.6) / 2
		for i, x in { -half + 0.6, -half + 1.5, half - 1.5, half - 0.6 } do
			local role = if x < 0 then "SirenA" else "SirenB"
			local p = box(ctx, role, Vector3.new(0.85, 0.4, 0.7), Vector3.new(x, roofTop + 0.4, zc))
			p.Color = (if x < 0 then colors[1] else colors[2]):Lerp(Color3.new(0, 0, 0), 0.45)
			p.Name = "Siren" .. i
			if ctx.decor and not ctx.opts.preview and (i == 1 or i == 4) then
				local light = Instance.new("PointLight")
				light.Color = if x < 0 then colors[1] else colors[2]
				light.Range = 18
				light.Brightness = 3
				light.Enabled = false
				light.Shadows = false
				light.Parent = p
			end
		end
		if ctx.def.body.box and ctx.decor then
			-- extra beacons on the box corners
			local spec = ctx.def.body.box
			for i, x in { -W2 + 0.5, W2 - 0.5 } do
				local p = box(ctx, if i == 1 then "SirenA" else "SirenB", Vector3.new(0.5, 0.4, 0.5), Vector3.new(x, spec.top + 0.2, zR - 0.6))
				p.Color = colors[i]:Lerp(Color3.new(0, 0, 0), 0.45)
				p.Name = "Siren" .. (4 + i)
			end
		end
	end
	if f.ladder and ctx.def.body.box then
		local spec = ctx.def.body.box
		local y = spec.top + 0.55
		local zs = zF + spec.start + 0.8
		local ze = zR + 1.6
		for _, side in { -1, 1 } do
			beam(ctx, "Chrome", Vector3.new(side * 1.2, y, zs), Vector3.new(side * 1.2, y, ze), 0.22, 0.4)
		end
		local z = zs + 0.6
		while z < ze - 0.3 do
			box(ctx, "Chrome", Vector3.new(2.4, 0.12, 0.12), Vector3.new(0, y, z))
			z += 1.1
		end
		for _, zz in { zs + 1.0, ze - 3.0 } do
			box(ctx, "Trim", Vector3.new(2.8, 0.45, 0.5), Vector3.new(0, spec.top + 0.22, zz))
		end
		cylinder(ctx, "Trim", 0.5, 2.6, CFrame.new(0, spec.top + 0.25, zR - 2.0) * CFrame.Angles(0, 0, math.pi / 2))
	end
	if f.hoseReels and ctx.def.body.box then
		local spec = ctx.def.body.box
		for _, side in { -1, 1 } do
			cylinder(ctx, "Chrome", 0.5, 1.6, CFrame.new(side * (W2 + 0.2), belt + 1.0, zF + spec.start + 2.2))
			cylinder(ctx, "Accent", 0.52, 1.0, CFrame.new(side * (W2 + 0.21), belt + 1.0, zF + spec.start + 2.2))
			for i = 0, 2 do
				box(ctx, "Trim", Vector3.new(0.06, spec.top - belt - 0.8, 0.08), Vector3.new(side * (W2 + 0.02), (belt + spec.top) / 2, zF + spec.start + 4.5 + i * 4))
			end
		end
	end

	-- big trucks
	if f.stacks and cab then
		local top = (if ctx.def.body.box then ctx.def.body.box.top else cab.yR) + 1.4
		local z = if geo.hullEnd < zR then geo.hullEnd + 0.4 else cab.z2 + 0.3
		for _, side in { -1, 1 } do
			local x = side * (W2 - 0.3)
			tube(ctx, "Chrome", Vector3.new(x, belt - 0.6, z), Vector3.new(x, top, z), 0.42)
			tube(ctx, "Dark", Vector3.new(x, top, z), Vector3.new(x, top + 0.12, z), 0.44)
		end
	end
	if f.fuelTanks and #geo.axles >= 2 then
		local z0 = geo.axles[1].z + geo.axles[1].radius + 0.6
		local z1 = geo.axles[2].z - geo.axles[2].radius - 0.6
		for _, side in { -1, 1 } do
			local x = side * (W2 - 0.9)
			cylinder(ctx, "Chrome", z1 - z0, 1.5, CFrame.new(x, floor + 0.2, (z0 + z1) / 2) * CFrame.Angles(0, math.pi / 2, 0))
		end
	end
	if f.visor and cab then
		box(ctx, "Paint", Vector3.new(cab.gw + 0.2, 0.15, 0.9), CFrame.new(0, cab.yR - 0.05, cab.z1 - 0.35) * CFrame.Angles(math.rad(-10), 0, 0))
		if ctx.def.body.box then
			local spec = ctx.def.body.box
			local h = spec.top - cab.yR
			if h > 0.2 then
				wedge(ctx, "Paint", Vector3.new(cab.gw, h, math.min(2.4, cab.z2 - cab.z1)), Vector3.new(0, cab.yR + h / 2, cab.z2 - math.min(2.4, cab.z2 - cab.z1) / 2), true)
			end
		end
	end

	-- novelty
	if f.iceCream and ctx.def.body.box then
		local spec = ctx.def.body.box
		local base = Vector3.new(0, spec.top, zF + spec.start + 2.2)
		for i = 0, 4 do
			local d = 0.5 + i * 0.32
			cylinder(ctx, "Plate", 0.42, d, CFrame.new(base + Vector3.new(0, 0.2 + i * 0.4, 0)) * CFrame.Angles(0, 0, math.pi / 2)).Color =
				Color3.fromRGB(214, 160, 90)
		end
		ball(ctx, "Plate", 2.2, base + Vector3.new(0, 2.6, 0)).Color = Color3.fromRGB(255, 190, 220)
		ball(ctx, "Plate", 1.7, base + Vector3.new(0, 3.6, 0)).Color = Color3.fromRGB(150, 236, 200)
		ball(ctx, "Plate", 0.5, base + Vector3.new(0, 4.5, 0)).Color = Color3.fromRGB(220, 20, 40)
	end
	if f.servingWindow and ctx.def.body.box then
		local spec = ctx.def.body.box
		local zs = zF + spec.start
		local zc = (zs + zR) / 2
		local yc = (belt + spec.top) / 2 + 0.2
		box(ctx, "TintGlass", Vector3.new(0.08, 1.8, 4.2), Vector3.new(W2 + 0.03, yc, zc))
		box(ctx, "Plate", Vector3.new(0.6, 0.12, 4.4), Vector3.new(W2 + 0.3, yc - 1.0, zc))
		for i = 0, 5 do
			local stripe = wedge(ctx, if i % 2 == 0 then "Accent" else "White", Vector3.new(4.4 / 6, 0.5, 1.2), Vector3.new(0, 0, 0), true)
			stripe.CFrame = CFrame.new(W2 + 0.55, yc + 1.25, zc - 2.2 + 4.4 / 12 + i * 4.4 / 6) * CFrame.Angles(0, -math.pi / 2, 0)
		end
	end
end

--------------------------------------------------------------------------------
-- Special styles
--------------------------------------------------------------------------------

local function suspensionArms(ctx: Ctx, geo: Geo, mountHalf: number, y: number)
	for _, a in geo.axles do
		for _, side in { -1, 1 } do
			local hub = Vector3.new(side * (a.track / 2 - a.width / 2), a.radius, a.z)
			tube(ctx, "Dark", Vector3.new(side * mountHalf, y + 0.15, a.z - 0.6), hub, 0.16)
			tube(ctx, "Dark", Vector3.new(side * mountHalf, y + 0.15, a.z + 0.6), hub, 0.16)
		end
	end
end

local function buildOpenWheel(ctx: Ctx, geo: Geo)
	local floor = geo.floor
	local zF, zR = geo.zF, geo.zR
	local front = geo.axles[1]
	local rear = geo.axles[#geo.axles]
	local tubW = 2.4
	local tubTop = floor + 1.3
	local cockpitZ0 = -1.4
	-- monocoque
	slab(ctx, "Paint", -tubW / 2, tubW / 2, floor, tubTop, front.z + 0.6, rear.z - 0.6)
	-- cockpit opening rim
	slab(ctx, "Dark", -0.9, 0.9, tubTop, tubTop + 0.04, cockpitZ0, cockpitZ0 + 3.0)
	-- nose cone (tapering down towards the front)
	wedge(ctx, "Paint", Vector3.new(1.6, 1.0, front.z + 0.6 - (zF + 0.9)), Vector3.new(0, floor + 0.5, (zF + 0.9 + front.z + 0.6) / 2), true)
	box(ctx, "Accent", Vector3.new(1.0, 0.06, 2.4), Vector3.new(0, floor + 0.85, front.z - 0.6))
	-- front wing
	local fwW = front.track + front.width + 0.2
	box(ctx, "Accent", Vector3.new(fwW, 0.12, 1.4), Vector3.new(0, 0.42, zF + 0.6))
	box(ctx, "Paint", Vector3.new(fwW - 0.6, 0.1, 0.7), CFrame.new(0, 0.62, zF + 1.1) * CFrame.Angles(math.rad(-14), 0, 0))
	for _, side in { -1, 1 } do
		box(ctx, "Trim", Vector3.new(0.1, 0.7, 1.6), Vector3.new(side * fwW / 2, 0.6, zF + 0.7))
	end
	-- sidepods
	local spZ0 = front.z + front.radius + 0.9
	local spZ1 = rear.z - rear.radius - 0.4
	for _, side in { -1, 1 } do
		local x0 = side * tubW / 2
		local x1 = side * (tubW / 2 + 1.6)
		slab(ctx, "Paint", math.min(x0, x1), math.max(x0, x1), floor, floor + 1.0, spZ0, spZ1 - 1.2)
		wedge(ctx, "Paint", Vector3.new(1.6, 1.0, 1.2), Vector3.new((x0 + x1) / 2, floor + 0.5, spZ1 - 0.6), false)
		box(ctx, "Dark", Vector3.new(1.4, 0.8, 0.08), Vector3.new((x0 + x1) / 2, floor + 0.5, spZ0 - 0.03))
	end
	-- engine cover + airbox
	wedge(ctx, "Paint", Vector3.new(1.8, 1.4, rear.z - cockpitZ0 - 3.0), Vector3.new(0, tubTop + 0.7, (cockpitZ0 + 3.0 + rear.z) / 2), false)
	box(ctx, "Paint", Vector3.new(1.0, 1.4, 1.2), Vector3.new(0, tubTop + 0.7, cockpitZ0 + 3.6))
	box(ctx, "Dark", Vector3.new(0.7, 0.6, 0.08), Vector3.new(0, tubTop + 0.95, cockpitZ0 + 2.98))
	-- halo
	local hz = cockpitZ0 + 0.2
	tube(ctx, "Trim", Vector3.new(0, tubTop, hz - 0.6), Vector3.new(0, tubTop + 1.4, hz), 0.2)
	for _, side in { -1, 1 } do
		tube(ctx, "Trim", Vector3.new(0, tubTop + 1.4, hz), Vector3.new(side * 0.85, tubTop + 1.3, hz + 1.4), 0.2)
		tube(ctx, "Trim", Vector3.new(side * 0.85, tubTop + 1.3, hz + 1.4), Vector3.new(side * 0.95, tubTop, hz + 2.2), 0.2)
	end
	-- rear wing
	local rwZ = zR - 0.7
	local rwW = 5.6
	box(ctx, "Trim", Vector3.new(0.2, 1.8, 0.5), Vector3.new(0, floor + 1.7, rwZ))
	box(ctx, "Accent", Vector3.new(rwW, 0.18, 1.2), CFrame.new(0, floor + 2.7, rwZ) * CFrame.Angles(math.rad(-10), 0, 0))
	box(ctx, "Paint", Vector3.new(rwW, 0.14, 0.7), CFrame.new(0, floor + 3.15, rwZ + 0.3) * CFrame.Angles(math.rad(-22), 0, 0))
	for _, side in { -1, 1 } do
		box(ctx, "Paint", Vector3.new(0.12, 1.4, 1.6), Vector3.new(side * rwW / 2, floor + 2.7, rwZ + 0.1))
	end
	-- rear light
	box(ctx, "Taillight", Vector3.new(0.5, 0.3, 0.08), Vector3.new(0, floor + 0.9, rwZ + 0.3))
	suspensionArms(ctx, geo, tubW / 2, floor + 0.3)
	if ctx.def.features.raceNumber and ctx.decor then
		local p = box(ctx, "Plate", Vector3.new(0.9, 0.04, 0.9), Vector3.new(0, floor + 0.95, front.z - 1.6))
		p.Transparency = 1
		roundel(ctx, p, Enum.NormalId.Top, tostring(ctx.def.features.raceNumber))
	end
	hull(ctx, Vector3.new(tubW + 3.2, 1.3, rear.z - front.z), Vector3.new(0, floor + 0.65, (front.z + rear.z) / 2))
	hull(ctx, Vector3.new(1.6, 1.0, front.z - zF), Vector3.new(0, floor + 0.5, (zF + front.z) / 2))
end

local function buildKart(ctx: Ctx, geo: Geo)
	local floor = geo.floor
	local zF, zR = geo.zF, geo.zR
	local W2 = geo.W / 2
	slab(ctx, "Trim", -1.6, 1.6, floor, floor + 0.18, zF + 1.0, zR - 0.8)
	-- bumpers
	tube(ctx, "Chrome", Vector3.new(-W2 + 0.6, floor + 0.35, zF + 0.3), Vector3.new(W2 - 0.6, floor + 0.35, zF + 0.3), 0.22)
	tube(ctx, "Chrome", Vector3.new(-W2 + 0.4, floor + 0.35, zR - 0.3), Vector3.new(W2 - 0.4, floor + 0.35, zR - 0.3), 0.22)
	-- side pods and nose
	local a1, a2 = geo.axles[1], geo.axles[2]
	for _, side in { -1, 1 } do
		slab(ctx, "Paint", side > 0 and 1.0 or -2.0, side > 0 and 2.0 or -1.0, floor + 0.05, floor + 0.55, a1.z + a1.radius + 0.25, a2.z - a2.radius - 0.25)
	end
	wedge(ctx, "Paint", Vector3.new(2.4, 0.8, 2.0), Vector3.new(0, floor + 0.5, zF + 1.5), true)
	-- seat
	local seats = CarBuilder.getSeats(ctx.def)
	local sp = seats[1].pos
	box(ctx, "Interior", Vector3.new(1.6, 0.3, 1.5), Vector3.new(sp.X, sp.Y - 0.15, sp.Z))
	box(ctx, "Interior", Vector3.new(1.6, 1.6, 0.3), CFrame.new(sp.X, sp.Y + 0.75, sp.Z + 0.85) * CFrame.Angles(math.rad(-12), 0, 0))
	-- steering
	tube(ctx, "Trim", Vector3.new(0, floor + 0.3, zF + 2.2), Vector3.new(0, floor + 1.4, sp.Z - 1.5), 0.15)
	cylinder(ctx, "Trim", 0.15, 1.1, CFrame.new(0, floor + 1.45, sp.Z - 1.45) * CFrame.Angles(math.rad(-35), 0, 0) * CFrame.Angles(0, math.pi / 2, 0))
	-- engine
	box(ctx, "Trim", Vector3.new(1.0, 0.9, 1.0), Vector3.new(1.1, floor + 0.6, zR - 1.6))
	tube(ctx, "Chrome", Vector3.new(1.5, floor + 0.7, zR - 1.6), Vector3.new(1.9, floor + 0.7, zR - 0.6), 0.25)
	attachment(ctx, "Exhaust1", Vector3.new(1.9, floor + 0.7, zR - 0.5))
	box(ctx, "Taillight", Vector3.new(0.6, 0.2, 0.06), Vector3.new(0, floor + 0.45, zR - 0.15))
	if ctx.def.features.raceNumber and ctx.decor then
		local p = box(ctx, "Plate", Vector3.new(1.0, 0.8, 0.04), CFrame.new(0, floor + 0.7, zF + 0.55) * CFrame.Angles(math.rad(-38), 0, 0))
		p.Transparency = 1
		roundel(ctx, p, Enum.NormalId.Front, tostring(ctx.def.features.raceNumber))
	end
	hull(ctx, Vector3.new(geo.W - 0.4, 0.6, geo.L - 0.4), Vector3.new(0, floor + 0.3, 0))
end

local function buildBuggy(ctx: Ctx, geo: Geo)
	local floor = geo.floor
	local zF, zR = geo.zF, geo.zR
	slab(ctx, "Trim", -2.0, 2.0, floor, floor + 0.3, zF + 1.2, zR - 1.4)
	local x = 1.9
	local zA, zB = -1.8, 2.2
	local top = floor + 4.4
	local frameRole = "Paint"
	for _, s in { -1, 1 } do
		local sx = s * x
		tube(ctx, frameRole, Vector3.new(sx, floor + 0.3, zA), Vector3.new(sx * 0.85, top, zA + 0.8), 0.3)
		tube(ctx, frameRole, Vector3.new(sx, floor + 0.3, zB), Vector3.new(sx * 0.85, top, zB - 0.3), 0.3)
		tube(ctx, frameRole, Vector3.new(sx * 0.85, top, zA + 0.8), Vector3.new(sx * 0.85, top, zB - 0.3), 0.3)
		tube(ctx, frameRole, Vector3.new(sx, floor + 0.3, zA), Vector3.new(sx * 0.7, floor + 1.2, zF + 0.8), 0.28)
		tube(ctx, frameRole, Vector3.new(sx, floor + 0.3, zB), Vector3.new(sx * 0.8, floor + 1.0, zR - 0.4), 0.28)
		tube(ctx, frameRole, Vector3.new(sx * 0.85, top, zB - 0.3), Vector3.new(sx * 0.8, floor + 1.0, zR - 0.4), 0.26)
		tube(ctx, frameRole, Vector3.new(sx, floor + 1.4, zA + 0.2), Vector3.new(sx, floor + 1.4, zB), 0.24)
	end
	tube(ctx, frameRole, Vector3.new(-x * 0.85, top, zA + 0.8), Vector3.new(x * 0.85, top, zA + 0.8), 0.3)
	tube(ctx, frameRole, Vector3.new(-x * 0.85, top, zB - 0.3), Vector3.new(x * 0.85, top, zB - 0.3), 0.3)
	tube(ctx, frameRole, Vector3.new(-x * 0.7, floor + 1.2, zF + 0.8), Vector3.new(x * 0.7, floor + 1.2, zF + 0.8), 0.28)
	-- nose panel and hood
	wedge(ctx, "Accent", Vector3.new(2.6, 0.9, zA - zF - 0.8), Vector3.new(0, floor + 0.75, (zF + 0.8 + zA) / 2), true)
	-- roof light bar
	box(ctx, "Trim", Vector3.new(2.8, 0.15, 0.25), Vector3.new(0, top + 0.18, zA + 0.8))
	for _, lx in { -0.8, 0.8 } do
		cylinder(ctx, "Light", 0.3, 0.5, CFrame.new(lx, top + 0.45, zA + 0.75) * CFrame.Angles(0, math.pi / 2, 0))
	end
	-- seat
	local sp = CarBuilder.getSeats(ctx.def)[1].pos
	box(ctx, "Interior", Vector3.new(1.7, 0.3, 1.6), Vector3.new(sp.X, sp.Y - 0.15, sp.Z))
	box(ctx, "Interior", Vector3.new(1.7, 2.0, 0.35), CFrame.new(sp.X, sp.Y + 0.95, sp.Z + 0.9) * CFrame.Angles(math.rad(-10), 0, 0))
	cylinder(ctx, "Trim", 0.15, 1.2, CFrame.new(sp.X, sp.Y + 1.7, sp.Z - 1.6) * CFrame.Angles(math.rad(-25), 0, 0) * CFrame.Angles(0, math.pi / 2, 0))
	tube(ctx, "Trim", Vector3.new(sp.X, sp.Y + 1.7, sp.Z - 1.6), Vector3.new(sp.X, floor + 0.8, zA - 0.6), 0.14)
	-- exposed engine
	box(ctx, "Trim", Vector3.new(2.0, 1.2, 1.6), Vector3.new(0, floor + 0.9, zR - 1.6))
	for _, ex in { -0.5, 0.5 } do
		cylinder(ctx, "Chrome", 0.5, 0.5, CFrame.new(ex, floor + 1.7, zR - 1.6) * CFrame.Angles(0, 0, math.pi / 2))
	end
	for i, ex in { -0.7, 0.7 } do
		tube(ctx, "Chrome", Vector3.new(ex, floor + 1.0, zR - 0.8), Vector3.new(ex, floor + 1.6, zR + 0.1), 0.28)
		attachment(ctx, "Exhaust" .. i, Vector3.new(ex, floor + 1.7, zR + 0.25))
	end
	for _, side in { -1, 1 } do
		box(ctx, "Taillight", Vector3.new(0.4, 0.3, 0.08), Vector3.new(side * 1.5, floor + 1.2, zR - 0.35))
		box(ctx, "Headlight", Vector3.new(0.5, 0.35, 0.08), Vector3.new(side * 0.9, floor + 0.9, zF + 0.75))
	end
	suspensionArms(ctx, geo, 1.9, floor + 0.2)
	hull(ctx, Vector3.new(4.2, 1.4, geo.L - 1.6), Vector3.new(0, floor + 0.7, 0))
	hull(ctx, Vector3.new(3.4, 0.3, 4.0), Vector3.new(0, top, (zA + zB) / 2 + 0.25))
end

local function buildTractor(ctx: Ctx, geo: Geo)
	local floor = geo.floor
	local zF = geo.zF
	local front, rear = geo.axles[1], geo.axles[2]
	-- hood and engine
	local hoodW = 3.0
	local hoodTop = floor + 2.4
	slab(ctx, "Paint", -hoodW / 2, hoodW / 2, floor, hoodTop, zF + 0.6, rear.z - 1.2)
	wedge(ctx, "Paint", Vector3.new(hoodW, 0.4, 1.2), Vector3.new(0, hoodTop + 0.2, rear.z - 1.8), true)
	box(ctx, "Dark", Vector3.new(hoodW - 0.4, 1.6, 0.1), Vector3.new(0, floor + 1.2, zF + 0.56))
	for _, side in { -1, 1 } do
		box(ctx, "Headlight", Vector3.new(0.45, 0.4, 0.1), Vector3.new(side * 1.0, hoodTop - 0.3, zF + 0.55))
		for i = 0, 3 do
			box(ctx, "Dark", Vector3.new(0.05, 0.12, 1.4), Vector3.new(side * (hoodW / 2 + 0.02), floor + 1.0 + i * 0.3, zF + 3.0))
		end
	end
	-- front weights
	slab(ctx, "Trim", -1.4, 1.4, floor - 0.4, floor + 0.6, zF, zF + 0.6)
	-- exhaust stack
	tube(ctx, "Trim", Vector3.new(0.8, hoodTop, zF + 2.4), Vector3.new(0.8, hoodTop + 2.2, zF + 2.4), 0.3)
	attachment(ctx, "Exhaust1", Vector3.new(0.8, hoodTop + 2.3, zF + 2.4))
	-- rear body, fenders
	slab(ctx, "Paint", -2.4, 2.4, floor, floor + 1.4, rear.z - 1.6, rear.z + 1.4)
	for _, side in { -1, 1 } do
		local x = side * rear.track / 2
		box(ctx, "Accent", Vector3.new(rear.width + 0.5, 0.25, rear.radius * 2 + 0.6), Vector3.new(x, rear.radius * 2 + 0.3, rear.z))
		box(ctx, "Accent", Vector3.new(rear.width + 0.5, 0.9, 0.25), Vector3.new(x, rear.radius * 2 - 0.15, rear.z - rear.radius - 0.2))
		box(ctx, "Taillight", Vector3.new(0.3, 0.3, 0.08), Vector3.new(side * 2.0, floor + 1.1, rear.z + 1.43))
	end
	-- ROPS cab
	local sp = CarBuilder.getSeats(ctx.def)[1].pos
	local roofY = sp.Y + 4.4
	for _, side in { -1, 1 } do
		for _, zz in { rear.z - 1.4, rear.z + 1.2 } do
			tube(ctx, "Trim", Vector3.new(side * 1.9, floor + 1.4, zz), Vector3.new(side * 1.9, roofY, zz), 0.25)
		end
	end
	slab(ctx, "Paint", -2.3, 2.3, roofY, roofY + 0.25, rear.z - 1.8, rear.z + 1.6)
	box(ctx, "Interior", Vector3.new(1.6, 0.35, 1.4), Vector3.new(sp.X, sp.Y - 0.17, sp.Z))
	box(ctx, "Interior", Vector3.new(1.6, 1.6, 0.3), CFrame.new(sp.X, sp.Y + 0.8, sp.Z + 0.8) * CFrame.Angles(math.rad(-8), 0, 0))
	cylinder(ctx, "Trim", 0.15, 1.1, CFrame.new(sp.X, sp.Y + 1.6, sp.Z - 1.4) * CFrame.Angles(math.rad(-40), 0, 0) * CFrame.Angles(0, math.pi / 2, 0))
	-- front axle beam
	tube(ctx, "Dark", Vector3.new(-front.track / 2 + 0.4, front.radius, front.z), Vector3.new(front.track / 2 - 0.4, front.radius, front.z), 0.35)
	hull(ctx, Vector3.new(hoodW, hoodTop - floor, rear.z - zF - 1.8), Vector3.new(0, (floor + hoodTop) / 2, (zF + 0.6 + rear.z - 1.2) / 2))
	hull(ctx, Vector3.new(4.8, 1.4, 3.0), Vector3.new(0, floor + 0.7, rear.z - 0.1))
end

local function buildMonsterExtras(ctx: Ctx, geo: Geo)
	if not ctx.def.features.monster then
		return
	end
	for _, a in geo.axles do
		tube(ctx, "Dark", Vector3.new(-a.track / 2 + a.width / 2, a.radius, a.z), Vector3.new(a.track / 2 - a.width / 2, a.radius, a.z), 0.6)
		for _, side in { -1, 1 } do
			local hub = Vector3.new(side * (a.track / 2 - a.width / 2 - 0.3), a.radius, a.z)
			tube(ctx, "Chrome", hub, Vector3.new(side * (geo.innerHalf - 0.4), geo.floor + 0.2, a.z - 0.5), 0.35)
			tube(ctx, "Accent", hub, Vector3.new(side * (geo.innerHalf - 0.4), geo.floor + 0.2, a.z + 0.5), 0.3)
		end
	end
	slab(ctx, "Trim", -1.0, 1.0, geo.axles[1].radius - 0.3, geo.floor, geo.axles[1].z, geo.axles[#geo.axles].z)
end

--------------------------------------------------------------------------------
-- Wheels, seats, interior
--------------------------------------------------------------------------------

local function buildWheels(ctx: Ctx, geo: Geo)
	local def = ctx.def
	local rimStyle = def.wheels.rim or "disc"
	local rest = def.stats.suspension.rest
	local freq = def.stats.suspension.freq or 2.6
	local omega = 2 * math.pi * freq
	local gravity = workspace.Gravity
	local sag = math.min(gravity / (omega * omega), rest * 0.85)
	local staticLen = rest - sag
	local index = 0
	for axleIndex, a in geo.axles do
		for _, side in { -1, 1 } do
			index += 1
			local r, w = a.radius, a.width
			local center = Vector3.new(side * a.track / 2, r, a.z)
			local tire = makePart(ctx, "Part", "Tire", Vector3.new(w, r * 2, r * 2), CFrame.new(center), ctx.model);
			(tire :: Part).Shape = Enum.PartType.Cylinder
			tire.Name = "Wheel_" .. index
			tire.CastShadow = true
			local rimParts = {}
			local outer = side * (w / 2)
			local function add(p: BasePart?)
				if p then
					p.Parent = tire
					table.insert(rimParts, p)
				end
			end
			local rimD = r * 2 * (if rimStyle == "offroad" then 0.52 else 0.64)
			add(cylinder(ctx, "Rim", w * 0.5, rimD, CFrame.new(center + Vector3.new(outer - side * w * 0.22, 0, 0))))
			add(cylinder(ctx, "Dark", 0.05, rimD * 0.92, CFrame.new(center + Vector3.new(outer + side * 0.035, 0, 0))))
			if rimStyle == "aero" then
				add(cylinder(ctx, "Rim", 0.06, rimD * 0.95, CFrame.new(center + Vector3.new(outer + side * 0.07, 0, 0))))
				for k = 0, 2 do
					local ang = k * math.pi * 2 / 3
					local p = box(ctx, "Dark", Vector3.new(0.04, rimD * 0.5, 0.12), CFrame.new(center + Vector3.new(outer + side * 0.1, 0, 0)) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, rimD * 0.2, 0))
					add(p)
				end
			elseif rimStyle == "spoke" or rimStyle == "star" then
				local n = if rimStyle == "spoke" then 6 else 5
				for k = 0, n - 1 do
					local ang = k * math.pi * 2 / n
					local p = box(ctx, "Rim", Vector3.new(0.12, rimD * 0.46, 0.22), CFrame.new(center + Vector3.new(outer + side * 0.07, 0, 0)) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, rimD * 0.24, 0))
					add(p)
				end
			elseif rimStyle == "steel" then
				for k = 0, 3 do
					local ang = k * math.pi / 2 + math.pi / 4
					local p = cylinder(ctx, "Dark", 0.06, rimD * 0.16, CFrame.new(center + Vector3.new(outer + side * 0.06, 0, 0)) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, rimD * 0.3, 0))
					add(p)
				end
				add(cylinder(ctx, "Rim", 0.06, rimD * 0.75, CFrame.new(center + Vector3.new(outer + side * 0.05, 0, 0))))
			elseif rimStyle == "offroad" then
				for k = 0, 5 do
					local ang = k * math.pi / 3
					local p = box(ctx, "Rim", Vector3.new(0.12, rimD * 0.4, 0.3), CFrame.new(center + Vector3.new(outer + side * 0.07, 0, 0)) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, rimD * 0.25, 0))
					add(p)
				end
				-- chunky tread blocks on the shoulder
				for k = 0, 11 do
					local ang = k * math.pi / 6
					local p = box(ctx, "Tire", Vector3.new(w * 1.02, 0.18, r * 0.42), CFrame.new(center) * CFrame.Angles(ang, 0, 0) * CFrame.new(0, r - 0.05, 0))
					add(p)
				end
			end
			add(cylinder(ctx, "Chrome", 0.1, r * 0.32, CFrame.new(center + Vector3.new(outer + side * 0.12, 0, 0))))

			if not ctx.anchored then
				for _, p in rimParts do
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = tire
					weld.Part1 = p
					weld.Parent = p
				end
				local motor = Instance.new("Motor6D")
				motor.Name = "Axle"
				motor.Part0 = ctx.chassis
				motor.Part1 = tire
				motor.C0 = ctx.chassis.CFrame:ToObjectSpace(CFrame.new(center))
				motor.C1 = CFrame.new()
				motor.Parent = tire
			end

			-- data for physics and visuals
			local mountWorld = center + Vector3.new(0, staticLen, 0)
			tire:SetAttribute("Wheel", true)
			tire:SetAttribute("Index", index)
			tire:SetAttribute("Axle", axleIndex)
			tire:SetAttribute("Mount", ctx.chassis.CFrame:PointToObjectSpace(mountWorld))
			tire:SetAttribute("Radius", r)
			tire:SetAttribute("Width", w)
			tire:SetAttribute("Steer", a.steer)
			tire:SetAttribute("Drive", a.drive)
			tire:SetAttribute("Side", side)
			tire:SetAttribute("StaticLen", staticLen)

			if not a.steer then
				attachment(ctx, "SkidA_" .. index, Vector3.new(side * a.track / 2 - w * 0.4, 0.06, a.z))
				attachment(ctx, "SkidB_" .. index, Vector3.new(side * a.track / 2 + w * 0.4, 0.06, a.z))
			end
		end
	end
end

local function buildSeats(ctx: Ctx, geo: Geo)
	local seats = CarBuilder.getSeats(ctx.def)
	local style = ctx.def.body.style
	local custom = style == "kart" or style == "buggy" or style == "tractor"
	local cab = geo.cabin
	local passengerIndex = 0
	for _, s in seats do
		local p = s.pos
		if not custom then
			-- visible seat
			local backH = if cab then math.min(2.3, cab.yR - p.Y - 0.35) else 2.0
			local cushionBottom = math.max(p.Y - 0.4, geo.floor + 0.02)
			if p.Y - cushionBottom > 0.08 then
				slab(ctx, "Interior", p.X - 0.9, p.X + 0.9, cushionBottom, p.Y, p.Z - 0.85, p.Z + 0.85)
			end
			box(ctx, "Interior", Vector3.new(1.8, backH, 0.35), CFrame.new(p.X, p.Y + backH / 2, p.Z + 0.95) * CFrame.Angles(math.rad(-8), 0, 0))
			if s.driver then
				local swY = if cab then math.max(p.Y + 1.5, geo.belt + 0.35) else p.Y + 1.5
				local swZ = if cab then math.max(cab.z0 + (cab.z1 - cab.z0) * 0.75, p.Z - 2.0) else p.Z - 1.6
				cylinder(ctx, "Trim", 0.14, 1.15, CFrame.new(p.X, swY, swZ) * CFrame.Angles(math.rad(-25), 0, 0) * CFrame.Angles(0, math.pi / 2, 0))
			end
		end
		if ctx.opts.preview or ctx.opts.showroom then
			continue
		end
		local seat: Seat | VehicleSeat
		if s.driver then
			local vs = Instance.new("VehicleSeat")
			vs.Name = "DriveSeat"
			vs.MaxSpeed = 0
			vs.Torque = 0
			vs.TurnSpeed = 0
			vs.HeadsUpDisplay = false
			seat = vs
		else
			passengerIndex += 1
			local ps = Instance.new("Seat")
			ps.Name = "Seat_" .. passengerIndex
			seat = ps
		end
		seat.Size = Vector3.new(1.6, 0.2, 1.6)
		seat.CFrame = CFrame.new(p.X, p.Y - 0.1, p.Z)
		seat.Transparency = 1
		seat.CanCollide = false
		seat.CanTouch = false -- players sit only through prompts
		seat.CanQuery = false
		seat.Massless = true
		seat.Anchored = false
		seat.Parent = ctx.model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = ctx.chassis
		weld.Part1 = seat
		weld.Parent = seat
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "SitPrompt"
		prompt.ActionText = if s.driver then "Drive" else "Sit"
		prompt.ObjectText = ctx.def.name
		prompt.KeyboardKeyCode = if s.driver then Enum.KeyCode.E else Enum.KeyCode.F
		prompt.GamepadKeyCode = if s.driver then Enum.KeyCode.ButtonY else Enum.KeyCode.ButtonX
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 11
		prompt.RequiresLineOfSight = false
		prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
		prompt:SetAttribute("LocAction", if s.driver then "PromptDrive" else "PromptSit")
		prompt.Parent = seat
	end
	ctx.seatCount = #seats
end

--------------------------------------------------------------------------------
-- Custom models (cars made in Studio / brought from other projects)
--------------------------------------------------------------------------------

-- Looks up ReplicatedStorage.CarsAssets.Cars[name]. The template's pivot must be
-- at ground level in the middle of the car with the front facing -Z. Wheels are
-- generated by the builder, so leave them out of the template (or name them
-- "Wheel..." and they will be hidden).
function CarBuilder.findTemplate(name: string): Model?
	local assets = game:GetService("ReplicatedStorage"):FindFirstChild("CarsAssets")
	local cars = assets and assets:FindFirstChild("Cars")
	local template = cars and cars:FindFirstChild(name)
	if template and template:IsA("Model") then
		return template
	end
	return nil
end

-- Invisible light sources, underglow and exhaust points for template bodies.
local function buildLightAnchors(ctx: Ctx, geo: Geo)
	if ctx.decor then
		local front = box(ctx, "Trim", Vector3.new(0.2, 0.2, 0.2), Vector3.new(0, geo.belt - 0.6, geo.zF + 0.3))
		front.Transparency = 1
		front.Name = "HeadlightBeam"
		local spot = Instance.new("SpotLight")
		spot.Name = "Beam"
		spot.Face = Enum.NormalId.Front
		spot.Angle = 75
		spot.Range = 60
		spot.Brightness = 3
		spot.Shadows = false
		spot.Parent = front
		local rear = box(ctx, "Trim", Vector3.new(0.2, 0.2, 0.2), Vector3.new(0, geo.belt - 0.6, geo.zR - 0.3))
		rear.Transparency = 1
		rear.Name = "TailGlow"
		local glow = Instance.new("SurfaceLight")
		glow.Name = "BrakeGlow"
		glow.Face = Enum.NormalId.Back
		glow.Range = 8
		glow.Angle = 120
		glow.Brightness = 0
		glow.Color = Color3.fromRGB(255, 30, 30)
		glow.Parent = rear
	end
	local glowPart = box(ctx, "Glow", Vector3.new(geo.W - 1.2, 0.08, geo.L * 0.72), Vector3.new(0, geo.floor - 0.02, 0))
	glowPart.CastShadow = false
	if ctx.decor then
		local light = Instance.new("PointLight")
		light.Range = 14
		light.Brightness = 2.5
		light.Shadows = false
		light.Parent = glowPart
	end
	applyRole(glowPart, "Glow", ctx.save)
	for i = 1, (ctx.def.features.exhaust or 0) do
		local x = (i - (ctx.def.features.exhaust + 1) / 2) * 1.2
		attachment(ctx, "Exhaust" .. i, Vector3.new(x, geo.floor + 0.3, geo.zR + 0.4))
	end
end

local function buildCustomBody(ctx: Ctx, geo: Geo): boolean
	local name = ctx.def.customModel
	if not name then
		return false
	end
	local template = CarBuilder.findTemplate(name)
	if not template then
		warn("[CarBuilder] custom model not found: CarsAssets.Cars." .. tostring(name) .. " (using the generated body)")
		return false
	end
	local clone = template:Clone()
	clone:PivotTo(CFrame.new())
	for _, d in clone:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = ctx.anchored
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Massless = true
			if string.sub(d.Name, 1, 5) == "Wheel" then
				d.Transparency = 1
			end
			-- parts named or tagged Paint/Accent follow the player's paint job
			local role = d:GetAttribute("Role") or (if d.Name == "Paint" or d.Name == "Accent" then d.Name else nil)
			if role then
				d:SetAttribute("Role", role)
				applyRole(d, role, ctx.save)
			end
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy() -- templates are visual only
		end
	end
	for _, child in clone:GetChildren() do
		child.Parent = ctx.body
	end
	clone:Destroy()
	-- standard lights so brake lights / headlights still work if the template has none
	hull(ctx, Vector3.new(geo.W, geo.belt - geo.floor - CarBuilder.HullLift, geo.L - 0.3), Vector3.new(0, (geo.floor + CarBuilder.HullLift + geo.belt) / 2, 0))
	if geo.cabin then
		local cab = geo.cabin
		hull(ctx, Vector3.new(cab.gw, cab.yR - geo.belt, math.max(cab.z3 - cab.z0, 1) * 0.85), Vector3.new(0, (geo.belt + cab.yR) / 2, (cab.z0 + cab.z3) / 2))
	end
	return true
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

local function makeChassis(ctx: Ctx, geo: Geo): BasePart
	local def = ctx.def
	local zSum, rSum, minTrack = 0, 0, math.huge
	for _, a in geo.axles do
		zSum += a.z
		rSum += a.radius
		minTrack = math.min(minTrack, a.track - a.width)
	end
	local cz = zSum / #geo.axles
	local avgR = rSum / #geo.axles
	local cy = math.min(def.body.floor + 0.5, avgR + 0.25)
	local frontZ = geo.axles[1].z
	local rearZ = geo.axles[#geo.axles].z
	local length = math.max(rearZ - frontZ, 4) * 1.1
	local width = math.max(minTrack, 2)
	local size = Vector3.new(width, 1.6, length)
	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = size
	chassis.CFrame = CFrame.new(0, cy, cz)
	chassis.Transparency = 1
	chassis.CanCollide = false
	chassis.CanTouch = false
	chassis.CanQuery = false
	chassis.Anchored = ctx.anchored
	chassis.CastShadow = false
	chassis.RootPriority = 127
	local targetMass = 420 * def.stats.mass
	local density = math.clamp(targetMass / (size.X * size.Y * size.Z), 0.5, 100)
	chassis.CustomPhysicalProperties = PhysicalProperties.new(density, 0.3, 0.1, 1, 1)
	chassis.Parent = ctx.model
	return chassis
end

function CarBuilder.build(def: CarDef, opts: BuildOptions?): Model
	local o: BuildOptions = opts or {}
	local save = o.save or CarCatalog.defaultSave(def)
	local model = Instance.new("Model")
	model.Name = def.id
	local body = Instance.new("Folder")
	body.Name = "Body"
	body.Parent = model

	local anchored = o.preview == true or o.showroom == true
	local ctx: Ctx = {
		def = def,
		save = save,
		opts = o,
		model = model,
		body = body,
		chassis = nil :: any,
		anchored = anchored,
		decor = not o.preview,
		seatCount = 0,
	}
	local geo = measure(def)
	ctx.chassis = makeChassis(ctx, geo)
	model.PrimaryPart = ctx.chassis

	local style = def.body.style
	local custom = buildCustomBody(ctx, geo) -- body from a template model, if any
	if custom then
		style = "custom"
	end
	if style == "custom" then
		buildLightAnchors(ctx, geo)
	elseif style == "openwheel" then
		buildOpenWheel(ctx, geo)
	elseif style == "kart" then
		buildKart(ctx, geo)
	elseif style == "buggy" then
		buildBuggy(ctx, geo)
	elseif style == "tractor" then
		buildTractor(ctx, geo)
	else
		buildLowerBody(ctx, geo)
		buildBed(ctx, geo)
		buildCabin(ctx, geo)
		buildBox(ctx, geo)
		buildSemiFrame(ctx, geo)
		buildBumpersAndLights(ctx, geo)
		buildDoors(ctx, geo)
		buildFeatures(ctx, geo)
		buildMonsterExtras(ctx, geo)
		local hullTop = math.min(geo.belt, geo.topAt(0))
		local hullEnd = geo.bedStart or geo.hullEnd
		local hullBottom = geo.floor + CarBuilder.HullLift
		hull(
			ctx,
			Vector3.new(geo.W, hullTop - hullBottom, hullEnd - geo.zF - 0.3),
			Vector3.new(0, (hullBottom + hullTop) / 2, (geo.zF + hullEnd) / 2)
		)
	end
	buildWheels(ctx, geo)
	buildSeats(ctx, geo)

	-- weld everything visual to the chassis
	if not anchored then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") and d ~= ctx.chassis and d:GetAttribute("Wheel") == nil then
				local parent = d.Parent
				local isRimPart = parent and parent:IsA("BasePart") and parent:GetAttribute("Wheel") ~= nil
				local hasWeld = d:FindFirstChildOfClass("WeldConstraint") ~= nil
				if not isRimPart and not hasWeld then
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = ctx.chassis
					weld.Part1 = d
					weld.Parent = d
				end
			end
		end
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.CollisionGroup = "Cars"
			end
		end
	end

	model:SetAttribute("CarId", def.id)
	model:SetAttribute("Seats", ctx.seatCount)
	model:SetAttribute("HasSiren", def.features.siren ~= nil)
	if def.features.siren then
		model:SetAttribute("SirenType", def.features.siren)
	end
	return model
end

-- Re-applies paint, finish, rims and underglow to an existing model.
function CarBuilder.applyPaint(model: Model, save: CarSave)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local role = d:GetAttribute("Role")
			if role == "Paint" or role == "Accent" or role == "NeonAccent" or role == "Rim" or role == "Glow" then
				applyRole(d, role, save)
			end
		end
	end
end

-- Approximate bounding size of a car (for spawn spacing and cameras).
function CarBuilder.getExtents(def: CarDef): Vector3
	local maxR = 0
	local maxTrack = 0
	for _, a in CarCatalog.getAxles(def) do
		maxR = math.max(maxR, a.radius)
		maxTrack = math.max(maxTrack, a.track + a.width)
	end
	local geo = measure(def)
	local height = def.body.belt
	if geo.cabin then
		height = geo.cabin.yR
	end
	if def.body.box then
		height = math.max(height, def.body.box.top)
	end
	return Vector3.new(math.max(def.body.width, maxTrack), math.max(height, maxR * 2) + 0.5, def.body.length)
end

return CarBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">CarCatalog</string>
          <string name="Source"><![CDATA[-- CarCatalog: every car in the game, described as data.
-- CarBuilder turns a definition into a model, CarPhysics drives it.
--
-- Coordinates are in studs in the car's own space: y = 0 is the ground,
-- the front of the car points to -Z, x = 0 is the center line.
-- To add a car: copy an entry with a similar style, change the numbers and
-- give it a unique `id`. Prices and stats are validated on the server.

local Config = require(script.Parent.Config)
local Types = require(script.Parent.Types)

type CarDef = Types.CarDef
type CarSave = Types.CarSave
type EffectiveStats = Types.EffectiveStats

local CarCatalog = {}

CarCatalog.Classes = {
	{ id = "Starter", name = { ru = "Старт", en = "Starter" }, color = Color3.fromRGB(140, 200, 255) },
	{ id = "Street", name = { ru = "Город", en = "Street" }, color = Color3.fromRGB(120, 220, 160) },
	{ id = "Utility", name = { ru = "Рабочие", en = "Utility" }, color = Color3.fromRGB(200, 180, 120) },
	{ id = "Offroad", name = { ru = "Внедорожники", en = "Offroad" }, color = Color3.fromRGB(170, 140, 90) },
	{ id = "Sport", name = { ru = "Спорт", en = "Sport" }, color = Color3.fromRGB(255, 150, 60) },
	{ id = "Muscle", name = { ru = "Маслкары", en = "Muscle" }, color = Color3.fromRGB(240, 90, 70) },
	{ id = "Emergency", name = { ru = "Спецслужбы", en = "Emergency" }, color = Color3.fromRGB(90, 140, 255) },
	{ id = "Super", name = { ru = "Суперкары", en = "Super" }, color = Color3.fromRGB(220, 90, 255) },
	{ id = "Hyper", name = { ru = "Гиперкары", en = "Hyper" }, color = Color3.fromRGB(255, 70, 160) },
	{ id = "Special", name = { ru = "Особые", en = "Special" }, color = Color3.fromRGB(255, 220, 80) },
}

local function stats(
	maxSpeed: number,
	accel: number,
	grip: number,
	steer: number,
	brake: number,
	drift: number,
	nitro: number,
	offroad: number,
	mass: number,
	drive: Types.DriveType,
	rest: number,
	freq: number?,
	damping: number?
): Types.CarStats
	return {
		maxSpeed = maxSpeed,
		accel = accel,
		grip = grip,
		steer = steer,
		brake = brake,
		drift = drift,
		nitro = nitro,
		offroad = offroad,
		mass = mass,
		drive = drive,
		suspension = { rest = rest, freq = freq, damping = damping },
	}
end

