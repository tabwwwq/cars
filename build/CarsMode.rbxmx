      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[-- Types: shared type definitions that cross the client/server boundary.

export type Localized = { ru: string, en: string }

export type DriveType = "RWD" | "FWD" | "AWD"

export type SuspensionSpec = {
	rest: number, -- spring travel in studs
	freq: number?, -- natural frequency (Hz)
	damping: number?, -- damping ratio
}

export type CarStats = {
	maxSpeed: number, -- studs/s
	accel: number, -- studs/s^2
	grip: number, -- tire friction coefficient (~1)
	steer: number, -- max steering angle, degrees
	brake: number, -- braking deceleration, studs/s^2
	drift: number, -- 0..1, how easily the rear lets go
	nitro: number, -- nitro power multiplier
	offroad: number, -- 0..1, how little rough surfaces slow the car
	mass: number, -- relative mass (1 = a normal car)
	drive: DriveType,
	suspension: SuspensionSpec,
}

export type AxleSpec = {
	z: number, -- axle position along the car (front is negative)
	steer: boolean,
	drive: boolean,
	radius: number?,
	width: number?,
	track: number?,
}

export type WheelSpec = {
	radius: number,
	width: number,
	base: number, -- wheelbase (front axle to rear axle)
	track: number, -- distance between left and right wheel centers
	offset: number?, -- shifts both axles along z
	rearRadius: number?,
	rearWidth: number?,
	rearTrack: number?,
	axles: { AxleSpec }?, -- full override (trucks with 3 axles, etc.)
	rim: string?, -- "steel" | "disc" | "spoke" | "star" | "offroad" | "aero"
}

export type CabinSpec = {
	start: number, -- distance from the front of the car to the windshield base
	wind: number, -- windshield length (z)
	roof: number, -- flat roof length (z)
	back: number, -- rear glass length (z); 0 = vertical back
	height: number, -- roof height above the belt line
	inset: number, -- glasshouse inset from the body sides
	open: boolean?, -- convertible
	sideWindows: number?, -- only the first N studs of the roof section are glass (vans)
	windowPillars: number?, -- spacing of pillars along long side windows (bus, limo)
	glassRoof: boolean?,
}

export type BodySpec = {
	style: string, -- "car" | "pickup" | "box" | "semi" | "openwheel" | "kart" | "buggy" | "tractor"
	length: number,
	width: number,
	floor: number, -- body bottom height
	belt: number, -- hood/shoulder height
	nose: number?,
	noseDrop: number?,
	tail: number?,
	tailDrop: number?,
	cabin: CabinSpec?,
	bed: { start: number }?,
	box: { start: number, top: number, length: number? }?,
}

export type CarColors = { paint: number, accent: number, rim: number }

export type SeatSpec = { x: number, z: number, y: number?, driver: boolean? }

export type CarDef = {
	id: string,
	name: string,
	class: string,
	price: number,
	description: Localized,
	stats: CarStats,
	wheels: WheelSpec,
	body: BodySpec,
	colors: CarColors,
	features: { [string]: any },
	seats: { SeatSpec }?,
	maxSeats: number?,
	-- optional: name of a template model in ReplicatedStorage.CarsAssets.Cars
	-- used as the visual body (see CarBuilder.findTemplate)
	customModel: string?,
}

-- Saved per-car customization and upgrades
export type CarSave = {
	paint: number,
	accent: number,
	rim: number,
	finish: string,
	glow: number, -- 0 = no underglow, otherwise palette index
	glowOwned: boolean,
	engine: number,
	tires: number,
	nitro: number,
}

export type Profile = {
	version: number,
	cash: number,
	owned: { [string]: boolean },
	cars: { [string]: CarSave },
	selected: string,
	bestTimes: { [string]: number },
	medals: { [string]: string },
	topSpeed: number,
	stats: {
		distance: number,
		drifts: number,
		airtime: number,
		races: number,
		earned: number,
	},
	daily: { last: number, streak: number },
	finishes: { [string]: boolean },
}

-- Effective (upgraded) stats the physics actually uses
export type EffectiveStats = {
	maxSpeed: number,
	accel: number,
	grip: number,
	steer: number,
	brake: number,
	drift: number,
	nitroPower: number,
	nitroRecharge: number,
	offroad: number,
	drive: DriveType,
	suspRest: number,
	suspFreq: number,
	suspDamping: number,
}

export type RequestResult = { ok: boolean, message: string?, args: { any }? }

return {}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="48">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[-- Format: number/time/speed formatting shared by the HUD, garage and boards.

local Config = require(script.Parent.Parent.Config)

local Format = {}

-- 1234567 -> "1,234,567"
function Format.int(n: number): string
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return if n < 0 then "-" .. out else out
end

function Format.money(n: number): string
	return "$" .. Format.int(n)
end

-- Short form for big prices: 1250000 -> "$1.25M", 48000 -> "$48K"
function Format.moneyShort(n: number): string
	if n >= 1e6 then
		return (string.format("$%.2fM", n / 1e6):gsub("%.?0+M$", "M"))
	elseif n >= 1e4 then
		return string.format("$%dK", math.floor(n / 1000))
	end
	return Format.money(n)
end

-- 83.456 -> "1:23.46"
function Format.time(seconds: number): string
	if seconds ~= seconds or seconds == math.huge then
		return "--:--.--"
	end
	local m = math.floor(seconds / 60)
	local s = seconds - m * 60
	return string.format("%d:%05.2f", m, s)
end

-- studs/s -> displayed km/h
function Format.speed(studsPerSecond: number): number
	return math.floor(math.abs(studsPerSecond) * Config.SpeedDisplayFactor + 0.5)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[-- Signal: a tiny synchronous event object for module-to-module communication.

export type Connection = { Connected: boolean, Disconnect: (self: Connection) -> () }

local Signal = {}
Signal.__index = Signal

export type Signal<T...> = typeof(setmetatable({} :: { _handlers: { [Connection]: (T...) -> () } }, Signal))

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal.Connect(self, fn: (...any) -> ()): Connection
	local handlers = self._handlers
	local conn = { Connected = true } :: any
	function conn.Disconnect(c)
		c.Connected = false
		handlers[c] = nil
	end
	handlers[conn] = fn
	return conn
end

function Signal.Once(self, fn: (...any) -> ()): Connection
	local conn
	conn = self:Connect(function(...)
		conn:Disconnect()
		fn(...)
	end)
	return conn
end

function Signal.Fire(self, ...: any)
	for conn, fn in table.clone(self._handlers) do
		if conn.Connected then
			local ok, err = pcall(fn, ...)
			if not ok then
				warn("[Signal] handler error: " .. tostring(err))
			end
		end
	end
end

function Signal.DisconnectAll(self)
	for conn in self._handlers do
		conn.Connected = false
	end
	table.clear(self._handlers)
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Spline</string>
            <string name="Source"><![CDATA[-- Spline: Catmull-Rom curves used to lay out race tracks and their checkpoints.

local Spline = {}

local function catmull(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, t: number): Vector3
	local t2, t3 = t * t, t * t * t
	return (p1 * 2 + (p2 - p0) * t + (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2 + (p1 * 3 - p0 - p2 * 3 + p3) * t3) * 0.5
end

-- Samples the curve densely, then resamples at an even spacing.
-- Returns { { pos: Vector3, dir: Vector3, dist: number } }
export type Sample = { pos: Vector3, dir: Vector3, dist: number }

function Spline.sample(points: { Vector3 }, closed: boolean, spacing: number): ({ Sample }, number)
	local n = #points
	assert(n >= 2, "Spline needs at least two points")
	local function at(i: number): Vector3
		if closed then
			return points[((i - 1) % n) + 1]
		end
		return points[math.clamp(i, 1, n)]
	end
	local dense: { Vector3 } = {}
	local segments = if closed then n else n - 1
	local per = 24
	for i = 1, segments do
		for k = 0, per - 1 do
			table.insert(dense, catmull(at(i - 1), at(i), at(i + 1), at(i + 2), k / per))
		end
	end
	table.insert(dense, if closed then dense[1] else points[n])

	-- cumulative length
	local cum = { 0 }
	for i = 2, #dense do
		cum[i] = cum[i - 1] + (dense[i] - dense[i - 1]).Magnitude
	end
	local total = cum[#dense]
	local count = math.max(2, math.floor(total / spacing + 0.5))
	local step = total / count
	local out: { Sample } = {}
	local j = 1
	local last = if closed then count - 1 else count
	for i = 0, last do
		local d = i * step
		while j < #dense - 1 and cum[j + 1] < d do
			j += 1
		end
		local segLen = cum[j + 1] - cum[j]
		local t = if segLen > 0 then (d - cum[j]) / segLen else 0
		local pos = dense[j]:Lerp(dense[j + 1], math.clamp(t, 0, 1))
		local dir = dense[j + 1] - dense[j]
		dir = if dir.Magnitude > 1e-6 then dir.Unit else Vector3.new(0, 0, -1)
		table.insert(out, { pos = pos, dir = dir, dist = d })
	end
	return out, total
end

return Spline
]]></string>
          </Properties>
        </Item>
      </Item>
